def docs_qr():
    """The documentation site's QR code (made once)."""
    if "docs" not in _QR:
        _QR["docs"] = rommlib.qr_matrix(rommlib.DOCS_URL)
    return _QR["docs"]


_QR = {}


def draw_qr(c, matrix, rect):
    """A QR code, as large as fits in rect (logical), centred: whole physical
    pixels per module, dark on white with the 4-module quiet zone, whatever
    the theme (phones read dark on light best). Returns the physical rect."""
    n = len(matrix) + 8
    r = SR(rect)
    px = max(1, min(r.width, r.height) // n)
    box = pygame.Rect(0, 0, px * n, px * n)
    box.center = r.center
    pygame.draw.rect(c, (255, 255, 255), box, border_radius=px)
    for y, row in enumerate(matrix):
        x = 0
        while x < len(row):                     # one rect per run of dark modules
            if not row[x]:
                x += 1
                continue
            x0 = x
            while x < len(row) and row[x]:
                x += 1
            c.fill((0, 0, 0), (box.left + (x0 + 4) * px, box.top + (y + 4) * px, (x - x0) * px, px))
    return box


class DocsScreen(Screen):
    """Settings, Documentation: the docs site's QR code, big enough to scan from the couch."""

    def crumbs(self):
        return ["Settings", "Documentation"]

    def hints(self):
        return [("B", "Back")]

    def draw(self, c):
        p = pygame.Rect(48, 84, W - 96, 554)
        rrect(c, PANEL, p, 16)
        draw_qr(c, docs_qr(), pygame.Rect(p.left + 32, p.top + 32, 490, p.height - 64))
        x, w = p.left + 32 + 490 + 40, p.right - 32 - (p.left + 32 + 490 + 40)
        text(c, self.f.h2, "Documentation", (x, p.top + 60), TEXT, maxw=w)
        text(c, self.f.body, rommlib.DOCS_URL.replace("https://", "").rstrip("/"), (x, p.top + 104), ACCENT_HI,
             maxw=w)
        yy = p.top + 160
        for para in ("Point your phone's camera at the code to open it.",
                     "Installing, connecting to RomM, browsing and downloading, disc compression, PS3 games, "
                     "every setting, the controls, and what to do when something goes wrong."):
            for ln in wrap(self.f.body, para, w):
                text(c, self.f.body, ln, (x, yy), DIM)
                yy += 28
            yy += 14


class CreditsScreen(ListScreen):
    """Who made what RomM-o-Cera uses or downloads, and under which license."""
    ROW_H = 96
    ROWS, STEP = (H - 60 - 84) // ROW_H, 5     # 6 show, L/R pages by 5

    def __init__(self, app):
        super().__init__(app)
        self.sel = self.scroll = 0

    def crumbs(self):
        return ["Settings", "Credits and licenses"]

    def hints(self):
        return [("L", "Page up"), ("R", "Page down"), ("B", "Back")]

    def listed(self):
        return CREDITS

    def tap_row(self, i):
        self.sel = i                 # nothing to open: a tap only selects

    def action(self, a):
        if not self.nav(a):
            super().action(a)

    def draw(self, c):
        for i, r, on in self.row_rects(84, gap=8):
            name, what, lic, url, note = CREDITS[i]
            rrect(c, PANEL_HI if on else PANEL, r, 12)
            if on:
                rrect(c, ACCENT, r, 12, 2)
            t = text(c, self.f.h3, name, (r.left + 22, r.top + 8), TEXT)
            text(c, self.f.small, what, (t.right + 12, r.top + 13), DIM, maxw=r.right - 380 - t.right)
            text(c, self.f.small, lic, (r.right - 22, r.top + 13), ACCENT_HI, "topright", maxw=330)
            text(c, self.f.small, url, (r.left + 22, r.top + 38), FAINT, maxw=r.width - 44)
            if note:
                text(c, self.f.small, note, (r.left + 22, r.top + 60), FAINT, maxw=r.width - 44)


# ---- On this box: shared data and the space bar

MEDIA_COL = (232, 121, 249)     # covers, videos, manuals
SYSTEM_COL = mix(BG, FAINT, 0.57)   # Batocera itself, saves, BIOS: everything outside the game folders
SPACE_PARTS = (("ours", ACCENT, "From RomM-o-Cera"), ("other", BLUE, "Added another way"),
               ("media", MEDIA_COL, "Media"))


def installed_games(lib):
    """Games RomM-o-Cera installed that are still on the box, biggest first.
    A multi-disc set is one row."""
    out, sets = [], {}
    with lib.lock:
        lib._reload()
        recs = list(lib.installed.items())
    for rid, rec in recs:
        paths = [p for p in rec.get("paths", []) if os.path.exists(p)]
        if not paths:
            continue
        g = rec.get("group")
        if g:
            it = sets.get(g["id"])
            if it is None:
                it = sets[g["id"]] = {"id": int(rid), "group": g, "paths": [],
                                      "name": "%s (%d discs)" % (g.get("title") or g["base"],
                                                                 len(g.get("rom_ids") or [])),
                                      "system": rec.get("system"), "when": rec.get("when", "")}
                out.append(it)
            it["paths"] += [p for p in paths if p not in it["paths"]]
            continue
        out.append({"id": int(rid), "name": rec.get("name") or os.path.basename(paths[0]),
                    "system": rec.get("system"), "when": rec.get("when", ""), "paths": paths})
    for it in out:
        it["size"] = sum(rommlib.path_size(p) for p in it.pop("paths"))
    return sorted(out, key=lambda i: -i["size"])


def storage_by_system(lib):
    """Space per system: RomM-o-Cera's games, other games, and media."""
    with lib.lock:
        lib._reload()
        ours = {os.path.normpath(p) for rec in lib.installed.values() for p in rec.get("paths", [])}
    out = []
    for system in sorted(os.listdir(rommlib.ROMS_ROOT)):
        sysdir = os.path.join(rommlib.ROMS_ROOT, system)
        if not os.path.isdir(sysdir) or os.path.islink(sysdir):
            continue
        row = {"system": system, "ours": 0, "other": 0, "media": 0}
        for dp, dns, fns in os.walk(sysdir):
            rel = os.path.relpath(dp, sysdir)
            media = rel != "." and rel.split(os.sep)[0] in rommlib.MEDIA_DIRS
            top = None if rel == "." else os.path.normpath(os.path.join(sysdir, rel.split(os.sep)[0]))
            for fn in fns:
                p = os.path.join(dp, fn)
                try:
                    n = os.lstat(p).st_size
                except OSError:
                    continue
                if media:
                    row["media"] += n
                elif os.path.normpath(p) in ours or (top and top in ours):
                    row["ours"] += n
                elif fn.lower().endswith((".xml", ".txt")) or ".bak" in fn.lower():
                    row["media"] += n
                else:
                    row["other"] += n
        row["total"] = row["ours"] + row["other"] + row["media"]
        if row["total"]:
            out.append(row)
    return sorted(out, key=lambda r: -r["total"])


def disk_space(cfg):
    """(total, free, keep-free reserve) of the roms drive; zeros if unknown."""
    try:
        st = os.statvfs(rommlib.ROMS_ROOT)
        total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
    except OSError:
        total = free = 0
    return total, free, rommlib.keep_free_bytes(cfg)


def pending_roms(app):
    """Downloads still queued or paused: their partial files aren't leftovers."""
    d = app.downloader
    pend = [(j.rom, j.system) for j in list(d.jobs) if j.active or j.state == rommlib.Job.PAUSED]
    return pend + [(it["rom"], it["system"]) for it in rommlib.Downloader.saved_queue()
                   if it.get("rom") and it.get("system")]


def conversion_rows():
    """Conversions: the one running, the queue, then recent results (newest
    first). The worker (rb_chd.py) publishes chd-current.json and chd-results.jsonl."""
    qdir = rommlib.CHD_QUEUE_DIR
    cur = {}
    try:
        with open(rommlib.chd_current_path()) as f:
            cur = json.load(f)
    except (OSError, ValueError):
        pass
    rows = []
    try:
        names = sorted(n for n in os.listdir(qdir) if n.endswith(".json"))
    except OSError:
        names = []
    for n in names:
        try:
            with open(os.path.join(qdir, n)) as f:
                t = json.load(f)
        except (OSError, ValueError):
            continue
        srcs = t.get("sources") or []
        size = 0
        for x in srcs:
            try:
                size += os.path.getsize(x)
            except OSError:
                pass
        rows.append({"kind": "running" if n == cur.get("task") else "queued", "name": n, "task": t,
                     "title": os.path.splitext(os.path.basename(srcs[0]))[0] if srcs else n,
                     "discs": len(srcs), "size": size, "cur": cur if n == cur.get("task") else None})
    rows.sort(key=lambda r: r["kind"] != "running")
    try:
        with open(rommlib.chd_results_path()) as f:
            done = [json.loads(l) for l in f.readlines()[-60:] if l.strip()]
    except (OSError, ValueError):
        done = []
    for d in reversed(done):
        srcs = d.get("sources") or [""]
        rows.append({"kind": d.get("result"), "name": d.get("task"), "task": d.get("retry"),
                     "title": os.path.splitext(os.path.basename(srcs[0]))[0], "discs": len(srcs),
                     "message": d.get("message") or "", "time": d.get("time", 0), "mode": d.get("mode")})
    return rows


def conversion_status(r):
    """'Converting 42% · about 2 min left' for the running row."""
    cu = r.get("cur") or {}
    pct = cu.get("pct")
    st = cu.get("step") or "Starting"
    if pct:
        st += " %d%%" % pct
        if pct > 2:
            el = time.time() - (cu.get("since") or time.time())
            st += " · about %d min left" % max(1, round(el * (100 - pct) / pct / 60))
    return st, (pct or 0) / 100.0


def hatch(surf, rect, color, step=9):
    """Diagonal stripes: space that's set aside, not used."""
    pr = SR(rect)
    old = surf.get_clip()
    surf.set_clip(pr.clip(old) if old else pr)
    for x in range(pr.left - pr.height, pr.right, max(2, S(step))):
        pygame.draw.line(surf, color, (x, pr.bottom), (x + pr.height, pr.top), max(1, S(2)))
    surf.set_clip(old)


def space_parts(rows, total, free):
    """The space bar's used parts, summed over systems; the rest of the used
    space is Batocera itself, saves and BIOS."""
    parts = [(key, col, lab, sum(r[key] for r in rows or [])) for key, col, lab in SPACE_PARTS]
    rest = max(0, total - free - sum(p[3] for p in parts))
    return parts + [("system", SYSTEM_COL, "Batocera and saves", rest)]


def space_bar(surf, fonts, rect, parts, total, free, keep, cols=2):
    """The whole drive as one bar: each used part in its colour, the free
    space as an empty track whose last stretch, the keep-free reserve
    downloads never use, is striped. Then the legend; returns its bottom."""
    x, y, w, h = rect
    if total <= 0:
        return y
    pr = SR(rect)
    bar = pygame.Surface(pr.size, pygame.SRCALPHA)
    bar.fill(BG2)
    kw = int(pr.width * min(keep, total) / total)
    kr = pygame.Rect(pr.width - kw, 0, kw, pr.height)
    old = bar.get_clip()
    bar.set_clip(kr)
    for sx in range(kr.left - pr.height, kr.right, max(2, S(9))):
        pygame.draw.line(bar, LINE, (sx, pr.height), (sx + pr.height, 0), max(1, S(2)))
    bar.set_clip(old)
    cx = 0
    for key, col, lab, n in parts:
        sw = int(pr.width * n / total)
        if n and sw < S(3):
            sw = S(3)
        if sw:
            bar.fill(col, (cx, 0, sw, pr.height))
            cx += sw
    mask = pygame.Surface(pr.size, pygame.SRCALPHA)
    pygame.draw.rect(mask, (255, 255, 255, 255), mask.get_rect(), border_radius=pr.height // 2)
    bar.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MIN)
    surf.blit(bar, pr.topleft)
    usable = max(0, free - keep)
    items = [(lab, n, col) for key, col, lab, n in parts if n] + \
        [("Free for downloads", usable, None), ("Kept free", min(keep, total), "hatch")]
    colw = w // cols
    ly = y + h + 16
    for i, (lab, n, col) in enumerate(items):
        lx, yy = x + (i % cols) * colw, ly + (i // cols) * 28
        sw = pygame.Rect(lx, yy + 3, 14, 14)
        if col == "hatch":
            rrect(surf, BG2, sw, 4)
            hatch(surf, sw, DIM, 5)
        elif col is None:
            rrect(surf, BG2, sw, 4)
            rrect(surf, LINE, sw, 4, 1)
        else:
            rrect(surf, col, sw, 4)
        size = human_size(n)
        text(surf, fonts.small, size, (lx + colw - 28, yy), TEXT, "topright")
        text(surf, fonts.small, lab, (lx + 24, yy), DIM, maxw=colw - 64 - measure(fonts.small, size))
    return ly + ((len(items) + cols - 1) // cols) * 28


def bios_rows(app):
    """BIOS status: systems with games here first (needing attention first),
    then the others RomM has BIOS files for."""
    by_sys = {}
    for p in app.platforms:
        by_sys.setdefault(p["_system"], []).append(p["id"])
    with_games = set()
    try:
        for d in os.listdir(rommlib.ROMS_ROOT):
            full = os.path.join(rommlib.ROMS_ROOT, d)
            if os.path.isdir(full) and any(not n.startswith(".") and n not in
                                           ("gamelist.xml", "_info.txt") + rommlib.GAMELIST_MEDIA_DIRS
                                           for n in os.listdir(full)):
                with_games.add(d)
    except OSError:
        pass
    rows = rommlib.bios_status(app.api if app.platforms else None, by_sys, with_games)
    for r in rows:
        r["here"] = r["system"] in with_games
    return sorted(rows, key=lambda r: (not r["here"], 0 if r["offers"] else 1 if r["missing"] else 2,
                                       r["name"].lower()))


def bios_pill(it):
    """(pill text, colour, detail line) for one system's BIOS row."""
    nmiss, noff = len(it["missing"]), len(it["offers"])
    if not nmiss:
        sub = "%d file%s" % (len(it["required"]), "" if len(it["required"]) == 1 else "s")
        if it["fetched"]:
            f, rec = sorted(it["fetched"].items(), key=lambda kv: kv[1].get("when", ""))[-1]
            sub += " · %d fetched by RomM-o-Cera, last %s" % (len(it["fetched"]), rec.get("when", "")[:10])
        return "Complete", GREEN, sub
    if noff:
        return ("RomM has %d of %d missing" % (noff, nmiss), ACCENT_HI,
                ", ".join(os.path.basename(m["file"]) for m, _ in it["offers"][:4]))
    return ("%d missing, not in RomM" % nmiss, AMBER,
            ", ".join(os.path.basename(m["file"]) for m in it["missing"][:4]))


def plural(n, word, many=None):
    return "%d %s" % (n, word if n == 1 else (many or word + "s"))


class OnThisBoxScreen(Screen):
    """What's on the box, one section each: games from RomM, space, BIOS,
    checks, conversions, game info. Each line under a section is its live
    state, coloured only when something wants attention; the panel on the
    right previews the selected section, A opens it."""
    ITEMS = [("games", "Games from RomM"), ("space", "Space"), ("compress", "Compress games already here"),
             ("bios", "BIOS files"), ("check", "Check games"), ("conv", "Conversions"),
             ("info", "Fill in game info")]
    TILE_H, STEP = 70, 80

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.games = self.storage = self.leftovers = self.bios = self.counts = None
        self.audit, self.convs, self.conv_at = None, [], 0
        self.compress = None

    def enter(self):
        app = self.app
        app.bg(compress_scan, lambda v: setattr(self, "compress", v), lambda e: setattr(self, "compress", []))
        app.bg(lambda: installed_games(app.library), lambda v: setattr(self, "games", v),
               lambda e: setattr(self, "games", []))
        app.bg(lambda: storage_by_system(app.library), lambda v: setattr(self, "storage", v),
               lambda e: setattr(self, "storage", []))
        app.bg(lambda: rommlib.find_leftovers(pending_roms(app)), lambda v: setattr(self, "leftovers", v),
               lambda e: setattr(self, "leftovers", []))
        app.bg(lambda: bios_rows(app), lambda v: setattr(self, "bios", v), lambda e: setattr(self, "bios", []))
        app.bg(rommlib.es_counts, lambda v: setattr(self, "counts", v), lambda e: setattr(self, "counts", {}))
        self.audit = rommlib.load_audit()
        self.convs, self.conv_at = conversion_rows(), time.time()

    def crumbs(self):
        return ["On this box"]

    def hints(self):
        return [("A", "Open"), ("B", "Back")]

    def action(self, a):
        app = self.app
        if a == "up":
            self.sel = (self.sel - 1) % len(self.ITEMS)
        elif a == "down":
            self.sel = (self.sel + 1) % len(self.ITEMS)
        elif a == "ok":
            key = self.ITEMS[self.sel][0]
            if key == "games":
                app.push(InstalledScreen(app))
            elif key == "space":
                app.push(SpaceScreen(app))
            elif key == "compress":
                app.push(CompressScreen(app))
            elif key == "bios":
                app.push(BiosScreen(app))
            elif key == "check":
                app.push(CheckScreen(app))
            elif key == "conv":
                app.push(ConversionsScreen(app))
            elif key == "info":
                if not app.platforms:
                    app.load_platforms()
                    app.toast(app.error or "Still loading platforms…", AMBER)
                else:
                    InfoDialog.start(app, InfoDialog.all_systems(app))
        else:
            super().action(a)

    # -- the line under each section: (text, colour or None)
    def verdict(self, key):
        app = self.app
        if key == "games":
            if self.games is None:
                return "Measuring…", None
            if not self.games:
                return "None yet", None
            return "%s, %s" % (plural(len(self.games), "game"), human_size(sum(g["size"] for g in self.games))), None
        if key == "space":
            total, free, keep = disk_space(app.cfg)
            if not total:
                return "Can't read the drive", AMBER
            if free < keep:
                return "%s free: under the %s kept free" % (human_size(free), human_size(keep)), AMBER
            return "%s free, %s for downloads" % (human_size(free), human_size(free - keep)), None
        if key == "bios":
            if self.bios is None:
                return "Checking…", None
            here = [r for r in self.bios if r.get("here")]
            if not here:
                return "No BIOS needed", None
            offer = [r for r in here if r["offers"]]
            gone = [r for r in here if r["missing"] and not r["offers"]]
            if offer:
                if len(offer) == 1:
                    n = len(offer[0]["offers"])
                    return "%s is missing %s RomM has" % (offer[0]["name"], plural(n, "file")), ACCENT_HI
                return "%d systems are missing files RomM has" % len(offer), ACCENT_HI
            if gone:
                return "%s missing files, not in RomM" % plural(len(gone), "system"), AMBER
            return "All %s complete" % plural(len(here), "system"), None
        if key == "check":
            a = self.audit
            if not a:
                return "Not checked yet", None
            when = time.strftime("%Y-%m-%d", time.localtime(a.get("time", 0)))
            dmg = sum(1 for f in a["findings"] if f["severity"] == "damaged")
            dif = len(a["findings"]) - dmg
            if not a["findings"]:
                return "All good on %s" % when, None
            bits = (["%d damaged" % dmg] if dmg else []) + (["%d differ from RomM" % dif] if dif else [])
            return "%s, checked %s" % (", ".join(bits), when), RED if dmg else AMBER
        if key == "compress":
            if self.compress is None:
                return "Looking…", None
            ok = [c for c in self.compress if c["enabled"]]
            if not ok:
                return "Nothing left to compress", None
            return "%s could be smaller (%s)" % (plural(len(ok), "game"), human_size(sum(c["size"] for c in ok))), None
        if key == "conv":
            run = next((r for r in self.convs if r["kind"] == "running"), None)
            nq = sum(1 for r in self.convs if r["kind"] == "queued")
            if run:
                return "Converting" + (", %d waiting" % nq if nq else ""), BLUE
            if nq:
                return "%d waiting for a quiet moment" % nq, None
            failed = [r for r in self.convs if r["kind"] == "failed"]
            if failed:
                return "%s failed: retry from here" % plural(len(failed), "conversion"), RED
            return "Nothing waiting", None
        return "Covers, descriptions, manuals from RomM", None

    def draw(self, c):
        if time.time() - self.conv_at > 1.0:
            self.convs, self.conv_at = conversion_rows(), time.time()
        y = 84
        for i, (key, label) in enumerate(self.ITEMS):
            r = pygame.Rect(48, y, 520, self.TILE_H)
            self.app.hit(r, lambda i=i: self.tap_now(i))
            on = i == self.sel
            if on:
                focus_box(c, r, 14)
            else:
                rrect(c, PANEL, r, 14)
            text(c, self.f.h2, label, (r.left + 28, r.top + 9), TEXT if on else DIM)
            line, col = self.verdict(key)
            if col:
                circle(c, col, (r.left + 33, r.top + 50), 5)
            text(c, self.f.small, line, (r.left + (44 if col else 28), r.top + 40),
                 col or (DIM if on else FAINT), maxw=r.width - 60)
            y += self.STEP
        p = pygame.Rect(616, 84, 616, self.STEP * (len(self.ITEMS) - 1) + self.TILE_H)
        rrect(c, PANEL, p, 16)
        getattr(self, "panel_" + self.ITEMS[self.sel][0])(c, p)

    def foot(self, c, p, s, col=None):
        col = DIM if col is None else col
        hline(c, LINE, (p.left + 28, p.bottom - 74), (p.right - 28, p.bottom - 74))
        rich_text(c, self.f, self.f.body, s, (p.left + 28, p.bottom - 38), col, "midleft", maxw=p.width - 56)

    def head(self, c, p, title, right=""):
        text(c, self.f.h2, title, (p.left + 28, p.top + 22), TEXT, maxw=p.width - 260)
        if right:
            text(c, self.f.small, right, (p.right - 28, p.top + 28), FAINT, "topright", maxw=280)

    def waiting(self, c, p, s):
        text(c, self.f.body, s, (p.left + 28, p.top + 72), DIM)

    def panel_games(self, c, p):
        x = p.left + 28
        self.head(c, p, "Biggest first", self.verdict("games")[0] if self.games else "")
        if self.games is None:
            return self.waiting(c, p, "Measuring…")
        if not self.games:
            for i, ln in enumerate(wrap(self.f.body, "Nothing downloaded with RomM-o-Cera yet. Games copied over "
                                        "another way are in Space, under Free up space.", p.width - 56)):
                text(c, self.f.body, ln, (x, p.top + 72 + i * 26), DIM)
            return
        yy = p.top + 72
        for g in self.games[:7]:
            text(c, self.f.row, g["name"], (x, yy), DIM, maxw=p.width - 240)
            tag = g["system"] or "?"
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(p.right - 128 - tw, yy + 3, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, FAINT, "center")
            text(c, self.f.small, human_size(g["size"]), (p.right - 28, yy + 3), DIM, "topright")
            yy += 44
        if len(self.games) > 7:
            text(c, self.f.small, "and %d more" % (len(self.games) - 7), (x, yy), FAINT)
        self.foot(c, p, "Delete any of them; saves and states are kept.")

    def panel_space(self, c, p):
        x, w = p.left + 28, p.width - 56
        total, free, keep = disk_space(self.app.cfg)
        if not total:
            return self.head(c, p, "Can't read the drive")
        text(c, self.f.h1, human_size(free) + " free", (x, p.top + 20), AMBER if free < keep else TEXT)
        text(c, self.f.small, "of " + human_size(total), (p.right - 28, p.top + 36), FAINT, "topright")
        if self.storage is None:
            return self.waiting(c, p, "Measuring every system…")
        yy = space_bar(c, self.f, (x, p.top + 82, w, 26), space_parts(self.storage, total, free),
                       total, free, keep) + 16
        if self.storage:
            text(c, self.f.h3, "Biggest systems", (x, yy), TEXT)
            yy += 34
            big = self.storage[0]["total"] or 1
            for r in self.storage[:3]:
                text(c, self.f.body, r["system"], (x, yy), DIM, maxw=110)
                bx, bw = x + 120, w - 230
                for k, col, _ in SPACE_PARTS:
                    sw = int(bw * r[k] / big)
                    if sw:
                        rrect(c, col, (bx, yy + 8, max(4, sw), 8), 4)
                        bx += sw + 2
                text(c, self.f.small, human_size(r["total"]), (p.right - 28, yy + 1), DIM, "topright")
                yy += 30
        if self.leftovers:
            n = sum(i["size"] for i in self.leftovers)
            self.foot(c, p, "%s of leftovers from interrupted downloads" % human_size(n), AMBER)
        elif self.leftovers is not None:
            self.foot(c, p, "No leftovers to clean up.")

    def panel_bios(self, c, p):
        x = p.left + 28
        self.head(c, p, "Systems with games here", "" if self.app.platforms else "RomM offline")
        if self.bios is None:
            return self.waiting(c, p, "Checking BIOS files…")
        here = [r for r in self.bios if r.get("here")]
        if not here:
            return self.waiting(c, p, "None of the systems with games on this box needs BIOS files.")
        yy = p.top + 70
        for it in here[:6]:
            pill, col, sub = bios_pill(it)
            pw = int(measure(self.f.small, pill)) + 24
            text(c, self.f.row, it["name"], (x, yy), DIM, maxw=p.width - 90 - pw)
            text(c, self.f.small, sub, (x, yy + 26), FAINT, maxw=p.width - 90 - pw)
            pr = pygame.Rect(p.right - 28 - pw, yy + 6, pw, 30)
            rrect(c, BG2, pr, 15)
            text(c, self.f.small, pill, pr.center, col, "center")
            yy += 64
        others = len(self.bios) - len(here)
        more = (["%s more" % plural(len(here) - 6, "system")] if len(here) > 6 else []) + \
            (["%d without games here" % others] if others else [])
        if more:
            text(c, self.f.small, "Also: " + ", ".join(more), (x, yy), FAINT)
        if any(r["offers"] for r in here):
            self.foot(c, p, "Files RomM has: get one, or all at once.")
        else:
            self.foot(c, p, "Files go to /userdata/bios")

    def panel_check(self, c, p):
        x, a = p.left + 28, self.audit
        if not a:
            self.head(c, p, "Not checked yet")
            yy = p.top + 72
        else:
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(a.get("time", 0)))
            self.head(c, p, "Last check", "%s, %s" % ("Full check" if a.get("deep") else "Quick check", when))
            yy = p.top + 66
            for f in a["findings"][:3]:
                col = RED if f["severity"] == "damaged" else AMBER
                r = pygame.Rect(x, yy, p.width - 56, 70)
                rrect(c, BG2, r, 10)
                rrect(c, col, (r.left, r.top + 12, 4, r.height - 24), 2)
                name = (f.get("rom") or {}).get("name") or os.path.basename(f["path"])
                text(c, self.f.row, name, (r.left + 20, r.top + 10), TEXT, maxw=r.width - 120)
                text(c, self.f.small, f["problem"], (r.left + 20, r.top + 40), col, maxw=r.width - 40)
                text(c, self.f.tiny, f["system"], (r.right - 16, r.top + 14), FAINT, "topright")
                yy += 82
            st = a.get("stats") or {}
            more = len(a["findings"]) - 3
            line = ("and %d more. " % more if more > 0 else "") + \
                "%d checked, %d matched to RomM." % (st.get("checked", 0), st.get("matched", 0))
            text(c, self.f.body, line, (x, yy + 4), GREEN if not a["findings"] else DIM)
            yy += 50
        text(c, self.f.h3, "Quick check", (x, yy), TEXT)
        text(c, self.f.small, "Missing tracks, damaged zips, cut-short discs, sizes against RomM.", (x, yy + 26),
             FAINT, maxw=p.width - 56)
        text(c, self.f.h3, "Full check", (x, yy + 62), TEXT)
        text(c, self.f.small, "Also checksums every file and verifies CHDs. Hours for a big library.",
             (x, yy + 88), FAINT, maxw=p.width - 56)
        self.foot(c, p, "Damaged games can be downloaded again; saves follow.")

    def panel_compress(self, c, p):
        x = p.left + 28
        self.head(c, p, "Not compressed yet", "by system")
        if self.compress is None:
            return self.waiting(c, p, "Looking through every system…")
        rows = compress_by_system(self.compress)
        if not rows:
            for i, ln in enumerate(wrap(self.f.body, "Every disc game here that a converter supports is "
                                        "compressed already (or queued).", p.width - 56)):
                text(c, self.f.body, ln, (x, p.top + 72 + i * 26), DIM)
            return
        yy = p.top + 70
        for r in rows[:7]:
            col = DIM if r["enabled"] else FAINT
            text(c, self.f.row, r["system"], (x, yy), col, maxw=170)
            text(c, self.f.small, "%s, %s" % (plural(r["n"], "game"), human_size(r["size"])), (x + 180, yy + 3),
                 FAINT, maxw=220)
            text(c, self.f.small, ("to " + r["label"]) if r["enabled"] else "needs a setting",
                 (p.right - 28, yy + 3), ACCENT_HI if r["enabled"] else FAINT, "topright")
            yy += 40
        if len(rows) > 7:
            text(c, self.f.small, "and %s more" % plural(len(rows) - 7, "system"), (x, yy), FAINT)
        self.foot(c, p, "One game, or a whole system (that can take hours).")

    def panel_conv(self, c, p):
        x = p.left + 28
        run = next((r for r in self.convs if r["kind"] == "running"), None)
        queued = [r for r in self.convs if r["kind"] == "queued"]
        done = [r for r in self.convs if r["kind"] not in ("running", "queued")]
        mode = lambda r: ConversionsScreen.MODES.get((r.get("task") or {}).get("mode") or r.get("mode"), "")  # noqa: E731
        if not self.convs:
            self.head(c, p, "Nothing to convert")
            for i, ln in enumerate(wrap(self.f.body, "Disc games are compressed in the background after they "
                                        "download, while nothing is playing.", p.width - 56)):
                text(c, self.f.body, ln, (x, p.top + 72 + i * 26), DIM)
            return
        yy = p.top + 66
        if run:
            self.head(c, p, "Converting now", "runs while nothing is playing")
            r = pygame.Rect(x, yy, p.width - 56, 92)
            rrect(c, BG2, r, 12)
            st, frac = conversion_status(run)
            text(c, self.f.row, run["title"], (r.left + 20, r.top + 12), TEXT, maxw=r.width - 40)
            text(c, self.f.small, "%s, %s" % (mode(run), st), (r.left + 20, r.top + 40), BLUE, maxw=r.width - 40)
            progress_bar(c, (r.left + 20, r.bottom - 22, r.width - 40, 8), frac, BLUE)
            yy = r.bottom + 26
        else:
            self.head(c, p, "Conversions", "runs while nothing is playing")
        for title, rows in (("Waiting", queued[:3]), ("Recent", done[:3])):
            if not rows:
                continue
            text(c, self.f.h3, title, (x, yy), TEXT)
            yy += 32
            for r in rows:
                text(c, self.f.body, r["title"], (x, yy), DIM, maxw=p.width - 300)
                if r["kind"] == "queued":
                    s, col = "%s, %s" % (mode(r), human_size(r["size"])), FAINT
                else:
                    s = {"ok": "Done", "failed": "Failed", "skipped": "Skipped", "waiting": "Waiting"}.get(
                        r["kind"], r["kind"] or "")
                    col = {"ok": GREEN, "failed": RED}.get(r["kind"], AMBER)
                text(c, self.f.small, s, (p.right - 28, yy + 2), col, "topright", maxw=220)
                yy += 32
            yy += 18
        self.foot(c, p, "Also in Downloads: {L2 R2}")

    def panel_info(self, c, p):
        x = p.left + 28
        self.head(c, p, "Systems RomM can fill in")
        yy = p.top + 70
        counts = self.counts or {}
        romm = {pl["_system"] for pl in self.app.platforms}
        systems = sorted(((k, v) for k, v in counts.items() if not romm or k in romm), key=lambda kv: -kv[1])
        for sysn, n in systems[:6]:
            text(c, self.f.row, sysn, (x, yy), DIM)
            text(c, self.f.small, plural(n, "game"), (p.right - 28, yy + 3), FAINT, "topright")
            yy += 38
        if len(systems) > 6:
            text(c, self.f.small, "and %s more" % plural(len(systems) - 6, "system"), (x, yy), FAINT)
            yy += 26
        for i, ln in enumerate(wrap(self.f.body, "Names, descriptions, covers and manuals from RomM, matched "
                                    "by file name. Only empty fields are filled: your own scrapes and edits "
                                    "are never replaced.", p.width - 56)):
            text(c, self.f.body, ln, (x, yy + 18 + i * 26), DIM)
        self.foot(c, p, "To do one system: its game list, then {X}")


def compress_scan(skipped=None):
    """Games here that could still be compressed (see rb_chd_plan.candidates);
    skipped gets (system, file, reason) for the ones that can't be."""
    import rb_chd_plan
    return rb_chd_plan.candidates(skipped=skipped)


def cant_convert_rows(skipped):
    """[{"system", "n", "size", "skipped": [(file, reason)], "cant": True}] in the planner's order:
    images a converter applies to but that can't be converted (an encrypted dump, a bad .cso…)."""
    by = {}
    for system, f, why in skipped:
        r = by.setdefault(system, {"system": system, "n": 0, "size": 0, "skipped": [], "cant": True,
                                   "enabled": False})
        r["n"] += 1
        try:
            r["size"] += os.path.getsize(f)
        except OSError:
            pass
        r["skipped"].append((f, why))
    return list(by.values())


def compress_by_system(cands):
    """[{"system", "n", "size", "label", "enabled", "setting"}], biggest first."""
    by = {}
    for c in cands:
        r = by.setdefault(c["system"], {"system": c["system"], "n": 0, "size": 0, "labels": [],
                                        "enabled": c["enabled"], "setting": c["setting"]})
        r["n"] += 1
        r["size"] += c["size"]
        if c["label"] not in r["labels"]:
            r["labels"].append(c["label"])
        r["enabled"] = r["enabled"] and c["enabled"]
    for r in by.values():
        r["label"] = "/".join(r["labels"])
    return sorted(by.values(), key=lambda r: -r["size"])


def compress_confirm(app, title, cands, done):
    """Ask before queueing a whole system: it can run for hours."""
    size = sum(c["size"] for c in cands)
    app.modal = Confirm(app, title,
                        "%s, %s to work through: this can take hours. It runs in the background, pauses "
                        "while you play, and each original goes only after its copy checks out."
                        % (plural(len(cands), "game"), human_size(size)),
                        "Compress %d" % len(cands), lambda: compress_queue(app, cands, done))


def compress_queue(app, cands, done=None):
    import rb_chd_plan

    def run():
        return rb_chd_plan.queue(cands)

    def ok(n):
        prep = sum(1 for c in cands if c.get("prep") and c["enabled"])
        if n > prep:
            app.spawn_helper("rb_chd.py")
            app.toast("Queued %s: they compress in the background (On this box, Conversions)"
                      % plural(n - prep, "game") + ("; %d Xbox made bootable" % prep if prep else ""), GREEN)
        else:
            app.toast("Made %s bootable" % plural(n, "Xbox game"), GREEN)
        if done:
            done()
    app.bg(run, ok)


class CompressScreen(ListScreen):
    """Compress games already here: every system with disc images a converter
    still applies to, biggest first. A: that system's games; X: all of them."""
    ROWS, ROW_H = 9, 58

    def __init__(self, app):
        super().__init__(app)
        self.cands, self.rows = None, []
        self.sel = self.scroll = 0

    def enter(self):
        self.load_error = None
        failed = self.load_failed("cands")

        def scan():
            skipped = []
            return compress_scan(skipped), skipped
        self.app.bg(scan, lambda r: self._loaded(*r), lambda e: (setattr(self, "rows", []), failed(e)))

    def _loaded(self, cands, skipped=()):
        self.cands = cands
        self.rows = compress_by_system(cands) + cant_convert_rows(skipped)    # those it can't: last, never queued
        self.clamp()

    def listed(self):
        return self.rows                 # set with cands, which every caller checks first

    def crumbs(self):
        return self.trail("Compress")

    def hints(self):
        if not self.rows:
            return [("B", "Back")]
        r = self.rows[self.sel]
        if r.get("cant"):
            return self.list_hints(("A", "Why"))
        return self.list_hints(("A", "Games"), *[("X", "Compress all %s" % r["system"])] if r["enabled"] else [])

    def action(self, a):
        if not self.rows:
            return super().action(a)
        if self.nav(a):
            return
        r = self.rows[self.sel]
        if r.get("cant") and a in ("ok", "x"):
            if a == "ok":
                self.app.push(CantConvertScreen(self.app, r["system"], r["skipped"]))
            else:
                self.app.toast("These can't be converted: {A} shows why", AMBER)
        elif a == "ok":
            self.app.push(CompressSystemScreen(self.app, r["system"]))
        elif a == "x":
            if not r["enabled"]:
                self.app.toast("Turn on %s in Settings first" % r["setting"], AMBER)
            else:
                compress_confirm(self.app, "Compress every %s game here?" % r["system"],
                                 [c for c in self.cands if c["system"] == r["system"]], self.enter)
        else:
            super().action(a)

    def draw(self, c):
        if self.cands is None:
            text(c, self.f.h2, "Looking through every system…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.cands:
            text(c, self.f.h3, "Nothing left to compress.", (56, 86), GREEN)
            text(c, self.f.body, "Every disc game here that a converter supports is compressed already, "
                 "or queued. Formats with a Settings switch (RVZ, squashfs, .zcci, .zar, PS3 folders) show "
                 "up once it's on.", (56, 124), DIM, maxw=W - 112)
            if not self.rows:
                return
        else:
            ok = [r for r in self.rows if r["enabled"]]
            text(c, self.f.h3, "%s could be smaller, %s to work through" % (
                plural(sum(r["n"] for r in ok), "game"), human_size(sum(r["size"] for r in ok))), (56, 86), TEXT)
        for i, r, on in self.row_rects(164 if not self.cands else 124):
            r_ = self.rows[i]
            if on:
                focus_box(c, r)
            if r_.get("cant"):
                text(c, self.f.row, r_["system"], (r.left + 22, r.top + 5), TEXT if on else DIM)
                text(c, self.f.small, "%s, %s · left as they are" % (plural(r_["n"], "game"),
                     human_size(r_["size"])), (r.left + 22, r.top + 30), FAINT, maxw=r.width - 200)
                text(c, self.f.small, "can't convert", (r.right - 20, r.centery), AMBER, "midright")
                continue
            col = (TEXT if on else DIM) if r_["enabled"] else FAINT
            text(c, self.f.row, r_["system"], (r.left + 22, r.top + 5), col)
            sub = "%s, %s" % (plural(r_["n"], "game"), human_size(r_["size"]))
            text(c, self.f.small, sub if r_["enabled"] else sub + " · turn on %s in Settings" % r_["setting"],
                 (r.left + 22, r.top + 30), FAINT, maxw=r.width - 200)
            text(c, self.f.small, ("to " + r_["label"]) if r_["enabled"] else "needs a setting",
                 (r.right - 20, r.centery), ACCENT_HI if r_["enabled"] else FAINT, "midright")


class CantConvertScreen(ListScreen):
    """One system's images a converter applies to but can't convert (an
    encrypted 3DS dump, a PS3 disc without its key, a damaged .cso…), each
    with the reason. Nothing to do here: they're left as they are."""
    ROWS, ROW_H = 9, 58

    def __init__(self, app, system, skipped):
        super().__init__(app)
        self.system, self.items = system, list(skipped)
        self.sel = self.scroll = 0

    def crumbs(self):
        return self.trail("%s: can't convert" % self.system)

    def hints(self):
        return [("L", "Page up"), ("R", "Page down"), ("B", "Back")] if len(self.items) > self.ROWS \
            else [("B", "Back")]

    def action(self, a):
        if not self.nav(a):
            super().action(a)

    def draw(self, c):
        text(c, self.f.h3, "%s in roms/%s can't be converted" % (plural(len(self.items), "game"), self.system),
             (56, 86), TEXT)
        text(c, self.f.small, "They're left as they are. Fix or replace the file (for example a decrypted "
             "dump, or the disc's key in bios/ps3keys) and it shows up in Compress.", (56, 120), DIM, maxw=W - 112)
        for i, r, on in self.row_rects(156):
            f, why = self.items[i]
            if on:
                focus_box(c, r)
            text(c, self.f.row, os.path.basename(f), (r.left + 22, r.top + 5), TEXT if on else DIM,
                 maxw=r.width - 200)
            text(c, self.f.small, why[:1].upper() + why[1:], (r.left + 22, r.top + 30), AMBER, maxw=r.width - 200)
            try:
                size = human_size(os.path.getsize(f))
            except OSError:
                size = ""
            text(c, self.f.small, size, (r.right - 20, r.centery), DIM, "midright")


class CompressSystemScreen(ListScreen):
    """One system's games that could still be compressed: A queues one; the
    X menu queues them all, or the picked ones (asks first: it can take hours)."""
    ROWS, ROW_H = 9, 58
    PICKS, PICK_WHAT, JUMP = True, "games", "A–Z"

    def __init__(self, app, system):
        super().__init__(app)
        self.system = system
        self.cands = None
        self.sel = self.scroll = 0

    def enter(self):
        import rb_chd_plan
        self.load_error = None
        self.app.bg(lambda: rb_chd_plan.candidates([self.system]), self._loaded, self.load_failed("cands"))

    def _loaded(self, cands):
        self.cands = cands
        self.clamp()

    def listed(self):
        return self.cands or []

    def crumbs(self):
        return self.trail(self.system)

    def title_of(self, c):
        return c["name"] or os.path.splitext(os.path.basename(c["root"]))[0]

    def pick_key(self, c):
        return c["root"]

    def jump_label(self, c):
        return letter_of(self.title_of(c))

    def hints(self):
        if not self.cands:
            return [("B", "Back")]
        if not self.cands[0]["enabled"]:
            return self.list_hints()
        return self.list_hints(("A", "Compress this one"), ("X", "Menu"))

    def list_actions(self):
        return [("Compress all %d" % len(self.cands), "%s · asks first: it can take hours" % human_size(
            sum(x["size"] for x in self.cands)), lambda: compress_confirm(
                self.app, "Compress all %s here?" % plural(len(self.cands), "%s game" % self.system),
                list(self.cands), self.enter))]

    def pick_entries(self, cands):
        def done():
            self.picks.clear()
            self.picking = False
            self.enter()
        return [("Compress %d picked" % len(cands), human_size(sum(x["size"] for x in cands)),
                 lambda: compress_confirm(self.app, "Compress %s?" % plural(len(cands), "picked game"),
                                          cands, done))]

    def action(self, a):
        if not self.cands:
            return super().action(a)
        if self.nav(a):
            return
        cand = self.cands[self.sel]
        if a in ("ok", "x") and not cand["enabled"]:
            self.app.toast("Turn on %s in Settings first" % cand["setting"], AMBER)
        elif self.pick_action(a):
            return
        elif a == "ok":
            compress_queue(self.app, [cand], self.enter)
        else:
            super().action(a)

    def draw(self, c):
        if self.cands is None:
            text(c, self.f.h2, "Looking…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.cands:
            text(c, self.f.h3, "Nothing left to compress here.", (56, 86), GREEN)
            return
        text(c, self.f.h3, "%s, %s · to %s" % (plural(len(self.cands), "game"),
             human_size(sum(x["size"] for x in self.cands)), self.cands[0]["label"]), (56, 86), TEXT)
        for i, r, on in self.row_rects(124):
            cand = self.cands[i]
            if on:
                focus_box(c, r)
            tx = r.left + (48 if self.draw_pick(c, cand, (r.left + 22, r.centery)) else 22)
            text(c, self.f.row, self.title_of(cand), (tx, r.top + 5), TEXT if on else DIM,
                 maxw=r.width - 200)
            discs = len(cand["files"])
            ext = os.path.splitext(cand["files"][0])[1].lower().lstrip(".")
            sub = {"cue": "CUE/BIN", "gdi": "GDI"}.get(ext, ext.upper())
            if discs > 1:
                sub = "%d discs, %s" % (discs, sub)
            where = os.path.relpath(cand["root"], os.path.join(rommlib.ROMS_ROOT, self.system))
            if os.path.splitext(where)[0] != self.title_of(cand):          # only when it says something new
                sub += " · " + where
            if cand["cut"]:
                sub += " · made bootable first"
            text(c, self.f.small, sub, (tx, r.top + 30), FAINT, maxw=r.width - 200)
            text(c, self.f.small, human_size(cand["size"]), (r.right - 20, r.centery), DIM, "midright")


class InstalledScreen(ListScreen):
    """Games RomM-o-Cera installed, biggest first (Y: by name or newest),
    with RomM's cover and details beside them. A: the game's menu, as in a
    game list (delete, download again, more like this); X: delete several."""
    ROWS, ROW_H = 10, 54
    LX, LW = 32, 676                     # the list; the game panel is to its right, as in a game list
    SORTS = (("size", "Biggest first"), ("name", "Name"), ("new", "Newest first"))
    PICKS, PICK_WHAT = True, "games"
    JUMP, JUMP_OFF = "A–Z", "A–Z jump works when sorted by name ({Y})"
    BUBBLE_AT = (LX + LW // 2, H // 2)
    sort = "size"
    draw_detail = GameListScreen.draw_detail        # RomM's record: cover, facts, summary
    variants = GameListScreen.variants
    _more_like = GameListScreen._more_like

    def __init__(self, app):
        super().__init__(app)
        self.items = None
        self.sel = self.scroll = 0
        self.load()

    def load(self):
        self.load_error = None
        self.app.bg(lambda: installed_games(self.app.library), self._loaded, self.load_failed("items"))

    def _loaded(self, items):
        self.items = items
        self.resort()
        self.clamp(scroll=True)

    def resort(self):
        if self.items is None:
            return
        if self.sort == "name":
            self.items.sort(key=lambda i: (i.get("name") or "").lower())
        elif self.sort == "new":
            self.items.sort(key=lambda i: i.get("when") or "", reverse=True)
        else:
            self.items.sort(key=lambda i: -(i.get("size") or 0))

    def cycle_sort(self, step=1):
        keys = [k for k, _ in self.SORTS]
        self.sort = keys[(keys.index(self.sort) + step) % len(keys)]
        self.resort()
        self.clamp()

    def enter(self):
        self.load()

    def crumbs(self):
        return self.trail("Games from RomM")

    def hints(self):
        if not self.items:
            return [("B", "Back")]
        return self.list_hints(("A", "Options"), ("X", "Menu"), ("Y", dict(self.SORTS)[self.sort]))

    def pick_key(self, it):
        return it["id"]

    def jump_label(self, it):
        return letter_of(it.get("name")) if self.sort == "name" else None

    def rom_status(self, rom):
        return self.app.rom_status(rom)

    def record(self, it):
        """RomM's record of a row's game: a dict, {} when RomM hasn't got it
        (or can't be reached), None while it's being asked."""
        d = self.app.detail({"id": it["id"]})
        return d if isinstance(d, dict) else None

    def list_controls(self):
        return [("Sort", "", self.cycle_sort, dict(self.SORTS)[self.sort], "choice")]

    def pick_entries(self, items):
        size = sum(i["size"] for i in items)
        return [("Delete %d picked" % len(items), "Frees %s, after you confirm" % human_size(size),
                 lambda: self.ask_delete_many(items))]

    def ask_delete_many(self, items):
        app, lib = self.app, self.app.library
        size = sum(i["size"] for i in items)

        def run():
            freed = 0
            for it in items:
                if it.get("group"):
                    freed += lib.uninstall_group(it["group"], it["system"])[1]
                else:
                    freed += lib.uninstall({"id": it["id"], "name": it["name"]}, it["system"])[1]
            return freed

        def done(freed):
            self.picks.clear()
            self.picking = False
            app.toast("Deleted %s — %s freed. Saves are kept." % (plural(len(items), "game"), human_size(freed)),
                      GREEN)
            app.space_freed()
            self.load()
        app.modal = Confirm(app, "Delete %s?" % plural(len(items), "game"),
                            "Frees about %s. Every file and disc of them goes from roms/; saves and states are "
                            "kept." % human_size(size), "Delete %d" % len(items),
                            lambda: app.bg(run, done, lambda e: (app.toast(str(e), RED), self.load())), danger=True)

    def ask_delete(self, it):
        app = self.app
        rom = {"id": it["id"], "name": it["name"]}
        if it.get("group"):
            app.modal = Confirm(app, "Delete %s?" % it["name"],
                                "Removes every disc and the playlist from roms/%s (%s). Saves and "
                                "states are kept." % (it["system"], human_size(it["size"])), "Delete",
                                lambda: app.uninstall_group(it["group"], it["system"], it["name"], self.load),
                                danger=True)
            return
        app.modal = Confirm(app, "Delete %s?" % it["name"],
                            "Removes it from roms/%s (%s). Saves and states are kept."
                            % (it["system"], human_size(it["size"])), "Delete",
                            lambda: app.uninstall(rom, it["system"], self.load), danger=True)

    def menu(self, it):
        """The game's menu from a game list, plus More like this; delete only
        while RomM's record isn't here."""
        app = self.app
        d = self.record(it)
        if d and d.get("id") is not None and app.system_for(d):
            m = ManageMenu(app, d, then=self.load)
            m.entries.append(("More like this", "Games RomM says are like it", lambda: self._more_like(d)))
            app.modal = m
            return
        why = "Looking it up in RomM…" if d is None else "RomM doesn't have it, or can't be reached"
        app.modal = ActionMenu(app, it["name"], [
            ("Delete from this box", "Frees %s" % human_size(it["size"]), lambda: self.ask_delete(it)),
            ("Download again", why, None), ("More like this", why, None)])

    def action(self, a):
        if not self.items:
            return super().action(a)
        if self.nav(a) or self.pick_action(a):
            return
        if a == "ok":
            self.menu(self.items[self.sel])
        elif a == "y":
            self.cycle_sort()
        else:
            super().action(a)

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Measuring…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
            free = human_size(st.f_bavail * st.f_frsize)
        except OSError:
            free = "?"
        if not self.items:
            text(c, self.f.h3, "No games from RomM here. %s free." % free, (56, 86), TEXT)
            text(c, self.f.body, "Nothing installed by RomM-o-Cera yet. Games copied over another way "
                 "can be deleted from their game list.", (56, 130), DIM)
            return
        lx, lw = self.LX, self.LW
        head = "%s · %s · %s free" % (plural(len(self.items), "game"),
                                      human_size(sum(i["size"] for i in self.items)), free)
        n = self.pick_count()
        if n:
            head += " · %d picked" % n
        text(c, self.f.h3, head, (lx + 8, 86), TEXT, maxw=lw - 170)
        text(c, self.f.small, dict(self.SORTS)[self.sort], (lx + lw - 8, 92), FAINT, "topright")
        for i, r, on in self.row_rects(124, x=lx, w=lw):
            it = self.items[i]
            if on:
                focus_box(c, r)
            nx = r.left + (44 if self.draw_pick(c, it, (r.left + 22, r.centery)) else 18)
            sr = text(c, self.f.small, human_size(it["size"]), (r.right - 14, r.centery), DIM, "midright")
            text(c, self.f.row, it["name"], (nx, r.top + 4), TEXT if on else DIM, maxw=sr.left - 16 - nx)
            sub = (it["system"] or "?") + ("  ·  added %s" % it["when"][:10] if it.get("when") else "")
            text(c, self.f.small, sub, (nx, r.top + 29), FAINT, maxw=sr.left - 16 - nx)
        it = self.items[self.sel]
        d = self.record(it)
        if d and d.get("id") is not None:
            self.draw_detail(c, d)
        else:
            self.draw_local(c, it, "Looking it up in RomM…" if d is None else
                            "RomM doesn't have this game any more, or can't be reached: only Delete works.")

    def draw_local(self, c, it, note):
        """The panel from what's on the box, while RomM's record isn't here."""
        p = pygame.Rect(728, 80, 520, 576)
        rrect(c, PANEL, p, 16)
        x, y, w = p.left + 24, p.top + 24, p.width - 48
        for ln in wrap(self.f.h3, it["name"], w, 3):
            text(c, self.f.h3, ln, (x, y), TEXT)
            y += 25
        y += 12
        for k, v in (("System", it["system"]), ("Size", human_size(it["size"])), ("Added", it.get("when", "")[:10])):
            if v:
                text(c, self.f.small, k, (x, y), FAINT)
                text(c, self.f.cond, str(v), (x, y + 17), DIM, maxw=w)
                y += 42
        for k, ln in enumerate(wrap(self.f.small, note, w, 3)):
            text(c, self.f.small, ln, (x, y + 12 + k * 20), FAINT)


def _lastplayed_label(lp):
    return "never played" if not lp else "played %s-%s-%s" % (lp[:4], lp[4:6], lp[6:8])


class ConversionsScreen(ListScreen):
    """Background CHD / RVZ conversions: the one running (progress, time
    left), the queue, and recent results (retry a failed one). The worker
    (rb_chd.py) publishes chd-current.json and chd-results.jsonl."""
    ROW_H = 60
    ROWS = (H - 60 - 124) // ROW_H      # 8: as many as fit, and L/R pages by as many
    MODES = rommlib.CONVERT_LABELS

    def __init__(self, app):
        super().__init__(app)
        self.sel = self.scroll = 0
        self.rows, self.at = [], 0
        self.refresh()

    def refresh(self):
        rows = conversion_rows()
        self.rows, self.at = rows, time.time()
        self.clamp()

    def listed(self):
        return self.rows

    def crumbs(self):
        return self.trail("Conversions")

    def hints(self):
        h = [("A", "Options")] if self.rows else []
        if any(r["kind"] in ("queued", "running") for r in self.rows):
            h.append(("X", "Start now"))
        if any(r["kind"] not in ("queued", "running") for r in self.rows):
            h.append(("Y", "Clear finished"))
        return self.list_hints(*h)

    def action(self, a):
        app = self.app
        n = len(self.rows)
        if self.nav(a):
            return
        if a == "ok" and n:
            self.menu(self.rows[self.sel])
        elif a == "x":
            app.spawn_helper("rb_chd.py")
            app.toast("Conversions start now if nothing is playing and there's room")
        elif a == "y":
            try:
                os.remove(rommlib.chd_results_path())
            except OSError:
                pass
            self.refresh()
        else:
            super().action(a)

    def menu(self, r):
        app = self.app
        e = []
        if r["kind"] == "queued":
            def gone():
                app.toast("It's converting now, or done already", AMBER)
                self.refresh()

            def first():
                if not rommlib.queue_task_first(r["name"]):
                    return gone()
                self.refresh()

            def drop():
                if not rommlib.drop_queue_task(r["name"]):
                    return gone()
                app.toast("Removed from the queue — the original stays as it is")
                self.refresh()
            e += [("Convert next", "", first), ("Remove from the queue", "The original is kept as it is", drop)]
        elif r["kind"] == "running":
            e.append(("Converting now", "It pauses by itself while a game runs", None))
        elif r["kind"] in ("failed", "waiting") and r.get("task"):
            def retry():
                rommlib.publish_queue_task(r["task"], "%d-retry.json" % int(time.time() * 1000))
                app.spawn_helper("rb_chd.py")
                app.toast("Queued again: %s" % r["title"], GREEN)
                self.refresh()
            e.append(("Try again", r.get("message") or "", retry))
        else:
            e.append((r["title"], r.get("message") or "", None))
        app.modal = ActionMenu(app, r["title"], e)

    def draw(self, c):
        if time.time() - self.at > 1.0:
            self.refresh()
        if not self.rows:
            text(c, self.f.h2, "Nothing to convert", (W // 2, 300), DIM, "center")
            text(c, self.f.body, "Disc games are compressed here in the background after they download.",
                 (W // 2, 340), FAINT, "center")
            return
        nq = sum(1 for r in self.rows if r["kind"] in ("queued", "running"))
        text(c, self.f.h3, "%d waiting · runs while nothing is playing" % nq if nq else "Queue empty",
             (56, 86), TEXT)
        col = {"running": BLUE, "queued": DIM, "ok": GREEN, "failed": RED, "skipped": AMBER, "waiting": AMBER}
        for i, box, on in self.row_rects(124, gap=6):
            r = self.rows[i]
            rrect(c, PANEL_HI if on else PANEL, box, 12)
            if on:
                rrect(c, ACCENT, box, 12, 2)
            mode = self.MODES.get((r.get("task") or {}).get("mode") or r.get("mode"), "")
            title = r["title"] + (" (%d discs)" % r["discs"] if r["discs"] > 1 else "")
            text(c, self.f.h3, title, (box.left + 20, box.top + 8), TEXT if on else DIM, maxw=box.width - 500)
            k = r["kind"]
            if k == "running":
                st, frac = conversion_status(r)
                progress_bar(c, (box.left + 460, box.top + 40, box.width - 480, 8), frac, BLUE)
                sub = "%s · %s" % (mode, human_size(r["size"]))
            elif k == "queued":
                st = "Queued"
                sub = "%s · %s" % (mode, human_size(r["size"]))
            else:
                st = {"ok": "Done", "failed": "Failed", "skipped": "Skipped", "waiting": "Waiting"}.get(k, k)
                sub = r.get("message") or ""
            text(c, self.f.small, st, (box.right - 20, box.top + 12), col.get(k, DIM), "topright", maxw=440)
            text(c, self.f.small, sub, (box.left + 20, box.top + 34), FAINT,
                 maxw=(box.width - 40) if k not in ("running",) else 420)


class SpaceScreen(ListScreen):
    """The whole drive as one bar (what's used, what downloads may use, the
    keep-free reserve), the two ways to get space back, then space per
    system. A on a system: free up space there."""
    ROWS, ROW_H, TOP = 6, 54, 326
    TILES = (("free", "Free up space"), ("leftovers", "Clean up leftovers"))
    base = 2

    def __init__(self, app):
        super().__init__(app)
        self.rows = self.leftovers = None
        self.sel = self.scroll = 0          # 0, 1: the tiles; 2…: systems

    def listed(self):
        return self.rows or []

    def enter(self):
        app = self.app
        app.bg(lambda: storage_by_system(app.library), self._loaded,
               lambda e: (setattr(self, "rows", []), app.toast(str(e), RED)))
        app.bg(lambda: rommlib.find_leftovers(pending_roms(app)), lambda v: setattr(self, "leftovers", v),
               lambda e: setattr(self, "leftovers", []))

    def _loaded(self, rows):
        self.rows = rows
        self.clamp()

    def crumbs(self):
        return self.trail("Space")

    def hints(self):
        if self.sel < 2:
            return [("A", "Open"), ("B", "Back")]
        return self.list_hints(("A", "Free up space here"))

    def action(self, a):
        app = self.app
        n = len(self.rows or [])
        if self.tile_nav(a, wrap=True):
            return
        if a == "ok":
            if self.sel == 0:
                app.push(FreeUpScreen(app))
            elif self.sel == 1:
                app.push(LeftoversScreen(app))
            elif n:
                app.push(FreeUpScreen(app, [self.rows[self.sel - 2]["system"]]))
        else:
            super().action(a)

    def tap_tile(self, i):
        self.sel = i
        self.action("ok")

    def draw(self, c):
        total, free, keep = disk_space(self.app.cfg)
        low = free < keep
        text(c, self.f.h1, human_size(free) + " free", (56, 78), AMBER if low else TEXT)
        text(c, self.f.small, "of %s   Keep free on disk: %s (Settings)" % (human_size(total), human_size(keep)),
             (W - 56, 94), FAINT, "topright")
        if self.rows is None:
            text(c, self.f.h2, "Measuring every system…", (W // 2, H // 2), DIM, "center")
            return
        space_bar(c, self.f, (56, 128, W - 112, 26), space_parts(self.rows, total, free), total, free, keep, cols=3)
        lo = self.leftovers
        subs = ["Every game on the box, least played first",
                "Looking…" if lo is None else "Nothing to clean up" if not lo else
                "%s from interrupted downloads" % human_size(sum(i["size"] for i in lo))]
        tw = (W - 96 - 16) // 2
        for i, (key, label) in enumerate(self.TILES):
            r = pygame.Rect(48 + i * (tw + 16), 240, tw, 64)
            self.app.hit(r, lambda i=i: self.tap_tile(i))
            on = self.sel == i
            if on:
                focus_box(c, r, 12)
            else:
                rrect(c, PANEL, r, 12)
            text(c, self.f.h3, label, (r.left + 22, r.top + 10), TEXT if on else DIM)
            text(c, self.f.small, subs[i], (r.left + 22, r.top + 37), AMBER if key == "leftovers" and lo else FAINT,
                 maxw=r.width - 44)
        hline(c, LINE, (56, 316), (W - 56, 316))
        if not self.rows:
            text(c, self.f.body, "No games on this box yet.", (56, self.TOP + 10), DIM)
            return
        big = self.rows[0]["total"] or 1
        for i, r, on in self.row_rects(self.TOP):
            r_ = self.rows[i]
            if on:
                focus_box(c, r)
            text(c, self.f.row, r_["system"], (r.left + 22, r.top + 4), TEXT if on else DIM)
            x, ty = r.left + 22, r.top + 28      # each part's dot is its colour in the bar: the legend
            for key, col, lab in SPACE_PARTS:
                if r_[key] and x < r.left + 560:
                    circle(c, col, (x + 5, ty + 9), 5)
                    lab = "%s %s" % (lab, human_size(r_[key]))
                    text(c, self.f.small, lab, (x + 13, ty), FAINT)
                    x += 13 + measure(self.f.small, lab) + 18
            bx, bw = r.left + 600, r.width - 760
            x = bx
            for key, col, _ in SPACE_PARTS:
                w = int(bw * r_[key] / big)
                if w:
                    rrect(c, col, (x, r.centery - 5, w, 10), 4)
                    x += w
            text(c, self.f.small, human_size(r_["total"]), (r.right - 20, r.centery), DIM, "midright")


class FreeUpScreen(ListScreen):
    """Every game EmulationStation lists (ours or copied over), least played
    and biggest first. Always picking: A picks, X: delete the picked / pick
    enough to free N GB, Y: sort. Saves and states are never touched."""
    ROWS, ROW_H = 9, 56
    SORTS = (("unplayed", "Least played first"), ("size", "Biggest first"), ("name", "Name"))
    PICKS, PICK_ALWAYS, PICK_ALL, PICK_WHAT = True, True, False, "games"
    JUMP, JUMP_OFF = "A–Z", "A–Z jump works when sorted by name ({Y})"

    def __init__(self, app, systems=None):
        super().__init__(app)
        self.systems = systems
        self.items = None
        self.sort = "unplayed"
        self.sel = self.scroll = 0
        self.busy = False
        self.load()

    def load(self):
        def scan():
            games = rommlib.es_game_list(self.systems)
            for g in games:
                g["size"] = sum(rommlib.path_size(p) for p in rommlib.game_files(g["path"]))
            return [g for g in games if g["size"]]
        self.load_error = None
        self.app.bg(scan, self._loaded, self.load_failed("items"))

    def _loaded(self, items):
        self.items = items
        keep = {g["path"]: g for g in items if g["path"] in self.picks}
        self.picks.clear()
        self.picks.update(keep)
        self.resort()

    def resort(self):
        if self.items is None:
            return
        if self.sort == "size":
            self.items.sort(key=lambda g: -g["size"])
        elif self.sort == "name":
            self.items.sort(key=lambda g: g["name"].lower())
        else:                       # never played first, then longest ago; bigger first within
            self.items.sort(key=lambda g: (g["lastplayed"] or "0", g["playcount"], -g["size"]))
        self.clamp()

    def crumbs(self):
        return self.trail("Free up space" + (" · " + ", ".join(self.systems) if self.systems else ""))

    def hints(self):
        if not self.items:
            return [("B", "Back")]
        return self.list_hints(("Y", dict(self.SORTS)[self.sort]))

    def jump_label(self, g):
        return letter_of(g["name"]) if self.sort == "name" else None

    def suggest(self, gb):
        """Pick the least-played, biggest games until about gb GB would be freed."""
        order = sorted(self.items, key=lambda g: (g["lastplayed"] or "0", g["playcount"], -g["size"]))
        self.picks.clear()
        tot = 0
        for g in order:
            if tot >= gb << 30:
                break
            self.picks[g["path"]] = g
            tot += g["size"]
        self.app.toast("Picked %d games (%s) — check the list, then {X} to delete them"
                       % (len(self.picks), human_size(tot)))

    def delete_marked(self):
        app, todo = self.app, self.picked()
        size = sum(g["size"] for g in todo)

        def run():
            freed = 0
            for g in todo:
                freed += rommlib.delete_game(g["system"], g["path"], app.library)[1]
            return freed

        def done(freed):
            self.busy = False
            self.picks.clear()
            app.toast("Deleted %d games — %s freed. Saves are kept." % (len(todo), human_size(freed)), GREEN)
            app.space_freed()
            self.load()
        app.modal = Confirm(app, "Delete %d games?" % len(todo),
                            "Frees about %s. Their files go (playlist discs and tracks too); saves, states and "
                            "screenshots are kept. EmulationStation drops them from its lists when you leave "
                            "RomM-o-Cera." % human_size(size), "Delete %d" % len(todo),
                            lambda: (setattr(self, "busy", True), app.bg(run, done)), danger=True)

    def pick_entries(self, games):
        return [("Delete %d picked" % len(games), "Frees about %s" % human_size(sum(g["size"] for g in games)),
                 self.delete_marked)]

    def list_actions(self):
        return [("Pick enough to free %d GB" % gb, "Least played, biggest first", lambda gb=gb: self.suggest(gb))
                for gb in (10, 20, 50, 100)]

    def list_controls(self):
        return [("Sort", "", self.cycle_sort, dict(self.SORTS)[self.sort], "choice")]

    def menu_title(self):
        n = self.pick_count()
        return "Free up space" + (" · %d picked" % n if n else "")

    def cycle_sort(self, step=1):
        keys = [k for k, _ in self.SORTS]
        self.sort = keys[(keys.index(self.sort) + step) % len(keys)]
        self.resort()

    def action(self, a):
        if not self.items or self.busy:
            return super().action(a)
        if self.nav(a) or self.pick_action(a):
            return
        if a == "y":
            self.cycle_sort()
        else:
            super().action(a)

    def draw(self, c):
        if self.items is None or self.busy:
            text(c, self.f.h2, "Deleting…" if self.busy else "Measuring games…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        free = rommlib.free_bytes()
        picked = self.picked()
        n, size = len(picked), sum(g["size"] for g in picked)
        head = "%d games · %s free" % (len(self.items), human_size(free))
        if n:
            head += " · %d picked (%s)" % (n, human_size(size))
        text(c, self.f.h3, head, (56, 86), TEXT)
        text(c, self.f.small, dict(self.SORTS)[self.sort], (W - 56, 90), FAINT, "topright")
        if not self.items:
            text(c, self.f.body, "No games found.", (56, 130), DIM)
            return
        for i, r, on in self.row_rects(124):
            g = self.items[i]
            if on:
                focus_box(c, r)
            self.draw_pick(c, g, (r.left + 26, r.centery))
            text(c, self.f.row, g["name"], (r.left + 50, r.centery), TEXT if on else DIM, "midleft",
                 maxw=r.width - 520)
            tw = int(measure(self.f.tiny, g["system"])) + 14
            tr = pygame.Rect(r.right - 380 - tw, r.centery - 10, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, g["system"], tr.center, FAINT, "center")
            text(c, self.f.small, _lastplayed_label(g["lastplayed"]), (r.right - 130, r.centery),
                 FAINT, "midright")
            text(c, self.f.small, human_size(g["size"]), (r.right - 20, r.centery), DIM, "midright")


class LeftoversScreen(ListScreen):
    """Partial files and empty folders that interrupted downloads or
    conversions left behind, and copies of games already here converted (a
    .7z beside its .rvz). Partial downloads still queued are kept. A deletes
    one; the X menu deletes the picked ones or all of them (Y)."""
    ROWS, ROW_H = 9, 56
    PICKS, PICK_WHAT, JUMP = True, "leftovers", "System"

    def __init__(self, app):
        super().__init__(app)
        self.items = None
        self.sel = self.scroll = 0
        self.load()

    def load(self):
        pend = pending_roms(self.app)
        self.load_error = None
        self.app.bg(lambda: rommlib.find_leftovers(pend), self._loaded, self.load_failed("items"))

    def _loaded(self, items):
        self.items = items
        self.clamp()

    def crumbs(self):
        return self.trail("Leftovers")

    def hints(self):
        if not self.items:
            return [("B", "Back")]
        return self.list_hints(("A", "Delete"), ("X", "Menu"), ("Y", "Delete all"))

    def jump_label(self, it):
        """Grouped by system: roms/<system>/…, then the app's own folder."""
        p = it["path"]
        if p.startswith(rommlib.ROMS_ROOT + "/"):
            return os.path.relpath(p, rommlib.ROMS_ROOT).split(os.sep)[0]
        return "other"

    def list_actions(self):
        return [("Delete all %d" % len(self.items), "%s, after you confirm" % human_size(
            sum(i["size"] for i in self.items)), self.ask_delete_all)]

    def pick_entries(self, items):
        return [("Delete %d picked" % len(items), "%s, after you confirm" % human_size(sum(i["size"] for i in items)),
                 lambda: setattr(self.app, "modal", Confirm(
                     self.app, "Delete %s?" % plural(len(items), "leftover"),
                     "Frees %s. Partial downloads that are still queued or paused are not listed and are kept."
                     % human_size(sum(i["size"] for i in items)), "Delete %d" % len(items),
                     lambda: self.remove(items), danger=True)))]

    def ask_delete_all(self):
        tot = sum(i["size"] for i in self.items)
        copies = sum(1 for i in self.items if i.get("note"))
        self.app.modal = Confirm(self.app, "Delete all %d leftovers?" % len(self.items),
                                 "Frees %s.%s Partial downloads that are still queued or paused are not "
                                 "listed and are kept." % (human_size(tot), (
                                     " Includes %s of games already here converted; the converted ones "
                                     "stay." % plural(copies, "copy", "copies")) if copies else ""),
                                 "Delete all",
                                 lambda: self.remove(list(self.items)), danger=True)

    def remove(self, items):
        app = self.app

        def done(freed):
            self.picks.clear()
            self.picking = False
            app.toast("Cleaned up %d — %s freed" % (len(items), human_size(freed)), GREEN)
            app.space_freed()
            self.load()
        app.bg(lambda: rommlib.delete_leftovers(items), done)

    def action(self, a):
        if not self.items:
            return super().action(a)
        if self.nav(a) or self.pick_action(a):
            return
        if a == "ok":
            it = self.items[self.sel]
            self.app.modal = Confirm(self.app, "Delete this %s?" % it["kind"].lower(),
                                     "%s (%s)" % (it["path"], human_size(it["size"])), "Delete",
                                     lambda: self.remove([it]), danger=True)
        elif a == "y":
            self.ask_delete_all()
        else:
            super().action(a)

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Looking for leftovers…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.items:
            text(c, self.f.h3, "Nothing to clean up.", (56, 86), GREEN)
            text(c, self.f.body, "No partial files, empty game folders or copies of converted games. "
                 "Partial downloads still in the queue are kept so they can resume.", (56, 124), DIM,
                 maxw=W - 112)
            return
        text(c, self.f.h3, "%d leftovers · %s" % (len(self.items), human_size(sum(i["size"] for i in self.items))),
             (56, 86), TEXT)
        for i, r, on in self.row_rects(124):
            it = self.items[i]
            if on:
                focus_box(c, r)
            p = it["path"]
            for root in (rommlib.ROMS_ROOT, rommlib.DATA_DIR):
                if p.startswith(root + "/"):
                    p = os.path.relpath(p, os.path.dirname(root))
            tx = r.left + (48 if self.draw_pick(c, it, (r.left + 22, r.centery)) else 22)
            text(c, self.f.row, p, (tx, r.top + 6), TEXT if on else DIM, maxw=r.width - 200)
            text(c, self.f.small, it["kind"] + (" · " + it["note"] if it.get("note") else ""),
                 (tx, r.top + 32), FAINT, maxw=r.width - 200)
            text(c, self.f.small, human_size(it["size"]) if it["size"] else "", (r.right - 20, r.centery),
                 DIM, "midright")


class BiosScreen(ListScreen):
    """BIOS status per system: complete, missing but in RomM (A gets it,
    X gets everything RomM has), or missing everywhere — plus what RomM
    Browser has fetched before."""
    ROWS, ROW_H = 8, 62
    JUMP = "A–Z"

    def __init__(self, app):
        super().__init__(app)
        self.items = None
        self.sel = self.scroll = 0
        self.busy = False
        self.load()

    def load(self):
        app = self.app

        def loaded(rows):
            self.items = rows
            self.clamp(scroll=True)
        self.load_error = None
        app.bg(lambda: bios_rows(app), loaded, self.load_failed("items"))

    def crumbs(self):
        return self.trail("BIOS files")

    def hints(self):
        h = [("A", "Get from RomM")] if self.items and self.items[self.sel]["offers"] else []
        if self.items and any(r["offers"] for r in self.items):
            h.append(("X", "Get all from RomM"))
        return self.list_hints(*h)

    def fetch(self, rows):
        app = self.app
        if self.busy:
            return
        self.busy = True
        offers = [(r["system"], o) for r in rows for o in r["offers"]]

        def run():
            done = []
            for system in dict.fromkeys(sy for sy, _ in offers):
                done += rommlib.fetch_bios(app.api, [o for sy, o in offers if sy == system], system)
            return done

        def ok(written):
            self.busy = False
            app.toast("BIOS installed: %d file%s" % (len(written), "" if len(written) == 1 else "s"), GREEN)
            self.load()

        def fail(e):
            self.busy = False
            app.toast(str(e), RED)
            self.load()
        app.bg(run, ok, fail)

    def action(self, a):
        if not self.items:
            return super().action(a)
        if self.nav(a):
            return
        if a == "ok":
            r = self.items[self.sel]
            if r["offers"]:
                self.fetch([r])
            elif r["missing"]:
                self.app.toast("Not in RomM either: " + ", ".join(os.path.basename(m["file"])
                                                                    for m in r["missing"][:4]), AMBER)
        elif a == "x" and any(r["offers"] for r in self.items):
            todo = [r for r in self.items if r["offers"]]
            k = sum(len(r["offers"]) for r in todo)
            self.app.modal = Confirm(self.app, "Get %d BIOS file%s from RomM?" % (k, "" if k == 1 else "s"),
                                     "For %s. Each is checked against Batocera's checksum; a wrong file "
                                     "already there is kept as .bak-romm." % ", ".join(r["name"] for r in todo[:4]) +
                                     (" and %d more" % (len(todo) - 4) if len(todo) > 4 else ""),
                                     "Get %d" % k, lambda: self.fetch(todo))
        else:
            super().action(a)

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Checking BIOS files…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.items:
            text(c, self.f.h2, "No BIOS needed", (W // 2, 300), DIM, "center")
            text(c, self.f.body, "None of the systems with games on this box needs BIOS files.",
                 (W // 2, 340), FAINT, "center")
            return
        ok = sum(1 for r in self.items if not r["missing"])
        can = sum(1 for r in self.items if r["offers"])
        gone = sum(1 for r in self.items if r["missing"] and not r["offers"])
        x = 56
        for label, col in (("%d complete" % ok, GREEN), ("%d RomM can fill" % can, ACCENT_HI),
                           ("%d missing everywhere" % gone, AMBER)):
            r = text(c, self.f.h3, label, (x, 86), col)
            x = r.right + 24
        text(c, self.f.small, "Files go to /userdata/bios", (W - 56, 90), FAINT, "topright")
        for i, r, on in self.row_rects(124, gap=6):
            it = self.items[i]
            if on:
                focus_box(c, r)
            pill, col, sub = bios_pill(it)
            if not it.get("here", True):
                sub = "No games here yet · " + sub
            text(c, self.f.row, it["name"], (r.left + 22, r.top + 8), TEXT if on else DIM, maxw=r.width - 420)
            text(c, self.f.small, sub, (r.left + 22, r.top + 34), FAINT, maxw=r.width - 60)
            pw = int(measure(self.f.small, pill)) + 20
            pr = pygame.Rect(r.right - 20 - pw, r.top + 8, pw, 24)
            rrect(c, BG2, pr, 8)
            text(c, self.f.small, pill, pr.center, col, "center")
        if self.busy:
            text(c, self.f.body, "Fetching from RomM…", (W // 2, H - 90), ACCENT_HI, "center")


class AuditScreen(ListScreen):
    """Check what's on the box against RomM; damaged games can be downloaded
    again. Red: damaged or incomplete. Amber: not RomM's copy (another dump,
    a trimmed image…), which may well play. Picked findings (amber ones
    too) download again together from the X menu."""
    LOAD_ERROR_HEAD = "The check didn't finish"
    ROWS, ROW_H = 8, 62
    PICKS, PICK_WHAT, JUMP = True, "findings", "System"

    def __init__(self, app, deep=False):
        super().__init__(app)
        self.deep = deep
        self.cancel = threading.Event()
        self.where = ""
        self.findings = None
        self.stats = None
        self.sel = self.scroll = 0
        self.queued = set()
        self.t0 = time.time()
        by_sys = {}
        for p in app.platforms:
            by_sys.setdefault(p["_system"], []).append(p["id"])

        def progress(system, name):
            self.where = "roms/%s/%s" % (system, name)

        def run():
            return rommlib.audit(app.api, by_sys, deep=deep, progress=progress, cancel=self.cancel)

        def done(res):
            f, self.stats = res
            self.findings = self.order(f)
            if not self.cancel.is_set() and (self.stats or {}).get("checked"):   # nothing checked: keep the last
                try:
                    rommlib.save_audit(self.findings, self.stats, deep)
                except OSError as e:
                    rommlib.log("audit save: %s" % e)
        app.bg(run, done, self.load_failed("findings"))

    base = 0            # sel of the first finding (CheckScreen puts three tiles above them)

    def listed(self):
        return self.findings or []

    @staticmethod
    def order(findings):
        rank = {"damaged": 0, "differs": 1}
        return sorted(findings, key=lambda x: (rank.get(x["severity"], 2), x["system"], x["path"]))

    def crumbs(self):
        return self.trail("Full check" if self.deep else "Quick check")

    def hints(self):
        if self.findings is None:
            return [("B", "Stop")]
        h = [("A", "Download again"), ("X", "Menu")] if self.findings else []
        if self.redownloadable():
            h.append(("Y", "Download all damaged again"))
        return self.list_hints(*h)

    def redownloadable(self):
        return [f for f in (self.findings or []) if f["severity"] == "damaged" and f.get("rom")
                and f["path"] not in self.queued]

    def jump_label(self, f):
        return f["system"]

    def pickable(self, f):
        return bool(f.get("rom")) and f["path"] not in self.queued

    def unpickable_why(self, f):
        return "Already queued" if f["path"] in self.queued else \
            "Not in RomM under this name — can't download it again"

    def list_actions(self):
        n = len({f["rom"]["id"] for f in self.redownloadable()})
        return [("Download all damaged again", "%s; amber ones are left alone" % plural(n, "game"),
                 self.redownload_all)] if n else []

    def pick_entries(self, picked):
        todo = [f for f in picked if self.pickable(f)]
        dmg = sum(1 for f in todo if f["severity"] == "damaged")
        sub = ", ".join(x for x in ("%d damaged" % dmg if dmg else "",
                                    "%d differ from RomM" % (len(todo) - dmg) if len(todo) > dmg else "") if x)
        return [("Download %d again" % len(todo), sub, (lambda: self.redownload_many(
            todo, "Download %s again?" % plural(len({f["rom"]["id"] for f in todo}), "picked game"),
            "RomM's copies replace the ones on the box (saves are kept), the ones that only differ "
            "from RomM too.")) if todo else None)]

    @staticmethod
    def renamed(f):
        """RomM's copy has another file name than the broken one on the box."""
        new = (f["rom"].get("fs_name_no_ext") or os.path.splitext(f["rom"].get("fs_name") or "")[0]).lower()
        return bool(f.get("via")) or (new and new != os.path.splitext(os.path.basename(f["path"]))[0].lower())

    def redownload(self, f):
        app = self.app
        app.downloader.enqueue(dict(f["rom"]), f["system"], replace=[f["path"]] if self.renamed(f) else None)
        self.queued.add(f["path"])

    def action(self, a):
        app = self.app
        if self.findings is None:
            if a in ("back", "quit"):
                self.cancel.set()
                app.toast("Check stopped")
                super().action("back")
            return
        n = len(self.findings)
        if self.nav(a) or self.pick_action(a):
            return
        if a == "ok" and n:
            self.open_finding(self.findings[self.sel])
        elif a == "y" and self.redownloadable():
            self.redownload_all()
        else:
            if a == "back":
                self.cancel.set()
            super().action(a)

    def open_finding(self, f):
        app = self.app
        if not f.get("rom"):
            app.toast("Not in RomM under this name — can't download it again", AMBER)
        elif f["path"] in self.queued:
            app.toast("Already queued")
        else:
            name = f["rom"].get("name") or os.path.basename(f["path"])
            how = ("RomM's copy (%s) is downloaded; then saves move to its name and the broken file is "
                   "deleted." % (f["rom"].get("fs_name") or name)) if self.renamed(f) else \
                "RomM's copy replaces the one on the box (saves are kept)."
            app.modal = Confirm(app, "Download %s again?" % name, "%s. %s" % (f["problem"].split(" · ")[0], how),
                                "Download again", lambda: (self.redownload(f), app.toast("Queued: %s" % name, GREEN)))

    def redownload_all(self):
        todo = self.redownloadable()
        n = len({f["rom"]["id"] for f in todo})
        self.redownload_many(todo, "Download %d damaged games again?" % n,
                             "RomM's copies replace the damaged ones. Games that only differ from RomM "
                             "(amber) are left alone.")

    def redownload_many(self, todo, title, body):
        """Each game once (two findings can be one game), after a confirm."""
        app = self.app
        uniq = {}
        for f in todo:
            uniq.setdefault(f["rom"]["id"], f)

        def go():
            for f in uniq.values():
                self.redownload(f)
            self.picks.clear()
            self.picking = False
            app.toast("Queued %d games" % len(uniq), GREEN)
        app.modal = Confirm(app, title, body, "Download %d" % len(uniq), go)

    def draw(self, c):
        if self.findings is None:
            secs = int(time.time() - self.t0)
            text(c, self.f.h2, "Checking games…", (W // 2, 280), TEXT, "center")
            text(c, self.f.body, self.where or "Asking RomM what it has…", (W // 2, 326), DIM, "center",
                 maxw=W - 160)
            text(c, self.f.small, "%d:%02d elapsed%s" % (secs // 60, secs % 60,
                 " · full check: checksums every file" if self.deep else ""), (W // 2, 362), FAINT, "center")
            return
        if self.draw_load_error(c):
            return
        st = self.stats or {}
        dmg = sum(1 for f in self.findings if f["severity"] == "damaged")
        dif = len(self.findings) - dmg
        head = "%d checked, %d matched to RomM. " % (st.get("checked", 0), st.get("matched", 0))
        if st.get("unverified"):
            tools = st.get("unverified_tools") or ["chdman"]        # a check saved by v0.9.0: CHDs only
            head += "%s not verified (missing %s). " % (plural(st["unverified"], "game"), ", ".join(tools))
        if not self.findings:
            text(c, self.f.h3, head + "Everything looks right.", (56, 86), GREEN)
            text(c, self.f.body, "Games not in RomM under the same file name aren't checked (%d)."
                 % st.get("unmatched", 0), (56, 124), DIM)
            return
        text(c, self.f.h3, head, (56, 86), TEXT)
        x = 56 + int(measure(self.f.h3, head)) + 6
        if dmg:
            r = text(c, self.f.h3, "%d damaged" % dmg, (x, 86), RED)
            x = r.right + 16
        if dif:
            text(c, self.f.h3, "%d differ from RomM" % dif, (x, 86), AMBER)
        self.draw_rows(c, 124, self.ROWS)

    def draw_rows(self, c, y, rows):
        for i, r, on in self.row_rects(y, gap=6, rows=rows):
            f = self.findings[i]
            if on:
                focus_box(c, r)
            col = RED if f["severity"] == "damaged" else AMBER
            if not self.draw_pick(c, f, (r.left + 18, r.top + 20)):
                circle(c, col, (r.left + 18, r.top + 20), 5)
            name = os.path.relpath(f["path"], os.path.join(rommlib.ROMS_ROOT, f["system"]))
            text(c, self.f.row, name, (r.left + 34, r.top + 8), TEXT if on else DIM, maxw=r.width - 230)
            text(c, self.f.small, f["problem"], (r.left + 34, r.top + 34), col, maxw=r.width - 230)
            tag = "queued" if f["path"] in self.queued else f["system"]
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - 20 - tw, r.top + 10, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, GREEN if f["path"] in self.queued else FAINT, "center")


class CheckScreen(AuditScreen):
    """Check games, from On this box: start a quick or full check, look for
    games ES can't see, and the last finished check's findings (files changed
    since drop out), each one downloadable again from here."""
    ROWS = 7
    TILES = (("Quick check", "Missing tracks, bad zips, short discs"),
             ("Full check", "Also checksums every file (slow)"),
             ("Games ES can't see", "Archives and games in the wrong folder"))
    base = 3

    def __init__(self, app):
        Screen.__init__(self, app)
        self.deep = False
        self.cancel = threading.Event()
        self.queued = set()
        self.sel = self.scroll = 0
        self.last = None
        self.findings, self.stats = [], {}
        self.unseen = None                 # files ES can't see (counted in the background)

    def enter(self):
        self.last = rommlib.load_audit()
        self.findings = self.order(self.last["findings"]) if self.last else []
        self.stats = (self.last or {}).get("stats") or {}
        self.clamp()
        es = self.app.downloader.es
        self.app.bg(lambda: len(rommlib.find_unseen(es)), lambda n: setattr(self, "unseen", n),
                    lambda e: setattr(self, "unseen", None))

    def crumbs(self):
        return self.trail("Check games")

    def hints(self):
        y = [("Y", "Download all damaged again")] if self.redownloadable() else []
        if self.sel >= self.base:
            return AuditScreen.hints(self)
        return [("A", "Look" if self.sel == 2 else "Start")] + ([("X", "Menu")] if self.findings else []) + y + \
            [("B", "Stop picking" if self.picking else "Back")]

    def action(self, a):
        app = self.app
        n = len(self.findings)
        if self.tile_nav(a):
            return
        if a in ("l2", "r2"):
            if self.sel >= self.base and n:
                self.jump(a == "r2")
        elif (a != "ok" or self.sel >= self.base) and (a != "x" or n) and self.pick_action(a):
            return
        elif a == "ok":
            if self.sel == 2:
                app.push(UnseenScreen(app))
            elif self.sel < 2:
                if not app.platforms:              # offline: a check would find nothing and say all is well
                    app.load_platforms()
                    app.toast(app.error or "Still loading platforms…", AMBER)
                    return
                app.push(AuditScreen(app, deep=self.sel == 1))
            elif n:
                self.open_finding(self.findings[self.sel - self.base])
        elif a == "y" and self.redownloadable():
            self.redownload_all()
        else:
            Screen.action(self, a)

    def tap_tile(self, i):
        self.sel = i
        self.action("ok")

    def draw(self, c):
        k = len(self.TILES)
        tw = (W - 96 - 16 * (k - 1)) // k
        for i, (label, sub) in enumerate(self.TILES):
            r = pygame.Rect(48 + i * (tw + 16), 80, tw, 64)
            self.app.hit(r, lambda i=i: self.tap_tile(i))
            on = self.sel == i
            if on:
                focus_box(c, r, 12)
            else:
                rrect(c, PANEL, r, 12)
            col = FAINT
            if i == 2 and self.unseen is not None:
                sub, col = ("%s ES can't see" % plural(self.unseen, "file"), AMBER) if self.unseen else \
                    ("ES sees every game file", GREEN)
            text(c, self.f.h3, label, (r.left + 20, r.top + 10), TEXT if on else DIM, maxw=r.width - 40)
            text(c, self.f.small, sub, (r.left + 20, r.top + 37), col, maxw=r.width - 40)
        hline(c, LINE, (56, 160), (W - 56, 160))
        a = self.last
        if not a:
            text(c, self.f.h3, "Not checked yet.", (56, 176), TEXT)
            text(c, self.f.body, "A quick check takes minutes; findings stay here until you check again.",
                 (56, 212), DIM, maxw=W - 112)
            return
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(a.get("time", 0)))
        head = "Last %s, %s: " % ("full check" if a.get("deep") else "quick check", when)
        st = self.stats
        dmg = sum(1 for f in self.findings if f["severity"] == "damaged")
        dif = len(self.findings) - dmg
        r = text(c, self.f.h3, head, (56, 176), TEXT)
        if not self.findings:
            text(c, self.f.h3, "everything looks right.", (r.right + 4, 176), GREEN)
            text(c, self.f.body, "%d checked, %d matched to RomM. Games not in RomM under the same file name "
                 "aren't checked (%d)." % (st.get("checked", 0), st.get("matched", 0), st.get("unmatched", 0)),
                 (56, 212), DIM, maxw=W - 112)
            return
        x = r.right + 4
        if dmg:
            x = text(c, self.f.h3, "%d damaged" % dmg, (x, 176), RED).right + 16
        if dif:
            text(c, self.f.h3, "%d differ from RomM" % dif, (x, 176), AMBER)
        self.draw_rows(c, 212, self.ROWS)


class UnseenScreen(ListScreen):
    """Check games › Games ES can't see: files in roms/<system>/ that
    EmulationStation ignores because the system doesn't list their extension
    (rommlib.find_unseen). Archives can be unpacked (as after a download),
    games in the wrong system folder moved, and anything deleted after a
    confirmation that names what goes. The X menu picks files for doing
    several at once: unpack every picked archive, or delete them all."""
    ROWS, ROW_H = 9, 56
    MOVE_CHOICES = 5                   # the menu has no scrolling: the likeliest systems first
    PICKS, PICK_WHAT, JUMP = True, "files", "System"

    def __init__(self, app):
        super().__init__(app)
        self.items = None
        self.sel = self.scroll = 0
        self.busy = False
        self.progress = ""             # "Unpacking 3 of 13…" while a batch runs
        self.load()

    def load(self):
        es = self.app.downloader.es
        self.load_error = None
        self.app.bg(lambda: rommlib.find_unseen(es), self._loaded, self.load_failed("items"))

    def _loaded(self, items):
        self.items = items
        keep = {i["path"]: i for i in items if i["path"] in self.picks}
        self.picks.clear()
        self.picks.update(keep)
        self.clamp()

    def crumbs(self):
        return self.trail("Games ES can't see")

    def hints(self):
        if not self.items:
            return [("B", "Back")]
        return self.list_hints(("A", "Options"), ("X", "Menu"))

    def jump_label(self, it):
        return it["system"]

    def action(self, a):
        if not self.items or self.busy:
            if self.busy and a in ("ok", "x", "y"):
                self.app.toast("Still working on the last one…", AMBER)
                return
            return super().action(a)
        if self.nav(a) or self.pick_action(a):
            return
        if a == "ok":
            self.menu(self.items[self.sel])
        else:
            super().action(a)

    def pick_entries(self, todo):
        arcs = [i for i in todo if i["kind"] == "archive"]
        size = sum(i["size"] for i in todo)
        return [("Unpack %s" % plural(len(arcs), "archive"),
                 "%s, as after a download" % human_size(sum(i["size"] for i in arcs)) if arcs
                 else "None of the picked files is an archive", (lambda: self.ask_unpack_many(arcs)) if arcs else None),
                ("Delete %s" % plural(len(todo), "file"), "%s, after you confirm" % human_size(size),
                 lambda: self.ask_delete_many(todo))]

    def ask_unpack_many(self, arcs):
        app = self.app
        systems = sorted({i["system"] for i in arcs})
        app.modal = Confirm(app, "Unpack %s?" % plural(len(arcs), "archive"),
                            "Each is unpacked into its own system folder (%s) as after a download, compressed if "
                            "that's on, and deleted once it's out. One that can't be unpacked is left as it is."
                            % ", ".join(systems), "Unpack %d" % len(arcs), lambda: self.run_many("unpack", arcs))

    def ask_delete_many(self, todo):
        app = self.app
        size, extra = 0, 0
        for it in todo:
            size += it["size"]
            extra += len([p for p in rommlib.game_files(it["path"])
                          if os.path.normpath(p) != os.path.normpath(it["path"])])
        also = ", with %s they name" % plural(extra, "file") if extra else ""
        app.modal = Confirm(app, "Delete %s?" % plural(len(todo), "file"),
                            "Deletes %s (%s)%s. Saves and states stay. This can't be undone."
                            % (plural(len(todo), "file"), human_size(size), also),
                            "Delete %d" % len(todo), lambda: self.run_many("delete", todo), danger=True)

    def run_many(self, what, todo):
        """Unpack or delete the picked files one after another; a failure is
        noted and the rest go on."""
        app = self.app
        verb = {"unpack": "Unpacking", "delete": "Deleting"}[what]
        self.busy = True

        def run():
            done, failed, freed, tasks = 0, [], 0, False
            for n, it in enumerate(todo, 1):
                self.progress = "%s %d of %d…" % (verb, n, len(todo))
                if not os.path.lexists(it["path"]):
                    done += 1                       # went with a sheet picked before it
                    continue
                try:
                    if what == "unpack":
                        tasks = bool(rommlib.unpack_unseen(app.downloader, it)[1]) or tasks
                    else:
                        freed += rommlib.delete_unseen(it, app.library)[1]
                    done += 1
                except Exception as e:              # a damaged archive is noted, the rest go on
                    why = str(e) if isinstance(e, rommlib.RommError) else "can't be read (%s)" % (
                        e.strerror if isinstance(e, OSError) and e.strerror else e.__class__.__name__)
                    failed.append((os.path.basename(it["path"]), why))
            return done, failed, freed, tasks

        def ok(res):
            done, failed, freed, tasks = res
            self.progress = ""
            self.picks.clear()
            self.picking = False
            if tasks and not app.headless:
                app.spawn_helper("rb_chd.py")          # flock'd: no-op if already running
            if what == "unpack":
                msg = "Unpacked %d%s" % (done, ", compressing in the background" if tasks else "")
            else:
                msg = "Deleted %d, freed %s" % (done, human_size(freed))
            if failed:
                msg += " — %d couldn't be: %s (%s)" % (len(failed), failed[0][0], failed[0][1])
                rommlib.log("UNSEEN %s failed: %s" % (what, failed))
            self._done(msg, AMBER if failed else GREEN)

        def err(e):
            self.progress = ""
            self._failed(e)
        app.bg(run, ok, err)

    def menu(self, it):
        app = self.app
        name = os.path.basename(it["path"])
        leave = ("Leave it", "Stays where it is", lambda: None)
        delete = ("Delete", "Removes it from the box after you confirm", lambda: self.ask_delete(it))
        if self.busy:
            app.toast("Still working on the last one…", AMBER)
            return
        if it["kind"] == "archive":
            entries = [("Unpack", "Shows what's inside first; unpacked here as after a download",
                        lambda: self.ask_unpack(it)), delete, leave]
        elif it["kind"] == "wrong":
            entries = [("Move to %s/" % s, "%s · roms/%s/%s" % (rommlib.system_label(s), s,
                        "" if os.path.isdir(os.path.join(rommlib.ROMS_ROOT, s)) else " (new folder)"),
                        lambda s=s: self.move_to(it, s)) for s in it["to"][:self.MOVE_CHOICES]] + [delete, leave]
        else:
            entries = [("Leave it", "ES can't list it here; it does no harm", lambda: None), delete]
        app.modal = ActionMenu(app, name, entries)

    def ask_unpack(self, it):
        app = self.app
        name = os.path.basename(it["path"])

        def shown(members):
            if not members:
                app.toast("%s is empty or can't be read" % name, RED)
                return
            parts = ["%s (%s)" % (os.path.basename(m) or m, human_size(sz)) if sz is not None else m
                     for m, sz in members[:3]]
            more = " and %d more" % (len(members) - 3) if len(members) > 3 else ""
            app.modal = Confirm(app, "Unpack %s?" % name,
                                "Inside: %s%s. Unpacked into roms/%s/ as after a download (compressed "
                                "if that's on); the archive is deleted once it's out."
                                % (", ".join(parts), more, it["system"]), "Unpack", lambda: self.unpack(it))
        app.bg(lambda: rommlib.archive_contents(app.downloader, it["path"]), shown,
               lambda e: app.toast("Can't read %s (%s)" % (name, e), RED))

    def ask_delete(self, it):
        app = self.app
        name = os.path.basename(it["path"])
        extra = [p for p in rommlib.game_files(it["path"]) if os.path.normpath(p) != os.path.normpath(it["path"])]
        also = " with %s it names" % plural(len(extra), "file") if extra else ""
        app.modal = Confirm(app, "Delete %s?" % name,
                            "Deletes %s (%s)%s from roms/%s/. Saves and states stay. This can't be undone."
                            % (name, human_size(it["size"]), also, it["system"]),
                            "Delete", lambda: self.delete(it), danger=True)

    def delete(self, it):
        app = self.app
        name = os.path.basename(it["path"])
        self.busy = True
        app.bg(lambda: rommlib.delete_unseen(it, app.library),
               lambda res: self._done("Deleted %s, freed %s" % (name, human_size(res[1]))), self._failed)

    def _done(self, msg, color=None):
        color = GREEN if color is None else color
        self.busy = False
        self.app.toast(msg, color)
        self.load()

    def _failed(self, e):
        self._done(str(e), RED)

    def unpack(self, it):
        app = self.app
        name = os.path.basename(it["path"])
        self.busy = True
        app.toast("Unpacking %s…" % name)

        def ok(res):
            out, task = res
            if task and not app.headless:
                app.spawn_helper("rb_chd.py")      # flock'd: no-op if already running
            self._done("Unpacked %s%s — ES lists it when you leave RomM-o-Cera" % (
                name, ", compressing in the background" if task else ""))
        app.bg(lambda: rommlib.unpack_unseen(app.downloader, it), ok, self._failed)

    def move_to(self, it, system):
        app = self.app
        self.busy = True
        app.bg(lambda: rommlib.move_unseen(it, system, app.library, app.downloader.es),
               lambda new: self._done("Moved to roms/%s/ — ES lists it when you leave RomM-o-Cera" % system),
               self._failed)

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Looking through roms/…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.items:
            text(c, self.f.h3, "ES sees every game file here.", (56, 86), GREEN)
            text(c, self.f.body, "No archives a system doesn't take and no games in the wrong system folder.",
                 (56, 124), DIM, maxw=W - 112)
            return
        n_sys = len({i["system"] for i in self.items})
        head = "%s ES can't see, in %s" % (plural(len(self.items), "file"), plural(n_sys, "system"))
        picked = self.picked()
        if picked:
            head += " · %d picked (%s)" % (len(picked), human_size(sum(i["size"] for i in picked)))
        text(c, self.f.h3, head, (56, 86), TEXT)
        if self.progress:
            text(c, self.f.small, self.progress, (W - 56, 90), AMBER, "topright")
        for i, r, on in self.row_rects(124):
            it = self.items[i]
            if on:
                focus_box(c, r)
            col = FAINT if it["kind"] == "unknown" else AMBER
            if not self.draw_pick(c, it, (r.left + 18, r.top + 18)):
                circle(c, col, (r.left + 18, r.top + 18), 5)
            rel = os.path.relpath(it["path"], os.path.join(rommlib.ROMS_ROOT, it["system"]))
            text(c, self.f.row, rel, (r.left + 34, r.top + 6), TEXT if on else DIM, maxw=r.width - 260)
            why = it["why"][:1].upper() + it["why"][1:]
            text(c, self.f.small, why, (r.left + 34, r.top + 32), col, maxw=r.width - 260)
            tag = it["system"]
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - 20 - tw, r.top + 8, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, FAINT, "center")
            text(c, self.f.small, human_size(it["size"]), (r.right - 20, r.top + 40), DIM, "midright")


# ------------------------------------------------------------------ modals

class ActionMenu:
    """Modal menu. entries: list of rows, None = divider. A row is
    (label, sub, fn or None=disabled[, value[, kind]]):
      kind "action" (default): A runs fn and closes the menu;
      kind "switch": value True/False drawn as a switch, A/◀▶ flip it in place;
      kind "choice": value drawn as ‹ value ›, A/▶ next, ◀ previous, in place.
    In-place rows need `refresh` (returns fresh entries) so values update."""
    ROW, ROW_SUB, CTRL, GAP = 46, 62, 44, 14

    def __init__(self, app, title, entries, refresh=None):
        self.app, self.title, self.entries, self.refresh = app, title, entries, refresh
        self.sel = next((i for i, e in enumerate(entries) if e and e[2]), 0)

    @staticmethod
    def kind(e):
        return e[4] if len(e) > 4 else "action"

    def action(self, a):
        n = len(self.entries)
        e = self.entries[self.sel] if n else None
        if a in ("up", "down") and n:
            for _ in range(n):
                self.sel = (self.sel + (1 if a == "down" else -1)) % n
                if self.entries[self.sel] and self.entries[self.sel][2]:
                    break
        elif e and e[2] and self.kind(e) != "action" and a in ("ok", "left", "right"):
            fn = e[2]
            if self.kind(e) == "choice":
                fn(-1 if a == "left" else 1)
            else:
                fn()
            self.reload()
        elif a == "ok" and e and e[2]:
            self.app.modal = None
            e[2]()
        elif a in ("back", "quit", "x"):
            self.app.modal = None

    def tap(self, i, a="ok"):
        self.sel = i
        self.action(a)

    def reload(self):
        """Re-read entries, keeping focus on the same row (by label)."""
        if not self.refresh:
            return
        cur = self.entries[self.sel][0] if self.entries and self.entries[self.sel] else None
        self.entries = self.refresh()
        idx = next((i for i, e in enumerate(self.entries) if e and e[0] == cur), None)
        self.sel = idx if idx is not None else next((i for i, e in enumerate(self.entries) if e and e[2]), 0)

    def _height(self, e):
        if e is None:
            return self.GAP
        if self.kind(e) != "action":
            return self.CTRL
        return self.ROW_SUB if e[1] else self.ROW

    def draw(self, c):
        f = self.app.fonts
        veil = pygame.Surface(c.get_size(), pygame.SRCALPHA)
        veil.fill((0, 0, 0, 170))
        c.blit(veil, (0, 0))
        tops, body = [], 0
        for e in self.entries:
            tops.append(body)
            body += self._height(e)
        r = pygame.Rect(0, 0, 680, min(78 + body + 18, H - 40))    # a long menu scrolls
        r.center = (W // 2, H // 2)
        self.app.hit(r, None)                    # taps on the dialog itself don't close it
        rrect(c, PANEL, r, 18)
        rrect(c, LINE, r, 18, 1)
        text(c, f.h2, self.title, (r.left + 28, r.top + 24), TEXT, maxw=r.width - 56)
        view = r.height - 96                     # what the rows get
        off = getattr(self, "off", 0)
        if self.entries:                         # keep the selected row in view
            st, sh = tops[self.sel], self._height(self.entries[self.sel])
            off = min(max(off, st + sh - view), st)
        self.off = off = max(0, min(off, body - view))
        for up, show in ((True, off > 0), (False, off + view < body)):
            if show:                             # more rows above / below
                cy, d = (r.top + 62, -5) if up else (r.bottom - 10, 5)
                polyline(c, FAINT, [(r.centerx - 8, cy - d), (r.centerx, cy + d), (r.centerx + 8, cy - d)], 2)
        for i, e in enumerate(self.entries):
            h = self._height(e)
            y = r.top + 72 + tops[i] - off
            if y < r.top + 72 or y + h > r.top + 72 + view:
                continue                                # scrolled out of the dialog
            if e is None:                               # divider between actions and view controls
                hline(c, LINE, (r.left + 28, y + h // 2), (r.right - 28, y + h // 2))
                continue
            label, sub, fn = e[:3]
            value = e[3] if len(e) > 3 else None
            kind = self.kind(e)
            row = pygame.Rect(r.left + 16, y, r.width - 32, h - 6)
            if fn:
                self.app.hit(row, lambda i=i: self.tap(i))
            on = i == self.sel
            if on:
                focus_box(c, row)
            col = (TEXT if on else DIM) if fn else FAINT
            vw = 0
            if kind == "switch":
                tr = pygame.Rect(row.right - 18 - 44, row.centery - 12, 44, 24)
                rrect(c, ACCENT if value else LINE, tr, 12)
                circle(c, TEXT if value else DIM, (tr.right - 12 if value else tr.left + 12, tr.centery), 8)
                vw = 44 + 24
            elif kind == "choice":
                vr = text(c, f.body, str(value), (row.right - 40, row.centery), ACCENT_HI if on else DIM, "midright")
                for side, x0 in ((-1, vr.left - 16), (1, row.right - 26)):
                    pts = [(x0 + 4, row.centery - 6), (x0 - 2, row.centery), (x0 + 4, row.centery + 6)]
                    if side > 0:
                        pts = [(x0 - 2, row.centery - 6), (x0 + 4, row.centery), (x0 - 2, row.centery + 6)]
                    polyline(c, ACCENT_HI if on else FAINT, pts, 2)
                if fn:                                  # ‹ and the value's left half step back
                    bx = min(vr.left - 28, vr.centerx - 60)
                    self.app.hit((bx, row.top, vr.centerx - bx, row.height), lambda i=i: self.tap(i, "left"))
                vw = (row.right - vr.left) + 24
            elif value:
                vr = text(c, f.body, value, (row.right - 18, row.centery), ACCENT_HI if on else DIM, "midright")
                vw = vr.width + 24
            if sub:
                text(c, f.body, label, (row.left + 18, row.top + 6), col, maxw=row.width - 36 - vw)
                if GLYPH_RE.search(sub):
                    rich_text(c, f, f.small, sub, (row.left + 18, row.top + 30), FAINT)
                else:
                    text(c, f.small, sub, (row.left + 18, row.top + 30), FAINT, maxw=row.width - 36 - vw)
            else:
                text(c, f.body, label, (row.left + 18, row.centery), col, "midleft", maxw=row.width - 36 - vw)


class ManageMenu(ActionMenu):
    """For a game already on the box. then: runs after a delete (a list to reload)."""

    def __init__(self, app, rom, then=None):
        system = app.system_for(rom)
        lib = app.library
        paths = lib.paths_for(rom, system) if system else []
        size = sum(rommlib.path_size(p) for p in paths)
        name = rom_title(rom)
        group = lib.group_for(rom["id"]) if system else None
        if group:
            n = len(group.get("rom_ids") or [])
            allp = []
            for rid in group["rom_ids"]:
                for p in lib.paths_for({"id": rid, "fs_name": None, "fs_name_no_ext": None}, system):
                    if p not in allp:
                        allp.append(p)
            gsize = sum(rommlib.path_size(p) for p in allp)
            title = group.get("title") or name

            def delete_set():
                app.modal = Confirm(app, "Delete all %d discs of %s?" % (n, title),
                                    "Removes the discs and their playlist from roms/%s (%s). Saves and "
                                    "states are kept." % (system, human_size(gsize)), "Delete",
                                    lambda: app.uninstall_group(group, system, title, then), danger=True)
            super().__init__(app, title, [
                ("Delete all %d discs" % n, "Frees %s" % human_size(gsize), delete_set if allp else None),
                ("Download this disc again", "Replaces this disc only", lambda: app.start_download(rom)),
            ])
            return

        def delete():
            files = ", ".join(os.path.basename(p) for p in paths[:3]) + ("…" if len(paths) > 3 else "")
            app.modal = Confirm(app, "Delete %s?" % name,
                                "Removes %s from roms/%s (%s). Saves and states are kept."
                                % (files, system, human_size(size)),
                                "Delete", lambda: app.uninstall(rom, system, then), danger=True)
        super().__init__(app, name, [
            ("Delete from this box", "Frees %s (%d file%s)" % (human_size(size), len(paths),
                                                         "" if len(paths) == 1 else "s"),
             delete if paths else None),
            ("Download again", "Replaces what's on the box", lambda: setattr(
                app, "modal", DownloadConfirm(app, rom))),
        ])


class Confirm:
    def __init__(self, app, title, body, ok_label, on_ok, danger=False):
        self.app, self.title, self.body = app, title, body
        self.ok_label, self.on_ok, self.danger = ok_label, on_ok, danger

    def action(self, a):
        if a == "ok":
            self.app.modal = None
            self.on_ok()
        elif a in ("back", "quit"):
            self.app.modal = None

    def draw(self, c):
        f = self.app.fonts
        veil = pygame.Surface(c.get_size(), pygame.SRCALPHA)
        veil.fill((0, 0, 0, 170))
        c.blit(veil, (0, 0))
        r = pygame.Rect(0, 0, 640, 260)
        r.center = (W // 2, H // 2)
        self.app.hit(r, None)
        rrect(c, PANEL, r, 18)
        rrect(c, LINE, r, 18, 1)
        text(c, f.h2, self.title, (r.left + 32, r.top + 28), TEXT, maxw=r.width - 64)
        for i, ln in enumerate(rich_lines(self.app.fonts, f.body, self.body, r.width - 64, 4)):
            rich_text(c, self.app.fonts, f.body, ln, (r.left + 32, r.top + 76 + i * 26), DIM)
        bx = r.left + 32
        by = r.bottom - 58
        okr = pygame.Rect(bx, by, 260, 40)
        self.app.hit(okr, lambda: self.action("ok"))
        rrect(c, RED if self.danger else ACCENT, okr, 10)
        g = button_glyph(c, f, "A", okr.left + 12, okr.centery - 11)
        text(c, f.h3, self.ok_label, (okr.left + 22 + g, okr.centery), TEXT, "midleft")
        nr = pygame.Rect(okr.right + 16, by, 180, 40)
        self.app.hit(nr, lambda: self.action("back"))
        rrect(c, PANEL_HI, nr, 10)
        g = button_glyph(c, f, "B", nr.left + 12, nr.centery - 11)
        text(c, f.h3, "Back", (nr.left + 22 + g, nr.centery), DIM, "midleft")


class InfoDialog(Confirm):
    """Fill in game info (name, description, cover, manual) from RomM for
    games already on the box. Only what's missing is added — scrapes and
    edits stay — and it's written by the usual idle-time gamelist merge."""

    @staticmethod
    def all_systems(app):
        by = {}
        for p in app.platforms:
            by.setdefault(p["_system"], []).append(p["id"])
        return sorted(by.items())

    @classmethod
    def start(cls, app, systems):
        app.modal = cls(app, systems)

    def __init__(self, app, systems):
        super().__init__(app, "Fill in game info", "Matching the games on this box with RomM…",
                         "Fill in", lambda: None)
        self.pending, self.plan = True, []
        self.cancel = threading.Event()
        es = app.downloader.es
        manuals = app.cfg["manuals"]

        def run():
            tot = {"on_box": 0, "matched": 0, "complete": 0, "queued": 0}
            out = []
            for system, pids in systems:
                if self.cancel.is_set():
                    break
                self.body = "Matching roms/%s with RomM…" % system
                ents, st = rommlib.plan_info(app.api, system, pids, es, manuals, self.cancel)
                out += ents
                for k in tot:
                    tot[k] += st[k]
            return out, tot
        app.bg(run, self._planned, self._failed)

    def _failed(self, e):
        self.pending = False
        self.body = "Couldn't ask RomM: %s" % e
        self.ok_label, self.on_ok = "OK", lambda: None

    def _planned(self, res):
        self.plan, st = res
        self.pending = False
        if not self.plan:
            self.title = "Nothing to fill in"
            self.body = ("%d games here, %d found in RomM, all already have a name, description and cover."
                         % (st["on_box"], st["matched"]))
            self.ok_label, self.on_ok = "OK", lambda: None
            return
        self.title = "Fill in info for %d game%s?" % (len(self.plan), "" if len(self.plan) == 1 else "s")
        self.body = ("%d games here, %d found in RomM, %d already complete. Only what's missing is added — "
                     "nothing you have is replaced. Saved when you leave RomM-o-Cera."
                     % (st["on_box"], st["matched"], st["complete"]))
        self.ok_label = "Fill in %d" % len(self.plan)
        self.on_ok = self._queue

    def _queue(self):
        rommlib.queue_info(self.plan)
        self.app.toast("Game info queued for %d games — saved when you leave RomM-o-Cera" % len(self.plan),
                       GREEN)

    def action(self, a):
        if self.pending:
            if a in ("back", "quit"):
                self.cancel.set()
                self.app.modal = None
            return
        super().action(a)


class DownloadConfirm(Confirm):
    """Download one game. A disc of a multi-disc set first looks the set up in
    RomM, then offers all discs (one ES entry via an .m3u) or just this one."""

    def __init__(self, app, rom):
        system = app.system_for(rom)
        st = app.rom_status(rom)
        name = rom.get("name") or rom.get("fs_name_no_ext")
        self.pending = False
        if not system:
            super().__init__(app, name, "This platform has no Batocera system to put it in.",
                             "OK", lambda: None)
            return
        if st[0] == "active":
            super().__init__(app, name, "Already downloading.", "OK", lambda: None)
            return
        body = app.plan_text(rom, system)
        if st[0] == "installed":
            body = "Already on this box. Download again anyway?  " + body
        var = app.library.variants(rom, system)
        if var:
            body += "  You already have %s%s." % (var[0], " and %d more" % (len(var) - 1) if len(var) > 1 else "")
        super().__init__(app, name, body, "Download", lambda: app.start_download(rom))
        if rommlib.disc_info(rom.get("fs_name_no_ext") or "") and st[0] != "installed":
            self.pending = True
            self.body = "Looking for the other discs in RomM…"
            app.bg(lambda: rommlib.find_disc_set(app.api, rom),
                   lambda res: self._found(rom, system, body, *res),
                   lambda e: self._lookup_failed(body, e))

    def _lookup_failed(self, body, e):
        self.pending = False
        self.body = body + "  (Couldn't look up the other discs: %s)" % e

    def _found(self, rom, system, body, discs, missing):
        app = self.app
        self.pending = False
        if app.modal is not self:
            return                            # closed meanwhile
        if not discs or len(discs) < 2:
            self.body = body + "  No other discs of it found in RomM."
            return
        me = rommlib.disc_info(rom.get("fs_name_no_ext") or "")[1]
        here = [r for _, r in discs if r["id"] != rom["id"] and app.library.is_installed(r, system)]
        size = sum(r.get("fs_size_bytes") or 0 for _, r in discs
                   if r["id"] == rom["id"] or not app.library.is_installed(r, system))
        m3u = app.downloader._accepts(system, ".m3u")
        sub = "%s · %s" % (human_size(size), "one entry in EmulationStation" if m3u
                           else "each disc listed separately")
        if here:
            sub += " · %d already here" % len(here)
        entries = [("Download all %d discs" % len(discs), sub, lambda: app.download_set(rom, discs))]
        if missing:
            entries.append(("Disc %s not in RomM" % ", ".join(map(str, missing)),
                            "The set looks incomplete", None))
        entries.append(("Only disc %d" % me, human_size(rom.get("fs_size_bytes")),
                        lambda: app.start_download(rom)))
        var = app.library.variants(rom, system)
        if var:
            entries += [None, ("Already here: %s" % var[0],
                               ("and %d more" % (len(var) - 1)) if len(var) > 1 else "Another version", None)]
        app.modal = ActionMenu(app, app.set_title(rom), entries)

    def action(self, a):
        if self.pending and a == "ok":
            return
        super().action(a)


# --------------------------------------------------------------------- main

def read_marker(name):
    """A one-line marker file in the data folder (None if there's none)."""
    try:
        with open(os.path.join(rommlib.DATA_DIR, name)) as f:
            return f.read().strip()
    except OSError:
        return None


def write_marker(name, value):
    """Write it whole or not at all; a full disk only means it's written next time."""
    try:
        rommlib.atomic_write_text(os.path.join(rommlib.DATA_DIR, name), value)
        return True
    except OSError as e:
        rommlib.log("marker %s: %s" % (name, e.__class__.__name__))
        return False


def register_self():
    """Queue our own ES gamelist entry (name, icon, developer, release date)
    for the post-exit merge, so the pygame system lists the app by name, not a
    folder. Re-queued whenever the version changes, so ES stays current.
    Never stops the app from starting (a full disk: tried again next start)."""
    if read_marker(".registered") == rommlib.VERSION_LABEL:
        return
    import calendar
    rel = calendar.timegm(time.strptime(rommlib.RELEASE_DATE, "%Y-%m-%d")) * 1000
    entry = {"system": "pygame", "paths": [os.path.join(APP_DIR, "rommbrowser.pygame")],
             "name": APP_NAME,
             "desc": "Browse and search your RomM library with a controller and download games "
                     "straight into this box's roms folders. v%s · %s" % (rommlib.VERSION, rommlib.PROJECT_URL),
             "genres": ["Utility"], "developer": rommlib.AUTHOR, "publisher": rommlib.AUTHOR,
             "players": "1", "releasedate": rel,
             "image_local": os.path.join(APP_DIR, "icon.png")}
    try:
        rommlib.append_gamelist(entry)
    except OSError as e:
        rommlib.log("register: %s" % e.__class__.__name__)
        return
    write_marker(".registered", rommlib.VERSION_LABEL)


def fit_memory_budgets():
    """A box with under 3 GB of RAM keeps half as much text and covers in memory."""
    global TEXT_BUDGET, COVER_BUDGET
    ram = rommlib.total_ram()
    if ram and ram < 3 << 30:
        TEXT_BUDGET, COVER_BUDGET = 32 << 20, 32 << 20


def tame_malloc():
    """glibc gives each thread its own heap (up to 8 per core) and keeps what's
    freed: with a dozen cover threads decoding images, the app's memory only
    ever grew (~200 MB more at 4K on a 2 GB box). Two heaps, and freed memory
    handed back to the system every 30 s. Best effort: not glibc, no change."""
    try:
        import ctypes
        libc = ctypes.CDLL("libc.so.6")
        libc.mallopt(-8, 2)                        # M_ARENA_MAX
        malloc_trim = libc.malloc_trim
    except (ImportError, OSError, AttributeError):
        return

    def trim():
        while True:
            time.sleep(30)
            malloc_trim(0)
    threading.Thread(target=trim, daemon=True, name="malloc-trim").start()


def main():
    tame_malloc()
    fit_memory_budgets()
    try:
        pygame.mixer.pre_init(44100, -16, 2, 512)    # small buffer: blips land on the press
    except Exception:
        pass
    pygame.init()
    pygame.mouse.set_visible(False)
    flags = pygame.FULLSCREEN
    try:
        screen = pygame.display.set_mode((0, 0), flags)
    except pygame.error:
        screen = pygame.display.set_mode((W, H))
    pygame.display.set_caption(APP_NAME)
    try:
        os.makedirs(rommlib.DATA_DIR, exist_ok=True)
    except OSError:                  # a full disk: start anyway (Free up space is in here)
        pass
    rommlib.log("start")
    register_self()
    app = App(screen)
    try:
        app.run()
    except Exception as e:
        import traceback
        rommlib.log("crash: " + traceback.format_exc())
        raise
    finally:
        rommlib.log("exit")
        pygame.quit()


if __name__ == "__main__":
    main()
