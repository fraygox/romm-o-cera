#!/usr/bin/env python3
"""RomM Browser for Batocera — browse/search the RomM library with a
controller and download games straight into /userdata/roms/<system>.

Launched by Batocera's pygame system (roms/pygame/rommbrowser/). Renders a
1280x720 logical canvas scaled to the screen. Exit: Hotkey+Start (evmapy
sends Alt+F4), or Home -> Exit. Backend lives in the romm/ package, through rommlib.py.
"""
import json
import os
import re
import shutil
import sys
import threading
import time
from collections import OrderedDict

APP_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, APP_DIR)
os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
# Batocera's screenshot hotkey flashes a fullscreen window for 0.1 s; SDL would
# minimise this fullscreen app when it takes focus, and ES (white while a
# "game" runs) would be left showing
os.environ.setdefault("SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS", "0")

import pygame  # noqa: E402
import rommlib  # noqa: E402

APP_NAME = "RomM-o-Cera"
from rommlib import human_size  # noqa: E402

try:
    from pygame._sdl2 import controller as sdlcontroller
except Exception:  # pragma: no cover - older pygame
    sdlcontroller = None

W, H = 1280, 720      # logical layout units; drawn natively at W*K x H*K
FPS = 60
K = 1.0               # physical px per logical unit (3.0 on a 4K TV), set at startup


def S(v):
    return int(round(v * K))


def SR(r):
    r = pygame.Rect(r)
    return pygame.Rect(S(r.x), S(r.y), max(1, S(r.width)), max(1, S(r.height)))


def LR(r):
    """physical rect -> logical rect (what layout code reasons in)"""
    return pygame.Rect(int(r.x / K), int(r.y / K), int(round(r.width / K)), int(round(r.height / K)))

# palette (RomM-ish violet on near-black)
# Design tokens (2026-10-10 sweep): deep indigo "ink" instead of neutral black
# (calmer on a TV, ties to RomM's violet), one focus language (violet outline
# on a lifted panel), status colours used for status only.
BG = (21, 19, 42)          # ink        #15132A
BG2 = (28, 25, 54)         # recess     #1C1936
PANEL = (33, 30, 64)       # panel      #211E40
PANEL_HI = (47, 42, 92)    # focus fill #2F2A5C
LINE = (61, 55, 108)       # rule       #3D376C
TEXT = (242, 239, 255)     # text       #F2EFFF
DIM = (171, 165, 216)      # secondary  #ABA5D8
FAINT = (145, 138, 196)    # tertiary   #918AC4 (5.7:1 on BG: readable from the couch)
ACCENT = (139, 92, 246)    # RomM violet #8B5CF6
ACCENT_HI = (183, 160, 255)
GREEN = (74, 222, 128)
AMBER = (251, 191, 36)
RED = (248, 113, 113)
BLUE = (96, 165, 250)
# controller face buttons keep their own colours in every theme; L/R/START/SELECT use DIM
BTN_COL = {"A": (52, 211, 153), "B": (248, 113, 113), "X": (96, 165, 250), "Y": (251, 191, 36)}

# Themes (Settings → Theme): each one hue carried through the neutrals (ink, panels,
# rules, secondary text are tinted toward it) with the system's colour as the accent.
# OLED versions put everything on pure black; panels stay faintly lifted so rows keep
# their shape. A status colour that would read as the accent moves (Nintendo: danger
# is coral, never the red focus; PlayStation: "working" is cyan; Xbox: "ok" is mint).
# Contrast floors (test_themes), Default's own levels: TEXT 12:1, DIM 6.5:1, FAINT 4.5:1 on BG/BG2/PANEL.
_OLED = dict(BG=(0, 0, 0))
THEMES = {
    "default": ("Default", {}),
    "default_oled": ("Default OLED", dict(_OLED, BG2=(12, 10, 24), PANEL=(20, 17, 40), PANEL_HI=(42, 35, 88),
                                          LINE=(48, 42, 88))),
    "playstation": ("PlayStation", dict(
        BG=(8, 18, 40), BG2=(12, 26, 56), PANEL=(17, 35, 74), PANEL_HI=(24, 62, 128), LINE=(40, 70, 126),
        TEXT=(238, 244, 255), DIM=(164, 186, 224), FAINT=(134, 160, 206), ACCENT=(0, 112, 209),
        ACCENT_HI=(118, 182, 255), BLUE=(80, 206, 232))),
    "playstation_oled": ("PlayStation OLED", dict(
        _OLED, BG2=(6, 12, 26), PANEL=(10, 22, 48), PANEL_HI=(18, 52, 112), LINE=(30, 52, 96),
        TEXT=(238, 244, 255), DIM=(164, 186, 224), FAINT=(134, 160, 206), ACCENT=(0, 112, 209),
        ACCENT_HI=(118, 182, 255), BLUE=(80, 206, 232))),
    "xbox": ("Xbox", dict(
        BG=(14, 17, 14), BG2=(21, 25, 21), PANEL=(29, 34, 29), PANEL_HI=(24, 66, 24), LINE=(52, 62, 52),
        TEXT=(238, 245, 238), DIM=(172, 188, 172), FAINT=(142, 158, 142), ACCENT=(16, 124, 16),
        ACCENT_HI=(136, 224, 96), GREEN=(80, 220, 190))),
    "xbox_oled": ("Xbox OLED", dict(
        _OLED, BG2=(8, 11, 8), PANEL=(16, 21, 16), PANEL_HI=(18, 56, 18), LINE=(38, 48, 38),
        TEXT=(238, 245, 238), DIM=(172, 188, 172), FAINT=(142, 158, 142), ACCENT=(16, 124, 16),
        ACCENT_HI=(136, 224, 96), GREEN=(80, 220, 190))),
    "nintendo": ("Nintendo", dict(
        BG=(28, 24, 26), BG2=(38, 32, 35), PANEL=(48, 41, 44), PANEL_HI=(110, 22, 30), LINE=(76, 64, 68),
        TEXT=(250, 245, 245), DIM=(210, 192, 194), FAINT=(182, 164, 168), ACCENT=(230, 0, 18),
        ACCENT_HI=(255, 128, 134), RED=(255, 150, 84))),
    "nintendo_oled": ("Nintendo OLED", dict(
        _OLED, BG2=(12, 9, 10), PANEL=(22, 17, 19), PANEL_HI=(92, 14, 22), LINE=(54, 42, 46),
        TEXT=(250, 245, 245), DIM=(210, 192, 194), FAINT=(178, 160, 164), ACCENT=(230, 0, 18),
        ACCENT_HI=(255, 128, 134), RED=(255, 150, 84))),
    # High contrast: pure black and white, a yellow focus; amber turns orange so it
    # never reads as the focus
    "high_contrast": ("High contrast", dict(
        BG=(0, 0, 0), BG2=(0, 0, 0), PANEL=(16, 16, 16), PANEL_HI=(70, 58, 0), LINE=(170, 170, 170),
        TEXT=(255, 255, 255), DIM=(235, 235, 235), FAINT=(205, 205, 205), ACCENT=(255, 214, 0),
        ACCENT_HI=(255, 236, 120), GREEN=(90, 255, 150), AMBER=(255, 120, 0), RED=(255, 96, 96),
        BLUE=(110, 205, 255))),
    "high_contrast_light": ("High contrast light", dict(
        BG=(255, 255, 255), BG2=(238, 238, 238), PANEL=(246, 246, 246), PANEL_HI=(210, 224, 255),
        LINE=(80, 80, 80), TEXT=(0, 0, 0), DIM=(34, 34, 34), FAINT=(70, 70, 70), ACCENT=(0, 56, 200),
        ACCENT_HI=(0, 44, 150), GREEN=(0, 112, 44), AMBER=(140, 78, 0), RED=(184, 0, 28),
        BLUE=(0, 112, 128))),
}
PALETTE = ("BG", "BG2", "PANEL", "PANEL_HI", "LINE", "TEXT", "DIM", "FAINT", "ACCENT", "ACCENT_HI",
           "GREEN", "AMBER", "RED", "BLUE")
_DEFAULT_PALETTE = {k: globals()[k] for k in PALETTE}


def mix(a, b, t):
    """Colour t of the way from a to b."""
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def luminance(c):
    """Relative luminance (WCAG), 0 black .. 1 white."""
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    return 0.2126 * ch(c[0]) + 0.7152 * ch(c[1]) + 0.0722 * ch(c[2])


def light_theme():
    return luminance(BG) > 0.5


def ink_on(fill):
    """TEXT or BG, whichever reads better on fill (a letter on an accent tile)."""
    return TEXT if abs(luminance(TEXT) - luminance(fill)) >= abs(luminance(BG) - luminance(fill)) else BG


def apply_theme(name):
    """Switch every colour to a theme (unknown: Default). Takes effect on the next
    frame: everything is drawn from these names. Returns the theme's key."""
    if name not in THEMES:
        name = "default"
    globals().update(_DEFAULT_PALETTE)
    globals().update(THEMES[name][1])
    g = globals()
    if "SPACE_PARTS" in g:                      # colours derived from the palette
        g["SYSTEM_COL"] = mix(g["BG"], g["FAINT"], 0.57)
        g["SPACE_PARTS"] = (("ours", g["ACCENT"], "From RomM-o-Cera"), ("other", g["BLUE"], "Added another way"),
                            ("media", MEDIA_COL, "Media"))
    return name

FONT_DIRS = ["/usr/share/fonts/dejavu", "/usr/share/fonts/dejavu-sans-fonts",
             "/usr/share/fonts/truetype/dejavu", os.path.join(APP_DIR, "fonts")]


CJK_FONTS = ["/usr/share/emulationstation/resources/DroidSansFallbackFull.ttf",
             "/usr/share/fonts/truetype/droid/DroidSansFallback.ttf",
             "/usr/share/fonts/google-droid-sans-fonts/DroidSansFallbackFull.ttf"]
# Hangul: Droid has none. EmulationStation's own Korean font first (its weight
# matches Rubik's), Nanum otherwise. Batocera's Noto CJK fonts are variable
# fonts that SDL_ttf draws at their thinnest weight, so they aren't used.
HANGUL_FONTS = ["/usr/share/emulationstation/resources/PyeojinGothic-Medium.ttf",
                "/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf",
                "/usr/share/fonts/truetype/nanum/NanumGothic.ttf"]
HANGUL = ((0x1100, 0x11FF), (0x3130, 0x318F), (0xA960, 0xA97F), (0xAC00, 0xD7FF))
FALLBACK = {}   # Font -> [same-size Fonts tried in turn for characters it doesn't have]
FONT_PATH = {}  # Font -> the file it was made from (coverage is per file, at any size)
FONT_CACHE = {}  # (file, size) -> Font: one open file each, however often Fonts() is made


def find_font(name):
    for d in FONT_DIRS:
        p = os.path.join(d, name)
        if os.path.exists(p):
            return p
    return None


class Fonts:
    def __init__(self):
        fdir = os.path.join(APP_DIR, "fonts")
        bundled = lambda n: os.path.join(fdir, n) if os.path.exists(os.path.join(fdir, n)) else None  # noqa: E731
        dv = find_font("DejaVuSans.ttf")
        reg = bundled("Rubik-Regular.ttf") or dv
        med = bundled("Rubik-Medium.ttf") or find_font("DejaVuSans-Bold.ttf") or reg
        bold = bundled("Rubik-SemiBold.ttf") or med
        # for characters Rubik lacks: Greek, arrows, music and other symbols; Chinese
        # and Japanese; Korean (game titles and descriptions come in every script)
        chain = [p for p in (dv, next((p for p in CJK_FONTS if os.path.exists(p)), None),
                             next((p for p in HANGUL_FONTS if os.path.exists(p)), None)) if p and p != reg]
        def font(path, size):
            if (path, size) not in FONT_CACHE:
                f = FONT_CACHE[(path, size)] = pygame.font.Font(path, size)
                FONT_PATH[f] = path
            return FONT_CACHE[(path, size)]

        def mk(path, size):
            size = max(6, int(round(size * K)))
            f = font(path, size)
            FALLBACK[f] = [font(p, size) for p in chain]
            return f
        self.h1 = mk(bold, 36)
        self.h2 = mk(bold, 25)
        self.h3 = mk(med, 20)
        self.body = mk(reg, 19)
        self.row = mk(reg, 21)
        self.small = mk(reg, 17)
        self.cond = mk(reg, 17)
        self.tiny = mk(med, 15)
        self.key = mk(med, 24)
        self.btn = mk(bold, 14)


# ------------------------------------------------------------------ drawing

def rrect(surf, color, rect, radius=10, width=0):
    pygame.draw.rect(surf, color, SR(rect), max(1, S(width)) if width else 0,
                     border_radius=S(radius))


def focus_box(surf, rect, radius=10):
    """The one focus treatment: lifted fill + violet outline."""
    rrect(surf, PANEL_HI, rect, radius)
    rrect(surf, ACCENT, rect, radius, 2)


def circle(surf, color, center, radius, width=0):
    pygame.draw.circle(surf, color, (S(center[0]), S(center[1])), max(1, S(radius)),
                       max(1, S(width)) if width else 0)


def hline(surf, color, a, b, width=1):
    pygame.draw.line(surf, color, (S(a[0]), S(a[1])), (S(b[0]), S(b[1])), max(1, S(width)))


def polyline(surf, color, pts, width=1):
    pygame.draw.lines(surf, color, False, [(S(x), S(y)) for x, y in pts], max(1, S(width)))


def arc(surf, color, rect, a0, a1, width=1):
    pygame.draw.arc(surf, color, SR(rect), a0, a1, max(1, S(width)))


def installed_mark(surf, center, radius=9):
    """The green tick for "on this box"."""
    x, y = center
    k = radius / 9
    circle(surf, GREEN, center, radius)
    polyline(surf, BG, [(x - 4 * k, y), (x - k, y + 3 * k), (x + 4 * k, y - 3 * k)], 2)


def _wide(ch):
    return ord(ch) >= 0x2E80        # CJK, kana, hangul, fullwidth forms


_HAS = {}       # (font file, char) -> it has a glyph for it
_PROBE = {}     # font file -> (a small Font of it, its "missing glyph" pixels)


def _has_glyph(path, ch):
    """SDL_ttf draws a character a font lacks as that font's missing-glyph box
    (and its metrics don't tell): compare with an unassigned code point."""
    k = (path, ch)
    if k not in _HAS:
        if path in HANGUL_FONTS and not any(a <= ord(ch) <= b for a, b in HANGUL):
            _HAS[k] = False                 # only Hangul from these (their other glyphs aren't Rubik-like)
            return False
        if path not in _PROBE:
            f = pygame.font.Font(path, 16)
            _PROBE[path] = (f, pygame.image.tobytes(f.render("\u0378", True, (255,) * 3, (0,) * 3), "RGB"))
        f, missing = _PROBE[path]
        try:
            _HAS[k] = pygame.image.tobytes(f.render(ch, True, (255,) * 3, (0,) * 3), "RGB") != missing
        except pygame.error:                # zero width (a combining mark): nothing to draw, no box either
            _HAS[k] = True
    return _HAS[k]


def _font_for(font, chain, ch):
    if ch.isascii() or ch.isspace() or _has_glyph(FONT_PATH[font], ch):
        return font
    # the first fallback that has it; none does (an emoji): the font's own box
    return next((f for f in chain if _has_glyph(FONT_PATH[f], ch)), font)


def _runs(font, s):
    """Split s into (font, chunk) runs: each character in the first font of
    font + FALLBACK[font] that has it."""
    chain = FALLBACK.get(font)
    if not chain or s.isascii():
        return [(font, s)]
    out = []
    for ch in s:
        f = _font_for(font, chain, ch)
        if out and out[-1][0] is f:
            out[-1] = (f, out[-1][1] + ch)
        else:
            out.append((f, ch))
    return out


def measure(font, s):
    """width in logical units"""
    return sum(f.size(chunk)[0] for f, chunk in _runs(font, s)) / K


# Memory: rendered text and decoded covers are kept in RAM by size, not by
# count: at 4K one line of text is ~180 KB and one cover several MB, so a count
# limit let a long scroll reach gigabytes. What's dropped comes back from the
# fonts / the disk cache, in milliseconds.
TEXT_BUDGET = 64 << 20          # rendered strings (a full screen of 4K text is ~25 MB)
COVER_BUDGET = 64 << 20         # decoded covers, already shrunk to what's drawn (~1.8 MB each at 4K)
COVER_ENTRIES = 400            # covers tracked at once, loading and "no cover" ones included
COVER_DECODES = threading.BoundedSemaphore(2)   # a 4000 px cover is ~100 MB while it decodes


def surface_bytes(img):
    return img.get_width() * img.get_height() * img.get_bytesize() if isinstance(img, pygame.Surface) else 0


_TEXT_CACHE = OrderedDict()     # (font, text, colour) -> Surface, least recently drawn first
_TEXT_BYTES = [0]


def render_cached(font, s, color):
    key = (id(font), s, color)
    img = _TEXT_CACHE.get(key)
    if img is not None:
        _TEXT_CACHE.move_to_end(key)
        return img
    img = _TEXT_CACHE[key] = render(font, s, color)
    _TEXT_BYTES[0] += surface_bytes(img)
    while _TEXT_BYTES[0] > TEXT_BUDGET and len(_TEXT_CACHE) > 1:
        _TEXT_BYTES[0] -= surface_bytes(_TEXT_CACHE.popitem(last=False)[1])
    return img


def render(font, s, color):
    runs = _runs(font, s)
    if len(runs) == 1:
        return runs[0][0].render(runs[0][1], True, color)
    imgs = [(f, f.render(chunk, True, color)) for f, chunk in runs]
    h = font.get_height()
    out = pygame.Surface((sum(i.get_width() for _, i in imgs), h), pygame.SRCALPHA)
    x = 0
    for f, i in imgs:
        # align baselines
        out.blit(i, (x, font.get_ascent() - f.get_ascent()))
        x += i.get_width()
    return out


FONTS = {}            # the app's Fonts, so text() can draw {TOKEN} glyphs anywhere


def text(surf, font, s, pos, color=None, anchor="topleft", maxw=None):
    color = TEXT if color is None else color
    s = s or ""
    if "{" in s and FONTS.get("f") and GLYPH_RE.search(s):
        # prose naming a control: same glyphs as the hint bar, whoever draws it
        f = FONTS["f"]
        w = rich_width(f, font, s) if not maxw else min(maxw, rich_width(f, font, s))
        lh = font.get_height() / K
        x = {"topright": pos[0] - w, "midright": pos[0] - w, "center": pos[0] - w / 2,
             "midtop": pos[0] - w / 2, "midbottom": pos[0] - w / 2}.get(anchor, pos[0])
        top = {"center": pos[1] - lh / 2, "midleft": pos[1] - lh / 2, "midright": pos[1] - lh / 2,
               "bottomleft": pos[1] - lh, "bottomright": pos[1] - lh, "midbottom": pos[1] - lh}.get(anchor, pos[1])
        return rich_text(surf, f, font, s, (x, top), color, maxw=maxw)
    if maxw is not None and measure(font, s) > maxw:
        while s and measure(font, s + "…") > maxw:
            s = s[:-1]
        s = s.rstrip() + "…"
    img = render_cached(font, s, color)
    r = img.get_rect(**{anchor: (S(pos[0]), S(pos[1]))})
    surf.blit(img, r)
    return LR(r)


def wrap(font, s, width, max_lines=None):
    lines = []
    for para in (s or "").replace("\r", "").split("\n"):
        cur = ""
        for w in para.split():
            t = (cur + " " + w).strip()
            if measure(font, t) <= width:
                cur = t
                continue
            if cur:
                lines.append(cur)
            cur = w
            while measure(font, cur) > width and len(cur) > 1:   # unbreakable (CJK) run
                k = len(cur)
                while k > 1 and measure(font, cur[:k]) > width:
                    k -= 1
                lines.append(cur[:k])
                cur = cur[k:]
        lines.append(cur)
    # drop blank paragraph gaps beyond one
    lines = [l for i, l in enumerate(lines) if l or (i and lines[i - 1])]
    while lines and not lines[-1]:
        lines.pop()
    if max_lines and len(lines) > max_lines:
        lines = lines[:max_lines]
        last = lines[-1]
        while last and measure(font, last + "…") > width:
            last = last[:-1]
        lines[-1] = last.rstrip() + "…"
    return lines


# --- controller styles -------------------------------------------------------
# Hints name *actions* with Xbox-ish tokens ("A" confirm, "B" back, "X"/"Y" the
# west/north buttons, "L"/"R", "L2 R2", "START", "SELECT"). PAD_STYLE turns a
# token into what is printed on the user's controller, by physical position, so
# the glyphs stay right with any style and with the confirm-button swap.
PAD_STYLE = {"style": "xbox", "ok": "south", "back": "east"}
FACE = {
    "xbox": {"south": ("A", (52, 211, 153)), "east": ("B", (248, 113, 113)),
             "west": ("X", (96, 165, 250)), "north": ("Y", (251, 191, 36))},
    "nintendo": {"south": ("B", (251, 191, 36)), "east": ("A", (248, 113, 113)),
                 "west": ("Y", (74, 222, 128)), "north": ("X", (96, 165, 250))},
    "playstation": {"south": ("cross", (125, 167, 230)), "east": ("circle", (236, 112, 112)),
                    "west": ("square", (226, 140, 205)), "north": ("triangle", (95, 205, 160))},
}
OTHER = {
    "xbox": {"L": "LB", "R": "RB", "L2 R2": "LT RT", "START": "Menu", "SELECT": "View"},
    "playstation": {"L": "L1", "R": "R1", "L2 R2": "L2 R2", "START": "Options", "SELECT": "Create"},
    "nintendo": {"L": "L", "R": "R", "L2 R2": "ZL ZR", "START": "+", "SELECT": "−"},
}
STYLE_NAMES = {"xbox": "Xbox", "playstation": "PlayStation", "nintendo": "Nintendo"}
# While the keyboard is the last thing used, hints show key names instead.
INPUT_MODE = {"kb": False}
KEY_LABELS = {"A": "Enter", "B": "Esc", "X": "X", "Y": "Y", "L": "PgUp", "R": "PgDn",
              "L2 R2": "[ ]", "START": "Home", "SELECT": "Tab"}
TOKEN_ACTION = {"A": "ok", "B": "back", "X": "x", "Y": "y", "L": "l1", "R": "r1", "L2 R2": "r2",
                "START": "start", "SELECT": "select", "LEFT RIGHT": "right", "BKSP": "x"}
TOKEN_BACK = {"LEFT RIGHT": "left", "L2 R2": "l2"}      # a tap on the left half of these glyphs
# Every control shown on screen is one of these tokens, drawn by button_glyph():
# in hints as (token, label), in prose as "{token}" through rich_text/rich_lines.
TOKENS = ("A", "B", "X", "Y", "L", "R", "L2 R2", "START", "SELECT", "LEFT RIGHT", "TYPE", "BKSP")
# keyboard-only: typing letters and Backspace in text fields
KEY_ONLY = {"TYPE": "a–z", "BKSP": "Bksp"}


def style_from_names(names):
    """Guess the label style from controller names SDL reports."""
    for n in names:
        n = (n or "").lower()
        if any(k in n for k in ("dualsense", "dualshock", "playstation", "ps3", "ps4", "ps5", "sony")):
            return "playstation"
        if any(k in n for k in ("nintendo", "pro controller", "joy-con", "joycon", "switch")):
            return "nintendo"
    return "xbox"


# "Match theme to controller": the theme of the pad's maker (the button labels'
# style when they're set by hand); the chosen Theme for a keyboard or a pad it
# doesn't know, and always for a high-contrast Theme.
XBOX_NAMES = ("xbox", "x-box", "microsoft", "xinput", "x360")


def pad_family(names):
    """playstation, nintendo or xbox from controller names; None when there's
    no controller or its name says nothing (style_from_names would say xbox)."""
    st = style_from_names(names)
    if st != "xbox" or any(k in (n or "").lower() for n in names for k in XBOX_NAMES):
        return st
    return None


def theme_for(name, auto, button_style, names):
    """The Theme setting (and Match theme to controller) -> the THEMES key to paint with."""
    if not auto or name.startswith("high_contrast"):
        return name
    fam = button_style if button_style in FACE else pad_family(names)
    return fam + ("_oled" if name.endswith("_oled") else "") if fam else name


def pad_face(token):
    """(kind, text_or_shape, colour) for a hint token in the active style; on a light
    theme the controller's colours are deepened so they hold up on white."""
    kind, label, col = _pad_face(token)
    return kind, label, (mix(col, (0, 0, 0), 0.45) if light_theme() and col != DIM else col)


def _pad_face(token):
    st = PAD_STYLE["style"]
    if token == "LEFT RIGHT":                 # D-pad left/right (arrow keys on a keyboard)
        return ("arrows" if INPUT_MODE["kb"] else "dpad"), "", DIM
    if token in KEY_ONLY:
        return "pill", KEY_ONLY[token], DIM
    if INPUT_MODE["kb"]:
        col = {"A": FACE["xbox"]["south"][1], "B": FACE["xbox"]["east"][1], "X": FACE["xbox"]["west"][1],
               "Y": FACE["xbox"]["north"][1]}.get(token, BTN_COL.get(token, DIM))
        return "pill", KEY_LABELS.get(token, token), col
    pos = {"A": PAD_STYLE["ok"], "B": PAD_STYLE["back"], "X": "west", "Y": "north"}.get(token)
    if pos:
        lab, col = FACE[st][pos]
        return ("shape" if st == "playstation" else "letter"), lab, col
    return "pill", OTHER[st].get(token, token), BTN_COL.get(token, DIM)


def pad_text(token):
    """Plain-text name of a button for prose ("Press Options to …")."""
    kind, lab, _ = pad_face(token)
    if kind in ("dpad", "arrows"):
        return "Left/Right"
    return {"cross": "Cross", "circle": "Circle", "square": "Square", "triangle": "Triangle"}.get(lab, lab)


def glyph_width(fonts, token):
    kind, lab, _ = pad_face(token)
    if kind == "dpad":
        return 22
    if kind == "arrows":
        return 40
    return 22 if kind in ("letter", "shape") else int(measure(fonts.btn, lab)) + 14


def button_glyph(surf, fonts, label, x, y):
    """Pad-button glyph in the active controller style; returns its width.
    The only place controls are drawn: hints, prose and menus all come here."""
    kind, lab, col = pad_face(label)
    cx, cy = x + 11, y + 11
    if kind == "dpad":                  # a D-pad, its left/right arms lit
        rrect(surf, LINE, (cx - 3.5, cy - 10, 7, 20), 2)
        rrect(surf, LINE, (cx - 11, cy - 3.5, 22, 7), 2)
        rrect(surf, TEXT, (cx - 11, cy - 3.5, 7, 7), 2)
        rrect(surf, TEXT, (cx + 4, cy - 3.5, 7, 7), 2)
        return 22
    if kind == "arrows":                # ← → keys
        rrect(surf, col, (x, y + 1, 40, 20), 10)
        polyline(surf, BG, [(x + 15, y + 6), (x + 9, y + 11), (x + 15, y + 16)], 2)
        polyline(surf, BG, [(x + 25, y + 6), (x + 31, y + 11), (x + 25, y + 16)], 2)
        return 40
    if kind == "letter":
        circle(surf, col, (cx, cy), 11)
        text(surf, fonts.btn, lab, (cx, cy), BG, "center")
        return 22
    if kind == "shape":                 # PlayStation symbols, drawn (no font has them all)
        circle(surf, BG2, (cx, cy), 11)
        circle(surf, col, (cx, cy), 11, 2)
        if lab == "cross":
            hline(surf, col, (cx - 4, cy - 4), (cx + 4, cy + 4), 2)
            hline(surf, col, (cx - 4, cy + 4), (cx + 4, cy - 4), 2)
        elif lab == "circle":
            circle(surf, col, (cx, cy), 5, 2)
        elif lab == "square":
            rrect(surf, col, (cx - 4.5, cy - 4.5, 9, 9), 1, 2)
        else:
            polyline(surf, col, [(cx, cy - 5), (cx + 5, cy + 4), (cx - 5, cy + 4), (cx, cy - 5)], 2)
        return 22
    w = int(measure(fonts.btn, lab)) + 14
    rrect(surf, col, (x, y + 1, w, 20), 10)
    text(surf, fonts.btn, lab, (x + w // 2, y + 11), BG, "center")
    return w


def as_rgba(img):
    """Covers can be palette / 8-bit images (GIF-ish PNGs); smoothscale only
    takes 24/32-bit surfaces, so normalise once at load."""
    if img.get_bitsize() in (24, 32):
        return img
    out = pygame.Surface(img.get_size(), pygame.SRCALPHA, 32)
    out.blit(img, (0, 0))
    return out


COVER_BOX = (192, 256)          # the game panel's cover (logical): the largest any screen draws


def cover_fit(img):
    """A decoded cover scaled once to the game panel's cover box, the largest
    any screen draws it (Home's smaller shelf crops from it). RomM's large
    covers are often 1000-4000 px: kept whole they cost ~10x the RAM, and a
    smaller one needed a second, enlarged copy for the panel."""
    iw, ih = img.get_size()
    pw, ph = SR(pygame.Rect((0, 0), COVER_BOX)).size
    f = min(pw / iw, ph / ih)
    size = (max(1, int(iw * f)), max(1, int(ih * f)))
    return img if size == (iw, ih) else smooth_scale(img, size)


def smooth_scale(img, size):
    try:
        return pygame.transform.smoothscale(img, size)
    except ValueError:                    # any other odd format: plain scale, never crash
        return pygame.transform.scale(img, size)


class Sfx:
    """Small UI sounds, synthesised at start-up (no audio files): soft sine
    blips with a fast attack and exponential decay. Every failure is silent —
    a box without audio just stays quiet."""
    # name: (notes in Hz, ms per note, peak amplitude, wave)
    SPEC = {
        "move": ((1046,), 26, 0.09, "sine"),
        "page": ((784, 988), 22, 0.10, "sine"),
        "ok": ((784, 1175), 42, 0.14, "sine"),
        "back": ((1175, 784), 42, 0.12, "sine"),
        "toggle": ((988,), 40, 0.12, "sine"),
        "deny": ((196, 185), 70, 0.14, "triangle"),
        "queued": ((659, 880), 55, 0.13, "sine"),
        "done": ((523, 659, 784, 1046), 70, 0.12, "sine"),
    }
    LEVEL = {"normal": 1.0, "quiet": 0.4, "off": 0.0}

    def __init__(self, level="normal"):
        self.sounds, self.channels = {}, {}
        self.level = self.LEVEL.get(level, 1.0)
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(44100, -16, 2, 512)
            pygame.mixer.set_num_channels(max(8, len(self.SPEC)))
            for i, (name, spec) in enumerate(self.SPEC.items()):
                self.sounds[name] = pygame.mixer.Sound(file=self._wav(*spec))
                self.channels[name] = pygame.mixer.Channel(i)
        except Exception as e:                 # no audio device, no mixer: stay silent
            rommlib.log("sound off: %s" % e.__class__.__name__)
            self.sounds = {}

    @staticmethod
    def _wav(notes, ms, amp, wave_kind, rate=44100):
        import io
        import math
        import struct
        import wave
        n = int(rate * ms / 1000)
        out = []
        for k, f in enumerate(notes):
            for i in range(n):
                t = i / rate
                ph = (f * t) % 1.0
                v = math.sin(2 * math.pi * ph) if wave_kind == "sine" else (4 * abs(ph - 0.5) - 1)
                env = min(1.0, i / (rate * 0.002)) * math.exp(-5.0 * i / n)   # 2 ms attack, decay
                out.append(int(32767 * amp * env * v))
        tail = int(rate * 0.01)                 # 10 ms of silence: no click at the end
        out += [0] * tail
        buf = io.BytesIO()
        with wave.open(buf, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(rate)
            w.writeframes(struct.pack("<%dh" % len(out), *out))
        buf.seek(0)
        return buf

    def set_level(self, level):
        self.level = self.LEVEL.get(level, 1.0)

    def play(self, name):
        snd = self.sounds.get(name)
        if not snd or not self.level:
            return
        try:
            snd.set_volume(self.level)
            self.channels[name].play(snd)        # one channel per sound: repeats restart, never pile up
        except Exception:
            pass


SOUND_FOR = {"up": "move", "down": "move", "left": "move", "right": "move",
             "l1": "page", "r1": "page", "l2": "page", "r2": "page",
             "ok": "ok", "x": "ok", "y": "ok", "start": "ok", "select": "ok", "back": "back"}


def rom_title(rom):
    """The rom's name, plus its disc number when RomM gives every disc of a
    game the same name ("Lorem Odyssey" ×3)."""
    name = rom.get("name") or rom.get("fs_name_no_ext") or ""
    d = rommlib.disc_info(rom.get("fs_name_no_ext") or "")
    if d and not rommlib.disc_info(name):
        return "%s (Disc %d)" % (name, d[1])
    return name


GLYPH_RE = re.compile(r"\{(%s)\}" % "|".join(re.escape(t) for t in TOKENS))


def rich_width(fonts, font, s):
    """Width of a line with {TOKEN} glyphs, as rich_text draws it."""
    parts = GLYPH_RE.split(s)
    w = 0
    for i, part in enumerate(parts):
        if i % 2:
            w += glyph_width(fonts, part) + 7
        else:
            if i > 0:
                part = part.lstrip()
            if i + 1 < len(parts):
                part = part.rstrip()
            if part:
                w += measure(font, part) + (7 if i + 1 < len(parts) else 0)
    return w


def rich_lines(fonts, font, s, width, max_lines=0):
    """Word-wrap prose that may hold {TOKEN} glyphs (a glyph never splits)."""
    out = []
    for para in s.split("\n"):
        cur = ""
        for word in re.split(r"(\{[^}]+\} ?|\s+)", para):
            if not word or word.isspace():
                if cur and not cur.endswith(" "):
                    cur += " "
                continue
            trial = cur + word
            if cur and rich_width(fonts, font, trial.rstrip()) > width:
                out.append(cur.rstrip())
                cur = word
            else:
                cur = trial
        out.append(cur.rstrip())
    if max_lines and len(out) > max_lines:
        out = out[:max_lines]
        while out[-1] and rich_width(fonts, font, out[-1] + "…") > width:
            out[-1] = out[-1][:-1]
        out[-1] = out[-1].rstrip() + "…"
    return out


def rich_text(surf, fonts, font, s, pos, color=None, anchor="topleft", maxw=None):
    """Text with inline pad glyphs: "Press {START} to see all results" draws
    the same glyph the hint bar uses, in the active controller style, so
    prose and hints always match. Supports topleft/midleft anchors; maxw
    shortens the text (never a glyph) with "…"."""
    color = TEXT if color is None else color
    if maxw and rich_width(fonts, font, s) > maxw:
        s = rich_lines(fonts, font, s, maxw, 1)[0]
    parts = GLYPH_RE.split(s)            # text, token, text, token, ...
    lh = font.get_height() / K
    x, y = pos
    top = y - lh / 2 if anchor == "midleft" else y
    cy = top + lh / 2
    for i, part in enumerate(parts):
        if i % 2:
            x += button_glyph(surf, fonts, part, x, cy - 11) + 7
        else:
            if i > 0:
                part = part.lstrip()      # the glyph's own gap replaces the space
            if i + 1 < len(parts):
                part = part.rstrip()
            if part:
                r = text(surf, font, part, (x, cy), color, "midleft")
                x = r.right + (7 if i + 1 < len(parts) else 0)
    return pygame.Rect(pos[0], top, x - pos[0], lh)


def progress_bar(surf, rect, frac, color=None):
    color = ACCENT if color is None else color
    rrect(surf, LINE, rect, rect[3] // 2)
    if frac > 0:
        w = max(rect[3], int(rect[2] * min(1.0, frac)))
        rrect(surf, color, (rect[0], rect[1], w, rect[3]), rect[3] // 2)


# -------------------------------------------------------------------- input

class Input:
    """Maps keyboard, SDL game controllers and raw joysticks to actions.
    Game controllers use SDL's standard layout, so a DualSense and an 8BitDo
    behave the same. Batocera's ES confirms with the south button; swap_ab in
    config.json flips that."""
    REPEAT_DELAY, REPEAT_RATE = 0.32, 0.055

    NAV_KEYS = None   # filled lazily (pygame constants need pygame imported)

    def __init__(self, swap_ab):
        self.set_swap(swap_ab)
        self.last = {}          # action -> (time, "pad"|"key"): drops evmapy's key echoes of pad presses
        self.pad_t = 0.0        # last pad activity of any kind
        self.pending = []       # keyboard actions held back briefly: an echo can arrive before its pad event
        self.text_mode = False  # a text field has focus: letters type instead of acting
        self.controllers = {}
        self.joysticks = {}
        self.held = {}
        self.key_action = {}    # pygame key -> the action its press queued
        self.key_up = {}        # action -> when its key was last let go
        self.axis_dir = {}
        self.raw_triggers = {}  # raw joystick instance id -> its [L2, R2] trigger axes
        if sdlcontroller is not None:
            sdlcontroller.init()
        for i in range(pygame.joystick.get_count()):
            self._open(i)

    def set_swap(self, swap_ab):
        self.ok_btn, self.back_btn = ("east", "south") if swap_ab else ("south", "east")
        PAD_STYLE["ok"], PAD_STYLE["back"] = self.ok_btn, self.back_btn

    def names(self):
        out = []
        for j in list(self.joysticks.values()):
            try:
                out.append(j.get_name())
            except Exception:
                pass
        for jid in self.controllers:
            for i in range(pygame.joystick.get_count()):
                try:
                    js = pygame.joystick.Joystick(i)
                    if js.get_instance_id() == jid:
                        out.append(js.get_name())
                except Exception:
                    pass
        return out

    def _open(self, index):
        try:
            jid = pygame.joystick.Joystick(index).get_instance_id()
            if jid in self.controllers or jid in self.joysticks:
                return                            # both "added" events fire for one pad
        except Exception:
            pass
        try:
            if sdlcontroller is not None and sdlcontroller.is_controller(index):
                c = sdlcontroller.Controller(index)
                jid = pygame.joystick.Joystick(index).get_instance_id()
                self.controllers[jid] = c
                return
        except Exception:
            pass
        try:
            j = pygame.joystick.Joystick(index)
            j.init()
            self.joysticks[j.get_instance_id()] = j
            # triggers on a raw joystick are the axes past the left stick that rest
            # all the way back (-1), first L2 then R2; a right stick rests at 0
            self.raw_triggers[j.get_instance_id()] = \
                [a for a in range(2, j.get_numaxes()) if j.get_axis(a) < -0.5][:2]
        except Exception:
            pass

    def _face(self, name):
        if name == self.ok_btn:
            return "ok"
        if name == self.back_btn:
            return "back"
        return {"west": "x", "north": "y"}.get(name)

    ECHO = 0.3
    KEY_HOLD = 0.06             # keyboard actions wait this long for a pad event they'd be the echo of

    def _key(self, action, out):
        """Queue a keyboard action; flush() commits it unless pad activity
        happened within ECHO of it (Batocera's evmapy echoes pad presses as
        keys; which one arrives first varies)."""
        now = time.time()
        if now - self.pad_t < self.ECHO:
            return
        self.pending.append((now, action))

    def flush(self, out):
        now = time.time()
        keep = []
        for t, action in self.pending:
            if abs(self.pad_t - t) < self.ECHO:
                continue                  # a pad event turned up: it was an echo
            if now - t < self.KEY_HOLD:
                keep.append((t, action))
            elif action.startswith("text:"):
                INPUT_MODE["kb"] = True
                out.append(action)
            else:
                # a tap let go before it was committed moves once: nothing is held to repeat
                self._press(action, out, "key", hold=self.key_up.get(action, 0) < t)
        self.pending = keep

    def _press(self, action, out, src="pad", hold=True):
        now = time.time()
        t, other = self.last.get(action, (0, src))
        if other != src and now - t < self.ECHO:
            return                    # the same press arriving twice (pad + its keyboard echo)
        self.last[action] = (now, src)
        INPUT_MODE["kb"] = src == "key"
        if hold and action in ("up", "down", "left", "right", "l1", "r1", "l2", "r2"):
            self.held[action] = now + self.REPEAT_DELAY
        out.append(action)

    def _release(self, action):
        self.held.pop(action, None)

    def handle(self, ev, out):
        t = ev.type
        if t in (pygame.CONTROLLERBUTTONDOWN, pygame.CONTROLLERBUTTONUP, pygame.JOYBUTTONDOWN,
                 pygame.JOYBUTTONUP, pygame.JOYHATMOTION) or \
                (t in (pygame.CONTROLLERAXISMOTION, pygame.JOYAXISMOTION) and abs(ev.value) > 0.5 *
                 (32767 if t == pygame.CONTROLLERAXISMOTION else 1)):
            self.pad_t = time.time()
        if t == pygame.TEXTINPUT:
            if self.text_mode and ev.text and ev.text.isprintable():
                self._key("text:" + ev.text, out)
            return
        if t == pygame.KEYDOWN:
            if ev.key == pygame.K_F4 and ev.mod & pygame.KMOD_ALT:
                out.append("quit")
                return
            if self.text_mode:
                km = {pygame.K_UP: "up", pygame.K_DOWN: "down", pygame.K_LEFT: "left",
                      pygame.K_RIGHT: "right", pygame.K_RETURN: "start", pygame.K_KP_ENTER: "start",
                      pygame.K_ESCAPE: "back", pygame.K_BACKSPACE: "x", pygame.K_TAB: "select"}
            else:
                km = {pygame.K_UP: "up", pygame.K_DOWN: "down", pygame.K_LEFT: "left",
                      pygame.K_RIGHT: "right", pygame.K_RETURN: "ok", pygame.K_KP_ENTER: "ok",
                      pygame.K_SPACE: "ok", pygame.K_ESCAPE: "back", pygame.K_BACKSPACE: "back",
                      pygame.K_x: "x", pygame.K_y: "y", pygame.K_PAGEUP: "l1", pygame.K_PAGEDOWN: "r1",
                      pygame.K_TAB: "select", pygame.K_HOME: "start",
                      pygame.K_LEFTBRACKET: "l2", pygame.K_RIGHTBRACKET: "r2"}
            if ev.key in km:
                self.key_action[ev.key] = km[ev.key]
                self._key(km[ev.key], out)
        elif t == pygame.KEYUP:
            a = self.key_action.pop(ev.key, None)
            if a:
                self.key_up[a] = time.time()
            for a in ("up", "down", "left", "right", "l1", "r1", "l2", "r2"):
                if self.last.get(a, (0, ""))[1] == "key":
                    self._release(a)
        elif sdlcontroller is not None and t == pygame.CONTROLLERDEVICEADDED:
            self._open(ev.device_index)
            out.append("padchange")
        elif t == pygame.JOYDEVICEADDED:
            # plain joysticks (no SDL mapping) only announce themselves here
            self._open(ev.device_index)
            out.append("padchange")
        elif t in (pygame.JOYDEVICEREMOVED, getattr(pygame, "CONTROLLERDEVICEREMOVED", -1)):
            iid = getattr(ev, "instance_id", None)
            self.controllers.pop(iid, None)
            self.joysticks.pop(iid, None)
            out.append("padchange")
        elif t in (pygame.CONTROLLERBUTTONDOWN, pygame.CONTROLLERBUTTONUP):
            m = {pygame.CONTROLLER_BUTTON_A: "south", pygame.CONTROLLER_BUTTON_B: "east",
                 pygame.CONTROLLER_BUTTON_X: "west", pygame.CONTROLLER_BUTTON_Y: "north",
                 pygame.CONTROLLER_BUTTON_DPAD_UP: "up",
                 pygame.CONTROLLER_BUTTON_DPAD_DOWN: "down",
                 pygame.CONTROLLER_BUTTON_DPAD_LEFT: "left",
                 pygame.CONTROLLER_BUTTON_DPAD_RIGHT: "right",
                 pygame.CONTROLLER_BUTTON_LEFTSHOULDER: "l1",
                 pygame.CONTROLLER_BUTTON_RIGHTSHOULDER: "r1",
                 pygame.CONTROLLER_BUTTON_START: "start",
                 pygame.CONTROLLER_BUTTON_BACK: "select",
                 pygame.CONTROLLER_BUTTON_GUIDE: "guide"}
            name = m.get(ev.button)
            if name in ("south", "east", "west", "north"):
                name = self._face(name)
            if name:
                if t == pygame.CONTROLLERBUTTONDOWN:
                    self._press(name, out)
                else:
                    self._release(name)
        elif t == pygame.CONTROLLERAXISMOTION:
            if ev.axis in (pygame.CONTROLLER_AXIS_LEFTX, pygame.CONTROLLER_AXIS_LEFTY):
                self._axis(("c", ev.instance_id, ev.axis), ev.axis == pygame.CONTROLLER_AXIS_LEFTX,
                           ev.value / 32767.0, out)
            elif ev.axis in (pygame.CONTROLLER_AXIS_TRIGGERLEFT, pygame.CONTROLLER_AXIS_TRIGGERRIGHT):
                key = ("t", ev.instance_id, ev.axis)
                on = ev.value > 16000
                trig = "l2" if ev.axis == pygame.CONTROLLER_AXIS_TRIGGERLEFT else "r2"
                if on and not self.axis_dir.get(key):
                    self._press(trig, out)
                elif not on and self.axis_dir.get(key):
                    self._release(trig)
                self.axis_dir[key] = on
        # raw joystick fallback (only for devices SDL has no mapping for)
        elif t in (pygame.JOYBUTTONDOWN, pygame.JOYBUTTONUP):
            if ev.instance_id in self.controllers:
                return
            m = {0: "south", 1: "east", 2: "west", 3: "north", 4: "l1", 5: "r1",
                 6: "select", 7: "start", 8: "select", 9: "start"}
            j = self.joysticks.get(ev.instance_id)
            try:
                if j is not None and j.get_numbuttons() >= 10:
                    m.update({6: "l2", 7: "r2"})      # 10+ buttons: L2 R2 then Select Start (generic pads)
            except Exception:
                pass
            name = m.get(ev.button)
            if name in ("south", "east", "west", "north"):
                name = self._face(name)
            if name:
                if t == pygame.JOYBUTTONDOWN:
                    self._press(name, out)
                else:
                    self._release(name)
        elif t == pygame.JOYHATMOTION:
            if ev.instance_id in self.controllers:
                return
            x, y = ev.value
            for a in ("up", "down", "left", "right"):
                self._release(a)
            if y == 1:
                self._press("up", out)
            elif y == -1:
                self._press("down", out)
            if x == -1:
                self._press("left", out)
            elif x == 1:
                self._press("right", out)
        elif t == pygame.JOYAXISMOTION:
            if ev.instance_id in self.controllers:
                return
            trig = self.raw_triggers.get(ev.instance_id, [])
            if ev.axis in trig:
                key, on = ("jt", ev.instance_id, ev.axis), ev.value > 0
                name = ("l2", "r2")[trig.index(ev.axis)]
                if on and not self.axis_dir.get(key):
                    self._press(name, out)
                elif not on and self.axis_dir.get(key):
                    self._release(name)
                self.axis_dir[key] = on
            elif ev.axis <= 1:
                self._axis(("j", ev.instance_id, ev.axis), ev.axis == 0, ev.value, out)

    def _axis(self, key, horizontal, v, out):
        d = None
        if v < -0.6:
            d = "left" if horizontal else "up"
        elif v > 0.6:
            d = "right" if horizontal else "down"
        prev = self.axis_dir.get(key)
        if d == prev:
            return
        if prev:
            self._release(prev)
        if d:
            self._press(d, out)
        self.axis_dir[key] = d

    def repeats(self, out):
        self.flush(out)
        now = time.time()
        for a, due in list(self.held.items()):
            if now >= due:
                out.append(a)
                self.held[a] = now + self.REPEAT_RATE


# ------------------------------------------------------------------- app

COVER_RETRY = (5, 15, 60)       # seconds before a cover RomM couldn't send is asked for again


class CoverLoader:
    """Covers come in on up to WORKERS threads, the newest request first, so
    the screen you're looking at fills before rows you scrolled past. A request
    for a cover nobody has drawn for STALE seconds is dropped when its turn
    comes; drawing that game again asks again."""
    WORKERS, STALE = 12, 1.5

    def __init__(self, app):
        self.app = app
        self.cv = threading.Condition()
        self.todo = []              # (rid, load, done, failed, dropped), newest last
        self.seen = {}              # rid -> when cover() last asked for it (drawn)
        self.busy = self.threads = 0

    def want(self, rid, load, done, failed, dropped, wanted):
        """wanted(): False once the app no longer waits for this request (the
        cover was evicted or the covers reset): it's then skipped silently."""
        with self.cv:
            self.todo.append((rid, load, done, failed, dropped, wanted))
            if self.threads < min(self.WORKERS, self.busy + len(self.todo)):
                self.threads += 1
                threading.Thread(target=self._work, daemon=True).start()
            self.cv.notify()

    def drawn(self, rid):
        now = self.seen[rid] = time.monotonic()
        if len(self.seen) > 2000:
            self.seen = {r: t for r, t in self.seen.items() if now - t < self.STALE}

    def pending(self):
        """Requests not finished yet (the screenshot harness waits for 0)."""
        with self.cv:
            return self.busy + len(self.todo)

    def run_one(self, wait=True):
        """Take the newest request and run it on this thread; False if there was none."""
        with self.cv:
            while not self.todo:
                if not wait:
                    return False
                self.cv.wait()
            rid, load, done, failed, dropped, wanted = self.todo.pop()
            self.busy += 1
        try:
            if not wanted():
                pass
            elif time.monotonic() - self.seen.get(rid, 0) > self.STALE:
                self.app.post(dropped)
            else:
                try:
                    res = load()
                except Exception as e:
                    if rid not in self.app.cover_retry:      # once, not every minute it stays down
                        rommlib.log("cover %s: %s" % (rid, e if isinstance(e, rommlib.RommError)
                                                      else e.__class__.__name__))
                    self.app.post(failed)
                else:
                    self.app.post(lambda: done(res))
        finally:
            with self.cv:
                self.busy -= 1
        return True

    def _work(self):
        while True:
            self.run_one()


class App:
    def __init__(self, screen, headless=False):
        global K
        self.screen = screen
        if screen is not None:
            sw, sh = screen.get_size()
            K = min(sw / W, sh / H)
        else:
            K = float(os.environ.get("ROMM_BROWSER_SCALE", "1"))
        self.fps = FPS if K <= 1.5 else 30   # 4K software blits: 30 fps is plenty for menus
        self.canvas = pygame.Surface((S(W), S(H)))
        self.scaled_covers = {}
        self.details, self.detail_busy = {}, False     # RomM's full record per rom id (files, archive members)
        self.es_count = {}                             # {system: games ES lists}, refreshed by Platforms
        self.fonts = Fonts()
        FONTS["f"] = self.fonts
        self.cfg = rommlib.load_config()
        self.targets, self.modal_from, self.ptr = [], 0, None
        self.tapped, self.ptr_later = False, []    # a tap acted since the last frame; events held back
        self.sfx = Sfx(self.cfg["sounds"] if screen is not None else "off")
        self.input = Input(self.cfg["swap_ab"])
        apply_theme(self.theme_key())
        self.headless = headless
        self.api = rommlib.Api.from_config(self.cfg)
        self.api.cache_limit = rommlib.cache_limit_bytes(self.cfg)
        self.loaded = False
        self.junk = None              # filename tags hidden by "Hide prototypes, demos & hacks"
        self.update_tag = None
        self.library = rommlib.Library()
        self.downloader = rommlib.Downloader(self.api, self.library, self.cfg)
        self.platforms = []          # mapped platforms only
        self.platform_by_id = {}
        self.unmapped = []
        self.stack = []
        self.toasts = []
        self.modal = None
        self.events_from_threads = []
        self.lock = threading.Lock()
        self.covers = {}             # rom_id -> Surface | "loading" | None
        self.cover_bytes = 0         # what the covers' Surfaces take (trim_covers keeps it in budget)
        self.cover_order = []
        self.cover_req = {}          # rom_id -> the request the app waits for (stale ones are ignored)
        self.cover_retry = {}        # rom_id -> (monotonic time to ask again, failures): RomM was busy
        self.cover_loader = CoverLoader(self)
        self.running = True
        self.status = "Connecting…"
        self.error = None
        self.t = 0.0
        self._chd_spawned = 0

    # ---- threading helpers
    def bg(self, fn, done=None, err=None):
        def run():
            try:
                res = fn()
                if done:
                    self.post(lambda: done(res))
            except Exception as e:
                if not isinstance(e, (rommlib.RommError, rommlib.UpdateError)):
                    # foreign exception text can carry request details: type only
                    e = rommlib.RommError("Error (%s)" % e.__class__.__name__)
                rommlib.log("bg error: %s" % e)
                # bind e now: Python 3 deletes `e` when the except block ends
                if err:
                    self.post(lambda e=e: err(e))
                else:
                    self.post(lambda e=e: self.toast(str(e), RED))
        threading.Thread(target=run, daemon=True).start()

    def post(self, fn):
        with self.lock:
            self.events_from_threads.append(fn)

    def toast(self, msg, color=None):
        color = TEXT if color is None else color
        now = time.time()
        last = self.toasts[-1] if self.toasts else None
        if last and last[0] == msg and last[1] == color and last[2] > now:
            burst = last[2] - 3.5 > now - 0.5    # e.g. every load of a screen failing at once: one sound
            last[2] = now + 3.5                  # the same message again: one toast, its time renewed, ×N
            last[3] += 1
            if burst:
                return
        else:
            self.toasts.append([msg, color, now + 3.5, 1])
        if color == RED:
            self.sfx.play("deny")
        elif msg.startswith("Ready"):
            self.sfx.play("done")
        elif msg.startswith("Queued"):
            self.sfx.play("queued")

    # ---- data
    def load_platforms(self):
        def done(plats):
            mp = dict(rommlib.PLATFORM_MAP)
            mp.update(self.cfg["platform_map"] or {})
            self.platforms, self.unmapped = [], []
            for p in plats:
                system = mp.get(p["fs_slug"])
                p["_system"] = system
                if not p.get("rom_count"):
                    continue
                (self.platforms if system else self.unmapped).append(p)
            self.platforms.sort(key=lambda p: (p.get("display_name") or p["name"]).lower())
            self.platform_by_id = {p["id"]: p for p in self.platforms}
            self.status = "Online"
            self.error = None
            self.loaded = True

        def err(e):
            self.status = "Offline"
            self.error = str(e)
        self.bg(self.api.platforms, done, err)

    def system_for(self, rom):
        p = self.platform_by_id.get(rom.get("platform_id"))
        return p["_system"] if p else None

    def free_after_queue(self):
        """Free space once the queue already waiting has landed (None if unknown)."""
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
        except OSError:
            return None
        return st.f_bavail * st.f_frsize - rommlib.queue_forecast(
            self.downloader.jobs, 0, 0, self.cfg["chd"], self.cfg)["need"]

    def plan_text(self, rom, system):
        """One game's download in a sentence: size, unpacked size, conversion,
        where it goes and the space left afterwards."""
        size = rom.get("fs_size_bytes") or 0
        lay = self.layout(rom)
        parts, lands = ["%s to download" % human_size(size)], size
        if lay and lay["unpacked"]:
            lands = lay["unpacked"]
            parts.append("%s%s once unpacked" % ("about " if lay["estimated"] else "", human_size(lands)))
        elif (rom.get("fs_extension") or "").lower() in ("zip", "7z", "rar") and system in rommlib.EXPANDS:
            lands = rommlib.space_needed(rom, system)
            parts.append("about %s once unpacked" % human_size(lands))
        if lay and lay["convert"] == rommlib.CONVERTER["ps3"].label:
            parts.append("then made into a .ps3 game folder in the background (read from the zip)")
        elif lay and lay["convert"]:
            parts.append("then compressed to %s in the background" % lay["convert"])
        out = ", ".join(parts) + ". Saved to roms/%s" % system
        after, keep = self.free_after_queue(), rommlib.keep_free_bytes(self.cfg)
        if after is not None:
            after -= lands
            out += ("; %s free afterwards" % human_size(after) if after >= keep else
                    "; it waits for space (keeping %s free)" % human_size(keep))
        return out + "."

    def detail(self, rom):
        """RomM's full record for rom ({} if it couldn't be fetched), or None
        while it's being fetched. One fetch at a time: scrolling past a list
        fetches only where the selection stops."""
        rid = rom["id"]
        if rid in self.details or self.detail_busy:
            return self.details.get(rid)
        self.detail_busy = True

        def keep(d):
            self.detail_busy = False
            if len(self.details) > 400:
                self.details.clear()
            self.details[rid] = d or {}
        self.bg(lambda: self.api.rom(rid), keep, lambda e: keep({}))
        return None

    def layout(self, rom):
        """rommlib.disc_layout for rom once its record is here, else None."""
        system = self.system_for(rom)
        d = self.detail(rom)
        if not (d and system):
            return None
        return rommlib.disc_layout(d, system, self.cfg, self.downloader._accepts)

    def cover(self, rom):
        rid = rom["id"]
        self.cover_loader.drawn(rid)
        c = self.covers.get(rid)
        if c is not None or rid in self.covers:
            if self.cover_order[-1] != rid:            # most recently drawn last: trimmed last
                self.cover_order.remove(rid)
                self.cover_order.append(rid)
            return None if c == "loading" else c
        retry = self.cover_retry.get(rid)
        if retry and time.monotonic() < retry[0]:
            return None                   # couldn't be fetched a moment ago: "…" until it's time
        self.covers[rid] = "loading"
        req = self.cover_req[rid] = object()
        self.cover_order.append(rid)
        self.trim_covers()

        def current():
            return self.cover_req.get(rid) is req

        def load():
            for _ in (1, 2):
                path = self.api.fetch_cover(rom, large=K > 1.5)
                if not path:
                    return None
                try:
                    with COVER_DECODES:
                        return cover_fit(as_rgba(pygame.image.load(path)))
                except (pygame.error, OSError):
                    # trimmed from the cache between finding and reading it
                    # (or unreadable): drop it and fetch once more
                    try:
                        os.remove(path)
                    except OSError:
                        pass
            return None                     # fetched again and still not an image: no cover

        def done(img):
            if current():
                del self.cover_req[rid]
                self.covers[rid] = img
                self.cover_bytes += surface_bytes(img)
                self.cover_retry.pop(rid, None)
                self.trim_covers(keep=rid)

        def failed():                       # RomM busy or unreachable: ask again after a wait
            if current():
                del self.cover_req[rid]
                del self.covers[rid]
                self.cover_order.remove(rid)
                n = self.cover_retry.get(rid, (0, 0))[1] + 1
                now = time.monotonic()
                self.cover_retry[rid] = (now + COVER_RETRY[min(n, len(COVER_RETRY)) - 1], n)
                if len(self.cover_retry) > 2000:
                    self.cover_retry = {r: v for r, v in self.cover_retry.items() if v[0] > now - 600}

        def dropped():                  # scrolled away before its turn: asked again when drawn
            if current():
                del self.cover_req[rid]
                del self.covers[rid]
                self.cover_order.remove(rid)
        self.cover_loader.want(rid, load, done, failed, dropped, current)
        return None

    def trim_covers(self, keep=None):
        """Least recently drawn covers out of memory past COVER_BUDGET (or
        COVER_ENTRIES; it can run over by the cover just loaded when every
        other one was drawn more recently); a load still on its way for one
        is ignored. They come back from the disk cache when drawn again."""
        while self.cover_order and (self.cover_bytes > COVER_BUDGET or len(self.cover_order) > COVER_ENTRIES):
            old = self.cover_order[0]
            if old == keep:
                break
            self.cover_order.pop(0)
            self.cover_bytes -= surface_bytes(self.covers.pop(old, None))
            self.cover_req.pop(old, None)
            self.scaled_covers.pop(old, None)

    def forget_covers(self):
        """Drop every cover in memory (new server, cache cleared); loads on their way are ignored."""
        self.cover_bytes = 0
        self.covers.clear()
        self.cover_order.clear()
        self.cover_req.clear()
        self.cover_retry.clear()
        self.scaled_covers.clear()

    def theme_key(self):
        return theme_for(self.cfg["theme"], self.cfg["theme_auto"], self.cfg["button_style"], self.input.names())

    def resolve_style(self):
        want = self.cfg["button_style"] or "auto"
        PAD_STYLE["style"] = want if want in FACE else style_from_names(self.input.names())
        return PAD_STYLE["style"]

    def apply_config(self, reconnect=False):
        """Called by Settings after a change: persist, re-wire live objects."""
        try:
            rommlib.save_config(self.cfg)
        except rommlib.ConfigUnreadable:
            self.toast("config.json can't be read: this change is not saved (Settings, Reset settings)", AMBER)
        self.input.set_swap(self.cfg["swap_ab"])
        apply_theme(self.theme_key())
        self.resolve_style()
        if reconnect:
            self.api = rommlib.Api.from_config(self.cfg)
            self.api.cache_limit = rommlib.cache_limit_bytes(self.cfg)
            self.downloader.api = self.api
            self.forget_covers()
            self.details.clear()
            self.platforms, self.platform_by_id, self.loaded = [], {}, False
            self.status, self.error = "Connecting…", None
            self.load_platforms()

    def uninstall(self, rom, system, then=None):
        def done(res):
            paths, freed = res
            self.toast("Deleted %s — %s freed" % (rom.get("name"), human_size(freed)), GREEN)
            self.space_freed()
            if then:
                then()
        self.bg(lambda: self.library.uninstall(rom, system), done)

    def uninstall_group(self, group, system, title, then=None):
        """Every disc of a set and its playlist; like uninstall(), conversions
        waiting for room hear about the space."""
        def done(res):
            self.toast("Deleted %s — %s freed" % (title, human_size(res[1])), GREEN)
            self.space_freed()
            if then:
                then()
        self.bg(lambda: self.library.uninstall_group(group, system), done)

    def start_download(self, rom):
        system = self.system_for(rom)
        if not system:
            self.toast("No Batocera system for this platform", RED)
            return
        self.downloader.enqueue(rom, system)
        self.toast("Queued: %s" % rom_title(rom) + self.hours_note(), GREEN)
        self.space_check()

    def space_check(self):
        """After queueing: warn when the whole queue won't fit (it waits for room)."""
        fc = rommlib.queue_forecast(self.downloader.jobs, rommlib.free_bytes(),
                                    rommlib.keep_free_bytes(self.cfg), self.cfg["chd"], self.cfg)
        if fc["jobs"] and not fc["fits"]:
            self.toast("The queue needs %s more space than this box has free (keeping %s free). "
                       "Downloads wait until there's room." % (human_size(fc["short"]), human_size(fc["keep"])),
                       AMBER)

    def hours_note(self):
        if rommlib.in_download_hours(self.cfg):
            return ""
        return " — downloads run %s" % rommlib.hours_label(self.cfg["download_hours"])

    def rom_status(self, rom):
        """("active"|"failed"|"installed"|"remote", job or None). A finished
        download counts as installed only while its files are still there."""
        j = self.downloader.job_for(rom["id"])
        if j and j.active:
            return "active", j
        if j and j.state == rommlib.Job.FAILED:
            return "failed", j
        system = self.system_for(rom)
        if system and self.library.is_installed(rom, system):
            return "installed", j if j and j.state == rommlib.Job.DONE else None
        return "remote", None

    def set_title(self, rom):
        name = rom.get("name") or rom.get("fs_name_no_ext") or ""
        d = rommlib.disc_info(name)
        return d[0] if d else name

    def make_group(self, rom, discs):
        plat = self.platform_by_id.get(rom.get("platform_id")) or {}
        return rommlib.disc_group(plat.get("fs_slug") or str(rom.get("platform_id")), discs,
                                  self.set_title(rom))

    def queue_set(self, group, items, system):
        """items: [(rom, system)] of one disc set. Discs already on the box
        join the set instead of downloading again. Returns discs queued."""
        lib, dl = self.library, self.downloader
        queued = 0
        for r, _ in items:
            j = dl.job_for(r["id"])
            if j and j.active:
                j.group = group
                continue
            if lib.is_installed(r, system) and lib.adopt(r, system, group):
                continue
            dl.enqueue(r, system, group)
            queued += 1
        if not queued:                       # everything already here: just make the playlist
            self.bg(lambda: dl._finish_group(group, system),
                    lambda m3u: self.toast("Playlist made: %s" % os.path.basename(m3u) if m3u
                                           else "All discs are already on this box", GREEN))
        dl.save_queue()
        return queued

    def download_set(self, rom, discs):
        system = self.system_for(rom)
        group = self.make_group(rom, discs)
        n = self.queue_set(group, [(r, system) for _, r in discs], system)
        if n:
            self.toast("Queued %d disc%s: %s" % (n, "" if n == 1 else "s", group["title"]), GREEN)
            self.space_check()

    def expand_sets(self, items):
        """Bulk downloads: give every disc its whole set (found in RomM) and
        a shared group. Runs in a worker thread. Returns [(group|None, [(rom, system)])]."""
        out, seen = [], {}
        for r, sy in items:
            d = rommlib.disc_info(r.get("fs_name_no_ext") or "")
            if not d:
                out.append((None, [(r, sy)]))
                continue
            key = (r.get("platform_id"), d[0].lower())
            if key in seen:
                continue
            discs, _ = rommlib.find_disc_set(self.api, r)
            if not discs or len(discs) < 2:
                out.append((None, [(r, sy)]))
                continue
            seen[key] = True
            out.append((self.make_group(r, discs), [(x, sy) for _, x in discs]))
        return out

    def queue_many(self, roms, title, after=None):
        """Queue many games (a list, a collection, picked games) with the space
        check, the keep-free reserve and whole multi-disc sets."""
        app = self
        def busy(r):
            j = app.downloader.job_for(r["id"])
            return bool(j and j.active)
        roms = [r for r in roms if app.system_for(r) and not app.library.is_installed(r, app.system_for(r))
                and not busy(r)]
        if not roms:
            app.toast("Nothing to download — all on this box already", AMBER)
            return
        size = sum(r.get("fs_size_bytes") or 0 for r in roms)
        items = [(r, app.system_for(r)) for r in roms]
        need = sum(rommlib.space_needed(r, sy) for r, sy in items)
        keep = rommlib.keep_free_bytes(app.cfg)
        free = app.free_after_queue()

        def go(chosen):
            if after:
                after()
            if not any(rommlib.disc_info(r.get("fs_name_no_ext") or "") for r, _ in chosen):
                for r, sy in chosen:
                    app.downloader.enqueue(r, sy)
                app.toast("Queued %d games" % len(chosen) + app.hours_note(), GREEN)
                app.space_check()
                return
            app.toast("Finding the other discs of multi-disc games…")

            def queued(groups):
                n = 0
                for group, members in groups:
                    if group:
                        n += app.queue_set(group, members, members[0][1])
                    else:
                        for r, sy in members:
                            app.downloader.enqueue(r, sy)
                            n += 1
                sets = sum(1 for g, _ in groups if g)
                app.toast("Queued %d download%s%s" % (n, "" if n == 1 else "s",
                          (", %d multi-disc set%s kept together" % (sets, "" if sets == 1 else "s"))
                          if sets else "") + app.hours_note(), GREEN)
                app.space_check()
            app.bg(lambda: app.expand_sets(chosen), queued)

        if free is not None and need + (keep or rommlib.SPACE_MARGIN) > free:
            fit, used = rommlib.fit_in_space(items, free, keep or rommlib.SPACE_MARGIN)
            entries = []
            if fit:
                entries.append(("Download the %d that fit" % len(fit),
                                "About %s once extracted" % human_size(used), lambda: go(fit)))
            entries.append(("Download all %d anyway" % len(items),
                            "Needs about %s; %s free after the queue, keeping %s free. Later ones wait "
                            "for space." % (human_size(need), human_size(max(0, free)), human_size(keep)),
                            lambda: go(items)))
            entries.append(("Cancel", "", lambda: None))
            app.modal = ActionMenu(app, "Not enough space for all %d" % len(items), entries)
            return
        body = "%d games, %s to download (about %s once extracted)%s." % (
            len(roms), human_size(size), human_size(need),
            "" if free is None else ". %s free on this box" % human_size(max(0, free)))
        app.modal = Confirm(app, title, body, "Download %d" % len(roms), lambda: go(items))

    def space_freed(self):
        """Space was just freed: conversions waiting for room shouldn't wait for
        the next download to be noticed. The worker is flock'd (no-op if running)."""
        if self.headless:
            return
        if rommlib.conversions_pending():
            self.spawn_helper("rb_chd.py")

    def spawn_helper(self, script):
        rommlib.spawn_detached(script, "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else None)

    # ---- navigation
    def push(self, screen):
        self.stack.append(screen)
        screen.enter()

    def pop(self):
        if len(self.stack) > 1:
            self.stack.pop()
            self.stack[-1].enter()

    def request_quit(self):
        if getattr(self.modal, "is_quit", False):
            return self._quit()                     # asked twice: quit
        n = self.downloader.active_count()
        if n and not self.cfg["background_downloads"]:
            self.modal = Confirm(self, "Quit %s?" % APP_NAME,
                                 "%d download%s still running. They're paused and resume "
                                 "next time you open RomM-o-Cera (or turn on \"Keep "
                                 "downloading after exit\" in Settings)." % (n, "s" if n > 1 else ""),
                                 "Quit", self._quit, danger=True)
            self.modal.is_quit = True
        else:
            self._quit()

    def _quit(self):
        self.running = False

    # ---- main loop
    def _update_found(self, tag):
        if not tag:
            return
        self.update_tag = tag
        if read_marker(".update-notified") == tag:
            return
        self.toast("%s %s is out. Settings shows how to update." % (APP_NAME, tag), BLUE)
        write_marker(".update-notified", tag)

    def on_pad_change(self):
        if (self.cfg["button_style"] or "auto") == "auto":
            self.resolve_style()
        if self.cfg["theme_auto"]:
            apply_theme(self.theme_key())

    def take_over_downloads(self):
        """A background rb_dl.py may still be working: ask it to hand over,
        then resume whatever is queued (here or left from last time)."""
        self.bg(self.downloader.repair_groups, lambda n: None, lambda e: None)
        try:
            import rb_dl
            was_running = rb_dl.handover()
        except Exception as e:
            rommlib.log("handover: %r" % e)
            was_running = False
        n = self.downloader.resume()
        if not self.headless and rommlib.conversions_pending():
            self.spawn_helper("rb_chd.py")        # discs left waiting last time (flock'd: no-op if running)
        if n and self.downloader.hold:
            self.toast("%d download%s waiting — paused (Downloads, X resumes)" % (n, "" if n == 1 else "s"), AMBER)
        elif n:
            self.toast("Resumed %d download%s%s" % (n, "" if n == 1 else "s",
                                                    " from the background" if was_running else ""), BLUE)

    def startup_checks(self):
        """Things the player must know before anything else."""
        if rommlib.config_unreadable():
            kept = sorted(n for n in os.listdir(rommlib.DATA_DIR) if n.startswith("config.json.bad-"))
            rommlib.load_config()                    # keeps a copy beside it if there isn't one
            kept = sorted(n for n in os.listdir(rommlib.DATA_DIR) if n.startswith("config.json.bad-")) or kept
            self.modal = Confirm(
                self, "Settings file can't be read",
                "config.json has an error, so defaults are in use and nothing is saved over it "
                "(copy kept: %s). Fix it over SSH and restart, or reset: you then enter the "
                "server and token again." % (kept[-1] if kept else "config.json.bad-…"),
                "Reset settings", self.reset_config, danger=True)

    def reset_config(self):
        rommlib.reset_config()
        self.cfg.clear()
        self.cfg.update(rommlib.load_config())
        self.downloader.cfg = self.cfg
        self.apply_config(reconnect=True)
        self.toast("Settings reset to defaults; the old file is kept", GREEN)

    def run(self, scripted=None):
        clock = pygame.time.Clock()
        self.startup_checks()
        self.resolve_style()
        apply_theme(self.theme_key())
        self.take_over_downloads()
        lim = rommlib.cache_limit_bytes(self.cfg)
        if lim:                                   # trim the cover cache once per start
            self.bg(lambda: rommlib.prune_cache(lim), lambda r: None, lambda e: None)
        self.load_platforms()
        if not self.headless:
            self.bg(lambda: rommlib.newer_release(self.cfg), self._update_found, lambda e: None)
        self.push(HomeScreen(self))
        while self.running:
            dt = clock.tick(self.fps) / 1000.0
            self.t += dt
            actions = []
            want_text = not self.modal and getattr(self.stack[-1], "text_entry", False)
            if want_text != self.input.text_mode:
                self.input.text_mode = want_text
                try:
                    (pygame.key.start_text_input if want_text else pygame.key.stop_text_input)()
                except Exception:
                    pass
            for ev in self.pointer_later() + pygame.event.get():
                if ev.type == pygame.QUIT:
                    actions.append("quit")
                elif not self.pointer(ev, actions):
                    if ev.type in (pygame.KEYDOWN, pygame.CONTROLLERBUTTONDOWN, pygame.JOYBUTTONDOWN) \
                            and not self.headless:
                        pygame.mouse.set_visible(False)
                    self.input.handle(ev, actions)
            self.input.repeats(actions)
            if scripted is not None:
                actions += scripted(self)
            with self.lock:
                fns, self.events_from_threads = self.events_from_threads, []
            for fn in fns:
                fn()
            for a in actions:
                self.dispatch(a)
            self.tick_downloads()
            self.draw()
        self.on_exit()

    # ---- touch / mouse: screens register tap targets while drawing
    def hit(self, rect, fn):
        self.targets.append((pygame.Rect(rect), fn))

    def to_logical(self, pos):
        if self.screen is None:
            return pos
        sw, sh = self.screen.get_size()
        cw, ch = self.canvas.get_size()
        return ((pos[0] - (sw - cw) // 2) / K, (pos[1] - (sh - ch) // 2) / K)

    DRAG_STEP = 46

    def pointer(self, ev, actions):
        """A tap or click acts on what was under it when pressed, if it's let go
        on the same thing; a finger's drag and the wheel scroll. Returns True
        if the event was a pointer event."""
        t = ev.type
        if t not in (pygame.MOUSEBUTTONDOWN, pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION, pygame.MOUSEWHEEL):
            return False
        if self.tapped or self.ptr_later:
            # a tap acted since the last frame was drawn: what's on screen is
            # about to change, so the rest waits for the next frame's targets
            self.ptr_later.append(ev)
            return True
        if t == pygame.MOUSEBUTTONDOWN and ev.button == 1:
            touch = bool(getattr(ev, "touch", False))
            # show the cursor for a real mouse click only (evmapy maps the right
            # stick to a mouse, which must not make it pop up; touch needs none)
            if not touch and not self.headless:
                pygame.mouse.set_visible(True)
            p = self.to_logical(ev.pos)
            self.ptr = {"start": p, "y": p[1], "moved": False, "touch": touch,
                        "hit": self.target_at(p), "on": (self.stack[-1], self.modal)}
        elif t == pygame.MOUSEMOTION:
            if self.ptr and ev.buttons and ev.buttons[0]:
                p = self.to_logical(ev.pos)
                if abs(p[1] - self.ptr["start"][1]) > 14 or abs(p[0] - self.ptr["start"][0]) > 14:
                    self.ptr["moved"] = True
                # only a finger drags the list (up: content moves on): a mouse has its
                # wheel, and a click must never turn into a scroll (the pointer can jump while held)
                while self.ptr["touch"] and p[1] - self.ptr["y"] <= -self.DRAG_STEP:
                    actions.append("down")
                    self.ptr["y"] -= self.DRAG_STEP
                while self.ptr["touch"] and p[1] - self.ptr["y"] >= self.DRAG_STEP:
                    actions.append("up")
                    self.ptr["y"] += self.DRAG_STEP
        elif t == pygame.MOUSEBUTTONUP and ev.button == 1:
            ptr, self.ptr = self.ptr, None
            if ptr and not (ptr["moved"] and ptr["touch"]) and ptr["on"] == (self.stack[-1], self.modal):
                hit = self.target_at(self.to_logical(ev.pos))
                if self.same_target(hit, ptr["hit"]):
                    self.tapped = True
                    self.press(hit)
        elif t == pygame.MOUSEWHEEL:
            actions += ["up" if ev.y > 0 else "down"] * min(5, abs(ev.y))
        return True

    def pointer_later(self):
        """Pointer events held back until a frame was drawn after a tap."""
        later, self.ptr_later = self.ptr_later, []
        return later

    def target_at(self, pt):
        """(rect, fn) of the topmost tap target under pt in the frame on
        screen (only the dialog's while one is open), or None."""
        cands = self.targets[self.modal_from:] if self.modal else self.targets
        return next(((r, fn) for r, fn in reversed(cands) if r.collidepoint(pt)), None)

    @staticmethod
    def same_target(a, b):
        """The same thing on screen: same place, and the same row (a target's
        fn is a lambda with its row in its defaults, made anew each frame)."""
        if a is None or b is None:
            return a is b
        fa, fb = a[1], b[1]
        return a[0] == b[0] and (fa is fb or (fa is not None and fb is not None and
                                             fa.__code__ is fb.__code__ and fa.__defaults__ == fb.__defaults__))

    def tap(self, pt):
        self.press(self.target_at(pt))

    def press(self, hit):
        if hit:
            if hit[1]:
                self.sfx.play("ok")
                hit[1]()
        elif self.modal:
            self.dispatch("back")              # tap outside a dialog closes it

    def dispatch(self, a):
        if a.startswith("text:"):
            top = self.stack[-1]
            if not self.modal and hasattr(top, "type_text"):
                self.sfx.play("move")
                top.type_text(a[5:])
            return
        snd = SOUND_FOR.get(a)
        moving = snd in ("move", "page")
        before = self.nav_state() if moving else None
        if snd and not moving:
            self.sfx.play(snd)
        if a == "padchange":
            self.on_pad_change()
            return
        if a == "quit":
            self.request_quit()
            return
        if self.modal:
            self.modal.action(a)
            self._moved_sound(snd, before)
            return
        if a == "select" and not isinstance(self.stack[-1], DownloadsScreen):
            self.push(DownloadsScreen(self))
            return
        if a == "start" and len(self.stack) > 1 and not getattr(self.stack[-1], "own_start", False):
            del self.stack[1:]
            self.stack[0].enter()
            return
        self.stack[-1].action(a)
        self._moved_sound(snd, before)

    def nav_state(self):
        """What a move/page could change: focus, scroll, keyboard cursor,
        menu row, screen/dialog identity."""
        out = [len(self.stack), id(self.modal), id(self.stack[-1])]
        for o in (self.stack[-1], self.modal):
            if o is not None:
                out += [getattr(o, k, None) for k in ("sel", "scroll", "r", "c", "region_i")]
        ents = self.modal.entries if isinstance(self.modal, ActionMenu) else None
        if ents:                                   # in-place switches / choices in a menu
            out.append(tuple(e[3] if e and len(e) > 3 else None for e in ents))
        out.append(repr(sorted(self.cfg.items())))   # Settings rows cycled with left/right
        return tuple(out)

    def _moved_sound(self, snd, before):
        # held at the top/bottom of a list, repeats change nothing: stay quiet
        if before is not None and self.nav_state() != before:
            self.sfx.play(snd)

    def tick_downloads(self):
        for j in self.downloader.jobs:
            if j.state == rommlib.Job.DONE and not getattr(j, "_announced", False):
                j._announced = True
                self.toast("Ready: %s" % j.label, GREEN)
                for scr in self.stack:
                    scr.__dict__.pop("_variants", None)
                if j.chd_queued and not self.headless:
                    self.spawn_helper("rb_chd.py")   # flock'd: no-op if already running
            elif j.state == rommlib.Job.FAILED and not getattr(j, "_announced", False):
                j._announced = True
                self.toast("Failed: %s — %s" % (j.label, j.message), RED)

    def on_exit(self):
        pending = 0 if self.downloader.hold else self.downloader.pending_count()
        self.downloader.pause_all()          # keeps them in download-queue.json
        if self.headless:
            return
        if pending and self.cfg["background_downloads"]:
            self.spawn_helper("rb_dl.py")     # finishes the queue while you play
            return                            # it runs CHD + gamelist merge when done
        if os.path.exists(rommlib.GAMELIST_QUEUE):
            self.spawn_helper("rb_finalize.py")
        if rommlib.conversions_pending():
            self.spawn_helper("rb_chd.py")

    # ---- drawing
    def draw(self):
        c = self.canvas
        c.fill(BG)
        self.targets, self.tapped = [], False
        # subtle top glow
        rrect(c, BG2, (0, 0, W, 64), 0)
        hline(c, LINE, (0, 64), (W, 64))
        top = self.stack[-1]
        # logo
        rrect(c, ACCENT, (24, 16, 34, 34), 9)
        text(c, self.fonts.h3, "R", (41, 33), ink_on(ACCENT), "center")
        text(c, self.fonts.h2, APP_NAME, (68, 33), TEXT, "midleft")
        x = 68 + int(measure(self.fonts.h2, APP_NAME)) + 14
        self.hit((16, 8, x - 16, 50), lambda: self.dispatch("start") if len(self.stack) > 1 else None)
        if len(self.stack) > 1:
            self.hit((x, 8, 520, 50), lambda: self.dispatch("back"))
        for crumb in top.crumbs():
            text(c, self.fonts.h3, "›", (x, 32), FAINT, "midleft")
            x += 18
            r = text(c, self.fonts.h3, crumb, (x, 33), DIM, "midleft", maxw=380)
            x = r.right + 12
        # right side status
        n = self.downloader.active_count()
        rx = W - 24
        dot = GREEN if self.status == "Online" else (AMBER if self.status.startswith("Conn") else RED)
        r = text(c, self.fonts.small, self.status, (rx, 33), DIM, "midright")
        circle(c, dot, (r.left - 12, 33), 5)
        rx = r.left - 30
        if n:
            j = next((j for j in self.downloader.jobs if j.state == rommlib.Job.DOWNLOADING), None)
            label = "%d in queue" % n + (", %s/s" % human_size(j.speed) if j and j.speed else "")
            r = text(c, self.fonts.small, label, (rx, 33), BLUE, "midright")
        top.draw(c)
        if isinstance(top, ListScreen):
            top.draw_bubble(c)                 # the letter (or system) an L2/R2 jump landed on
        # footer
        hline(c, LINE, (0, H - 46), (W, H - 46))
        # right side first (the two global buttons, then the version): the hints get what's left
        rx = W - 24
        r = text(c, self.fonts.small, "v" + rommlib.VERSION_LABEL, (rx, H - 23), FAINT, "midright")
        rx = r.left - 28
        globals_ = [("START", "Home"), ("SELECT", "Downloads")]
        if getattr(top, "own_start", False) or len(self.stack) == 1:
            globals_ = [g for g in globals_ if g[0] != "START"]     # Start means something else here
        if isinstance(top, DownloadsScreen):
            globals_ = [g for g in globals_ if g[0] != "SELECT"]
        for btn, label in globals_:
            r = text(c, self.fonts.small, label, (rx, H - 23), DIM, "midright")
            gw = glyph_width(self.fonts, btn)
            button_glyph(c, self.fonts, btn, r.left - 8 - gw, H - 34)
            self.hit((r.left - 16 - gw, H - 46, r.width + gw + 24, 46),
                     lambda a=TOKEN_ACTION[btn]: self.dispatch(a))
            rx = r.left - 8 - gw - 22
        hints = top.hints()

        def width(hs):
            return sum(glyph_width(self.fonts, b) + 8 + measure(self.fonts.small, lab) + 22 for b, lab in hs)
        if 24 + width(hints) > rx:                   # too long: page up/down go first (L1/R1 still work)
            hints = [h for h in hints if h[0] not in ("L", "R")]
        fx = 24
        for btn, label in hints:
            if fx + glyph_width(self.fonts, btn) + 8 + measure(self.fonts.small, label) > rx:
                break
            x0 = fx
            gw = button_glyph(c, self.fonts, btn, fx, H - 34)
            fx += gw + 8
            r = text(c, self.fonts.small, label, (fx, H - 23), DIM, "midleft")
            if btn in TOKEN_ACTION:
                self.hit((x0 - 8, H - 46, r.right - x0 + 16, 46), lambda a=TOKEN_ACTION[btn]: self.dispatch(a))
            if btn in TOKEN_BACK:                    # a two-way control: its left half goes the other way
                self.hit((x0 - 8, H - 46, gw // 2 + 8, 46), lambda a=TOKEN_BACK[btn]: self.dispatch(a))
            fx = r.right + 22
        self.modal_from = len(self.targets)
        if self.modal:
            self.modal.draw(c)
        self.draw_toasts(c)
        if self.screen is not None:
            # canvas is already native-resolution; just centre it (letterbox if
            # the screen isn't 16:9)
            sw, sh = self.screen.get_size()
            cw, ch = c.get_size()
            if (sw, sh) != (cw, ch):
                self.screen.fill(BG)
            self.screen.blit(c, ((sw - cw) // 2, (sh - ch) // 2))
            pygame.display.flip()

    def draw_toasts(self, c):
        now = time.time()
        self.toasts = [t for t in self.toasts if t[2] > now][-3:]
        y = H - 64
        for t in reversed(self.toasts):
            msg, color = t[0], t[1]
            if t[3] > 1:
                msg = "%s  ×%d" % (msg, t[3])
            w = min(900, rich_width(self.fonts, self.fonts.body, msg) + 52)
            r = pygame.Rect(0, 0, w, 40)
            r.midbottom = (W // 2, y)
            rrect(c, PANEL_HI, r, 20)
            circle(c, color, (r.left + 18, r.centery), 5)
            rich_text(c, self.fonts, self.fonts.body, msg, (r.left + 30, r.centery), TEXT, "midleft", maxw=w - 44)
            y -= 48


# ------------------------------------------------------------------ screens

class Screen:
    def __init__(self, app):
        self.app = app
        self.f = app.fonts

    def enter(self):
        pass

    def crumbs(self):
        return []

    def trail(self, *more):
        """Crumbs that follow the way here: the screen below's, then ours."""
        st = self.app.stack
        i = next((k for k, s in enumerate(st) if s is self), len(st))
        return (st[i - 1].crumbs() if i > 0 else []) + list(more)

    def hints(self):
        return [("A", "Select"), ("B", "Back")]

    def action(self, a):
        if a == "back":
            self.app.pop()

    def draw(self, c):
        pass

    load_error = None               # why the screen's list couldn't load: drawn instead of "nothing here"
    LOAD_ERROR_HEAD = "Couldn't load this list"

    def load_failed(self, attr):
        """The err callback of a list load: an empty list, and the reason kept so
        draw() says what went wrong instead of a reassuring "nothing here"."""
        def failed(e):
            self.load_error = str(e) or e.__class__.__name__
            setattr(self, attr, [])
            self.app.toast(self.load_error, RED)
        return failed

    def draw_load_error(self, c, y=86):
        """True (and drawn) when the last load failed."""
        if not self.load_error:
            return False
        text(c, self.f.h3, self.LOAD_ERROR_HEAD, (56, y), RED)
        text(c, self.f.body, "%s. Go back and open it again to try once more." % self.load_error.rstrip("."),
             (56, y + 38), DIM, maxw=W - 112)
        return True

    def tap_row(self, i):
        """Touch: first tap selects (detail panels update), second opens."""
        if getattr(self, "sel", None) == i:
            self.action("ok")
        else:
            self.sel = i

    def tap_now(self, i):
        """Touch: select and open in one tap (menus, settings, tiles)."""
        self.sel = i
        self.action("ok")


class ListScreen(Screen):
    """A list of rows: sel/scroll, up/down a row, L/R a page, the visible
    window (scroll follows sel when drawn) and each row's tap target.
    `base`: tiles above the list, which sel counts first. All state here is
    class attributes: no __init__ or action/draw of its own, so a screen
    that skips its parents' __init__ or action still works."""
    ROWS, ROW_H = 9, 56
    STEP = None                  # L/R page step when it isn't ROWS (not PAGE: GameList's is its fetch size)
    base = 0
    sel = scroll = 0

    def listed(self):
        """The rows; a screen keeping them elsewhere overrides this."""
        return getattr(self, "items", None) or []

    def clamp(self, scroll=False):
        """After a reload: sel onto the last row if the list got shorter
        (and, with scroll, the window back over it at once)."""
        self.sel = max(0, min(self.sel, self.base + len(self.listed()) - 1))
        if scroll:
            self.scroll = min(self.scroll, self.sel)

    def move(self, d):
        self.sel = max(self.base, min(self.base + len(self.listed()) - 1, self.sel + d))

    def nav(self, a):
        """up/down a row, L/R and left/right a page, L2/R2 to the previous or
        next letter (or system) in a list with jumps; False when `a` isn't
        one of them or nothing's listed."""
        step = self.STEP or self.ROWS
        d = {"up": -1, "down": 1, "l1": -step, "r1": step, "left": -step, "right": step}.get(a)
        if not self.listed():
            return False
        if a in ("l2", "r2") and self.JUMP:
            if not self.jump(a == "r2") and len(self.letter_starts()) < 2 and self.JUMP_OFF:
                self.app.toast(self.JUMP_OFF)
            return True
        if d is None:
            return False
        self.move(d)
        return True

    # -- L2/R2: letters in a list sorted by name, systems in one grouped by system
    JUMP = None                  # the hint ("A–Z", "System"); None: no jumps
    JUMP_OFF = None              # said when the list isn't in an order that jumps right now
    BUBBLE_AT = (W // 2, H // 2)
    bubble, bubble_until = None, 0.0

    def jump_label(self, row):
        """The run a row belongs to; None while the list isn't in an order that jumps."""
        return letter_of(row.get("name"))

    def letter_starts(self):
        """[(sel, label)] where each run of rows with the same label starts.
        Kept per list (and sort): hints() asks every frame."""
        rows = self.listed()
        key = (id(rows), len(rows), getattr(self, "sort", None))
        got = self.__dict__.get("_starts")
        if got and got[0] == key:
            return got[1]
        out = []
        for i, r in enumerate(rows):
            lab = self.jump_label(r) if r is not None else None
            if lab is None:
                out = []
                break
            if not out or out[-1][1] != lab:
                out.append((i + self.base, lab))
        self.__dict__["_starts"] = (key, out)
        return out

    def jump(self, forward):
        """To the first row of the next/previous run, put at the top of the list."""
        hit = letter_jump(self.letter_starts(), self.sel, forward)
        if hit:
            self.sel = hit[0]
            self.scroll = max(0, min(hit[0] - self.base, len(self.listed()) - self.ROWS))
            self.bubble, self.bubble_until = hit[1], time.time() + 0.7
        return hit

    def draw_bubble(self, c):
        draw_bubble(c, self.f, self.bubble, self.bubble_until, self.BUBBLE_AT)

    def list_hints(self, *own, back="Back"):
        """A list's hint bar: its own buttons (while picking, A and X say what
        they do then), L2/R2 and L/R when they do something here, then B."""
        own = list(own)
        if self.picking or self.PICK_ALWAYS:
            n = self.pick_count()
            own = [("A", "Pick"), ("X", "%d picked" % n if n else "Menu")] + \
                [h for h in own if h[0] not in ("A", "X")]
            if not self.PICK_ALWAYS:
                back = "Stop picking"
        n = len(self.listed())
        if self.JUMP and n and len(self.letter_starts()) > 1:
            own.append(("L2 R2", self.JUMP))
        if n > self.ROWS:
            own += [("L", "Page up"), ("R", "Page down")]
        return own + [("B", back)]

    # -- picking several rows: one scheme on every list that acts on more than
    # one. X opens the list's menu, where "Pick several" starts picking. While
    # picking, A picks or unpicks the row and moves on, X opens the menu (what
    # to do with the picks first), B stops (the picks stay ticked until they're
    # used or cleared). Deleting or cancelling picks still asks first.
    PICKS = False                # this list can pick rows
    PICK_ALWAYS = False          # a list that's only for picking (Free up space): A always picks, B goes back
    PICK_ALL = True              # "Pick all" in the menu (not on game lists: RomM-sized)
    PICK_WHAT = "rows"           # "Pick several <what>"
    picking = False

    @property
    def picks(self):
        """pick_key -> row of the picked rows (made on first use: no __init__ here)."""
        return self.__dict__.setdefault("_picks", {})

    def pick_key(self, row):
        return row["path"]

    def pickable(self, row):
        return True

    def unpickable_why(self, row):
        return "This one can't be picked"

    def picked(self):
        """The picked rows still listed, in list order."""
        p = self.picks
        return [r for r in self.listed() if r is not None and self.pick_key(r) in p] if p else []

    def pick_count(self):
        return len(self.picked())

    def showing_picks(self):
        return self.PICKS and (self.picking or self.PICK_ALWAYS or bool(self.picks))

    def toggle_pick(self, move=True):
        rows, i = self.listed(), self.sel - self.base
        if not 0 <= i < len(rows) or rows[i] is None:
            return
        r = rows[i]
        k = self.pick_key(r)
        if k in self.picks:
            del self.picks[k]
        elif self.pickable(r):
            self.picks[k] = r
        else:
            self.app.toast(self.unpickable_why(r), AMBER)
        if move:
            self.move(1)

    def pick_all(self):
        """Pick every row that can be (all picked already: clear them)."""
        rows = [r for r in self.listed() if r is not None and self.pickable(r)]
        if rows and len(self.picked()) == len(rows):
            self.picks.clear()
        else:
            self.picks.update((self.pick_key(r), r) for r in rows)

    def pick_action(self, a):
        """X: the list's menu; while picking, A picks and B stops. False when
        `a` isn't one of those here."""
        if a == "x":
            self.open_menu()
        elif a == "ok" and (self.picking or self.PICK_ALWAYS):
            self.toggle_pick()
        elif a == "back" and self.picking and not self.PICK_ALWAYS:
            self.picking = False
        else:
            return False
        return True

    def tap_row(self, i):
        """Touch while picking: one tap picks or unpicks the row."""
        if self.picking or self.PICK_ALWAYS:
            self.sel = i
            self.toggle_pick(move=False)
        else:
            super().tap_row(i)

    def pick_entries(self, rows):
        """Menu rows for what to do with the picked rows (the screen's)."""
        return []

    def list_actions(self):
        """Menu rows acting on the whole list (the screen's)."""
        return []

    def list_controls(self):
        """Menu rows that change the list in place: sort, filters (the screen's)."""
        return []

    def menu_title(self):
        n = self.pick_count()
        return "%d picked" % n if n else (self.crumbs() or [""])[-1]

    def menu_entries(self):
        """What to do with the picks, the whole-list actions, picking itself,
        then (below a line) what changes the list in place."""
        rows = self.picked()
        e = self.pick_entries(rows) if rows else []
        e += self.list_actions()
        if self.PICKS:
            if self.picking and not self.PICK_ALWAYS:
                e.append(("Stop picking", "", lambda: setattr(self, "picking", False)))
            elif not self.PICK_ALWAYS:
                e.append(("Pick several %s" % self.PICK_WHAT, "Then {A} picks, {X} acts on the picks, {B} stops",
                          lambda: setattr(self, "picking", True)))
            can = [r for r in self.listed() if r is not None and self.pickable(r)] if self.PICK_ALL else []
            if can and len(rows) < len(can):
                e.append(("Pick all %d" % len(can), "", lambda: (self.pick_all(), setattr(self, "picking", True))))
            if rows:
                e.append(("Clear picks", "", self.picks.clear))
        ctl = self.list_controls()
        return e + ([None] + ctl if ctl else [])

    def open_menu(self):
        e = self.menu_entries()
        if e:
            self.app.modal = ActionMenu(self.app, self.menu_title(), e, refresh=self.menu_entries)

    def draw_pick(self, c, row, center):
        """A row's tick box while picks show; True when drawn (it takes the
        place of the row's own dot or icon)."""
        if not self.showing_picks():
            return False
        x, y = center
        on = self.pick_key(row) in self.picks
        rrect(c, ACCENT if on else LINE, (x - 9, y - 9, 18, 18), 4, 0 if on else 2)
        if on:
            polyline(c, TEXT, [(x - 4, y), (x - 1, y + 3), (x + 4, y - 3)], 2)
        return True

    def visible(self, rows=None):
        """The indexes on screen, after scrolling so sel's row is one of them."""
        rows = rows or self.ROWS
        k = max(0, self.sel - self.base)
        if k < self.scroll:
            self.scroll = k
        elif k >= self.scroll + rows:
            self.scroll = k - rows + 1
        return range(self.scroll, min(len(self.listed()), self.scroll + rows))

    def tile_nav(self, a, wrap=False):
        """The `base` tiles above the rows: left/right among them (wrap: past
        the end to the other side), down into the rows, up from the first row
        to tile 0 (on a tile: stays), L/R and left/right page only in the
        rows. False when `a` isn't one of those here."""
        b, n = self.base, len(self.listed())
        if a in ("left", "right") and self.sel < b:
            d = 1 if a == "right" else -1
            self.sel = (self.sel + d) % b if wrap else max(0, min(b - 1, self.sel + d))
        elif a == "down" and n:
            self.sel = b if self.sel < b else min(b - 1 + n, self.sel + 1)
        elif a == "up":
            self.sel = 0 if self.sel == b else max(0, self.sel - 1) if self.sel > b else self.sel
        elif a in ("l1", "r1", "left", "right") and self.sel >= b:
            step = self.STEP or self.ROWS
            self.sel = max(b, min(b - 1 + n, self.sel + (step if a in ("r1", "right") else -step)))
        else:
            return False
        return True

    def row_rects(self, y, x=48, w=None, gap=4, rows=None, tap=None):
        """(i, rect, on) for each visible row from y down, its tap target
        (tap_row unless given, at i + base) registered before it's drawn."""
        for i in self.visible(rows):
            r = pygame.Rect(x, y + (i - self.scroll) * self.ROW_H, w or W - 96, self.ROW_H - gap)
            self.app.hit(r, lambda i=i: (tap or self.tap_row)(i + self.base))
            yield i, r, i + self.base == self.sel


class HomeScreen(Screen):
    ITEMS = [("search", "Search", "Find any game across every platform"),
             ("platforms", "Platforms", "Browse by console"),
             ("collections", "Collections", "Series, Top-N lists and themes"),
             ("recent", "Recently added", "Newest games in the library"),
             ("downloads", "Downloads", "Queue and progress"),
             ("installed", "On this box", "Your games, space, BIOS files and checks"),
             ("settings", "Settings", "Server, controller, downloads, compression"),
             ("exit", "Exit", "Back to EmulationStation")]

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.free = None

    def enter(self):
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
            self.free = st.f_bavail * st.f_frsize
        except OSError:
            self.free = None

    def hints(self):
        return [("A", "Select"), ("B", "Exit")]

    def action(self, a):
        if a == "up":
            self.sel = (self.sel - 1) % len(self.ITEMS)
        elif a == "down":
            self.sel = (self.sel + 1) % len(self.ITEMS)
        elif a == "back":
            self.app.request_quit()
        elif a == "ok":
            key = self.ITEMS[self.sel][0]
            app = self.app
            if key == "exit":
                app.request_quit()
            elif key == "settings":
                app.push(SettingsScreen(app))
            elif key == "installed":
                app.push(OnThisBoxScreen(app))
            elif not app.platforms and key not in ("downloads",):
                app.load_platforms()
                msg = app.error or ("No RomM platform maps to a Batocera system"
                                    if app.loaded else "Still loading platforms…")
                app.toast(msg, AMBER)
            elif key == "search":
                app.push(SearchScreen(app))
            elif key == "platforms":
                app.push(PlatformScreen(app))
            elif key == "collections":
                app.push(CollectionScreen(app))
            elif key == "recent":
                app.push(GameListScreen(app, "Recently added", order_by="id_desc"))
            elif key == "downloads":
                app.push(DownloadsScreen(app))

    def draw(self, c):
        y = 84
        for i, (key, label, sub) in enumerate(self.ITEMS):
            r = pygame.Rect(48, y, 520, 64)
            self.app.hit(r, lambda i=i: self.tap_now(i))
            on = i == self.sel
            if on:
                focus_box(c, r, 14)
            else:
                rrect(c, PANEL, r, 14)
            text(c, self.f.h2, label, (r.left + 28, r.top + 8), TEXT if on else DIM)
            extra = ""
            if key == "downloads":
                n = self.app.downloader.active_count()
                extra = (", %d running" % n) if n else ""
            text(c, self.f.small, sub + extra, (r.left + 28, r.top + 38), DIM if on else FAINT)
            y += 71
        # right panel: a shelf of the newest box art — the library's own face
        p = pygame.Rect(616, 84, 616, 558)
        rrect(c, PANEL, p, 16)
        app = self.app
        if app.platforms:
            total = sum(pl["rom_count"] for pl in app.platforms)
            text(c, self.f.h2, "Recently added", (p.left + 28, p.top + 22), TEXT)
            text(c, self.f.small, "{:,} games on {} platforms".format(total, len(app.platforms)),
                 (p.right - 28, p.top + 28), FAINT, "topright")
            self.load_recent()
            cw, ch, gap = 128, 172, 16
            x0 = p.left + (p.width - (4 * cw + 3 * gap)) // 2
            for k, rom in enumerate((self.recent or [])[:8]):
                cr = pygame.Rect(x0 + (k % 4) * (cw + gap), p.top + 70 + (k // 4) * (ch + gap), cw, ch)
                img = app.cover(rom)
                if img:
                    sc = self.shelf.get(rom["id"])
                    if sc is None or sc[0] != id(img):
                        pc = SR(cr)
                        iw, ih = img.get_size()
                        f = max(pc.width / iw, pc.height / ih)      # fill the slot, crop overflow
                        scaled = smooth_scale(img, (max(1, int(iw * f)), max(1, int(ih * f))))
                        crop = pygame.Rect(0, 0, pc.width, pc.height)
                        crop.center = scaled.get_rect().center
                        # the crop and the cover's id, not the cover: an evicted cover is freed
                        sc = (id(img), scaled.subsurface(crop.clip(scaled.get_rect())).copy())
                        if len(self.shelf) > 24:
                            self.shelf.clear()
                        self.shelf[rom["id"]] = sc
                    c.blit(sc[1], SR(cr).topleft)
                else:
                    rrect(c, BG2, cr, 8)
                    for j, ln in enumerate(wrap(self.f.small, rom.get("name") or "", cw - 16, 4)):
                        text(c, self.f.small, ln, (cr.left + 8, cr.top + 10 + j * 20), FAINT)
            if self.recent == []:
                text(c, self.f.body, "Nothing new yet.", (p.left + 28, p.top + 80), DIM)
        elif app.error:
            text(c, self.f.h2, "Can't reach RomM", (p.left + 28, p.top + 22), RED)
            for i, line in enumerate(wrap(self.f.body, app.error, p.width - 56, 4)):
                text(c, self.f.body, line, (p.left + 28, p.top + 66 + i * 26), DIM)
            text(c, self.f.small, rommlib.display_url(app.cfg["url"]) or "No server set",
                 (p.left + 28, p.top + 180), FAINT)
            text(c, self.f.small, "Check Settings, then select any item to retry.",
                 (p.left + 28, p.top + 206), FAINT)
        else:
            text(c, self.f.h2, "Loading…", (p.left + 28, p.top + 22), DIM)
        # panel foot: this box and the server, as plain sentences
        hline(c, LINE, (p.left + 28, p.bottom - 74), (p.right - 28, p.bottom - 74))
        if self.free is not None:
            text(c, self.f.h3, "%s free on this box" % human_size(self.free),
                 (p.left + 28, p.bottom - 38), TEXT, "midleft")
        u = rommlib.display_url(app.cfg["url"]) or "No server set"
        insecure = u.lower().startswith("http://")
        text(c, self.f.small, u if insecure else u.split("://")[-1], (p.right - 28, p.bottom - 38),
             AMBER if insecure else DIM, "midright", maxw=270)

    recent = None
    shelf = None

    def load_recent(self):
        if self.recent is not None or getattr(self, "_recent_loading", False):
            return
        self._recent_loading = True
        app = self.app
        self.shelf = {}
        p = {"limit": 8, "offset": 0, "order_by": "id", "order_dir": "desc",
             "with_char_index": "false", "with_filter_values": "false", "with_rom_id_index": "false",
             "platform_ids": [pl["id"] for pl in app.platforms]}
        app.bg(lambda: app.api.get("/api/roms", p).get("items", []),
               lambda items: setattr(self, "recent", items),
               lambda e: setattr(self, "recent", []))


class PlatformScreen(Screen):
    COLS, CW, CH, GAP = 4, 284, 98, 14

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.scroll = 0
        app.bg(rommlib.es_counts, lambda n: setattr(app, "es_count", n), lambda e: None)

    def crumbs(self):
        return ["Platforms"]

    def action(self, a):
        n = len(self.app.platforms)
        if not n:
            return super().action(a)
        moves = {"left": -1, "right": 1, "up": -self.COLS, "down": self.COLS,
                 "l1": -self.COLS * 4, "r1": self.COLS * 4}
        if a in moves:
            self.sel = max(0, min(n - 1, self.sel + moves[a]))
        elif a == "ok":
            p = self.app.platforms[self.sel]
            self.app.push(GameListScreen(self.app, p.get("display_name") or p["name"],
                                         platform=p))
        elif a == "y":
            self.app.push(SearchScreen(self.app, platform=self.app.platforms[self.sel]))
        else:
            super().action(a)

    def hints(self):
        return [("A", "Open"), ("Y", "Search platform"), ("L", "Page up"),
                ("R", "Page down"), ("B", "Back")]

    def draw(self, c):
        plats = self.app.platforms
        x0, y0 = 48, 88
        rows_vis = 5
        row = self.sel // self.COLS
        if row < self.scroll:
            self.scroll = row
        elif row >= self.scroll + rows_vis:
            self.scroll = row - rows_vis + 1
        for i, p in enumerate(plats):
            r_i, c_i = divmod(i, self.COLS)
            if not (self.scroll <= r_i < self.scroll + rows_vis):
                continue
            r = pygame.Rect(x0 + c_i * (self.CW + self.GAP),
                            y0 + (r_i - self.scroll) * (self.CH + self.GAP), self.CW, self.CH)
            self.app.hit(r, lambda i=i: self.tap_now(i))
            on = i == self.sel
            rrect(c, PANEL_HI if on else PANEL, r, 14)
            if on:
                rrect(c, ACCENT, r, 14, 2)
            name = p.get("display_name") or p["name"]
            lines = wrap(self.f.h3, name, r.width - 36, 2)
            for k, ln in enumerate(lines):
                text(c, self.f.h3, ln, (r.left + 18, r.top + 14 + k * 24), TEXT if on else DIM)
            tag = "roms/" + p["_system"]
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - tw - 14, r.bottom - 30, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, FAINT, "center")
            room = tr.left - 10                   # the left side never runs into the tag
            games = "{:,} games".format(p["rom_count"])
            if r.left + 18 + measure(self.f.small, games) > room:
                games = "{:,}".format(p["rom_count"])
            text(c, self.f.small, games, (r.left + 18, r.bottom - 28), DIM if on else FAINT)
            here = self.app.es_count.get(p["_system"])
            hx = r.left + 18 + measure(self.f.small, games) + 16
            if here and hx + 11 + measure(self.f.small, "{:,}".format(here)) <= room:
                installed_mark(c, (hx, r.bottom - 19), 7)     # games EmulationStation lists there
                text(c, self.f.small, "{:,}".format(here), (hx + 11, r.bottom - 28), GREEN)
        # scrollbar
        total_rows = (len(plats) + self.COLS - 1) // self.COLS
        if total_rows > rows_vis:
            track = pygame.Rect(W - 20, y0, 4, rows_vis * (self.CH + self.GAP) - self.GAP)
            rrect(c, LINE, track, 2)
            h = max(30, track.height * rows_vis // total_rows)
            yy = track.top + (track.height - h) * self.scroll // (total_rows - rows_vis)
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)


def letter_of(name):
    """Jump-bucket for a title: A–Z, '#' for digits/symbols, else the first
    character itself (kana/kanji/hangul get their own buckets)."""
    for ch in (name or ""):
        if ch.isspace() or ch in "'\"[(~.!¡¿-_*":
            continue
        if ch.isdigit():
            return "#"
        if "a" <= ch.lower() <= "z":
            return ch.upper()
        return ch if ch.isalpha() else "#"
    return "#"


def letter_jump(starts, sel, forward):
    """starts: sorted [(index, label)]. Next/previous letter from sel; going
    back from inside a letter first returns to that letter's start."""
    if not starts:
        return None
    g = max((k for k, (i, _) in enumerate(starts) if i <= sel), default=0)
    if forward:
        return starts[g + 1] if g + 1 < len(starts) else None
    if sel > starts[g][0]:
        return starts[g]
    return starts[g - 1] if g > 0 else None


def draw_bubble(c, f, label, until, center):
    if label and time.time() < until:
        r = pygame.Rect(0, 0, max(120, int(measure(f.h1, label)) + 48), 120)    # a system name is wider
        r.center = center
        rrect(c, ACCENT, r, 24)
        text(c, f.h1, label, r.center, TEXT, "center")


KNOWN_KINDS = re.compile(r"^(top\s*\d+|theme|series)$", re.I)
VIRTUAL_TYPES = [("genre", "Genre"), ("franchise", "Franchise"), ("collection", "Series"),
                 ("company", "Company"), ("mode", "Game mode")]


def collection_kinds(names):
    """Prefixes ("Theme" in "Theme: Hidden Gems") that are real categories:
    a known word, or shared by 3+ collections. Anything else stays part of
    the name, so "Lorem: Best Of" isn't split into a tag."""
    counts = {}
    for n in names:
        if ":" in n:
            k = n.split(":", 1)[0].strip()
            counts[k.lower()] = counts.get(k.lower(), 0) + 1
    return {k for k, c in counts.items() if c >= 3 or KNOWN_KINDS.match(k)}


class CollectionScreen(ListScreen):
    """Top level: the user's collections (grouped by kind when the names use
    a "Kind: Name" convention), smart collections, and "Browse by" entries
    for RomM's virtual collections. With `vtype` set: one virtual type's list."""
    ROWS, ROW_H = 10, 54

    def __init__(self, app, vtype=None, vlabel=None):
        super().__init__(app)
        self.vtype, self.vlabel = vtype, vlabel
        self.items = None
        self.sel = 0
        self.scroll = 0
        self.here = {}                      # (param, id) -> games of that collection on this box
        if vtype:
            app.bg(lambda: app.api.virtual_collections(vtype), self._loaded_virtual,
                   lambda e: self._failed(e))
        else:
            app.bg(self._load_top, self._loaded_top, lambda e: self._failed(e))

    def _failed(self, e):
        self.load_failed("items")(e)

    def enter(self):
        self.here = {}                      # back from a list: downloads/deletes may have changed it

    def count_here(self, it):
        """How many of a collection's games are on this box: the same test as
        the green tick in its list (our installs, and games copied over by
        hand, matched by file name). Fetches the collection's games."""
        app, n = self.app, 0
        for r in app.api.roms_all(collection=(it["param"], it["id"])):
            pl = app.platform_by_id.get(r.get("platform_id"))
            if pl and app.library.is_installed(r, pl["_system"]):
                n += 1
        return n

    def _want_here(self, it):
        """Count a visible collection's games on the box, one at a time, in the background."""
        key = (it.get("param"), it.get("id"))
        if not it.get("id") or key in self.here or getattr(self, "_here_busy", False) \
                or not self.app.platform_by_id:
            return
        self._here_busy = True

        def done(n):
            self.here[key] = n
            self._here_busy = False

        def failed(e):
            self.here[key] = None
            self._here_busy = False
        self.app.bg(lambda: self.count_here(it), done, failed)

    def _load_top(self):
        api = self.app.api
        regular = api.collections()
        try:
            smart = api.smart_collections()
        except rommlib.RommError:
            smart = []            # older RomM without smart collections
        return regular, smart

    def _loaded_top(self, res):
        regular, smart = res
        kinds = collection_kinds([c["name"] for c in regular])
        items = []
        for c in regular:
            if not c.get("rom_count"):
                continue
            name, kind = c["name"], ""
            if ":" in name and name.split(":", 1)[0].strip().lower() in kinds:
                kind, name = [x.strip() for x in name.split(":", 1)]
            group = "Top lists" if re.match(r"top\s*\d+", kind, re.I) else \
                {"theme": "Themes", "series": "Series"}.get(kind.lower(), kind or "Your collections")
            items.append({"name": name, "tag": kind, "group": group, "count": c["rom_count"],
                          "full": c["name"], "param": "collection_id", "id": c["id"]})
        order = {"Top lists": 0, "Themes": 1, "Series": 2}
        items.sort(key=lambda i: (order.get(i["group"], 3 if i["group"] != "Your collections" else 4),
                                  i["group"].lower(), i["name"].lower()))
        for c in sorted(smart, key=lambda c: c["name"].lower()):
            if c.get("rom_count"):
                items.append({"name": c["name"], "tag": "smart", "group": "Smart", "count": c["rom_count"],
                              "full": c["name"], "param": "smart_collection_id", "id": c["id"]})
        for vt, label in VIRTUAL_TYPES:
            items.append({"name": label, "tag": "", "group": "Browse by", "count": None,
                          "full": label, "vtype": vt})
        self.items = items

    def _loaded_virtual(self, cols):
        self.items = [{"name": c["name"], "tag": "", "group": self.vlabel, "count": c.get("rom_count"),
                       "full": c["name"], "param": "virtual_collection_id", "id": c["id"]}
                      for c in sorted(cols, key=lambda c: c["name"].lower()) if c.get("rom_count")]

    def groups(self):
        return [] if not self.items else list(dict.fromkeys(i["group"] for i in self.items))

    JUMP = "A–Z"

    def jump_label(self, it):
        """Letters only in a plain alphabetical list (a Browse-by list, or one group)."""
        return letter_of(it["name"]) if self.vtype or len(self.groups()) == 1 else None

    def action(self, a):
        if not self.items:
            return super().action(a)
        if a in ("left", "right") and len(self.groups()) > 1:       # left/right: groups, not pages
            gs = self.groups()
            gi = gs.index(self.items[self.sel]["group"])
            gi = max(0, min(len(gs) - 1, gi + (1 if a == "right" else -1)))
            self.sel = next(i for i, it in enumerate(self.items) if it["group"] == gs[gi])
        elif self.nav(a):
            return
        elif a == "ok":
            it = self.items[self.sel]
            if it.get("vtype"):
                self.app.push(CollectionScreen(self.app, it["vtype"], it["name"]))
            else:
                self.app.push(GameListScreen(self.app, it["full"], collection=it))
        elif a == "x" and not self.items[self.sel].get("vtype"):
            self.menu(self.items[self.sel])
        else:
            super().action(a)

    def menu(self, it):
        app = self.app
        n = it.get("count") or 0
        e = [("Open", "", lambda: app.push(GameListScreen(app, it["full"], collection=it)))]
        if n <= GameListScreen.BULK_MAX:
            e.append(("Download every game", "{:,} games, skipping any already on this box".format(n),
                      lambda: self.download_all(it)))
        else:
            e.append(("Download every game", "{:,} is more than 1,000: open it and filter first".format(n), None))
        app.modal = ActionMenu(app, it["full"], e)

    def download_all(self, it):
        app = self.app
        app.toast("Listing %s…" % it["full"])

        def collect():
            return app.api.roms_all(limit=250, cap=GameListScreen.BULK_MAX, collection=(it["param"], it["id"]))

        def listed(roms):
            if app.modal is not None or app.stack[-1] is not self:
                app.toast("List ready — press {X} on the collection again to download it", AMBER)
                return
            app.queue_many(roms, "Download %s?" % it["full"])
        app.bg(collect, listed, lambda e: app.toast(str(e), RED))

    def hints(self):
        h = [("A", "Open")]
        if self.items and not self.items[self.sel].get("vtype"):
            h.append(("X", "Download all"))
        return self.list_hints(*h)

    def crumbs(self):
        if self.vtype:
            return ["Collections", self.vlabel]
        if self.items and len(self.groups()) > 1:
            return ["Collections", self.items[self.sel]["group"]]
        return ["Collections"]

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Loading…", (W // 2, H // 2), DIM, "center")
            return
        if self.draw_load_error(c):
            return
        if not self.items:
            text(c, self.f.h2, "No collections", (W // 2, 300), DIM, "center")
            return
        rows = self.ROWS
        for i, r, on in self.row_rects(80, tap=self.tap_now):
            it = self.items[i]
            if i > self.scroll and it["group"] != self.items[i - 1]["group"]:
                hline(c, LINE, (64, r.top - 2), (W - 112, r.top - 2))
            if on:
                focus_box(c, r)
            here = self.here.get((it.get("param"), it.get("id")))
            right = 150 + (24 + int(measure(self.f.small, "{:,}".format(here))) if here else 0)
            tag = it["tag"]
            if tag:
                tw = int(measure(self.f.tiny, tag)) + 14
                tr = pygame.Rect(r.right - right - tw, r.centery - 10, tw, 20)
                rrect(c, BG2, tr, 6)
                text(c, self.f.tiny, tag, tr.center, FAINT, "center")
                right += tw + 16
            # full name: one line if it fits, else two smaller lines — never "…"
            name = it["name"]
            avail = r.width - 22 - right
            col_txt = TEXT if on else DIM
            if measure(self.f.row, name) <= avail:
                text(c, self.f.row, name, (r.left + 22, r.centery), col_txt, "midleft")
            else:
                lines = wrap(self.f.small, name, avail)
                fnt, lh = (self.f.small, 19) if len(lines) <= 2 else (self.f.tiny, 15)
                if len(lines) > 2:
                    lines = wrap(fnt, name, avail)
                y0 = r.centery - lh * len(lines) // 2
                for k, ln in enumerate(lines):
                    text(c, fnt, ln, (r.left + 22, y0 + k * lh), col_txt)
            cnt = ("{:,} game{}".format(it["count"], "" if it["count"] == 1 else "s")
                   if it["count"] is not None else "›")
            cr = text(c, self.f.small, cnt, (r.right - 20, r.centery), FAINT, "midright")
            self._want_here(it)
            if here:                                   # like the platform cards: green tick + count
                hr = text(c, self.f.small, "{:,}".format(here), (cr.left - 14, r.centery), GREEN, "midright")
                installed_mark(c, (hr.left - 11, r.centery), 7)
        n = len(self.items)
        if n > rows:
            track = pygame.Rect(W - 30, 80, 4, rows * self.ROW_H - 4)
            rrect(c, LINE, track, 2)
            h = max(24, track.height * rows // n)
            yy = track.top + int((track.height - h) * (self.sel / max(1, n - 1)))
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)


REGION_ABBR = {"USA": "US", "Europe": "EU", "Japan": "JP", "World": "World", "Australia": "AU",
               "Brazil": "BR", "Korea": "KR", "China": "CN", "Germany": "DE", "France": "FR",
               "Spain": "ES", "Italy": "IT", "UK": "UK", "Asia": "Asia"}


JUNK_MARKERS = ("~hack~", "~unlicensed~", "~prototype~", "~demo~", "~homebrew~", "(proto",
                "(beta", "(demo", "(sample", "(hack", "(pirate", "(unl)")


def rank_search(query, items):
    """RomM's search order is effectively alphabetical ('~Hack~', 'BS …' first).
    Re-rank the first page: real titles containing every query word, USA/World
    releases, Latin names first; hacks/protos/BS broadcasts last. Stable."""
    words = [w for w in query.lower().split() if w]

    def key(rom):
        name = (rom.get("name") or rom.get("fs_name_no_ext") or "").lower()
        fs = (rom.get("fs_name") or "").lower()
        score = 0
        if not all(w in name for w in words):
            score += 4
        if name.startswith(query.lower()) or name.startswith("the " + query.lower()):
            score -= 1
        if any(m in name or m in fs for m in JUNK_MARKERS):
            score += 6
        if any(_wide(ch) for ch in name):
            score += 3
        regions = [r.lower() for r in (rom.get("regions") or [])]
        if any(r in ("usa", "world") for r in regions):
            score -= 2
        elif any(r in ("europe", "uk", "australia") for r in regions):
            score -= 1
        return score
    return sorted(items, key=key)


class GameListScreen(ListScreen):
    PAGE = 60
    ROWS = 12
    ROW_H = 44

    REGION_CHOICES = [(None, "All regions"), (["USA", "World"], "USA + World"),
                      (["Europe", "World"], "Europe + World"), (["Japan"], "Japan")]
    BULK_MAX = 1000
    PICKS, PICK_ALL, PICK_WHAT = True, False, "games"
    JUMP, JUMP_OFF = "A–Z", "A–Z jump works in full lists sorted by name"
    BUBBLE_AT = (32 + 676 // 2, H // 2)

    def __init__(self, app, title, platform=None, collection=None, search=None,
                 order_by="name", static=None):
        super().__init__(app)
        self.static = static          # a fixed list (e.g. "More like this"): no paging/filters
        self.only_verified = False
        self.hide_junk = False
        self.title = title
        self.platform = platform
        self.collection = collection
        self.search = search
        self.order_by = order_by
        self.region_i = 0
        self.hide_installed = False
        self.bios = None              # [(missing, firmware)] RomM can supply
        self.reset()
        if platform and platform.get("_system"):
            app.bg(lambda: rommlib.bios_offer(app.api, platform["_system"], platform["id"]),
                   lambda offers: setattr(self, "bios", offers), lambda e: None)

    @property
    def regions(self):
        return self.REGION_CHOICES[self.region_i][0]

    @property
    def dense(self):
        # hiding installed games can't use sparse paging (offsets shift as rows
        # are filtered out), so that mode loads sequentially and filters
        return self.hide_installed

    def reset(self):
        # items is a sparse list (None = row not fetched yet) once total is known,
        # so jumping to a letter loads just that page, not everything before it
        self.items = []
        self.total = None
        self.load_error = None
        self.pending = set()
        self.failed = {}          # offset -> (retry after, failures)
        self.starts = []          # [(offset, letter)] from RomM's char_index
        self.sel = 0
        self.scroll = 0
        self.gen = getattr(self, "gen", 0) + 1
        self.bubble, self.bubble_until = None, 0.0
        self.server_off, self.server_total, self.exhausted = 0, None, False
        if self.static is not None:
            self.items = [r for r in self.static if not (self.hide_installed and self.installed(r))]
            self.total = self.server_total = len(self.items)
            self.exhausted = True
            return
        self.fetch_page(0)

    def crumbs(self):
        if self.static is not None:
            return ["More like this"]
        out = []
        if self.platform and not self.search:
            out.append("Platforms")
        elif self.collection:
            return ["Collections"]      # full name is shown (unclipped) in the list header
        if self.search:
            out.append("Search")
            if self.platform:
                out.append(self.platform.get("display_name") or self.platform["name"])
            out.append('"%s"' % self.search)
        else:
            out.append(self.title)
        return out

    @property
    def loading(self):
        return self.total is None

    def _pids(self):
        if self.platform:
            return [self.platform["id"]]
        if self.search or self.order_by == "id_desc":
            return [p["id"] for p in self.app.platforms]
        return None

    def _query(self, offset, limit, char_index=False):
        """One page from RomM with this list's filters (blocking)."""
        app, pids = self.app, self._pids()
        if self.order_by == "id_desc":
            p = {"offset": offset, "limit": limit, "with_char_index": "false",
                 "with_filter_values": "false", "with_rom_id_index": "false",
                 "order_by": "id", "order_dir": "desc", "platform_ids": pids}
            if self.regions:
                p["regions"], p["regions_logic"] = self.regions, "any"
            if self.only_verified:
                p["verified"] = "true"
            if self.hide_junk and app.junk:
                p["tags"], p["tags_logic"] = app.junk, "none"
            return app.api.get("/api/roms", p)
        return app.api.roms(platform_ids=pids, search=self.search, offset=offset, limit=limit,
                            order_by=self.order_by, char_index=char_index, regions=self.regions,
                            verified=self.only_verified,
                            exclude_tags=app.junk if self.hide_junk else None,
                            collection=(self.collection["param"], self.collection["id"])
                            if self.collection else None)

    def installed(self, rom):
        system = self.app.system_for(rom)
        return bool(system) and self.app.library.is_installed(rom, system)

    def letter_starts(self):
        return self.starts if not self.dense else []      # RomM's char_index: rows not loaded yet jump too

    def pick_key(self, rom):
        return rom["id"]

    def pickable(self, rom):
        return bool(self.app.system_for(rom)) and self.rom_status(rom)[0] != "installed"

    def unpickable_why(self, rom):
        return "Already on this box" if self.app.system_for(rom) else "No Batocera system for this platform"

    def picked(self):
        return list(self.picks.values())        # rows far from the cursor are dropped (forget_far): picks stay

    def fetch_page(self, offset):
        if self.static is not None:
            return
        if self.dense:
            return self._fetch_dense()
        if offset in self.pending:
            return
        if self.failed.get(offset, (0, 0))[0] > time.time():
            return                                 # failed a moment ago: back off
        self.pending.add(offset)
        app, gen = self.app, self.gen
        first = self.total is None
        want_ci = first and self.order_by == "name" and not self.search
        limit = 250 if self.search and offset == 0 else self.PAGE

        def done(page):
            if gen != self.gen:
                return
            self.pending.discard(offset)
            self.load_error = None
            total = page.get("total", len(page.get("items", [])))
            self.server_total = total
            if self.total is None or total != self.total:
                self.items = (self.items + [None] * total)[:total]
                self.total = total
            got = page.get("items", [])
            if self.search and offset == 0:
                got = rank_search(self.search, got)
            for k, rom in enumerate(got):
                if offset + k < total:
                    self.items[offset + k] = rom
            self.forget_far()
            self.refresh_menu()
            if want_ci and page.get("char_index"):
                merged = {}
                for ch, off in page["char_index"].items():
                    lab = letter_of(ch)
                    if off < total and (lab not in merged or off < merged[lab]):
                        merged[lab] = off
                self.starts = sorted((off, lab) for lab, off in merged.items())

        def err(e):
            if gen != self.gen:
                return
            self.pending.discard(offset)
            if self.total is None:
                self.total = 0
                self.load_error = str(e) or e.__class__.__name__     # not "No games found": it couldn't ask
            n = self.failed.get(offset, (0, 0))[1] + 1
            self.failed[offset] = (time.time() + min(60, 5 * 2 ** (n - 1)), n)
            if n == 1:
                app.toast(str(e), RED)             # once per page, not every retry
        app.bg(lambda: self._query(offset, limit, want_ci), done, err)

    def _fetch_dense(self):
        """Sequential pages, installed games filtered out, until there's a
        screenful past the cursor (or the list ends)."""
        if "dense" in self.pending or self.exhausted:
            return
        self.pending.add("dense")
        app, gen, off = self.app, self.gen, self.server_off

        def done(page):
            if gen != self.gen:
                return
            self.pending.discard("dense")
            got = page.get("items", [])
            self.server_total = page.get("total", 0)
            self.server_off = off + len(got)
            self.exhausted = not got or self.server_off >= self.server_total
            self.items.extend(r for r in got if not self.installed(r))
            self.total = len(self.items)
            self.refresh_menu()
            if not self.exhausted and len(self.items) < self.sel + 3 * self.ROWS:
                self._fetch_dense()

        def err(e):
            self.pending.discard("dense")
            self.exhausted = True
            self.total = len(self.items)
            app.toast(str(e), RED)
        app.bg(lambda: self._query(off, 120), done, err)

    KEEP_ROWS = 600     # rows kept either side of the cursor: RomM's records are ~16 KB each

    def forget_far(self):
        """Drop loaded pages far from the cursor (paging a 60,000-game platform
        end to end kept every record: ~1 GB); ensure() fetches them again on
        the way back. Only the sparse, page-addressed lists."""
        if self.static is not None or self.dense or len(self.items) <= 2 * self.KEEP_ROWS:
            return
        lo = max(0, (self.sel - self.KEEP_ROWS) // self.PAGE * self.PAGE)
        hi = (self.sel + self.KEEP_ROWS) // self.PAGE * self.PAGE + self.PAGE
        for start in range(0, len(self.items), self.PAGE):
            if (start + self.PAGE <= lo or start >= hi) and self.items[start] is not None:
                self.items[start:start + self.PAGE] = [None] * len(self.items[start:start + self.PAGE])

    def ensure(self, i):
        """Make sure the page holding row i is loaded (or loading)."""
        if self.static is not None:
            return
        if self.dense:
            if i >= len(self.items) - self.ROWS:
                self._fetch_dense()
            return
        if self.total is None or not (0 <= i < self.total):
            return
        start = (i // self.PAGE) * self.PAGE
        if any(r is None for r in self.items[start:start + self.PAGE]):
            self.fetch_page(start)

    # -- actions ------------------------------------------------------------
    def action(self, a):
        n = len(self.items)
        if self.nav(a):
            if a in ("l2", "r2"):
                self.ensure(self.sel)              # the letter's page (the top of the list now)
            self.ensure(self.sel + self.ROWS)
        elif self.pick_action(a):
            if a == "ok":
                self.ensure(self.sel + self.ROWS)
        elif a == "ok" and n and self.items[self.sel] is not None:
            rom = self.items[self.sel]
            if self.rom_status(rom)[0] == "installed":
                self.app.modal = ManageMenu(self.app, rom)
            else:
                self.app.modal = DownloadConfirm(self.app, rom)
        elif a == "y":
            self.app.push(SearchScreen(self.app, platform=self.platform))
        else:
            super().action(a)

    def open_menu(self):
        self.menu_rom = self.items[self.sel] if self.items and self.sel < len(self.items) else None
        super().open_menu()

    def menu_title(self):
        if self.static is not None or self.search:
            return self.title if self.static is not None else 'Results for "%s"' % self.search
        if self.collection:
            return self.collection.get("name") or self.title
        return self.title

    def pick_entries(self, roms):
        size = sum(r.get("fs_size_bytes") or 0 for r in roms)
        return [("Download %d picked" % len(roms), human_size(size), self._download_marked)]

    def list_actions(self):
        """Actions first (they close the menu); list_controls() change the
        list in place while the menu stays open."""
        e = []
        cur = getattr(self, "menu_rom", None)
        if cur is not None:
            e.append(("More like this", cur.get("name") or cur.get("fs_name_no_ext") or "",
                      lambda: self._more_like(cur)))
        tot = self.server_total
        if tot is None:
            e.append(("Download every game in this list", "Counting games…", None))
        elif tot:
            if tot <= self.BULK_MAX:
                e.append(("Download every game in this list",
                          "{:,} games, skipping any already on this box".format(tot), self._download_all))
            else:
                e.append(("Download every game in this list",
                          "{:,} is more than 1,000. Narrow it with the filters below.".format(tot), None))
        if self.platform:
            sy = self.platform["_system"]
            e.append(("Fill in game info for roms/%s" % sy,
                      "Covers, descriptions, manuals from RomM for games already here",
                      lambda: InfoDialog.start(self.app, [(sy, [self.platform["id"]])])))
        if self.bios:
            n = len(self.bios)
            e.append(("Get BIOS for %s" % (self.platform.get("display_name") or self.platform["_system"]),
                      "%d file%s from RomM, checksum-verified" % (n, "" if n == 1 else "s"), self._fetch_bios))
        return e

    def list_controls(self):
        e = []
        if self.static is None and not self.search and not self.collection:
            e.append(("Sort", "", lambda d=1: self._toggle_sort(),
                      "Newest first" if self.order_by == "id_desc" else "A to Z", "choice"))
        if self.static is None:
            e.append(("Region", "", self._cycle_region, self.REGION_CHOICES[self.region_i][1], "choice"))
        e.append(("Hide games on this box", "", self._toggle_hide, self.hide_installed, "switch"))
        if self.static is None:
            e.append(("Hide prototypes, demos and hacks", "", self._toggle_junk, self.hide_junk, "switch"))
            e.append(("Only checksum-verified dumps", "", self._toggle_verified, self.only_verified, "switch"))
        return e

    def refresh_menu(self):
        m = self.app.modal
        if isinstance(m, ActionMenu) and getattr(m.refresh, "__self__", None) is self:
            m.reload()

    def _more_like(self, rom):
        app = self.app
        name = rom.get("name") or rom.get("fs_name_no_ext")

        def done(roms):
            if not roms:
                app.toast("RomM has no similar games for %s" % name, AMBER)
                return
            app.push(GameListScreen(app, "Games like %s" % name, static=roms))
        app.bg(lambda: app.api.similar(rom["id"]), done)

    def _toggle_junk(self):
        app = self.app
        if not self.hide_junk and app.junk is None:
            def done(tags):
                app.junk = rommlib.junk_tags(tags)
                self.hide_junk = True
                self.reset()
                if app.stack[-1] is self:
                    self.refresh_menu()
            app.bg(app.api.all_tags, done)
            return
        self.hide_junk = not self.hide_junk
        self.reset()

    def _toggle_verified(self):
        self.only_verified = not self.only_verified
        self.reset()

    def _toggle_sort(self):
        self.order_by = "name" if self.order_by == "id_desc" else "id_desc"
        self.reset()

    def _toggle_hide(self):
        self.hide_installed = not self.hide_installed
        self.reset()

    def _cycle_region(self, step=1):
        self.region_i = (self.region_i + step) % len(self.REGION_CHOICES)
        self.reset()

    def _queue_many(self, roms, title):
        def picked():
            self.picks.clear()
            self.picking = False
        self.app.queue_many(roms, title, picked)

    def _download_marked(self):
        self._queue_many(self.picked(), "Download picked games?")

    def _download_all(self):
        app = self.app
        if self.static is not None:                # "More like this": exactly what's shown
            return self._queue_many([r for r in self.items if r], "Download this whole list?")
        app.toast("Listing every game…")

        def collect():
            out, off = [], 0
            while True:
                page = self._query(off, 250)
                got = page.get("items", [])
                out.extend(got)
                off += len(got)
                if not got or off >= page.get("total", 0) or off >= self.BULK_MAX:
                    return out
        def listed(roms):
            if app.modal is not None or app.stack[-1] is not self:
                app.toast("List ready — open the menu again to download it", AMBER)   # don't cover another dialog
                return
            self._queue_many(roms, "Download this whole list?")
        app.bg(collect, listed)

    def _fetch_bios(self):
        app, offers, system = self.app, self.bios, self.platform["_system"]

        def done(written):
            self.bios = [o for o in offers if o[0]["file"] not in written]
            app.toast("BIOS installed: %s" % ", ".join(os.path.basename(w) for w in written), GREEN)
        app.bg(lambda: rommlib.fetch_bios(app.api, offers, system), done)

    def hints(self):
        return self.list_hints(("A", "Download"), ("X", "Menu"), ("Y", "Search"))

    def rom_status(self, rom):
        return self.app.rom_status(rom)

    def draw(self, c):
        app = self.app
        lx, ly, lw = 32, 80, 676
        # list header
        if self.total is None:
            cnt = "Loading…"
        elif self.dense:
            cnt = "{:,}{} not on this box".format(self.total, "" if self.exhausted else "+")
        else:
            cnt = "{:,} games".format(self.total) if self.total else \
                "Couldn't load: %s" % self.load_error if self.load_error else "No games found"
        flt = [lab for on, lab in ((self.regions, self.REGION_CHOICES[self.region_i][1]),
                                   (self.picks, "%d picked" % len(self.picks))) if on]
        if flt:
            cnt = ", ".join(flt + [cnt])
        title = self.title if not self.search else 'Results for "%s"' % self.search
        if measure(self.f.h3, title) <= 520:
            text(c, self.f.h3, title, (lx + 8, ly + 4), TEXT)
        else:
            for k, ln in enumerate(wrap(self.f.small, title, 520)[:2]):
                text(c, self.f.small, ln, (lx + 8, ly - 2 + k * 18), TEXT)
        failed = not self.total and self.load_error
        text(c, self.f.small, cnt, (lx + lw - 8, ly + 8), RED if failed else FAINT, "topright",
             maxw=300 if failed else None)
        ly += 40
        multi_plat = self.platform is None
        for i, r, on in self.row_rects(ly, x=lx, w=lw):
            rom = self.items[i]
            if on:
                focus_box(c, r)
            if rom is None:
                self.ensure(i)
                text(c, self.f.row, "…", (r.left + 44, r.centery), FAINT, "midleft")
                continue
            st, j = self.rom_status(rom)
            ix = r.left + 24
            if st != "installed" and self.draw_pick(c, rom, (ix, r.centery)):
                pass
            elif st == "installed":
                installed_mark(c, (ix, r.centery))
            elif st == "active":
                frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
                circle(c, LINE, (ix, r.centery), 9, 2)
                if frac > 0:
                    arc(c, BLUE, (ix - 9, r.centery - 9, 18, 18),
                                    1.5708 - 6.2832 * frac, 1.5708, 3)
            elif st == "failed":
                circle(c, RED, (ix, r.centery), 9)
                text(c, self.f.tiny, "!", (ix, r.centery), BG, "center")
            else:
                circle(c, LINE, (ix, r.centery), 4)
            right_w = 0
            size = human_size(rom.get("fs_size_bytes"))
            sr = text(c, self.f.small, size, (r.right - 14, r.centery), FAINT if not on else DIM, "midright")
            right_w = sr.width + 14
            if multi_plat:
                p = app.platform_by_id.get(rom.get("platform_id"))
                tag = p["_system"] if p else rom.get("platform_slug") or "?"
                tw = int(measure(self.f.tiny, tag)) + 12
                tr = pygame.Rect(r.right - right_w - tw - 12, r.centery - 10, tw, 20)
                rrect(c, BG2 if p else mix(BG, RED, 0.22), tr, 6)
                text(c, self.f.tiny, tag, tr.center, FAINT, "center")
                right_w += tw + 12
            name = rom_title(rom)
            nr = text(c, self.f.row, name, (r.left + 44, r.centery), TEXT if on else DIM,
                      "midleft", maxw=r.width - 44 - right_w - 70)
            regions = rom.get("regions") or []
            if regions:
                rg = "/".join(REGION_ABBR.get(x, x[:3]) for x in regions[:2])
                text(c, self.f.tiny, rg, (nr.right + 8, r.centery + 1), FAINT, "midleft")
        if self.loading:
            text(c, self.f.body, "Loading…", (lx + lw // 2, ly + 120), DIM, "center")
        # scrollbar
        if self.total and self.total > self.ROWS:
            track = pygame.Rect(lx + lw + 6, ly, 4, self.ROWS * self.ROW_H - 4)
            rrect(c, LINE, track, 2)
            h = max(24, track.height * self.ROWS // self.total)
            yy = track.top + int((track.height - h) * (self.sel / max(1, self.total - 1)))
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)
        # detail panel
        if self.items and self.items[self.sel] is not None:
            self.draw_detail(c, self.items[self.sel])
        elif self.items:
            p = pygame.Rect(728, 80, 520, 576)
            rrect(c, PANEL, p, 16)
            text(c, self.f.body, "Loading…", p.center, DIM, "center")

    def draw_detail(self, c, rom):
        app = self.app
        p = pygame.Rect(728, 80, 520, 576)
        rrect(c, PANEL, p, 16)
        cov = pygame.Rect((p.left + 24, p.top + 24), COVER_BOX)
        img = app.cover(rom)
        if img:
            pc = SR(cov)
            sc = app.scaled_covers.get(rom["id"])
            if sc is None or sc[0] is not img:
                iw, ih = img.get_size()
                f = min(pc.width / iw, pc.height / ih)
                size = (max(1, int(iw * f)), max(1, int(ih * f)))
                sc = (img, img if abs(size[0] - iw) <= 1 and abs(size[1] - ih) <= 1 else smooth_scale(img, size))
                if len(app.scaled_covers) > 24:
                    app.scaled_covers.clear()
                app.scaled_covers[rom["id"]] = sc
            c.blit(sc[1], sc[1].get_rect(midtop=(pc.centerx, pc.top)))
        else:
            rrect(c, BG2, cov, 10)
            text(c, self.f.small, "no cover" if rom["id"] in app.covers and
                 app.covers[rom["id"]] is None else "…", cov.center, FAINT, "center")
        tx, tw = cov.right + 20, p.right - cov.right - 44
        y = p.top + 24
        title = rom_title(rom)
        tl = wrap(self.f.h3, title, tw)
        tf, lh = (self.f.h3, 25) if len(tl) <= 3 else (self.f.body, 22)
        for ln in wrap(tf, title, tw, 5):
            text(c, tf, ln, (tx, y), TEXT)
            y += lh
        y += 8
        md = rom.get("metadatum") or {}
        plat = app.platform_by_id.get(rom.get("platform_id"))
        year = ""
        if md.get("first_release_date"):
            year = time.strftime("%Y", time.gmtime(md["first_release_date"] / 1000))
        size, fmt = human_size(rom.get("fs_size_bytes")), ""
        lay = app.layout(rom)
        if lay:
            if lay["unpacked"]:
                size += " · %s%s unpacked" % ("~" if lay["estimated"] else "", human_size(lay["unpacked"]))
            fmt = ("%d discs, " % lay["discs"] if lay["discs"] > 1 else "") + lay["label"]
            if fmt and lay["convert"]:
                fmt += " (becomes %s)" % lay["convert"]        # Rubik has no arrow glyph
        facts = [
            ("Platform", (plat.get("display_name") or plat["name"]) if plat else
             (rom.get("platform_display_name") or "?")),
            ("Released", year),
            ("Genre", ", ".join((md.get("genres") or [])[:2])),
            ("Players", md.get("player_count") or ""),
            ("Size", size),
            ("Format", fmt),
            ("Achievements", ("%d · %d points" % ra) if (ra := rommlib.ra_summary(rom)) and ra[0] else ""),
            ("Manual", "Included" if rommlib.manual_path(rom) else ""),
        ]
        for k, v in facts:
            if not v:
                continue
            text(c, self.f.small, k, (tx, y), FAINT)
            text(c, self.f.cond, str(v), (tx, y + 17), DIM, maxw=tw)
            y += 42
        # summary
        sy = max(y, cov.bottom) + 18
        summ = rom.get("summary") or ""
        lines = wrap(self.f.small, summ, p.width - 48, max(1, (p.bottom - 110 - sy) // 20))
        for i, ln in enumerate(lines if summ else []):
            text(c, self.f.small, ln, (p.left + 24, sy + i * 20), DIM)
        # action area
        ar = pygame.Rect(p.left + 24, p.bottom - 76, p.width - 48, 52)
        self.app.hit(ar, lambda: self.action("ok"))
        st, j = self.rom_status(rom)
        system = app.system_for(rom)
        if not system:
            rrect(c, BG2, ar, 12)
            text(c, self.f.body, "No Batocera system for this platform", ar.center, FAINT, "center")
        elif self.picking and st != "installed":           # A picks here
            on = self.pick_key(rom) in self.picks
            rrect(c, BG2 if on else ACCENT, ar, 12)
            gx = ar.left + 18
            gx += button_glyph(c, self.f, "A", gx, ar.centery - 11) + 12
            text(c, self.f.h3, "Unpick" if on else "Pick", (gx, ar.centery), TEXT, "midleft")
            text(c, self.f.small, "%d picked" % self.pick_count(), (ar.right - 20, ar.centery), DIM, "midright")
        elif st == "installed":
            rrect(c, mix(BG, GREEN, 0.18), ar, 12)
            gx = ar.left + 18
            gx += button_glyph(c, self.f, "A", gx, ar.centery - 11) + 12
            text(c, self.f.h3, "On this box", (gx, ar.centery), GREEN, "midleft")
            text(c, self.f.small, "roms/" + system, (ar.right - 20, ar.centery), DIM, "midright")
        elif st == "active":
            rrect(c, BG2, ar, 12)
            frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
            label = j.state
            if j.state == rommlib.Job.DOWNLOADING:
                label = "Downloading %d%%, %s/s" % (frac * 100, human_size(j.speed))
            text(c, self.f.body, label, (ar.left + 18, ar.top + 10), TEXT)
            progress_bar(c, (ar.left + 18, ar.bottom - 16, ar.width - 36, 6), frac, BLUE)
        else:
            rrect(c, ACCENT, ar, 12)
            gx = ar.left + 18
            gx += button_glyph(c, self.f, "A", gx, ar.centery - 11) + 12
            msg = "Retry download" if st == "failed" else "Download"
            text(c, self.f.h3, msg, (gx, ar.centery), TEXT, "midleft")
            text(c, self.f.small, "to roms/" + system, (ar.right - 20, ar.centery), TEXT, "midright")
            yy = ar.top - 22
            if st == "failed":
                text(c, self.f.small, j.message, (ar.left, yy), RED, maxw=ar.width)
                yy -= 22
            var = self.variants(rom, system)
            if var:
                text(c, self.f.small, "Already here: " + var[0] + (" +%d more" % (len(var) - 1) if len(var) > 1 else ""),
                     (ar.left, yy), AMBER, maxw=ar.width)

    def variants(self, rom, system):
        """Other versions of this game on the box (cached per rom)."""
        cache = self.__dict__.setdefault("_variants", {})
        if rom["id"] not in cache:
            if len(cache) > 300:
                cache.clear()
            cache[rom["id"]] = self.app.library.variants(rom, system)
        return cache[rom["id"]]


class SearchScreen(Screen):
    ROWS = ["1234567890", "QWERTYUIOP", "ASDFGHJKL'", "ZXCVBNM-:&"]
    SPECIAL = [("Space", 3), ("Delete", 3), ("Clear", 2), ("Search", 2)]

    def __init__(self, app, platform=None):
        super().__init__(app)
        self.platform = platform
        self.query = ""
        self.r, self.c = 1, 0
        self.preview = []
        self.preview_total = None
        self.preview_q = None
        self.pending_at = None
        self.pick = None                  # the focused Top match; None: the keyboard has focus

    def crumbs(self):
        out = ["Search"]
        if self.platform:
            out.append(self.platform.get("display_name") or self.platform["name"])
        return out

    def hints(self):
        if self.pick is not None:
            return [("A", "Open"), ("B", "Keyboard")] + ([] if INPUT_MODE["kb"] else [("START", "Search")])
        if INPUT_MODE["kb"]:
            return [("TYPE", "Letters"), ("BKSP", "Delete"), ("A", "Search"), ("B", "Back")]
        return [("A", "Type"), ("X", "Delete"), ("Y", "Space"), ("START", "Search"), ("B", "Back")]

    def row_len(self, r):
        return len(self.ROWS[r]) if r < len(self.ROWS) else len(self.SPECIAL)

    def _type(self, s):
        self.query = (self.query + s)[:60]
        self.pending_at = time.time() + 0.45

    @property
    def text_entry(self):
        """A physical keyboard types here, except on the Top matches (Enter opens one)."""
        return self.pick is None

    def type_text(self, s):
        self.pick = None
        self._type(s)

    def tap_key(self, r, c):
        self.pick = None                  # a key tapped after a match was open types, not reopens it
        self.r, self.c = r, c
        self.action("ok")

    def open(self, rom):
        """A Top match: the manage menu for a game on the box (as in a game list), else download."""
        app = self.app
        app.modal = ManageMenu(app, rom) if app.rom_status(rom)[0] == "installed" else DownloadConfirm(app, rom)

    def tap_pick(self, i):
        self.pick = None                  # a tap opens it; focus stays with the keyboard
        self.open(self.preview[i])

    def pick_action(self, a):
        """Focus on the Top matches: up/down among them, left/right back to the
        keyboard row beside the focused one, B too."""
        n = len(self.preview[:8])
        if a in ("up", "down") and n:
            self.pick = max(0, min(n - 1, self.pick + (1 if a == "down" else -1)))
        elif a in ("left", "right", "back"):
            self.r = max(0, min(len(self.ROWS), round((58 * self.pick - 35) / 64)))
            self.c = 0 if a == "right" else self.row_len(self.r) - 1
            self.pick = None
        elif a == "ok" and n:
            self.open(self.preview[self.pick])
        elif a in ("start", "r1"):
            self.go()

    def action(self, a):
        if self.pick is not None:
            return self.pick_action(a)
        nrows = len(self.ROWS) + 1
        n = len(self.preview[:8])
        if a in ("left", "right") and n and self.c == (0 if a == "left" else self.row_len(self.r) - 1):
            self.pick = min(n - 1, round((35 + 64 * self.r) / 58))   # past the keyboard's edge: the matches beside it
        elif a == "up":
            self.r = (self.r - 1) % nrows
        elif a == "down":
            self.r = (self.r + 1) % nrows
        elif a == "left":
            self.c = (self.c - 1) % self.row_len(self.r)
        elif a == "right":
            self.c = (self.c + 1) % self.row_len(self.r)
        elif a == "x":
            self.query = self.query[:-1]
            self.pending_at = time.time() + 0.45
        elif a == "y":
            self._type(" ")
        elif a == "ok":
            if self.r < len(self.ROWS):
                self._type(self.ROWS[self.r][self.c].lower() if self.r else self.ROWS[self.r][self.c])
            else:
                key = self.SPECIAL[self.c][0]
                if key == "Space":
                    self._type(" ")
                elif key == "Delete":
                    self.query = self.query[:-1]
                    self.pending_at = time.time() + 0.45
                elif key == "Clear":
                    self.query = ""
                    self.preview = []
                    self.preview_total = None
                else:
                    self.go()
        elif a in ("start", "r1"):
            self.go()
        elif a == "back":
            self.app.pop()
        self.c = min(self.c, self.row_len(self.r) - 1)

    def go(self):
        q = self.query.strip()
        if len(q) < 2:
            self.app.toast("Type at least 2 characters", AMBER)
            return
        self.app.push(GameListScreen(self.app, "Search", platform=self.platform, search=q))

    def live_preview(self):
        if self.pending_at and time.time() >= self.pending_at:
            self.pending_at = None
            q = self.query.strip()
            if len(q) < 2:
                self.preview, self.preview_total = [], None
                return
            app = self.app
            pids = [self.platform["id"]] if self.platform else [p["id"] for p in app.platforms]

            def done(page, q=q):
                if q == self.query.strip():
                    self.preview = page.get("items", [])
                    self.preview_total = page.get("total")
                    if self.pick is not None:
                        self.pick = min(self.pick, len(self.preview[:8]) - 1) if self.preview else None
            def call():
                page = app.api.roms(platform_ids=pids, search=q, limit=250)
                page["items"] = rank_search(q, page.get("items", []))[:8]
                return page
            app.bg(call, done)

    own_start = True   # Start = run the search here, not "go Home"

    def draw(self, c):
        self.live_preview()
        # query field
        qf = pygame.Rect(48, 88, 640, 60)
        rrect(c, PANEL, qf, 14)
        rrect(c, ACCENT, qf, 14, 2)
        shown = self.query or ""
        r = text(c, self.f.h2, shown, (qf.left + 22, qf.centery), TEXT, "midleft", maxw=qf.width - 50)
        if not shown:
            text(c, self.f.h2, "Search " + ((self.platform.get("display_name") or self.platform["name"])
                                            if self.platform else "all games"),
                 (qf.left + 22, qf.centery), FAINT, "midleft", maxw=qf.width - 50)
            r = pygame.Rect(qf.left + 20, qf.top, 0, qf.height)
        if int(self.app.t * 2) % 2 == 0:
            hline(c, ACCENT_HI, (r.right + 3, qf.top + 16), (r.right + 3, qf.bottom - 16), 2)
        # keyboard
        kx, ky, kw, kh, gap = 48, 172, 58, 58, 6
        for ri, row in enumerate(self.ROWS):
            for ci, ch in enumerate(row):
                kr = pygame.Rect(kx + ci * (kw + gap), ky + ri * (kh + gap), kw, kh)
                self.app.hit(kr, lambda ri=ri, ci=ci: self.tap_key(ri, ci))
                on = (ri, ci) == (self.r, self.c) and self.pick is None
                rrect(c, ACCENT if on else PANEL, kr, 10)
                text(c, self.f.key, ch, kr.center, TEXT if on else DIM, "center")
        sy = ky + len(self.ROWS) * (kh + gap)
        sx = kx
        for ci, (label, span) in enumerate(self.SPECIAL):
            w = span * kw + (span - 1) * gap
            kr = pygame.Rect(sx, sy, w, kh)
            self.app.hit(kr, lambda ci=ci: self.tap_key(len(self.ROWS), ci))
            on = (self.r, self.c) == (len(self.ROWS), ci) and self.pick is None
            col = ACCENT if on else (PANEL_HI if label == "Search" else PANEL)
            rrect(c, col, kr, 10)
            text(c, self.f.h3, label, kr.center, TEXT if on or label == "Search" else DIM, "center")
            sx += w + gap
        # live results
        p = pygame.Rect(720, 88, 528, 568)
        rrect(c, PANEL, p, 16)
        text(c, self.f.h3, "Top matches", (p.left + 24, p.top + 20), DIM)
        if self.preview_total is not None:
            text(c, self.f.small, "{:,} total".format(self.preview_total),
                 (p.right - 24, p.top + 22), FAINT, "topright")
        y = p.top + 56
        if not self.preview:
            msg = "Start typing — results appear here." if len(self.query.strip()) < 2 else \
                ("Searching…" if self.preview_total is None or self.pending_at else "No matches")
            text(c, self.f.body, msg, (p.left + 24, y), DIM)
        for i, rom in enumerate(self.preview[:8]):
            self.app.hit((p.left + 12, y - 6, p.width - 24, 56), lambda i=i: self.tap_pick(i))
            if i == self.pick:
                focus_box(c, (p.left + 12, y - 6, p.width - 24, 56), 12)
            pl = self.app.platform_by_id.get(rom.get("platform_id"))
            text(c, self.f.row, rom_title(rom), (p.left + 24, y),
                 TEXT, maxw=p.width - 48)
            sr = text(c, self.f.small, pl["_system"] if pl else "?", (p.left + 24, y + 26), FAINT)
            text(c, self.f.small, human_size(rom.get("fs_size_bytes")), (sr.right + 16, y + 26), FAINT)
            y += 58
        if self.preview:
            rich_text(c, self.f, self.f.small, "Press {START} to see all results",
                      (p.left + 24, p.bottom - 34), ACCENT_HI)


class DownloadsScreen(ListScreen):
    """The queue in the order it runs, then finished downloads (newest
    first). A: per-download menu (reorder, pause, cancel, retry); X: pause
    or resume everything, and pick several to pause, resume, cancel, retry
    or remove at once; Y clears the finished ones."""
    ROWS, ROW_H = 7, 76
    PICKS, PICK_WHAT = True, "downloads"

    def __init__(self, app):
        super().__init__(app)
        self.sel = self.scroll = 0

    def crumbs(self):
        return ["Downloads"]

    def listed(self):
        return self.view()

    def view(self):
        d = self.app.downloader
        jobs = list(d.jobs)
        pend = [j for j in jobs if j.active or j.state == rommlib.Job.PAUSED]
        return pend + [j for j in reversed(jobs) if j not in pend]

    def hints(self):
        d = self.app.downloader
        h = [("A", "Options"), ("X", "Menu")] if d.jobs else []
        if any(not (j.active or j.state == rommlib.Job.PAUSED) for j in d.jobs):
            h.append(("Y", "Clear finished"))
        return self.list_hints(*h + [("L2 R2", "Conversions")])

    def pick_key(self, j):
        return (j.rom.get("id"), j.system)

    def list_actions(self):
        d, app = self.app.downloader, self.app
        e = []
        if d.pending_count():
            if d.hold:
                e.append(("Resume all", "", lambda: (d.release_all(), app.toast("Downloads resumed", GREEN))))
            else:
                e.append(("Pause all", "The partial files are kept", lambda: (
                    d.hold_all(), app.toast("Downloads paused — partial files are kept", AMBER))))
        if any(not (j.active or j.state == rommlib.Job.PAUSED) for j in d.jobs):
            e.append(("Clear finished", "Done, failed and cancelled ones leave the list", self.clear_finished))
        return e

    def clear_finished(self):
        n = self.app.downloader.clear_finished()
        if n:
            self.app.toast("Cleared %d finished" % n)

    def pick_entries(self, jobs):
        """Pause, resume, cancel, retry or remove the picked downloads (each
        only those it applies to); cancelling asks first."""
        app, d, J = self.app, self.app.downloader, rommlib.Job
        live = [j for j in jobs if j.active and j.state != J.PAUSED]
        paused = [j for j in jobs if j.state == J.PAUSED]
        again = [j for j in jobs if j.state in (J.FAILED, J.CANCELLED)]
        over = [j for j in jobs if not (j.active or j.state == J.PAUSED)]

        def each(fn, todo, msg):
            def run():
                for j in todo:
                    fn(j)
                self.picks.clear()
                self.picking = False
                app.toast(msg % plural(len(todo), "download"))
            return run
        stop = live + paused
        cancel = each(d.cancel_job, stop, "Cancelled %s")
        e = []
        if live:
            e.append(("Pause %d" % len(live), "Keeps their partial files", each(d.pause_job, live, "Paused %s")))
        if paused:
            e.append(("Resume %d" % len(paused), "", each(d.resume_job, paused, "Resumed %s")))
        if stop:
            e.append(("Cancel %d" % len(stop), "Their partial files are deleted", lambda: setattr(app, "modal", Confirm(
                app, "Cancel %s?" % plural(len(stop), "download"),
                "Their partial files are deleted; finished downloads in the pick stay as they are.",
                "Cancel %d" % len(stop), cancel, danger=True))))
        if again:
            e.append(("Retry %d" % len(again), "Failed and cancelled ones download again",
                      each(d.resume_job, again, "Queued %s again")))
        if over:
            e.append(("Remove %d from the list" % len(over), "Finished games stay on the box",
                      each(d.remove, over, "Removed %s from the list")))
        return e

    def follow(self, jobs):
        """Keep the highlight on the same download when the list reorders."""
        sj = getattr(self, "sel_job", None)
        if sj in jobs:
            self.sel = jobs.index(sj)

    def tap_row(self, i):
        """The first tap also remembers the download, for follow()."""
        if self.sel != i:
            jobs = self.view()
            self.sel_job = jobs[i] if i < len(jobs) else None
        super().tap_row(i)

    def action(self, a):
        app, d = self.app, self.app.downloader
        jobs = self.view()
        self.follow(jobs)
        if self.nav(a):
            self.sel_job = jobs[min(self.sel, len(jobs) - 1)]
        elif jobs and self.pick_action(a):
            jobs = self.view()
            if jobs:
                self.sel_job = jobs[min(self.sel, len(jobs) - 1)]
        elif a == "ok" and jobs:
            self.menu(jobs[min(self.sel, len(jobs) - 1)])
        elif a == "y":
            self.clear_finished()
        elif a in ("l2", "r2"):
            app.push(ConversionsScreen(app))
        else:
            super().action(a)

    def menu(self, j):
        app, d = self.app, self.app.downloader
        J = rommlib.Job
        queued = [x for x in d.jobs if x.active or x.state == J.PAUSED]
        e = []
        if j in queued and len(queued) > 1:
            i = queued.index(j)
            e += [("Move to top", "Downloads next", (lambda: d.move(j, "top")) if i else None),
                  ("Move up", "", (lambda: d.move(j, "up")) if i else None),
                  ("Move down", "", (lambda: d.move(j, "down")) if i < len(queued) - 1 else None),
                  None]
        if j.state in (J.QUEUED, J.PAUSED) and not j.force and (d.hold or not rommlib.in_download_hours(app.cfg)):
            e.append(("Download now", "Start this one anyway (download hours / Pause all)", lambda: d.force_job(j)))
        if j.active:
            e.append(("Pause", "Keeps the partial file; resume any time", lambda: d.pause_job(j)))
            e.append(("Cancel download", "", lambda: self.confirm_cancel(j)))
        elif j.state == J.PAUSED:
            e.append(("Resume", "", lambda: d.resume_job(j)))
            e.append(("Cancel download", "Deletes the part downloaded so far", lambda: self.confirm_cancel(j)))
        elif j.state in (J.FAILED, J.CANCELLED):
            e.append(("Retry" if j.state == J.FAILED else "Download again", j.message, lambda: d.resume_job(j)))
            e.append(("Remove from the list", "", lambda: d.remove(j)))
        else:                                      # done
            e.append(("Remove from the list", "The game stays on the box", lambda: d.remove(j)))
        app.modal = ActionMenu(app, j.label, e)

    def confirm_cancel(self, j):
        """Cancelling deletes the partial file, paused or not: ask first, and say how much goes."""
        app, d = self.app, self.app.downloader
        got = max(d.part_bytes(j), j.done_bytes)
        if got:
            body = "%s: the %s downloaded so far%s is deleted." % (
                j.label, human_size(got), " (of %s)" % human_size(j.total_bytes) if j.total_bytes else "")
            if j.state == rommlib.Job.PAUSED:
                body += " Back keeps it, to resume later."
        else:
            body = "%s: nothing is downloaded yet." % j.label
        app.modal = Confirm(app, "Cancel download?", body, "Cancel download", lambda: d.cancel_job(j), danger=True)

    def status(self, j):
        """(text, colour) for a row."""
        J = rommlib.Job
        frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
        if j.state == J.DOWNLOADING:
            lim = " (slowed)" if self.app.downloader.rate_limit else ""
            return "%d%%   %s of %s   %s/s%s" % (frac * 100, human_size(j.done_bytes), human_size(j.total_bytes),
                                                 human_size(j.speed), lim), BLUE
        if j.state == J.VERIFYING:
            return "Checking checksum…", BLUE
        if j.state == J.EXTRACTING:
            return ("Waiting to unpack" if j.message.startswith("Waiting") else "Extracting…"), AMBER
        if j.state == J.QUEUED:
            if self.app.downloader.hold:
                return "Paused (all)", AMBER
            if not j.force and not rommlib.in_download_hours(self.app.cfg):
                return "Waiting for download hours (%s)" % rommlib.hours_label(
                    self.app.cfg["download_hours"]), AMBER
            if j.short_space:
                return "Waiting for space: free %s more" % human_size(j.short_space), AMBER
            wait = j.retry_at - time.time()
            if wait > 0 and j.attempts:                  # a real retry, not just "later"
                return "%s Retry %d of %d in %d s" % (j.message.split(" Retrying")[0], j.attempts,
                                                      len(rommlib.RETRY_DELAYS), wait + 1), AMBER
            return "Queued", DIM
        if j.state == J.DONE:
            msg = j.message or "Done"
            cache = self.__dict__.setdefault("_chd_st", {})
            if id(j) not in cache:
                cache[id(j)] = rommlib.chd_status(getattr(j, "chd_task", None), self.app.library,
                                                  j.rom.get("id"), getattr(j, "chd_mode", None)) \
                    if getattr(j, "chd_task", None) else None
            st = cache[id(j)]
            fmt = rommlib.CONVERT_LABELS.get(getattr(j, "chd_mode", None), "CHD")
            msg += {"queued": " · %s queued" % fmt, "compressing": " · compressing to %s…" % fmt,
                    "done": " · compressed to %s" % fmt}.get(st, "")
            return msg, GREEN
        if j.state == J.FAILED:
            return "Failed — " + j.message, RED
        if j.state == J.PAUSED:
            return "Paused", AMBER
        return j.state, FAINT

    def draw(self, c):
        d = self.app.downloader
        jobs = self.view()
        self.follow(jobs)
        y = 84
        if d.hold and d.pending_count():
            rich_text(c, self.f, self.f.small, "Downloads are paused. Resume them from the {X} menu.", (48, y),
                      AMBER)
            y += 28
        now = time.time()
        if now - getattr(self, "_chd_at", 0) > 1.0:   # disk reads once a second, not every frame
            self._chd_at = now
            self._chd_n = len([f for f in os.listdir(rommlib.CHD_QUEUE_DIR) if f.endswith(".json")]) \
                if os.path.isdir(rommlib.CHD_QUEUE_DIR) else 0
            self._chd_st = {}
            self._fc = rommlib.queue_forecast(d.jobs, rommlib.free_bytes(),
                                              rommlib.keep_free_bytes(self.app.cfg), self.app.cfg["chd"],
                                              self.app.cfg)
        fc = self._fc
        if fc["jobs"]:
            line = "Queue needs about %s · %s free · keeping %s free" % (
                human_size(fc["need"]), human_size(fc["free"]), human_size(fc["keep"]))
            if not fc["fits"]:
                line += " · short by %s: downloads wait for space" % human_size(fc["short"])
            text(c, self.f.small, line, (48, y), GREEN if fc["fits"] else AMBER, maxw=W - 96)
            y += 28
        chd = self._chd_n
        if chd:
            text(c, self.f.small, "%d disc game%s waiting for background compression "
                 "(runs when no game is playing) · {L2 R2} Conversions" % (chd, "s" if chd > 1 else ""),
                 (48, y), AMBER)
            y += 28
        if not jobs:
            text(c, self.f.h2, "No downloads yet", (W // 2, 300), DIM, "center")
            text(c, self.f.body, "Pick a game and press {A} to download it to this box.",
                 (W // 2, 340), FAINT, "center")
            return
        rows = max(1, (H - 60 - y) // self.ROW_H)       # fewer below the banners; L/R still page by ROWS
        self.sel = min(self.sel, len(jobs) - 1)
        J = rommlib.Job
        npend = sum(1 for j in jobs if j.active or j.state == J.PAUSED)
        for i, r, on in self.row_rects(y, gap=6, rows=rows):
            j = jobs[i]
            rrect(c, PANEL_HI if on else PANEL, r, 12)
            if on:
                rrect(c, ACCENT, r, 12, 2)
            x = r.left + 20
            if self.draw_pick(c, j, (x + 9, r.top + 24)):
                x += 30
            if i < npend:                          # position in the queue
                text(c, self.f.small, str(i + 1), (x + 10, r.top + 24), FAINT, "center")
                x += 30
            st, col = self.status(j)
            sw = min(520, int(measure(self.f.small, st)) + 4)
            text(c, self.f.h3, j.label, (x, r.top + 12), TEXT, maxw=r.right - 40 - sw - x)
            text(c, self.f.small, st, (r.right - 20, r.top + 14), col, "topright", maxw=520)
            sub = "roms/" + j.system
            if j.group:
                sub += "  ·  %s, %d discs" % (j.group.get("title") or j.group.get("base"),
                                             len(j.group.get("rom_ids") or []))
            if j.state == J.DONE and j.verified:
                sub += "  ·  checksum OK"
            bar = j.active and j.state != J.QUEUED
            text(c, self.f.small, sub, (x, r.top + 42), FAINT, maxw=(r.left + 440 - x) if bar else r.width - 60)
            if bar:
                frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
                busy = j.state in (J.EXTRACTING, J.VERIFYING)
                progress_bar(c, (r.left + 460, r.top + 48, r.width - 480, 8),
                             1.0 if busy else frac, AMBER if j.state == J.EXTRACTING else BLUE)
        if len(jobs) > rows:
            text(c, self.f.small, "%d–%d of %d" % (self.scroll + 1, min(len(jobs), self.scroll + rows), len(jobs)),
                 (W - 48, H - 64), FAINT, "bottomright")


class TextInputScreen(Screen):
    """Full-charset on-screen keyboard for URLs / tokens. A types, X deletes,
    Y = shift, Start saves, B cancels."""
    LOWER = ["1234567890", "qwertyuiop", "asdfghjkl:", "zxcvbnm./-", "_@?=&%~+#!"]
    SPECIAL = [("Shift", 2), ("Space", 2), ("Delete", 2), ("Clear", 2), ("Save", 2)]
    own_start = True

    def __init__(self, app, title, value, on_save, secret=False):
        super().__init__(app)
        self.title, self.value, self.on_save, self.secret = title, value or "", on_save, secret
        self.shift = False
        self.r, self.c = 1, 0

    def rows(self):
        if not self.shift:
            return self.LOWER
        return [r.upper() if i in (1, 2, 3) else
                ("!@#$%^&*()" if i == 0 else "<>[]{}|;,\'")
                for i, r in enumerate(self.LOWER)]

    def crumbs(self):
        return ["Settings", self.title]

    def hints(self):
        if INPUT_MODE["kb"]:
            return [("TYPE", "Letters"), ("BKSP", "Delete"), ("A", "Save"), ("B", "Cancel")]
        return [("A", "Type"), ("X", "Delete"), ("Y", "Shift"), ("START", "Save"), ("B", "Cancel")]

    def row_len(self, r):
        return len(self.rows()[r]) if r < len(self.LOWER) else len(self.SPECIAL)

    def action(self, a):
        n = len(self.LOWER) + 1
        if a == "up":
            self.r = (self.r - 1) % n
        elif a == "down":
            self.r = (self.r + 1) % n
        elif a == "left":
            self.c = (self.c - 1) % self.row_len(self.r)
        elif a == "right":
            self.c = (self.c + 1) % self.row_len(self.r)
        elif a == "x":
            self.value = self.value[:-1]
        elif a == "y":
            self.shift = not self.shift
        elif a == "ok":
            if self.r < len(self.LOWER):
                self.value += self.rows()[self.r][self.c]
            else:
                key = self.SPECIAL[self.c][0]
                if key == "Shift":
                    self.shift = not self.shift
                elif key == "Space":
                    self.value += " "
                elif key == "Delete":
                    self.value = self.value[:-1]
                elif key == "Clear":
                    self.value = ""
                else:
                    self.save()
        elif a == "start":
            self.save()
        elif a == "back":
            self.app.pop()
        self.c = min(self.c, self.row_len(self.r) - 1)

    def save(self):
        self.app.pop()
        self.on_save(self.value.strip())

    text_entry = True

    def type_text(self, s):
        self.value = (self.value + s)[:2048]

    def tap_key(self, r, c):
        self.r, self.c = r, c
        self.action("ok")

    def draw(self, c):
        qf = pygame.Rect(48, 88, W - 96, 60)
        rrect(c, PANEL, qf, 14)
        rrect(c, ACCENT, qf, 14, 2)
        shown = self.value
        if self.secret:
            shown = (shown[:4] + "•" * min(24, len(shown) - 8) + shown[-4:]) if len(shown) > 16 \
                else "•" * len(shown)
        # keep the tail (where you type) visible
        while shown and measure(self.f.h3, shown) > qf.width - 50:
            shown = shown[1:]
        r = text(c, self.f.h3, shown, (qf.left + 22, qf.centery), TEXT, "midleft")
        if not self.value:
            text(c, self.f.h3, self.title, (qf.left + 22, qf.centery), FAINT, "midleft")
            r = pygame.Rect(qf.left + 20, qf.top, 0, qf.height)
        if int(self.app.t * 2) % 2 == 0:
            hline(c, ACCENT_HI, (r.right + 3, qf.top + 16), (r.right + 3, qf.bottom - 16), 2)
        kw, kh, gap = 96, 62, 8
        kx = (W - (10 * kw + 9 * gap)) // 2
        ky = 172
        for ri, row in enumerate(self.rows()):
            for ci, ch in enumerate(row):
                kr = pygame.Rect(kx + ci * (kw + gap), ky + ri * (kh + gap), kw, kh)
                self.app.hit(kr, lambda ri=ri, ci=ci: self.tap_key(ri, ci))
                on = (ri, ci) == (self.r, self.c)
                rrect(c, ACCENT if on else PANEL, kr, 10)
                text(c, self.f.key, ch, kr.center, TEXT if on else DIM, "center")
        sy = ky + len(self.LOWER) * (kh + gap)
        sx = kx
        for ci, (label, span) in enumerate(self.SPECIAL):
            w = span * kw + (span - 1) * gap
            kr = pygame.Rect(sx, sy, w, kh)
            self.app.hit(kr, lambda ci=ci: self.tap_key(len(self.LOWER), ci))
            on = (self.r, self.c) == (len(self.LOWER), ci)
            hot = label == "Save" or (label == "Shift" and self.shift)
            rrect(c, ACCENT if on else (PANEL_HI if hot else PANEL), kr, 10)
            text(c, self.f.h3, label, kr.center, TEXT if on or hot else DIM, "center")
            sx += w + gap


class SettingsScreen(Screen):
    """Everything in config.json, editable with the pad. Saved immediately."""

    VISIBLE = 10

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.scroll = 0
        self.cache_bytes = None
        self.prev = rommlib.backup_version()
        self._measure_cache()

    def _measure_cache(self):
        def size():
            tot = 0
            for dp, _, fns in os.walk(rommlib.COVER_CACHE):
                for f in fns:
                    try:
                        tot += os.path.getsize(os.path.join(dp, f))
                    except OSError:
                        pass
            return tot
        self.app.bg(size, lambda n: setattr(self, "cache_bytes", n))

    def items(self):
        cfg = self.app.cfg
        tok = cfg["token"] or ""
        masked = (tok[:4] + "…" + tok[-4:]) if len(tok) > 10 else ("set" if tok else "not set")
        tls = rommlib.norm_verify(cfg["verify_tls"])
        tls_s = "On" if tls is True else ("Off" if tls is False else "CA: " + os.path.basename(tls))
        arcade = dict(cfg["platform_map"] or {}).get("arcade") or rommlib.PLATFORM_MAP["arcade"]
        def onoff(v):
            return "On" if v else "Off"
        rvz = rommlib.rvz_state(cfg)
        if getattr(self.app, "rvz_busy", False):
            pr = getattr(self.app, "rvz_progress", None)
            rvz = {"label": "Downloading %d%%" % (pr * 100) if pr is not None else "Downloading…",
                   "help": "dolphin-tool, from RomM-o-Cera's GitHub releases"}
        zar = rommlib.zar_state(cfg)
        if getattr(self.app, "zar_busy", False):
            pr = getattr(self.app, "zar_progress", None)
            zar = {"label": "Downloading %d%%" % (pr * 100) if pr is not None else "Downloading…",
                   "help": "extract-xiso and zarchive, from RomM-o-Cera's GitHub releases"}
        sec = SettingsScreen.section

        def row(rid, value, sub=None):            # a config.json row: name and grey line from the table
            st = SETTING_ROW[rid]
            return rid, st.label, value, st.sub if sub is None else sub

        def table(rid):                           # a generic row: all of it from the table
            st = SETTING_ROW[rid]
            return rid, st.label, self._value(st), st.sub
        return [
            sec("RomM server"),
            row("url", rommlib.display_url(cfg["url"]) or "not set",
                "Plain HTTP: the token isn't encrypted" if (cfg["url"] or "").lower().startswith("http://")
                else None),
            row("token", masked),
            ("pair", "Pair with RomM", "Enter code", "Type the code from RomM's Pair button"),
            row("tls", tls_s),
            ("test", "Test connection", "", "Fetch the platform list now"),
            sec("Controller"),
            row("style", self._style_value()),
            row("swap", "East (right)" if cfg["swap_ab"] else "South (bottom)"),
            sec("Downloads"),
            table("hours"),
            table("keepfree"),
            table("overlap"),
            table("bgdl"),
            table("speed"),
            table("notify"),
            table("manuals"),
            ("arcade", "Arcade games go to", "roms/" + arcade, "fbneo (forgiving) or mame (exact sets)"),
            sec("Disc compression"),
            table("chd"),
            row("rvz", rvz["label"], rvz["help"]),
            table("xboxboot"),
            table("squashfs"),
            table("z3ds"),
            row("zar", zar["label"], zar["help"]),
            table("ps3folders"),
            row("ps3decrypt", onoff(cfg["ps3_decrypt"]) if rommlib.ps3_decrypt_supported() else "Not available"),
            row("chdthreads", ("Auto (%d of %d)" % (rommlib.auto_chd_threads(), rommlib.cpu_threads()))
                if str(cfg["chd_threads"]) == "auto" else
                "%d of %d" % (rommlib.chd_threads(cfg), rommlib.cpu_threads())),
            row("chdlowmem", onoff(cfg["chd_low_memory"]) if isinstance(cfg["chd_low_memory"], bool) else
                "Auto (%s)" % ", ".join([onoff(rommlib.chd_low_memory(cfg))] +
                                        (["%s RAM" % human_size(rommlib.total_ram())] if rommlib.total_ram() else []))),
            sec("This app"),
            row("theme", self._theme_value()),
            table("themeauto"),
            table("sounds"),
            table("cachelimit"),
            ("cache", "Clear cover cache",
             human_size(self.cache_bytes) if self.cache_bytes is not None else "…",
             "Covers re-download as you browse"),
            ("bios", "BIOS files", "Open", "What each system needs, and what RomM can fill"),
            ("credits", "Credits and licenses", "Open", "The software RomM-o-Cera uses or downloads"),
            ("docs", "Documentation", "QR code", "Open it on your phone"),
            ("resetcfg", "Reset settings", "Can't be read" if rommlib.config_unreadable() else "Reset",
             "Start over from the defaults; the old file is kept"),
            sec("Updates"),
            table("channel"),
            table("checkupdates"),
            ("update", "Updates", ("%s available" % self.app.update_tag) if self.app.update_tag
             else "v" + rommlib.VERSION_LABEL,
             ("Download, check and install %s" % self.app.update_tag) if self.app.update_tag
             else "Check GitHub for a newer " + ("build" if cfg["update_channel"] == "nightly" else "release")),
        ] + ([("rollback", "Go back to the previous version", "v" + self.prev, "Undo the last update")]
             if self.prev else [])

    def pair(self):
        """Settings, Pair with RomM: type RomM's short code, get the token."""
        app, cfg = self.app, self.app.cfg
        if not (cfg["url"] or "").strip():
            app.toast("Set the server address first, then pair", AMBER)
            return

        def paired(res):
            cfg["token"] = res["token"]
            app.apply_config(reconnect=True)
            app.toast("Paired with RomM" + (" (%s)" % res["name"] if res.get("name") else "")
                      + " — reconnecting", GREEN)

        def submit(v):
            try:
                code = rommlib.normalize_pair_code(v)
            except rommlib.RommError as e:
                app.toast(str(e), RED)
                return
            app.toast("Pairing…")
            url, verify = cfg["url"], cfg["verify_tls"]
            app.bg(lambda: rommlib.exchange_pair_code(url, code, verify), paired,
                   lambda e: app.toast(str(e), RED))
        app.push(TextInputScreen(app, "Pairing code from RomM", "", submit))

    @staticmethod
    def section(title):
        return ("§", title, "", "")

    # generic rows that need something this box may lack: (is it here?, the toast when it isn't)
    NEEDS = {
        "squashfs": (lambda: rommlib.squashfs_supported(), "mksquashfs isn't on this system"),
        "z3ds": (lambda: rommlib.z3ds_supported(), "libzstd isn't on this system"),
    }
    # a choice row's value text, from the whole config
    SHOW = {
        "hours": lambda cfg: rommlib.hours_label(cfg["download_hours"]),
        "keepfree": lambda cfg: "%d GB" % float(cfg["keep_free_gb"]) if cfg["keep_free_gb"] else "Nothing (fill the disk)",
        "speed": lambda cfg: "%g MB/s" % float(cfg["speed_while_playing"]) if cfg["speed_while_playing"] else "No limit",
        "sounds": lambda cfg: {"normal": "On", "quiet": "Quiet", "off": "Off"}.get(cfg["sounds"], "On"),
        "channel": lambda cfg: {"stable": "Stable", "nightly": "Nightly"}.get(cfg["update_channel"], "Stable"),
        "cachelimit": lambda cfg: (rommlib.human_size(rommlib.cache_limit_bytes(cfg))
                                   if rommlib.cache_limit_bytes(cfg) else "No limit"),
    }

    def _wake(self, app):
        with app.downloader.cv:
            app.downloader.cv.notify_all()

    def _sounds(self, app):
        app.sfx.set_level(app.cfg["sounds"])
        app.sfx.play("toggle")

    def _cache_limit(self, app):
        lim = rommlib.cache_limit_bytes(app.cfg)
        app.api.cache_limit = lim
        if lim:
            app.bg(lambda: rommlib.prune_cache(lim), lambda r: self._measure_cache(), lambda e: None)

    def _check_updates(self, app):
        """Daily check back on: check now, not at the next start. Off: forget what it found."""
        if app.cfg["check_updates"]:
            self._update_channel(app)
        else:
            app.update_tag = None

    def _update_channel(self, app):
        """A new channel: forget what the old one offered and ask GitHub again."""
        app.update_tag = None

        def found(tag):
            app.update_tag = tag
            if tag:
                app.toast("%s is available" % tag, BLUE)
        app.bg(lambda: rommlib.newer_release(dict(app.cfg, check_updates=True), force=True), found,
               lambda e: None)

    # what a change to a generic row sets off, by name (rommlib.Setting.effects): (screen, app)
    EFFECTS = {
        "downloader": lambda screen, app: setattr(app.downloader, "cfg", app.cfg),
        "wake": _wake,
        "sounds": _sounds,
        "cache_limit": _cache_limit,
        "update_channel": _update_channel,
        "check_updates": _check_updates,
    }

    def _available(self, st):
        need = self.NEEDS.get(st.row)
        return need is None or need[0]()

    def _value(self, st):
        """A generic row's value text."""
        if not self._available(st):
            return "Not available"
        if st.kind == "choice":
            return self.SHOW[st.row](self.app.cfg)
        return "On" if self.app.cfg[st.key] else "Off"

    STYLES = ["auto", "xbox", "playstation", "nintendo"]
    SPEEDS = rommlib.SPEEDS                   # MB/s, 0 = no limit
    THEME_CYCLE = list(THEMES)                       # what left and right cycle through
    LOW_MEMORY = ["auto", True, False]

    def _theme_value(self):
        cfg = self.app.cfg
        chosen = THEMES.get(cfg["theme"], THEMES["default"])[0]
        now = self.app.theme_key()
        if now != cfg["theme"] and now in THEMES:              # matched to the controller
            return "%s (now %s)" % (chosen, THEMES[now][0])
        return chosen

    def _style_value(self):
        want = self.app.cfg["button_style"] or "auto"
        if want == "auto":
            return "Auto (%s)" % STYLE_NAMES[style_from_names(self.app.input.names())]
        return STYLE_NAMES.get(want, want)

    def crumbs(self):
        return ["Settings"]

    ACTIONS = ("url", "token", "pair", "test", "cache", "update", "rollback", "bios", "credits", "docs")
    STEPLESS = ACTIONS + ("resetcfg",)        # rows left/right don't step through

    def hints(self):
        items = self.items()
        key = items[min(self.sel, len(items) - 1)][0]
        if key in self.STEPLESS:
            return [("A", "Open" if key in ("bios", "credits", "docs") else "Select"), ("B", "Back")]
        return [("A", "Change"), ("LEFT RIGHT", "Choose"), ("B", "Back")]

    def selectable(self):
        return [i for i, it in enumerate(self.items()) if it[0] != "§"]

    tapped = None                  # the row a tap picked: drawing doesn't scroll it away

    def tap_now(self, i, a="ok"):
        """Touch: act on the row at once ("left" on the left of a value steps back)."""
        self.sel = self.tapped = i
        self.action(a)

    def action(self, a):
        idx = self.selectable()
        if self.sel not in idx:
            self.sel = idx[0]
        if a in ("up", "down", "l1", "r1"):
            self.tapped = None
            k = idx.index(self.sel)
            step = {"up": -1, "down": 1, "l1": -6, "r1": 6}[a]
            k = (k + step) % len(idx) if a in ("up", "down") else max(0, min(len(idx) - 1, k + step))
            self.sel = idx[k]
        elif a in ("ok", "left", "right"):
            key = self.items()[self.sel][0]
            app, cfg = self.app, self.app.cfg
            if key == "url" and a == "ok":
                def save_url(v):
                    if v and "://" not in v:
                        v = "https://" + v
                    if rommlib.url_has_userinfo(v):
                        app.toast("Leave user:password out of the URL — the token is the login", RED)
                        return
                    cfg["url"] = v.rstrip("/")
                    app.apply_config(reconnect=True)
                    app.toast("Server saved — reconnecting", GREEN)
                cur = cfg["url"] or "https://"
                if rommlib.url_has_userinfo(cur):
                    cur = "https://"          # never pre-fill an embedded password
                app.push(TextInputScreen(app, "RomM server URL", cur, save_url))
            elif key == "token" and a == "ok":
                def save_tok(v):
                    cfg["token"] = v
                    app.apply_config(reconnect=True)
                    app.toast("Token saved — reconnecting", GREEN)
                app.push(TextInputScreen(app, "RomM client API token", cfg["token"] or "",
                                         save_tok, secret=True))
            elif key == "pair" and a == "ok":
                self.pair()
            elif key == "tls":
                cur = rommlib.norm_verify(cfg["verify_tls"])
                ca = cfg["verify_tls_ca"] or ""
                if isinstance(cur, str):
                    cfg["verify_tls_ca"] = ca = cur          # remember the bundle when cycling away
                cycle = [True, False] + ([ca] if ca else [])
                i = next((k for k, v in enumerate(cycle) if v == cur), 0)
                cfg["verify_tls"] = cycle[(i + (-1 if a == "left" else 1)) % len(cycle)]
                app.apply_config(reconnect=True)
                if cfg["verify_tls"] is False:
                    app.toast("Certificates aren't checked now — only for a self-signed RomM", AMBER)
            elif key == "test" and a == "ok":
                app.toast("Testing…")
                app.bg(app.api.platforms,
                       lambda p: app.toast("Connected: %d platforms on the server" % len(p), GREEN),
                       lambda e: app.toast(str(e), RED))
            elif key in SETTING_ROW and SETTING_ROW[key].kind == "onoff":
                st = SETTING_ROW[key]
                if not self._available(st):
                    app.toast(self.NEEDS[key][1], AMBER)
                else:
                    cfg[st.key] = not cfg[st.key]
                    app.apply_config()
                    for e in st.effects:
                        self.EFFECTS[e](self, app)
            elif key in SETTING_ROW and SETTING_ROW[key].kind == "choice":
                st = SETTING_ROW[key]
                opts, cur = list(st.choices), cfg[st.key]
                i = opts.index(cur) if cur in opts else opts.index(st.default)
                cfg[st.key] = opts[(i + (-1 if a == "left" else 1)) % len(opts)]
                app.apply_config()
                for e in st.effects:
                    self.EFFECTS[e](self, app)
            elif key == "style":
                cur = cfg["button_style"] or "auto"
                i = self.STYLES.index(cur) if cur in self.STYLES else 0
                cfg["button_style"] = self.STYLES[(i + (-1 if a == "left" else 1)) % len(self.STYLES)]
                app.apply_config()
            elif key == "swap":
                cfg["swap_ab"] = not cfg["swap_ab"]
                app.apply_config()
                app.toast("Confirm is now the %s button" % ("east" if cfg["swap_ab"] else "south"))
            elif key == "theme":
                keys = self.THEME_CYCLE
                cur = cfg["theme"] if cfg["theme"] in keys else "default"
                cfg["theme"] = keys[(keys.index(cur) + (-1 if a == "left" else 1)) % len(keys)]
                app.apply_config()                  # repaints in the new colours on the next frame
                app.sfx.play("toggle")
            elif key == "chdthreads":
                n = rommlib.cpu_threads()
                opts = ["auto"] + list(range(1, n + 1))
                cur = cfg["chd_threads"]
                cur = cur if cur in opts else "auto"
                cfg["chd_threads"] = opts[(opts.index(cur) + (-1 if a == "left" else 1)) % len(opts)]
                app.apply_config()
            elif key == "chdlowmem":
                opts, cur = self.LOW_MEMORY, cfg["chd_low_memory"]
                i = opts.index(cur) if isinstance(cur, bool) else 0
                cfg["chd_low_memory"] = opts[(i + (-1 if a == "left" else 1)) % len(opts)]
                app.apply_config()
            elif key == "rvz":
                self._toggle_rvz()
            elif key == "zar":
                self._toggle_zar()
            elif key == "ps3decrypt":
                self._toggle_ps3_decrypt()
            elif key == "credits" and a == "ok":
                app.push(CreditsScreen(app))
            elif key == "docs" and a == "ok":
                app.push(DocsScreen(app))
            elif key == "resetcfg" and a == "ok":
                app.modal = Confirm(app, "Reset all settings?",
                                    "Every setting goes back to its default, including the server address and "
                                    "token. The current settings file is kept beside it.",
                                    "Reset settings", app.reset_config, danger=True)
            elif key == "arcade":
                pm = dict(cfg["platform_map"] or {})
                cur = pm.get("arcade") or rommlib.PLATFORM_MAP["arcade"]
                pm["arcade"] = "mame" if cur == "fbneo" else "fbneo"
                cfg["platform_map"] = pm
                app.apply_config(reconnect=True)
            elif key == "update" and a == "ok":
                if app.update_tag:
                    tag = app.update_tag
                    app.modal = Confirm(app, "Update to %s?" % tag,
                                        "Downloads it from GitHub, checks it, and keeps v%s so you can go "
                                        "back. RomM-o-Cera then closes; open it again." % rommlib.VERSION_LABEL,
                                        "Update", lambda: self._do_update())
                else:
                    app.toast("Checking GitHub…")

                    def checked(tag):
                        app.update_tag = tag
                        app.toast(("%s is available" % tag) if tag else
                                  "You have the latest version (v%s)" % rommlib.VERSION_LABEL, BLUE if tag else GREEN)
                    app.bg(lambda: rommlib.newer_release(dict(cfg, check_updates=True), force=True), checked)
            elif key == "rollback" and a == "ok":
                app.modal = Confirm(app, "Go back to v%s?" % self.prev,
                                    "Swaps v%s back in; v%s is kept so you can undo this. RomM-o-Cera then "
                                    "closes; open it again." % (self.prev, rommlib.VERSION_LABEL),
                                    "Go back", lambda: self._swap(rommlib.rollback), danger=True)
            elif key == "bios" and a == "ok":
                app.push(BiosScreen(app))
            elif key == "cache" and a == "ok":
                shutil.rmtree(rommlib.COVER_CACHE, ignore_errors=True)
                app.forget_covers()
                self.cache_bytes = 0
                app.toast("Cover cache cleared", GREEN)
        else:
            super().action(a)

    def _toggle_rvz(self):
        app, cfg = self.app, self.app.cfg
        if not rommlib.rvz_supported():
            app.toast("dolphin-tool is built for x86_64 and 64-bit ARM boxes only", AMBER)
            return
        if getattr(app, "rvz_busy", False):
            app.toast("dolphin-tool is still downloading")
            return
        if cfg["rvz"] and rommlib.dolphin_tool_path():
            cfg["rvz"] = False
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("GameCube and Wii conversion off (dolphin-tool stays installed)")
            return
        if rommlib.dolphin_tool_path():
            cfg["rvz"] = True
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("GameCube and Wii games will be converted to RVZ", GREEN)
            return
        t = rommlib.DOLPHIN_TOOL

        def install():
            app.rvz_busy = True

            def prog(got, total):
                app.rvz_progress = (got / total) if total else None
            try:
                return rommlib.install_dolphin_tool(prog)
            finally:
                app.rvz_busy = False

        def done(path):
            cfg["rvz"] = True
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("dolphin-tool %s installed: GameCube and Wii games convert to RVZ" % t["version"], GREEN)

        def failed(e):
            app.toast(str(e) if isinstance(e, rommlib.RommError) else "dolphin-tool download failed (%s)"
                      % e.__class__.__name__, RED)
        size = (" (%s)" % human_size(t["size"])) if t.get("size") else ""
        app.modal = Confirm(app, "Download dolphin-tool?",
                            "RVZ conversion needs Dolphin's dolphin-tool %s%s: built from the Dolphin "
                            "version Batocera uses, GPL-2.0-or-later, checked by SHA-256 before use. "
                            "Credits are in Settings." % (t["version"], size),
                            "Download", lambda: (app.toast("Downloading dolphin-tool…"), app.bg(install, done, failed)))

    def _toggle_ps3_decrypt(self):
        """On: copy the disc keys in RomM's PS3 firmware (if any) into bios/ps3keys."""
        app, cfg = self.app, self.app.cfg
        if not rommlib.ps3_decrypt_supported():
            app.toast("Python's cryptography module isn't on this system", AMBER)
            return
        cfg["ps3_decrypt"] = not cfg["ps3_decrypt"]
        app.apply_config()
        app.downloader.cfg = cfg
        if not cfg["ps3_decrypt"]:
            return
        pid = next((p["id"] for p in app.platforms if p.get("_system") == "ps3"), None)

        def done(n):
            if n:
                app.toast("%s disc keys ready in bios/ps3keys" % "{:,}".format(n), GREEN)
            else:
                app.toast("No disc keys yet: put the keys for games you own in bios/ps3keys, or add "
                          "them to RomM's PS3 firmware", AMBER)
        app.bg(lambda: rommlib.fetch_ps3_keys(app.api, pid) if pid and app.api else len(rommlib.ps3_keys()),
               done, lambda e: (app.toast(str(e), RED), done(len(rommlib.ps3_keys()))))

    def _toggle_zar(self):
        app, cfg = self.app, self.app.cfg
        if not rommlib.zar_supported():
            app.toast("Xbox 360 emulation on Batocera is x86_64 only", AMBER)
            return
        if getattr(app, "zar_busy", False):
            app.toast("The Xbox 360 tools are still downloading")
            return
        if cfg["zar"] and rommlib.x360_tools():
            cfg["zar"] = False
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("Xbox 360 conversion off (the tools stay installed)")
            return
        if rommlib.x360_tools():
            cfg["zar"] = True
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("Xbox 360 games will be converted to .zar", GREEN)
            return
        t = rommlib.X360_TOOLS

        def install():
            app.zar_busy = True

            def prog(got, total):
                app.zar_progress = (got / total) if total else None
            try:
                return rommlib.install_x360_tools(prog)
            finally:
                app.zar_busy = False

        def done(paths):
            cfg["zar"] = True
            app.apply_config()
            app.downloader.cfg = cfg
            app.toast("Xbox 360 tools installed: Xbox 360 games convert to .zar", GREEN)

        def failed(e):
            app.toast(str(e) if isinstance(e, rommlib.RommError) else "Xbox 360 tools download failed (%s)"
                      % e.__class__.__name__, RED)
        size = (" (%s)" % human_size(t["size"])) if t.get("size") else ""
        app.modal = Confirm(app, "Download the Xbox 360 tools?",
                            "Converting to .zar needs extract-xiso and zarchive%s, built from their "
                            "published source and checked by SHA-256 before use. A .zar holds the game's "
                            "files, not the whole disc image. Credits are in Settings." % size,
                            "Download", lambda: (app.toast("Downloading the Xbox 360 tools…"),
                                                 app.bg(install, done, failed)))

    def _do_update(self):
        self.app.toast("Downloading and checking the update…")
        tag = self.app.update_tag
        self._swap(lambda: rommlib.install_staged(rommlib.stage_release(rommlib.release_info(tag))))

    def _swap(self, fn):
        app = self.app
        if getattr(app, "updating", False):
            app.toast("An update is already running")
            return
        app.updating = True

        def done(ver):
            app.updating = False
            app.update_tag = None                  # we're on it now
            self.prev = rommlib.backup_version()
            app.modal = Confirm(app, "Now on v%s" % ver,
                                "Close RomM-o-Cera and open it again from Pygame to use it.",
                                "Close %s" % APP_NAME, app._quit)

        def err(e):
            app.updating = False
            app.toast(str(e) if isinstance(e, (rommlib.UpdateError, rommlib.RommError)) else "Update failed (%s)"
                      % e.__class__.__name__, RED)
        app.bg(fn, done, err)

    ROW_H, HEAD_H, TOP, BOTTOM = 57, 40, 84, 638

    def draw(self, c):
        items = self.items()
        if items[min(self.sel, len(items) - 1)][0] == "§":
            self.sel = self.selectable()[0]
        ys, y = [], 0                      # layout in list space
        for key, *_ in items:
            ys.append(y)
            y += self.HEAD_H if key == "§" else self.ROW_H
        total, view = y, self.BOTTOM - self.TOP
        top_of = ys[self.sel] - (self.HEAD_H if self.sel and items[self.sel - 1][0] == "§" else 0)
        if self.tapped == self.sel and -2 <= ys[self.sel] - self.scroll <= view - 52:
            pass                               # a tapped row stays under the finger
        elif top_of < self.scroll:
            self.scroll = top_of
        elif ys[self.sel] + self.ROW_H > self.scroll + view:
            need = ys[self.sel] + self.ROW_H - view
            self.scroll = min(y for y in ys if y >= need)     # start on a whole row
        self.scroll = max(0, min(self.scroll, max(0, total - view)))
        clip = c.get_clip()
        c.set_clip(pygame.Rect(S(40), S(self.TOP - 4), S(730), S(view + 4)))
        for i, (key, label, value, sub) in enumerate(items):
            y = self.TOP + ys[i] - self.scroll
            h = self.HEAD_H if key == "§" else 52
            if y < self.TOP - 2 or y + h > self.BOTTOM:
                continue                              # whole rows only
            if key == "§":
                text(c, self.f.small, label.upper(), (52, y + 16), ACCENT_HI)
                hline(c, LINE, (60 + measure(self.f.small, label.upper()), y + 26), (748, y + 26))
                continue
            r = pygame.Rect(48, y, 700, 52)
            self.app.hit(r, lambda i=i: self.tap_now(i))
            on = i == self.sel
            rrect(c, PANEL_HI if on else PANEL, r, 12)
            if on:
                rrect(c, ACCENT, r, 12, 2)
            text(c, self.f.h3, label, (r.left + 22, r.top + 4), TEXT if on else DIM)
            warn = sub.startswith("Plain HTTP")
            text(c, self.f.small, sub, (r.left + 22, r.top + 28), AMBER if warn else FAINT, maxw=420)
            vcol = ACCENT_HI if key in self.ACTIONS else (TEXT if on else DIM)
            vr = text(c, self.f.body, value, (r.right - 22, r.centery), vcol, "midright", maxw=240)
            if key not in self.STEPLESS:          # a tap left of the value's middle steps back
                bx = min(vr.left - 28, vr.centerx - 60)
                self.app.hit((bx, y, vr.centerx - bx, 52), lambda i=i: self.tap_now(i, "left"))
                if on:                                # ‹ › around the value: back and on
                    for x0, d in ((vr.left - 12, -1), (r.right - 12, 1)):
                        polyline(c, ACCENT_HI, [(x0 - 3 * d, r.centery - 6), (x0 + 3 * d, r.centery),
                                                (x0 - 3 * d, r.centery + 6)], 2)
        c.set_clip(clip)
        if total > view:
            track = pygame.Rect(756, self.TOP, 4, view - 5)
            rrect(c, LINE, track, 2)
            h = max(30, track.height * view // total)
            yy = track.top + (track.height - h) * self.scroll // max(1, total - view)
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)
        # right panel: what the selected setting does, then About
        p = pygame.Rect(776, 84, 472, 554)
        rrect(c, PANEL, p, 16)
        key, label, value, sub = items[self.sel]
        sec = next((it[1] for it in reversed(items[:self.sel]) if it[0] == "§"), "")
        text(c, self.f.small, sec.upper(), (p.left + 28, p.top + 24), ACCENT_HI)
        text(c, self.f.h2, label, (p.left + 28, p.top + 46), TEXT, maxw=p.width - 56)
        yy = p.top + 92
        for ln in rich_lines(self.f, self.f.body, SETTING_HELP.get(key, sub), p.width - 56, 7):
            rich_text(c, self.f, self.f.body, ln, (p.left + 28, yy), DIM)
            yy += 26
        a = p.bottom - 150
        if key == "docs":
            draw_qr(c, docs_qr(), pygame.Rect(p.left + 28, yy + 10, p.width - 56, a - yy - 22))
        elif value:
            yy += 8
            text(c, self.f.small, "Now: " + value, (p.left + 28, yy), ACCENT_HI, maxw=p.width - 56)
        hline(c, LINE, (p.left + 28, a), (p.right - 28, a))
        text(c, self.f.h3, APP_NAME, (p.left + 28, a + 14), TEXT)
        text(c, self.f.small, "v%s · %s · by %s" % (rommlib.VERSION_LABEL, rommlib.RELEASE_DATE, rommlib.AUTHOR),
             (p.left + 28, a + 44), ACCENT_HI)
        upd = ("%s is out: Updates installs it." % self.app.update_tag) if self.app.update_tag else \
            rommlib.PROJECT_URL.replace("https://", "")
        text(c, self.f.small, upd, (p.left + 28, a + 68), BLUE if self.app.update_tag else FAINT,
             maxw=p.width - 56)
        text(c, self.f.small, "%s · %d platforms" % (self.app.error or self.app.status, len(self.app.platforms)),
             (p.left + 28, a + 92), FAINT, maxw=p.width - 56)
        rich_text(c, self.f, self.f.small, "Hotkey + {START} exits", (p.left + 28, a + 116), FAINT)


# Settings rows for a config.json key take their name, grey line and help from rommlib.SETTINGS
SETTING_ROW = {s.row: s for s in rommlib.SETTINGS if s.row}
SETTING_HELP = dict({s.row: s.help for s in rommlib.SETTINGS if s.row}, **{
