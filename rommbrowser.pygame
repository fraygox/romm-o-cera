#!/usr/bin/env python3
"""RomM Browser for Batocera — browse/search the RomM library with a
controller and download games straight into /userdata/roms/<system>.

Launched by Batocera's pygame system (roms/pygame/rommbrowser/). Renders a
1280x720 logical canvas scaled to the screen. Exit: Hotkey+Start (evmapy
sends Alt+F4), or Home -> Exit. Backend lives in the romm/ package, through rommlib.py;
the UI in the rbui/ package. This file only sets up and starts it.
"""
import os
import sys

APP_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, APP_DIR)
os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
# Batocera's screenshot hotkey flashes a fullscreen window for 0.1 s; SDL would
# minimise this fullscreen app when it takes focus, and ES (white while a
# "game" runs) would be left showing
os.environ.setdefault("SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS", "0")

import pygame  # noqa: E402
import rommlib  # noqa: E402
from rbui import APP_NAME  # noqa: E402
from rbui.app import App  # noqa: E402
from rbui.startup import fit_memory_budgets, register_self, tame_malloc  # noqa: E402
from rbui.theme import H, W  # noqa: E402


# --------------------------------------------------------------------- main

def main():
    tame_malloc()
    fit_memory_budgets()
    try:
        pygame.mixer.pre_init(44100, -16, 2, 512)    # small buffer: blips land on the press
    except Exception:
        pass
    pygame.init()
    pygame.mouse.set_visible(False)
    flags = pygame.FULLSCREEN
    try:
        screen = pygame.display.set_mode((0, 0), flags)
    except pygame.error:
        screen = pygame.display.set_mode((W, H))
    pygame.display.set_caption(APP_NAME)
    try:
        os.makedirs(rommlib.DATA_DIR, exist_ok=True)
    except OSError:                  # a full disk: start anyway (Free up space is in here)
        pass
    rommlib.log("start")
    register_self()
    app = App(screen)
    try:
        app.run()
    except Exception as e:
        import traceback
        rommlib.log("crash: " + traceback.format_exc())
        raise
    finally:
        rommlib.log("exit")
        pygame.quit()


if __name__ == "__main__":
    main()
