#!/usr/bin/env python3
"""RomM Browser for Batocera — browse/search the RomM library with a
controller and download games straight into /userdata/roms/<system>.

Launched by Batocera's pygame system (roms/pygame/rommbrowser/). Renders a
1280x720 logical canvas scaled to the screen. Exit: Hotkey+Start (evmapy
sends Alt+F4), or Home -> Exit. Backend lives in rommlib.py.
"""
import os
import re
import shutil
import subprocess
import sys
import threading
import time

APP_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, APP_DIR)
os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")

import pygame  # noqa: E402
import rommlib  # noqa: E402
from rommlib import human_size  # noqa: E402

try:
    from pygame._sdl2 import controller as sdlcontroller
except Exception:  # pragma: no cover - older pygame
    sdlcontroller = None

W, H = 1280, 720      # logical layout units; drawn natively at W*K x H*K
FPS = 60
K = 1.0               # physical px per logical unit (3.0 on a 4K TV), set at startup


def S(v):
    return int(round(v * K))


def SR(r):
    r = pygame.Rect(r)
    return pygame.Rect(S(r.x), S(r.y), max(1, S(r.width)), max(1, S(r.height)))


def LR(r):
    """physical rect -> logical rect (what layout code reasons in)"""
    return pygame.Rect(int(r.x / K), int(r.y / K), int(round(r.width / K)), int(round(r.height / K)))

# palette (RomM-ish violet on near-black)
# Design tokens (2026-10-10 sweep): deep indigo "ink" instead of neutral black
# (calmer on a TV, ties to RomM's violet), one focus language (violet outline
# on a lifted panel), status colours used for status only.
BG = (21, 19, 42)          # ink        #15132A
BG2 = (28, 25, 54)         # recess     #1C1936
PANEL = (33, 30, 64)       # panel      #211E40
PANEL_HI = (47, 42, 92)    # focus fill #2F2A5C
LINE = (61, 55, 108)       # rule       #3D376C
TEXT = (242, 239, 255)     # text       #F2EFFF
DIM = (171, 165, 216)      # secondary  #ABA5D8
FAINT = (121, 114, 172)    # tertiary   #7972AC
ACCENT = (139, 92, 246)    # RomM violet #8B5CF6
ACCENT_HI = (183, 160, 255)
GREEN = (74, 222, 128)
AMBER = (251, 191, 36)
RED = (248, 113, 113)
BLUE = (96, 165, 250)
BTN_COL = {"A": (52, 211, 153), "B": (248, 113, 113), "X": (96, 165, 250),
           "Y": (251, 191, 36), "L": (171, 165, 216), "R": (171, 165, 216),
           "START": (171, 165, 216), "SELECT": (171, 165, 216)}

FONT_DIRS = ["/usr/share/fonts/dejavu", "/usr/share/fonts/dejavu-sans-fonts",
             "/usr/share/fonts/truetype/dejavu", os.path.join(APP_DIR, "fonts")]


CJK_FONTS = ["/usr/share/emulationstation/resources/DroidSansFallbackFull.ttf",
             "/usr/share/fonts/truetype/droid/DroidSansFallback.ttf",
             "/usr/share/fonts/google-droid-sans-fonts/DroidSansFallbackFull.ttf"]
FALLBACK = {}   # Font -> same-size CJK Font (DejaVu has no kana/kanji/hangul)


def find_font(name):
    for d in FONT_DIRS:
        p = os.path.join(d, name)
        if os.path.exists(p):
            return p
    return None


class Fonts:
    def __init__(self):
        fdir = os.path.join(APP_DIR, "fonts")
        bundled = lambda n: os.path.join(fdir, n) if os.path.exists(os.path.join(fdir, n)) else None  # noqa: E731
        dv = find_font("DejaVuSans.ttf")
        reg = bundled("Rubik-Regular.ttf") or dv
        med = bundled("Rubik-Medium.ttf") or find_font("DejaVuSans-Bold.ttf") or reg
        bold = bundled("Rubik-SemiBold.ttf") or med
        cjk = next((p for p in CJK_FONTS if os.path.exists(p)), None)
        cache = {}

        def mk(path, size):
            size = max(6, int(round(size * K)))
            k = (path, size)
            if k not in cache:
                cache[k] = pygame.font.Font(path, size)
                if cjk:
                    FALLBACK[cache[k]] = pygame.font.Font(cjk, size)
            return cache[k]
        self.h1 = mk(bold, 36)
        self.h2 = mk(bold, 25)
        self.h3 = mk(med, 20)
        self.body = mk(reg, 19)
        self.row = mk(reg, 21)
        self.small = mk(reg, 17)
        self.cond = mk(reg, 17)
        self.tiny = mk(med, 14)
        self.key = mk(med, 24)
        self.btn = mk(bold, 14)


# ------------------------------------------------------------------ drawing

def rrect(surf, color, rect, radius=10, width=0):
    pygame.draw.rect(surf, color, SR(rect), max(1, S(width)) if width else 0,
                     border_radius=S(radius))


def focus_box(surf, rect, radius=10):
    """The one focus treatment: lifted fill + violet outline."""
    rrect(surf, PANEL_HI, rect, radius)
    rrect(surf, ACCENT, rect, radius, 2)


def circle(surf, color, center, radius, width=0):
    pygame.draw.circle(surf, color, (S(center[0]), S(center[1])), max(1, S(radius)),
                       max(1, S(width)) if width else 0)


def hline(surf, color, a, b, width=1):
    pygame.draw.line(surf, color, (S(a[0]), S(a[1])), (S(b[0]), S(b[1])), max(1, S(width)))


def polyline(surf, color, pts, width=1):
    pygame.draw.lines(surf, color, False, [(S(x), S(y)) for x, y in pts], max(1, S(width)))


def arc(surf, color, rect, a0, a1, width=1):
    pygame.draw.arc(surf, color, SR(rect), a0, a1, max(1, S(width)))


def _wide(ch):
    return ord(ch) >= 0x2E80        # CJK, kana, hangul, fullwidth forms


def _runs(font, s):
    """Split s into (font, chunk) runs: Latin via font, CJK via its fallback."""
    fb = FALLBACK.get(font)
    if fb is None or not any(_wide(ch) for ch in s):
        return [(font, s)]
    out = []
    for ch in s:
        f = fb if _wide(ch) else font
        if out and out[-1][0] is f:
            out[-1] = (f, out[-1][1] + ch)
        else:
            out.append((f, ch))
    return out


def measure(font, s):
    """width in logical units"""
    return sum(f.size(chunk)[0] for f, chunk in _runs(font, s)) / K


_TEXT_CACHE = {}


def render_cached(font, s, color):
    key = (id(font), s, color)
    img = _TEXT_CACHE.get(key)
    if img is None:
        if len(_TEXT_CACHE) > 3000:
            _TEXT_CACHE.clear()
        img = _TEXT_CACHE[key] = render(font, s, color)
    return img


def render(font, s, color):
    runs = _runs(font, s)
    if len(runs) == 1:
        return runs[0][0].render(runs[0][1], True, color)
    imgs = [(f, f.render(chunk, True, color)) for f, chunk in runs]
    h = font.get_height()
    out = pygame.Surface((sum(i.get_width() for _, i in imgs), h), pygame.SRCALPHA)
    x = 0
    for f, i in imgs:
        # align baselines
        out.blit(i, (x, font.get_ascent() - f.get_ascent()))
        x += i.get_width()
    return out


def text(surf, font, s, pos, color=TEXT, anchor="topleft", maxw=None):
    s = s or ""
    if maxw is not None and measure(font, s) > maxw:
        while s and measure(font, s + "…") > maxw:
            s = s[:-1]
        s = s.rstrip() + "…"
    img = render_cached(font, s, color)
    r = img.get_rect(**{anchor: (S(pos[0]), S(pos[1]))})
    surf.blit(img, r)
    return LR(r)


def wrap(font, s, width, max_lines=None):
    lines = []
    for para in (s or "").replace("\r", "").split("\n"):
        cur = ""
        for w in para.split():
            t = (cur + " " + w).strip()
            if measure(font, t) <= width:
                cur = t
                continue
            if cur:
                lines.append(cur)
            cur = w
            while measure(font, cur) > width and len(cur) > 1:   # unbreakable (CJK) run
                k = len(cur)
                while k > 1 and measure(font, cur[:k]) > width:
                    k -= 1
                lines.append(cur[:k])
                cur = cur[k:]
        lines.append(cur)
    # drop blank paragraph gaps beyond one
    lines = [l for i, l in enumerate(lines) if l or (i and lines[i - 1])]
    while lines and not lines[-1]:
        lines.pop()
    if max_lines and len(lines) > max_lines:
        lines = lines[:max_lines]
        last = lines[-1]
        while last and measure(font, last + "…") > width:
            last = last[:-1]
        lines[-1] = last.rstrip() + "…"
    return lines


# --- controller styles -------------------------------------------------------
# Hints name *actions* with Xbox-ish tokens ("A" confirm, "B" back, "X"/"Y" the
# west/north buttons, "L"/"R", "L2 R2", "START", "SELECT"). PAD_STYLE turns a
# token into what is printed on the user's controller, by physical position, so
# the glyphs stay right with any style and with the confirm-button swap.
PAD_STYLE = {"style": "xbox", "ok": "south", "back": "east"}
FACE = {
    "xbox": {"south": ("A", (52, 211, 153)), "east": ("B", (248, 113, 113)),
             "west": ("X", (96, 165, 250)), "north": ("Y", (251, 191, 36))},
    "nintendo": {"south": ("B", (251, 191, 36)), "east": ("A", (248, 113, 113)),
                 "west": ("Y", (74, 222, 128)), "north": ("X", (96, 165, 250))},
    "playstation": {"south": ("cross", (125, 167, 230)), "east": ("circle", (236, 112, 112)),
                    "west": ("square", (226, 140, 205)), "north": ("triangle", (95, 205, 160))},
}
OTHER = {
    "xbox": {"L": "LB", "R": "RB", "L2 R2": "LT RT", "START": "Menu", "SELECT": "View"},
    "playstation": {"L": "L1", "R": "R1", "L2 R2": "L2 R2", "START": "Options", "SELECT": "Create"},
    "nintendo": {"L": "L", "R": "R", "L2 R2": "ZL ZR", "START": "+", "SELECT": "−"},
}
STYLE_NAMES = {"xbox": "Xbox", "playstation": "PlayStation", "nintendo": "Nintendo"}


def style_from_names(names):
    """Guess the label style from controller names SDL reports."""
    for n in names:
        n = (n or "").lower()
        if any(k in n for k in ("dualsense", "dualshock", "playstation", "ps3", "ps4", "ps5", "sony")):
            return "playstation"
        if any(k in n for k in ("nintendo", "pro controller", "joy-con", "joycon", "switch")):
            return "nintendo"
    return "xbox"


def pad_face(token):
    """(kind, text_or_shape, colour) for a hint token in the active style."""
    st = PAD_STYLE["style"]
    pos = {"A": PAD_STYLE["ok"], "B": PAD_STYLE["back"], "X": "west", "Y": "north"}.get(token)
    if pos:
        lab, col = FACE[st][pos]
        return ("shape" if st == "playstation" else "letter"), lab, col
    return "pill", OTHER[st].get(token, token), BTN_COL.get(token, DIM)


def pad_text(token):
    """Plain-text name of a button for prose ("Press Options to …")."""
    kind, lab, _ = pad_face(token)
    return {"cross": "Cross", "circle": "Circle", "square": "Square", "triangle": "Triangle"}.get(lab, lab)


def glyph_width(fonts, token):
    kind, lab, _ = pad_face(token)
    return 22 if kind in ("letter", "shape") else int(measure(fonts.btn, lab)) + 14


def button_glyph(surf, fonts, label, x, y):
    """Pad-button glyph in the active controller style; returns its width."""
    kind, lab, col = pad_face(label)
    cx, cy = x + 11, y + 11
    if kind == "letter":
        circle(surf, col, (cx, cy), 11)
        text(surf, fonts.btn, lab, (cx, cy), BG, "center")
        return 22
    if kind == "shape":                 # PlayStation symbols, drawn (no font has them all)
        circle(surf, BG2, (cx, cy), 11)
        circle(surf, col, (cx, cy), 11, 2)
        if lab == "cross":
            hline(surf, col, (cx - 4, cy - 4), (cx + 4, cy + 4), 2)
            hline(surf, col, (cx - 4, cy + 4), (cx + 4, cy - 4), 2)
        elif lab == "circle":
            circle(surf, col, (cx, cy), 5, 2)
        elif lab == "square":
            rrect(surf, col, (cx - 4.5, cy - 4.5, 9, 9), 1, 2)
        else:
            polyline(surf, col, [(cx, cy - 5), (cx + 5, cy + 4), (cx - 5, cy + 4), (cx, cy - 5)], 2)
        return 22
    w = int(measure(fonts.btn, lab)) + 14
    rrect(surf, col, (x, y + 1, w, 20), 10)
    text(surf, fonts.btn, lab, (x + w // 2, y + 11), BG, "center")
    return w


def as_rgba(img):
    """Covers can be palette / 8-bit images (GIF-ish PNGs); smoothscale only
    takes 24/32-bit surfaces, so normalise once at load."""
    if img.get_bitsize() in (24, 32):
        return img
    out = pygame.Surface(img.get_size(), pygame.SRCALPHA, 32)
    out.blit(img, (0, 0))
    return out


def smooth_scale(img, size):
    try:
        return pygame.transform.smoothscale(img, size)
    except ValueError:                    # any other odd format: plain scale, never crash
        return pygame.transform.scale(img, size)


class Sfx:
    """Small UI sounds, synthesised at start-up (no audio files): soft sine
    blips with a fast attack and exponential decay. Every failure is silent —
    a box without audio just stays quiet."""
    # name: (notes in Hz, ms per note, peak amplitude, wave)
    SPEC = {
        "move": ((1046,), 26, 0.09, "sine"),
        "page": ((784, 988), 22, 0.10, "sine"),
        "ok": ((784, 1175), 42, 0.14, "sine"),
        "back": ((1175, 784), 42, 0.12, "sine"),
        "toggle": ((988,), 40, 0.12, "sine"),
        "deny": ((196, 185), 70, 0.14, "triangle"),
        "queued": ((659, 880), 55, 0.13, "sine"),
        "done": ((523, 659, 784, 1046), 70, 0.12, "sine"),
    }
    LEVEL = {"normal": 1.0, "quiet": 0.4, "off": 0.0}

    def __init__(self, level="normal"):
        self.sounds, self.channels = {}, {}
        self.level = self.LEVEL.get(level, 1.0)
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(44100, -16, 2, 512)
            pygame.mixer.set_num_channels(max(8, len(self.SPEC)))
            for i, (name, spec) in enumerate(self.SPEC.items()):
                self.sounds[name] = pygame.mixer.Sound(file=self._wav(*spec))
                self.channels[name] = pygame.mixer.Channel(i)
        except Exception as e:                 # no audio device, no mixer: stay silent
            rommlib.log("sound off: %s" % e.__class__.__name__)
            self.sounds = {}

    @staticmethod
    def _wav(notes, ms, amp, wave_kind, rate=44100):
        import io
        import math
        import struct
        import wave
        n = int(rate * ms / 1000)
        out = []
        for k, f in enumerate(notes):
            for i in range(n):
                t = i / rate
                ph = (f * t) % 1.0
                v = math.sin(2 * math.pi * ph) if wave_kind == "sine" else (4 * abs(ph - 0.5) - 1)
                env = min(1.0, i / (rate * 0.002)) * math.exp(-5.0 * i / n)   # 2 ms attack, decay
                out.append(int(32767 * amp * env * v))
        tail = int(rate * 0.01)                 # 10 ms of silence: no click at the end
        out += [0] * tail
        buf = io.BytesIO()
        with wave.open(buf, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(rate)
            w.writeframes(struct.pack("<%dh" % len(out), *out))
        buf.seek(0)
        return buf

    def set_level(self, level):
        self.level = self.LEVEL.get(level, 1.0)

    def play(self, name):
        snd = self.sounds.get(name)
        if not snd or not self.level:
            return
        try:
            snd.set_volume(self.level)
            self.channels[name].play(snd)        # one channel per sound: repeats restart, never pile up
        except Exception:
            pass


SOUND_FOR = {"up": "move", "down": "move", "left": "move", "right": "move",
             "l1": "page", "r1": "page", "l2": "page", "r2": "page",
             "ok": "ok", "x": "ok", "y": "ok", "start": "ok", "select": "ok", "back": "back"}


def rom_title(rom):
    """The rom's name, plus its disc number when RomM gives every disc of a
    game the same name ("Final Fantasy VII" ×3)."""
    name = rom.get("name") or rom.get("fs_name_no_ext") or ""
    d = rommlib.disc_info(rom.get("fs_name_no_ext") or "")
    if d and not rommlib.disc_info(name):
        return "%s (Disc %d)" % (name, d[1])
    return name


GLYPH_RE = re.compile(r"\{(A|B|X|Y|L|R|L2 R2|START|SELECT)\}")


def rich_text(surf, fonts, font, s, pos, color=TEXT, anchor="topleft"):
    """Text with inline pad glyphs: "Press {START} to see all results" draws
    the same glyph the hint bar uses, in the active controller style, so
    prose and hints always match. Supports topleft/midleft anchors."""
    parts = GLYPH_RE.split(s)            # text, token, text, token, ...
    lh = font.get_height() / K
    x, y = pos
    top = y - lh / 2 if anchor == "midleft" else y
    cy = top + lh / 2
    for i, part in enumerate(parts):
        if i % 2:
            x += button_glyph(surf, fonts, part, x, cy - 11) + 7
        else:
            if i > 0:
                part = part.lstrip()      # the glyph's own gap replaces the space
            if i + 1 < len(parts):
                part = part.rstrip()
            if part:
                r = text(surf, font, part, (x, cy), color, "midleft")
                x = r.right + (7 if i + 1 < len(parts) else 0)
    return pygame.Rect(pos[0], top, x - pos[0], lh)


def progress_bar(surf, rect, frac, color=ACCENT):
    rrect(surf, LINE, rect, rect[3] // 2)
    if frac > 0:
        w = max(rect[3], int(rect[2] * min(1.0, frac)))
        rrect(surf, color, (rect[0], rect[1], w, rect[3]), rect[3] // 2)


# -------------------------------------------------------------------- input

class Input:
    """Maps keyboard, SDL game controllers and raw joysticks to actions.
    Game controllers use SDL's standard layout, so a DualSense and an 8BitDo
    behave the same. Batocera's ES confirms with the south button; swap_ab in
    config.json flips that."""
    REPEAT_DELAY, REPEAT_RATE = 0.32, 0.055

    NAV_KEYS = None   # filled lazily (pygame constants need pygame imported)

    def __init__(self, swap_ab):
        self.set_swap(swap_ab)
        self.pad_seen = False   # once a pad speaks, ignore keyboard nav (evmapy echoes)
        self.controllers = {}
        self.joysticks = {}
        self.held = {}
        self.axis_dir = {}
        if sdlcontroller is not None:
            sdlcontroller.init()
        for i in range(pygame.joystick.get_count()):
            self._open(i)

    def set_swap(self, swap_ab):
        self.ok_btn, self.back_btn = ("east", "south") if swap_ab else ("south", "east")
        PAD_STYLE["ok"], PAD_STYLE["back"] = self.ok_btn, self.back_btn

    def names(self):
        out = []
        for j in list(self.joysticks.values()):
            try:
                out.append(j.get_name())
            except Exception:
                pass
        for jid in self.controllers:
            for i in range(pygame.joystick.get_count()):
                try:
                    js = pygame.joystick.Joystick(i)
                    if js.get_instance_id() == jid:
                        out.append(js.get_name())
                except Exception:
                    pass
        return out

    def _open(self, index):
        try:
            if sdlcontroller is not None and sdlcontroller.is_controller(index):
                c = sdlcontroller.Controller(index)
                jid = pygame.joystick.Joystick(index).get_instance_id()
                self.controllers[jid] = c
                return
        except Exception:
            pass
        try:
            j = pygame.joystick.Joystick(index)
            j.init()
            self.joysticks[j.get_instance_id()] = j
        except Exception:
            pass

    def _face(self, name):
        if name == self.ok_btn:
            return "ok"
        if name == self.back_btn:
            return "back"
        return {"west": "x", "north": "y"}.get(name)

    def _press(self, action, out):
        if action in ("up", "down", "left", "right", "l1", "r1", "l2", "r2"):
            self.held[action] = time.time() + self.REPEAT_DELAY
        out.append(action)

    def _release(self, action):
        self.held.pop(action, None)

    def handle(self, ev, out):
        t = ev.type
        if t in (pygame.CONTROLLERBUTTONDOWN, pygame.JOYBUTTONDOWN, pygame.JOYHATMOTION):
            self.pad_seen = True
        if t in (pygame.KEYDOWN, pygame.KEYUP) and self.pad_seen and \
                not (ev.key == pygame.K_F4 and ev.mod & pygame.KMOD_ALT):
            # Batocera's evmapy turns the pad into keypresses for pygame apps
            # (D-pad -> arrows, Start -> Enter, X/Y -> X/Y): we already read
            # the pad itself, so those would double every press.
            # rommbrowser.pygame.keys turns that mapping off; this is the
            # belt-and-braces for boxes where it isn't installed.
            return
        if t == pygame.KEYDOWN:
            km = {pygame.K_UP: "up", pygame.K_DOWN: "down", pygame.K_LEFT: "left",
                  pygame.K_RIGHT: "right", pygame.K_RETURN: "ok", pygame.K_SPACE: "ok",
                  pygame.K_ESCAPE: "back", pygame.K_BACKSPACE: "back", pygame.K_x: "x",
                  pygame.K_y: "y", pygame.K_PAGEUP: "l1", pygame.K_PAGEDOWN: "r1",
                  pygame.K_TAB: "select", pygame.K_HOME: "start",
                  pygame.K_LEFTBRACKET: "l2", pygame.K_RIGHTBRACKET: "r2"}
            if ev.key == pygame.K_F4 and ev.mod & pygame.KMOD_ALT:
                out.append("quit")
            elif ev.key in km:
                self._press(km[ev.key], out)
        elif t == pygame.KEYUP:
            for a in ("up", "down", "left", "right", "l1", "r1", "l2", "r2"):
                self._release(a)
        elif sdlcontroller is not None and t == pygame.CONTROLLERDEVICEADDED:
            self._open(ev.device_index)
            out.append("padchange")
        elif t == pygame.JOYDEVICEADDED:
            # plain joysticks (no SDL mapping) only announce themselves here
            self._open(ev.device_index)
            out.append("padchange")
        elif t in (pygame.CONTROLLERBUTTONDOWN, pygame.CONTROLLERBUTTONUP):
            m = {pygame.CONTROLLER_BUTTON_A: "south", pygame.CONTROLLER_BUTTON_B: "east",
                 pygame.CONTROLLER_BUTTON_X: "west", pygame.CONTROLLER_BUTTON_Y: "north",
                 pygame.CONTROLLER_BUTTON_DPAD_UP: "up",
                 pygame.CONTROLLER_BUTTON_DPAD_DOWN: "down",
                 pygame.CONTROLLER_BUTTON_DPAD_LEFT: "left",
                 pygame.CONTROLLER_BUTTON_DPAD_RIGHT: "right",
                 pygame.CONTROLLER_BUTTON_LEFTSHOULDER: "l1",
                 pygame.CONTROLLER_BUTTON_RIGHTSHOULDER: "r1",
                 pygame.CONTROLLER_BUTTON_START: "start",
                 pygame.CONTROLLER_BUTTON_BACK: "select",
                 pygame.CONTROLLER_BUTTON_GUIDE: "guide"}
            name = m.get(ev.button)
            if name in ("south", "east", "west", "north"):
                name = self._face(name)
            if name:
                if t == pygame.CONTROLLERBUTTONDOWN:
                    self._press(name, out)
                else:
                    self._release(name)
        elif t == pygame.CONTROLLERAXISMOTION:
            if ev.axis in (pygame.CONTROLLER_AXIS_LEFTX, pygame.CONTROLLER_AXIS_LEFTY):
                self._axis(("c", ev.instance_id, ev.axis), ev.axis == pygame.CONTROLLER_AXIS_LEFTX,
                           ev.value / 32767.0, out)
            elif ev.axis in (pygame.CONTROLLER_AXIS_TRIGGERLEFT, pygame.CONTROLLER_AXIS_TRIGGERRIGHT):
                key = ("t", ev.instance_id, ev.axis)
                on = ev.value > 16000
                trig = "l2" if ev.axis == pygame.CONTROLLER_AXIS_TRIGGERLEFT else "r2"
                if on and not self.axis_dir.get(key):
                    self._press(trig, out)
                elif not on and self.axis_dir.get(key):
                    self._release(trig)
                self.axis_dir[key] = on
        # raw joystick fallback (only for devices SDL has no mapping for)
        elif t in (pygame.JOYBUTTONDOWN, pygame.JOYBUTTONUP):
            if ev.instance_id in self.controllers:
                return
            m = {0: "south", 1: "east", 2: "west", 3: "north", 4: "l1", 5: "r1",
                 6: "select", 7: "start", 8: "select", 9: "start"}
            name = m.get(ev.button)
            if name in ("south", "east", "west", "north"):
                name = self._face(name)
            if name:
                if t == pygame.JOYBUTTONDOWN:
                    self._press(name, out)
                else:
                    self._release(name)
        elif t == pygame.JOYHATMOTION:
            if ev.instance_id in self.controllers:
                return
            x, y = ev.value
            for a in ("up", "down", "left", "right"):
                self._release(a)
            if y == 1:
                self._press("up", out)
            elif y == -1:
                self._press("down", out)
            if x == -1:
                self._press("left", out)
            elif x == 1:
                self._press("right", out)
        elif t == pygame.JOYAXISMOTION:
            if ev.instance_id in self.controllers or ev.axis > 1:
                return
            self._axis(("j", ev.instance_id, ev.axis), ev.axis == 0, ev.value, out)

    def _axis(self, key, horizontal, v, out):
        d = None
        if v < -0.6:
            d = "left" if horizontal else "up"
        elif v > 0.6:
            d = "right" if horizontal else "down"
        prev = self.axis_dir.get(key)
        if d == prev:
            return
        if prev:
            self._release(prev)
        if d:
            self._press(d, out)
        self.axis_dir[key] = d

    def repeats(self, out):
        now = time.time()
        for a, due in list(self.held.items()):
            if now >= due:
                out.append(a)
                self.held[a] = now + self.REPEAT_RATE


# ------------------------------------------------------------------- app

class App:
    def __init__(self, screen, headless=False):
        global K
        self.screen = screen
        if screen is not None:
            sw, sh = screen.get_size()
            K = min(sw / W, sh / H)
        else:
            K = float(os.environ.get("ROMM_BROWSER_SCALE", "1"))
        self.fps = FPS if K <= 1.5 else 30   # 4K software blits: 30 fps is plenty for menus
        self.canvas = pygame.Surface((S(W), S(H)))
        self.scaled_covers = {}
        self.fonts = Fonts()
        self.cfg = rommlib.load_config()
        self.sfx = Sfx(self.cfg.get("sounds", "normal") if screen is not None else "off")
        self.input = Input(self.cfg.get("swap_ab"))
        self.headless = headless
        self.api = rommlib.Api.from_config(self.cfg)
        self.loaded = False
        self.junk = None              # filename tags hidden by "Hide prototypes, demos & hacks"
        self.update_tag = None
        self.library = rommlib.Library()
        self.downloader = rommlib.Downloader(self.api, self.library, self.cfg)
        self.platforms = []          # mapped platforms only
        self.platform_by_id = {}
        self.unmapped = []
        self.stack = []
        self.toasts = []
        self.modal = None
        self.events_from_threads = []
        self.lock = threading.Lock()
        self.covers = {}             # rom_id -> Surface | "loading" | None
        self.cover_order = []
        self.running = True
        self.status = "Connecting…"
        self.error = None
        self.t = 0.0
        self._chd_spawned = 0

    # ---- threading helpers
    def bg(self, fn, done=None, err=None):
        def run():
            try:
                res = fn()
                if done:
                    self.post(lambda: done(res))
            except Exception as e:
                if not isinstance(e, rommlib.RommError):
                    # foreign exception text can carry request details: type only
                    e = rommlib.RommError("Error (%s)" % e.__class__.__name__)
                rommlib.log("bg error: %s" % e)
                # bind e now: Python 3 deletes `e` when the except block ends
                if err:
                    self.post(lambda e=e: err(e))
                else:
                    self.post(lambda e=e: self.toast(str(e), RED))
        threading.Thread(target=run, daemon=True).start()

    def post(self, fn):
        with self.lock:
            self.events_from_threads.append(fn)

    def toast(self, msg, color=TEXT):
        self.toasts.append([msg, color, time.time() + 3.5])
        if color == RED:
            self.sfx.play("deny")
        elif msg.startswith("Ready"):
            self.sfx.play("done")
        elif msg.startswith("Queued"):
            self.sfx.play("queued")

    # ---- data
    def load_platforms(self):
        def done(plats):
            mp = dict(rommlib.PLATFORM_MAP)
            mp.update(self.cfg.get("platform_map") or {})
            self.platforms, self.unmapped = [], []
            for p in plats:
                system = mp.get(p["fs_slug"])
                p["_system"] = system
                if not p.get("rom_count"):
                    continue
                (self.platforms if system else self.unmapped).append(p)
            self.platforms.sort(key=lambda p: (p.get("display_name") or p["name"]).lower())
            self.platform_by_id = {p["id"]: p for p in self.platforms}
            self.status = "Online"
            self.error = None
            self.loaded = True

        def err(e):
            self.status = "Offline"
            self.error = str(e)
        self.bg(self.api.platforms, done, err)

    def system_for(self, rom):
        p = self.platform_by_id.get(rom.get("platform_id"))
        return p["_system"] if p else None

    def cover(self, rom):
        rid = rom["id"]
        c = self.covers.get(rid)
        if c is not None or rid in self.covers:
            return None if c == "loading" else c
        self.covers[rid] = "loading"
        self.cover_order.append(rid)
        if len(self.cover_order) > 160:
            old = self.cover_order.pop(0)
            self.covers.pop(old, None)

        def load():
            path = self.api.fetch_cover(rom, large=K > 1.5)
            return as_rgba(pygame.image.load(path)) if path else None

        def done(img):
            self.covers[rid] = img
        self.bg(load, done, lambda e: self.covers.__setitem__(rid, None))
        return None

    def resolve_style(self):
        want = self.cfg.get("button_style") or "auto"
        PAD_STYLE["style"] = want if want in FACE else style_from_names(self.input.names())
        return PAD_STYLE["style"]

    def apply_config(self, reconnect=False):
        """Called by Settings after a change: persist, re-wire live objects."""
        rommlib.save_config(self.cfg)
        self.input.set_swap(self.cfg.get("swap_ab"))
        self.resolve_style()
        if reconnect:
            self.api = rommlib.Api.from_config(self.cfg)
            self.downloader.api = self.api
            self.covers.clear()
            self.scaled_covers.clear()
            self.platforms, self.platform_by_id, self.loaded = [], {}, False
            self.status, self.error = "Connecting…", None
            self.load_platforms()

    def uninstall(self, rom, system, then=None):
        def done(res):
            paths, freed = res
            self.toast("Deleted %s — %s freed" % (rom.get("name"), human_size(freed)), GREEN)
            if then:
                then()
        self.bg(lambda: self.library.uninstall(rom, system), done)

    def start_download(self, rom):
        system = self.system_for(rom)
        if not system:
            self.toast("No Batocera system for this platform", RED)
            return
        self.downloader.enqueue(rom, system)
        self.toast("Queued: %s" % rom_title(rom), GREEN)

    def set_title(self, rom):
        name = rom.get("name") or rom.get("fs_name_no_ext") or ""
        d = rommlib.disc_info(name)
        return d[0] if d else name

    def make_group(self, rom, discs):
        plat = self.platform_by_id.get(rom.get("platform_id")) or {}
        return rommlib.disc_group(plat.get("fs_slug") or str(rom.get("platform_id")), discs,
                                  self.set_title(rom))

    def queue_set(self, group, items, system):
        """items: [(rom, system)] of one disc set. Discs already on the box
        join the set instead of downloading again. Returns discs queued."""
        lib, dl = self.library, self.downloader
        queued = 0
        for r, _ in items:
            j = dl.job_for(r["id"])
            if j and j.active:
                j.group = group
                continue
            if lib.is_installed(r, system) and lib.adopt(r, system, group):
                continue
            dl.enqueue(r, system, group)
            queued += 1
        if not queued:                       # everything already here: just make the playlist
            self.bg(lambda: dl._finish_group(group, system),
                    lambda m3u: self.toast("Playlist made: %s" % os.path.basename(m3u) if m3u
                                           else "All discs are already on this box", GREEN))
        dl.save_queue()
        return queued

    def download_set(self, rom, discs):
        system = self.system_for(rom)
        group = self.make_group(rom, discs)
        n = self.queue_set(group, [(r, system) for _, r in discs], system)
        if n:
            self.toast("Queued %d disc%s: %s" % (n, "" if n == 1 else "s", group["title"]), GREEN)

    def expand_sets(self, items):
        """Bulk downloads: give every disc its whole set (found in RomM) and
        a shared group. Runs in a worker thread. Returns [(group|None, [(rom, system)])]."""
        out, seen = [], {}
        for r, sy in items:
            d = rommlib.disc_info(r.get("fs_name_no_ext") or "")
            if not d:
                out.append((None, [(r, sy)]))
                continue
            key = (r.get("platform_id"), d[0].lower())
            if key in seen:
                continue
            discs, _ = rommlib.find_disc_set(self.api, r)
            if not discs or len(discs) < 2:
                out.append((None, [(r, sy)]))
                continue
            seen[key] = True
            out.append((self.make_group(r, discs), [(x, sy) for _, x in discs]))
        return out

    def spawn_helper(self, script):
        try:
            subprocess.Popen(["/usr/bin/python3" if os.path.exists("/usr/bin/python3")
                              else sys.executable, os.path.join(APP_DIR, script)],
                             start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             close_fds=True)
        except OSError as e:
            rommlib.log("spawn %s failed: %r" % (script, e))

    # ---- navigation
    def push(self, screen):
        self.stack.append(screen)
        screen.enter()

    def pop(self):
        if len(self.stack) > 1:
            self.stack.pop()
            self.stack[-1].enter()

    def request_quit(self):
        n = self.downloader.active_count()
        if n and not self.cfg.get("background_downloads", True):
            self.modal = Confirm(self, "Quit RomM Browser?",
                                 "%d download%s still running. They're paused and resume "
                                 "next time you open RomM Browser (or turn on \"Keep "
                                 "downloading after exit\" in Settings)." % (n, "s" if n > 1 else ""),
                                 "Quit", self._quit, danger=True)
        else:
            self._quit()

    def _quit(self):
        self.running = False

    # ---- main loop
    def _update_found(self, tag):
        if not tag:
            return
        self.update_tag = tag
        seen = os.path.join(rommlib.DATA_DIR, ".update-notified")
        try:
            if open(seen).read().strip() == tag:
                return
        except OSError:
            pass
        self.toast("romm-o-cera %s is out. Settings shows how to update." % tag, BLUE)
        try:
            with open(seen, "w") as f:
                f.write(tag)
        except OSError:
            pass

    def on_pad_change(self):
        if (self.cfg.get("button_style") or "auto") == "auto":
            self.resolve_style()

    def take_over_downloads(self):
        """A background rb_dl.py may still be working: ask it to hand over,
        then resume whatever is queued (here or left from last time)."""
        self.bg(self.downloader.repair_groups, lambda n: None, lambda e: None)
        try:
            import rb_dl
            was_running = rb_dl.handover()
        except Exception as e:
            rommlib.log("handover: %r" % e)
            was_running = False
        n = self.downloader.resume()
        if n and self.downloader.hold:
            self.toast("%d download%s waiting — paused (Downloads, X resumes)" % (n, "" if n == 1 else "s"), AMBER)
        elif n:
            self.toast("Resumed %d download%s%s" % (n, "" if n == 1 else "s",
                                                    " from the background" if was_running else ""), BLUE)

    def run(self, scripted=None):
        clock = pygame.time.Clock()
        self.resolve_style()
        self.take_over_downloads()
        self.load_platforms()
        if not self.headless:
            self.bg(lambda: rommlib.newer_release(self.cfg), self._update_found, lambda e: None)
        self.push(HomeScreen(self))
        while self.running:
            dt = clock.tick(self.fps) / 1000.0
            self.t += dt
            actions = []
            for ev in pygame.event.get():
                if ev.type == pygame.QUIT:
                    actions.append("quit")
                else:
                    self.input.handle(ev, actions)
            self.input.repeats(actions)
            if scripted is not None:
                actions += scripted(self)
            with self.lock:
                fns, self.events_from_threads = self.events_from_threads, []
            for fn in fns:
                fn()
            for a in actions:
                self.dispatch(a)
            self.tick_downloads()
            self.draw()
        self.on_exit()

    def dispatch(self, a):
        snd = SOUND_FOR.get(a)
        if snd:
            self.sfx.play(snd)
        if a == "padchange":
            self.on_pad_change()
            return
        if a == "quit":
            self.request_quit()
            return
        if self.modal:
            self.modal.action(a)
            return
        if a == "select" and not isinstance(self.stack[-1], DownloadsScreen):
            self.push(DownloadsScreen(self))
            return
        if a == "start" and len(self.stack) > 1 and not getattr(self.stack[-1], "own_start", False):
            del self.stack[1:]
            self.stack[0].enter()
            return
        self.stack[-1].action(a)

    def tick_downloads(self):
        for j in self.downloader.jobs:
            if j.state == rommlib.Job.DONE and not getattr(j, "_announced", False):
                j._announced = True
                self.toast("Ready: %s" % j.label, GREEN)
                for scr in self.stack:
                    scr.__dict__.pop("_variants", None)
                if j.chd_queued and not self.headless:
                    self.spawn_helper("rb_chd.py")   # flock'd: no-op if already running
            elif j.state == rommlib.Job.FAILED and not getattr(j, "_announced", False):
                j._announced = True
                self.toast("Failed: %s — %s" % (j.label, j.message), RED)

    def on_exit(self):
        pending = 0 if self.downloader.hold else self.downloader.pending_count()
        self.downloader.pause_all()          # keeps them in download-queue.json
        if self.headless:
            return
        if pending and self.cfg.get("background_downloads", True):
            self.spawn_helper("rb_dl.py")     # finishes the queue while you play
            return                            # it runs CHD + gamelist merge when done
        if os.path.exists(rommlib.GAMELIST_QUEUE):
            self.spawn_helper("rb_finalize.py")
        if os.path.isdir(rommlib.CHD_QUEUE_DIR) and os.listdir(rommlib.CHD_QUEUE_DIR):
            self.spawn_helper("rb_chd.py")

    # ---- drawing
    def draw(self):
        c = self.canvas
        c.fill(BG)
        # subtle top glow
        rrect(c, BG2, (0, 0, W, 64), 0)
        hline(c, LINE, (0, 64), (W, 64))
        top = self.stack[-1]
        # logo
        rrect(c, ACCENT, (24, 16, 34, 34), 9)
        text(c, self.fonts.h3, "R", (41, 33), TEXT, "center")
        text(c, self.fonts.h2, "RomM", (68, 33), TEXT, "midleft")
        x = 68 + int(measure(self.fonts.h2, "RomM")) + 14
        for crumb in top.crumbs():
            text(c, self.fonts.h3, "›", (x, 32), FAINT, "midleft")
            x += 18
            r = text(c, self.fonts.h3, crumb, (x, 33), DIM, "midleft", maxw=380)
            x = r.right + 12
        # right side status
        n = self.downloader.active_count()
        rx = W - 24
        dot = GREEN if self.status == "Online" else (AMBER if self.status.startswith("Conn") else RED)
        r = text(c, self.fonts.small, self.status, (rx, 33), DIM, "midright")
        circle(c, dot, (r.left - 12, 33), 5)
        rx = r.left - 30
        if n:
            j = next((j for j in self.downloader.jobs if j.state == rommlib.Job.DOWNLOADING), None)
            label = "%d in queue" % n + (", %s/s" % human_size(j.speed) if j and j.speed else "")
            r = text(c, self.fonts.small, label, (rx, 33), BLUE, "midright")
        top.draw(c)
        # footer
        hline(c, LINE, (0, H - 46), (W, H - 46))
        fx = 24
        for btn, label in top.hints():
            fx += button_glyph(c, self.fonts, btn, fx, H - 34) + 8
            r = text(c, self.fonts.small, label, (fx, H - 23), DIM, "midleft")
            fx = r.right + 22
        # right side: the two global buttons, then the version
        rx = W - 24
        r = text(c, self.fonts.small, "v" + rommlib.VERSION, (rx, H - 23), FAINT, "midright")
        rx = r.left - 28
        globals_ = [("START", "Home"), ("SELECT", "Downloads")]
        if getattr(top, "own_start", False) or len(self.stack) == 1:
            globals_ = [g for g in globals_ if g[0] != "START"]     # Start means something else here
        if isinstance(top, DownloadsScreen):
            globals_ = [g for g in globals_ if g[0] != "SELECT"]
        for btn, label in globals_:
            r = text(c, self.fonts.small, label, (rx, H - 23), DIM, "midright")
            gw = glyph_width(self.fonts, btn)
            button_glyph(c, self.fonts, btn, r.left - 8 - gw, H - 34)
            rx = r.left - 8 - gw - 22
        if self.modal:
            self.modal.draw(c)
        self.draw_toasts(c)
        if self.screen is not None:
            # canvas is already native-resolution; just centre it (letterbox if
            # the screen isn't 16:9)
            sw, sh = self.screen.get_size()
            cw, ch = c.get_size()
            if (sw, sh) != (cw, ch):
                self.screen.fill(BG)
            self.screen.blit(c, ((sw - cw) // 2, (sh - ch) // 2))
            pygame.display.flip()

    def draw_toasts(self, c):
        now = time.time()
        self.toasts = [t for t in self.toasts if t[2] > now][-3:]
        y = H - 64
        for msg, color, _ in reversed(self.toasts):
            w = min(900, measure(self.fonts.body, msg) + 52)
            r = pygame.Rect(0, 0, w, 40)
            r.midbottom = (W // 2, y)
            rrect(c, PANEL_HI, r, 20)
            circle(c, color, (r.left + 18, r.centery), 5)
            text(c, self.fonts.body, msg, (r.left + 30, r.centery), TEXT, "midleft", maxw=w - 44)
            y -= 48


# ------------------------------------------------------------------ screens

class Screen:
    def __init__(self, app):
        self.app = app
        self.f = app.fonts

    def enter(self):
        pass

    def crumbs(self):
        return []

    def hints(self):
        return [("A", "Select"), ("B", "Back")]

    def action(self, a):
        if a == "back":
            self.app.pop()

    def draw(self, c):
        pass


class HomeScreen(Screen):
    ITEMS = [("search", "Search", "Find any game across every platform"),
             ("platforms", "Platforms", "Browse by console"),
             ("collections", "Collections", "Series, Top-N lists and themes"),
             ("recent", "Recently added", "Newest games in the library"),
             ("downloads", "Downloads", "Queue and progress"),
             ("installed", "On this box", "Your games, sizes, and a check for damaged ones"),
             ("settings", "Settings", "Server, token, buttons, CHD, cache"),
             ("exit", "Exit", "Back to EmulationStation")]

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.free = None

    def enter(self):
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
            self.free = st.f_bavail * st.f_frsize
        except OSError:
            self.free = None

    def hints(self):
        return [("A", "Select"), ("B", "Exit")]

    def action(self, a):
        if a == "up":
            self.sel = (self.sel - 1) % len(self.ITEMS)
        elif a == "down":
            self.sel = (self.sel + 1) % len(self.ITEMS)
        elif a == "back":
            self.app.request_quit()
        elif a == "ok":
            key = self.ITEMS[self.sel][0]
            app = self.app
            if key == "exit":
                app.request_quit()
            elif key == "settings":
                app.push(SettingsScreen(app))
            elif key == "installed":
                app.push(InstalledScreen(app))
            elif not app.platforms and key not in ("downloads",):
                app.load_platforms()
                msg = app.error or ("No RomM platform maps to a Batocera system"
                                    if app.loaded else "Still loading platforms…")
                app.toast(msg, AMBER)
            elif key == "search":
                app.push(SearchScreen(app))
            elif key == "platforms":
                app.push(PlatformScreen(app))
            elif key == "collections":
                app.push(CollectionScreen(app))
            elif key == "recent":
                app.push(GameListScreen(app, "Recently added", order_by="id_desc"))
            elif key == "downloads":
                app.push(DownloadsScreen(app))

    def draw(self, c):
        y = 84
        for i, (key, label, sub) in enumerate(self.ITEMS):
            r = pygame.Rect(48, y, 520, 64)
            on = i == self.sel
            if on:
                focus_box(c, r, 14)
            else:
                rrect(c, PANEL, r, 14)
            text(c, self.f.h2, label, (r.left + 28, r.top + 8), TEXT if on else DIM)
            extra = ""
            if key == "downloads":
                n = self.app.downloader.active_count()
                extra = (", %d running" % n) if n else ""
            text(c, self.f.small, sub + extra, (r.left + 28, r.top + 38), DIM if on else FAINT)
            y += 71
        # right panel: a shelf of the newest box art — the library's own face
        p = pygame.Rect(616, 84, 616, 558)
        rrect(c, PANEL, p, 16)
        app = self.app
        if app.platforms:
            total = sum(pl["rom_count"] for pl in app.platforms)
            text(c, self.f.h2, "Recently added", (p.left + 28, p.top + 22), TEXT)
            text(c, self.f.small, "{:,} games on {} platforms".format(total, len(app.platforms)),
                 (p.right - 28, p.top + 28), FAINT, "topright")
            self.load_recent()
            cw, ch, gap = 128, 172, 16
            x0 = p.left + (p.width - (4 * cw + 3 * gap)) // 2
            for k, rom in enumerate((self.recent or [])[:8]):
                cr = pygame.Rect(x0 + (k % 4) * (cw + gap), p.top + 70 + (k // 4) * (ch + gap), cw, ch)
                img = app.cover(rom)
                if img:
                    sc = self.shelf.get(rom["id"])
                    if sc is None or sc[0] is not img:
                        pc = SR(cr)
                        iw, ih = img.get_size()
                        f = max(pc.width / iw, pc.height / ih)      # fill the slot, crop overflow
                        scaled = smooth_scale(img, (max(1, int(iw * f)), max(1, int(ih * f))))
                        crop = pygame.Rect(0, 0, pc.width, pc.height)
                        crop.center = scaled.get_rect().center
                        sc = (img, scaled.subsurface(crop.clip(scaled.get_rect())).copy())
                        self.shelf[rom["id"]] = sc
                    c.blit(sc[1], SR(cr).topleft)
                else:
                    rrect(c, BG2, cr, 8)
                    for j, ln in enumerate(wrap(self.f.small, rom.get("name") or "", cw - 16, 4)):
                        text(c, self.f.small, ln, (cr.left + 8, cr.top + 10 + j * 20), FAINT)
            if self.recent == []:
                text(c, self.f.body, "Nothing new yet.", (p.left + 28, p.top + 80), DIM)
        elif app.error:
            text(c, self.f.h2, "Can't reach RomM", (p.left + 28, p.top + 22), RED)
            for i, line in enumerate(wrap(self.f.body, app.error, p.width - 56, 4)):
                text(c, self.f.body, line, (p.left + 28, p.top + 66 + i * 26), DIM)
            text(c, self.f.small, rommlib.display_url(app.cfg.get("url")) or "No server set",
                 (p.left + 28, p.top + 180), FAINT)
            text(c, self.f.small, "Check Settings, then select any item to retry.",
                 (p.left + 28, p.top + 206), FAINT)
        else:
            text(c, self.f.h2, "Loading…", (p.left + 28, p.top + 22), DIM)
        # panel foot: this box and the server, as plain sentences
        hline(c, LINE, (p.left + 28, p.bottom - 74), (p.right - 28, p.bottom - 74))
        if self.free is not None:
            text(c, self.f.h3, "%s free on this box" % human_size(self.free),
                 (p.left + 28, p.bottom - 38), TEXT, "midleft")
        u = rommlib.display_url(app.cfg.get("url")) or "No server set"
        insecure = u.lower().startswith("http://")
        text(c, self.f.small, u if insecure else u.split("://")[-1], (p.right - 28, p.bottom - 38),
             AMBER if insecure else DIM, "midright", maxw=270)

    recent = None
    shelf = None

    def load_recent(self):
        if self.recent is not None or getattr(self, "_recent_loading", False):
            return
        self._recent_loading = True
        app = self.app
        self.shelf = {}
        p = {"limit": 8, "offset": 0, "order_by": "id", "order_dir": "desc",
             "with_char_index": "false", "with_filter_values": "false", "with_rom_id_index": "false",
             "platform_ids": [pl["id"] for pl in app.platforms]}
        app.bg(lambda: app.api.get("/api/roms", p).get("items", []),
               lambda items: setattr(self, "recent", items),
               lambda e: setattr(self, "recent", []))


class PlatformScreen(Screen):
    COLS, CW, CH, GAP = 4, 284, 98, 14

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.scroll = 0

    def crumbs(self):
        return ["Platforms"]

    def action(self, a):
        n = len(self.app.platforms)
        if not n:
            return super().action(a)
        moves = {"left": -1, "right": 1, "up": -self.COLS, "down": self.COLS,
                 "l1": -self.COLS * 4, "r1": self.COLS * 4}
        if a in moves:
            self.sel = max(0, min(n - 1, self.sel + moves[a]))
        elif a == "ok":
            p = self.app.platforms[self.sel]
            self.app.push(GameListScreen(self.app, p.get("display_name") or p["name"],
                                         platform=p))
        elif a == "y":
            self.app.push(SearchScreen(self.app, platform=self.app.platforms[self.sel]))
        else:
            super().action(a)

    def hints(self):
        return [("A", "Open"), ("Y", "Search platform"), ("L", "Page up"),
                ("R", "Page down"), ("B", "Back")]

    def draw(self, c):
        plats = self.app.platforms
        x0, y0 = 48, 88
        rows_vis = 5
        row = self.sel // self.COLS
        if row < self.scroll:
            self.scroll = row
        elif row >= self.scroll + rows_vis:
            self.scroll = row - rows_vis + 1
        for i, p in enumerate(plats):
            r_i, c_i = divmod(i, self.COLS)
            if not (self.scroll <= r_i < self.scroll + rows_vis):
                continue
            r = pygame.Rect(x0 + c_i * (self.CW + self.GAP),
                            y0 + (r_i - self.scroll) * (self.CH + self.GAP), self.CW, self.CH)
            on = i == self.sel
            rrect(c, PANEL_HI if on else PANEL, r, 14)
            if on:
                rrect(c, ACCENT, r, 14, 2)
            name = p.get("display_name") or p["name"]
            lines = wrap(self.f.h3, name, r.width - 36, 2)
            for k, ln in enumerate(lines):
                text(c, self.f.h3, ln, (r.left + 18, r.top + 14 + k * 24), TEXT if on else DIM)
            text(c, self.f.small, "{:,} games".format(p["rom_count"]),
                 (r.left + 18, r.bottom - 28), DIM if on else FAINT)
            tag = "roms/" + p["_system"]
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - tw - 14, r.bottom - 30, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, FAINT, "center")
        # scrollbar
        total_rows = (len(plats) + self.COLS - 1) // self.COLS
        if total_rows > rows_vis:
            track = pygame.Rect(W - 20, y0, 4, rows_vis * (self.CH + self.GAP) - self.GAP)
            rrect(c, LINE, track, 2)
            h = max(30, track.height * rows_vis // total_rows)
            yy = track.top + (track.height - h) * self.scroll // (total_rows - rows_vis)
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)


def letter_of(name):
    """Jump-bucket for a title: A–Z, '#' for digits/symbols, else the first
    character itself (kana/kanji/hangul get their own buckets)."""
    for ch in (name or ""):
        if ch.isspace() or ch in "'\"[(~.!¡¿-_*":
            continue
        if ch.isdigit():
            return "#"
        if "a" <= ch.lower() <= "z":
            return ch.upper()
        return ch if ch.isalpha() else "#"
    return "#"


def letter_jump(starts, sel, forward):
    """starts: sorted [(index, label)]. Next/previous letter from sel; going
    back from inside a letter first returns to that letter's start."""
    if not starts:
        return None
    g = max((k for k, (i, _) in enumerate(starts) if i <= sel), default=0)
    if forward:
        return starts[g + 1] if g + 1 < len(starts) else None
    if sel > starts[g][0]:
        return starts[g]
    return starts[g - 1] if g > 0 else None


def draw_bubble(c, f, label, until, center):
    if label and time.time() < until:
        r = pygame.Rect(0, 0, 120, 120)
        r.center = center
        rrect(c, ACCENT, r, 24)
        text(c, f.h1, label, r.center, TEXT, "center")


KNOWN_KINDS = re.compile(r"^(top\s*\d+|theme|series)$", re.I)
VIRTUAL_TYPES = [("genre", "Genre"), ("franchise", "Franchise"), ("collection", "Series"),
                 ("company", "Company"), ("mode", "Game mode")]


def collection_kinds(names):
    """Prefixes ("Theme" in "Theme: Hidden Gems") that are real categories:
    a known word, or shared by 3+ collections. Anything else stays part of
    the name, so "Zelda: Best Of" isn't split into a tag."""
    counts = {}
    for n in names:
        if ":" in n:
            k = n.split(":", 1)[0].strip()
            counts[k.lower()] = counts.get(k.lower(), 0) + 1
    return {k for k, c in counts.items() if c >= 3 or KNOWN_KINDS.match(k)}


class CollectionScreen(Screen):
    """Top level: the user's collections (grouped by kind when the names use
    a "Kind: Name" convention), smart collections, and "Browse by" entries
    for RomM's virtual collections. With `vtype` set: one virtual type's list."""
    ROWS, ROW_H = 10, 54

    def __init__(self, app, vtype=None, vlabel=None):
        super().__init__(app)
        self.vtype, self.vlabel = vtype, vlabel
        self.items = None
        self.sel = 0
        self.scroll = 0
        if vtype:
            app.bg(lambda: app.api.virtual_collections(vtype), self._loaded_virtual,
                   lambda e: self._failed(e))
        else:
            app.bg(self._load_top, self._loaded_top, lambda e: self._failed(e))

    def _failed(self, e):
        self.items = []
        self.app.toast(str(e), RED)

    def _load_top(self):
        api = self.app.api
        regular = api.collections()
        try:
            smart = api.smart_collections()
        except rommlib.RommError:
            smart = []            # older RomM without smart collections
        return regular, smart

    def _loaded_top(self, res):
        regular, smart = res
        kinds = collection_kinds([c["name"] for c in regular])
        items = []
        for c in regular:
            if not c.get("rom_count"):
                continue
            name, kind = c["name"], ""
            if ":" in name and name.split(":", 1)[0].strip().lower() in kinds:
                kind, name = [x.strip() for x in name.split(":", 1)]
            group = "Top lists" if re.match(r"top\s*\d+", kind, re.I) else \
                {"theme": "Themes", "series": "Series"}.get(kind.lower(), kind or "Your collections")
            items.append({"name": name, "tag": kind, "group": group, "count": c["rom_count"],
                          "full": c["name"], "param": "collection_id", "id": c["id"]})
        order = {"Top lists": 0, "Themes": 1, "Series": 2}
        items.sort(key=lambda i: (order.get(i["group"], 3 if i["group"] != "Your collections" else 4),
                                  i["group"].lower(), i["name"].lower()))
        for c in sorted(smart, key=lambda c: c["name"].lower()):
            if c.get("rom_count"):
                items.append({"name": c["name"], "tag": "smart", "group": "Smart", "count": c["rom_count"],
                              "full": c["name"], "param": "smart_collection_id", "id": c["id"]})
        for vt, label in VIRTUAL_TYPES:
            items.append({"name": label, "tag": "", "group": "Browse by", "count": None,
                          "full": label, "vtype": vt})
        self.items = items

    def _loaded_virtual(self, cols):
        self.items = [{"name": c["name"], "tag": "", "group": self.vlabel, "count": c.get("rom_count"),
                       "full": c["name"], "param": "virtual_collection_id", "id": c["id"]}
                      for c in sorted(cols, key=lambda c: c["name"].lower()) if c.get("rom_count")]

    def groups(self):
        return [] if not self.items else list(dict.fromkeys(i["group"] for i in self.items))

    bubble, bubble_until = None, 0.0

    def letter_starts(self):
        """Only for plain alphabetical lists (a Browse-by list, or one group)."""
        if not self.items or (not self.vtype and len(self.groups()) > 1):
            return []
        out = []
        for i, it in enumerate(self.items):
            lab = letter_of(it["name"])
            if not out or out[-1][1] != lab:
                out.append((i, lab))
        return out

    def action(self, a):
        if not self.items:
            return super().action(a)
        n = len(self.items)
        mv = {"up": -1, "down": 1, "l1": -self.ROWS, "r1": self.ROWS}
        if a in mv:
            self.sel = max(0, min(n - 1, self.sel + mv[a]))
        elif a in ("l2", "r2"):
            hit = letter_jump(self.letter_starts(), self.sel, a == "r2")
            if hit:
                self.sel = hit[0]
                self.bubble, self.bubble_until = hit[1], time.time() + 0.7
        elif a in ("left", "right") and len(self.groups()) > 1:
            gs = self.groups()
            gi = gs.index(self.items[self.sel]["group"])
            gi = max(0, min(len(gs) - 1, gi + (1 if a == "right" else -1)))
            self.sel = next(i for i, it in enumerate(self.items) if it["group"] == gs[gi])
        elif a == "ok":
            it = self.items[self.sel]
            if it.get("vtype"):
                self.app.push(CollectionScreen(self.app, it["vtype"], it["name"]))
            else:
                self.app.push(GameListScreen(self.app, it["full"], collection=it))
        else:
            super().action(a)

    def hints(self):
        h = [("A", "Open"), ("L", "Page up"), ("R", "Page down")]
        if len(self.letter_starts()) > 1:
            h.append(("L2 R2", "A–Z"))
        return h + [("B", "Back")]

    def crumbs(self):
        if self.vtype:
            return ["Collections", self.vlabel]
        if self.items and len(self.groups()) > 1:
            return ["Collections", self.items[self.sel]["group"]]
        return ["Collections"]

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Loading…", (W // 2, H // 2), DIM, "center")
            return
        if not self.items:
            text(c, self.f.h2, "No collections", (W // 2, 300), DIM, "center")
            return
        rows = self.ROWS
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + rows:
            self.scroll = self.sel - rows + 1
        y = 80
        for i in range(self.scroll, min(len(self.items), self.scroll + rows)):
            it = self.items[i]
            if i > self.scroll and it["group"] != self.items[i - 1]["group"]:
                hline(c, LINE, (64, y - 2), (W - 112, y - 2))
            on = i == self.sel
            r = pygame.Rect(48, y, W - 96, self.ROW_H - 4)
            if on:
                focus_box(c, r)
            right = 150
            tag = it["tag"]
            if tag:
                tw = int(measure(self.f.tiny, tag)) + 14
                tr = pygame.Rect(r.right - right - tw, r.centery - 10, tw, 20)
                rrect(c, BG2, tr, 6)
                text(c, self.f.tiny, tag, tr.center, FAINT, "center")
                right += tw + 16
            # full name: one line if it fits, else two smaller lines — never "…"
            name = it["name"]
            avail = r.width - 22 - right
            col_txt = TEXT if on else DIM
            if measure(self.f.row, name) <= avail:
                text(c, self.f.row, name, (r.left + 22, r.centery), col_txt, "midleft")
            else:
                lines = wrap(self.f.small, name, avail)
                fnt, lh = (self.f.small, 19) if len(lines) <= 2 else (self.f.tiny, 15)
                if len(lines) > 2:
                    lines = wrap(fnt, name, avail)
                y0 = r.centery - lh * len(lines) // 2
                for k, ln in enumerate(lines):
                    text(c, fnt, ln, (r.left + 22, y0 + k * lh), col_txt)
            cnt = ("{:,} game{}".format(it["count"], "" if it["count"] == 1 else "s")
                   if it["count"] is not None else "›")
            text(c, self.f.small, cnt, (r.right - 20, r.centery), FAINT, "midright")
            y += self.ROW_H
        n = len(self.items)
        if n > rows:
            track = pygame.Rect(W - 30, 80, 4, rows * self.ROW_H - 4)
            rrect(c, LINE, track, 2)
            h = max(24, track.height * rows // n)
            yy = track.top + int((track.height - h) * (self.sel / max(1, n - 1)))
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)
        draw_bubble(c, self.f, self.bubble, self.bubble_until, (W // 2, H // 2))


REGION_ABBR = {"USA": "US", "Europe": "EU", "Japan": "JP", "World": "World", "Australia": "AU",
               "Brazil": "BR", "Korea": "KR", "China": "CN", "Germany": "DE", "France": "FR",
               "Spain": "ES", "Italy": "IT", "UK": "UK", "Asia": "Asia"}


JUNK_MARKERS = ("~hack~", "~unlicensed~", "~prototype~", "~demo~", "~homebrew~", "(proto",
                "(beta", "(demo", "(sample", "(hack", "(pirate", "(unl)")


def rank_search(query, items):
    """RomM's search order is effectively alphabetical ('~Hack~', 'BS …' first).
    Re-rank the first page: real titles containing every query word, USA/World
    releases, Latin names first; hacks/protos/BS broadcasts last. Stable."""
    words = [w for w in query.lower().split() if w]

    def key(rom):
        name = (rom.get("name") or rom.get("fs_name_no_ext") or "").lower()
        fs = (rom.get("fs_name") or "").lower()
        score = 0
        if not all(w in name for w in words):
            score += 4
        if name.startswith(query.lower()) or name.startswith("the " + query.lower()):
            score -= 1
        if any(m in name or m in fs for m in JUNK_MARKERS):
            score += 6
        if any(_wide(ch) for ch in name):
            score += 3
        regions = [r.lower() for r in (rom.get("regions") or [])]
        if any(r in ("usa", "world") for r in regions):
            score -= 2
        elif any(r in ("europe", "uk", "australia") for r in regions):
            score -= 1
        return score
    return sorted(items, key=key)


class GameListScreen(Screen):
    PAGE = 60
    ROWS = 12
    ROW_H = 44

    REGION_CHOICES = [(None, "All regions"), (["USA", "World"], "USA + World"),
                      (["Europe", "World"], "Europe + World"), (["Japan"], "Japan")]
    BULK_MAX = 1000

    def __init__(self, app, title, platform=None, collection=None, search=None,
                 order_by="name", static=None):
        super().__init__(app)
        self.static = static          # a fixed list (e.g. "More like this"): no paging/filters
        self.only_verified = False
        self.hide_junk = False
        self.title = title
        self.platform = platform
        self.collection = collection
        self.search = search
        self.order_by = order_by
        self.region_i = 0
        self.hide_installed = False
        self.mark_mode = False
        self.marks = {}               # rom id -> rom
        self.bios = None              # [(missing, firmware)] RomM can supply
        self.reset()
        if platform and platform.get("_system"):
            app.bg(lambda: rommlib.bios_offer(app.api, platform["_system"], platform["id"]),
                   lambda offers: setattr(self, "bios", offers), lambda e: None)

    @property
    def regions(self):
        return self.REGION_CHOICES[self.region_i][0]

    @property
    def dense(self):
        # hiding installed games can't use sparse paging (offsets shift as rows
        # are filtered out), so that mode loads sequentially and filters
        return self.hide_installed

    def reset(self):
        # items is a sparse list (None = row not fetched yet) once total is known,
        # so jumping to a letter loads just that page, not everything before it
        self.items = []
        self.total = None
        self.pending = set()
        self.starts = []          # [(offset, letter)] from RomM's char_index
        self.sel = 0
        self.scroll = 0
        self.gen = getattr(self, "gen", 0) + 1
        self.bubble, self.bubble_until = None, 0.0
        self.server_off, self.server_total, self.exhausted = 0, None, False
        if self.static is not None:
            self.items = [r for r in self.static if not (self.hide_installed and self.installed(r))]
            self.total = self.server_total = len(self.items)
            self.exhausted = True
            return
        self.fetch_page(0)

    def crumbs(self):
        if self.static is not None:
            return ["More like this"]
        out = []
        if self.platform and not self.search:
            out.append("Platforms")
        elif self.collection:
            return ["Collections"]      # full name is shown (unclipped) in the list header
        if self.search:
            out.append("Search")
            if self.platform:
                out.append(self.platform.get("display_name") or self.platform["name"])
            out.append('"%s"' % self.search)
        else:
            out.append(self.title)
        return out

    @property
    def loading(self):
        return self.total is None

    def _pids(self):
        if self.platform:
            return [self.platform["id"]]
        if self.search or self.order_by == "id_desc":
            return [p["id"] for p in self.app.platforms]
        return None

    def _query(self, offset, limit, char_index=False):
        """One page from RomM with this list's filters (blocking)."""
        app, pids = self.app, self._pids()
        if self.order_by == "id_desc":
            p = {"offset": offset, "limit": limit, "with_char_index": "false",
                 "with_filter_values": "false", "with_rom_id_index": "false",
                 "order_by": "id", "order_dir": "desc", "platform_ids": pids}
            if self.regions:
                p["regions"], p["regions_logic"] = self.regions, "any"
            if self.only_verified:
                p["verified"] = "true"
            if self.hide_junk and app.junk:
                p["tags"], p["tags_logic"] = app.junk, "none"
            return app.api.get("/api/roms", p)
        return app.api.roms(platform_ids=pids, search=self.search, offset=offset, limit=limit,
                            order_by=self.order_by, char_index=char_index, regions=self.regions,
                            verified=self.only_verified,
                            exclude_tags=app.junk if self.hide_junk else None,
                            collection=(self.collection["param"], self.collection["id"])
                            if self.collection else None)

    def installed(self, rom):
        system = self.app.system_for(rom)
        return bool(system) and self.app.library.is_installed(rom, system)

    def fetch_page(self, offset):
        if self.static is not None:
            return
        if self.dense:
            return self._fetch_dense()
        if offset in self.pending:
            return
        self.pending.add(offset)
        app, gen = self.app, self.gen
        first = self.total is None
        want_ci = first and self.order_by == "name" and not self.search
        limit = 250 if self.search and offset == 0 else self.PAGE

        def done(page):
            if gen != self.gen:
                return
            self.pending.discard(offset)
            total = page.get("total", len(page.get("items", [])))
            self.server_total = total
            if self.total is None or total != self.total:
                self.items = (self.items + [None] * total)[:total]
                self.total = total
            got = page.get("items", [])
            if self.search and offset == 0:
                got = rank_search(self.search, got)
            for k, rom in enumerate(got):
                if offset + k < total:
                    self.items[offset + k] = rom
            self.refresh_menu()
            if want_ci and page.get("char_index"):
                merged = {}
                for ch, off in page["char_index"].items():
                    lab = letter_of(ch)
                    if off < total and (lab not in merged or off < merged[lab]):
                        merged[lab] = off
                self.starts = sorted((off, lab) for lab, off in merged.items())

        def err(e):
            self.pending.discard(offset)
            if self.total is None:
                self.total = 0
            app.toast(str(e), RED)
        app.bg(lambda: self._query(offset, limit, want_ci), done, err)

    def _fetch_dense(self):
        """Sequential pages, installed games filtered out, until there's a
        screenful past the cursor (or the list ends)."""
        if "dense" in self.pending or self.exhausted:
            return
        self.pending.add("dense")
        app, gen, off = self.app, self.gen, self.server_off

        def done(page):
            if gen != self.gen:
                return
            self.pending.discard("dense")
            got = page.get("items", [])
            self.server_total = page.get("total", 0)
            self.server_off = off + len(got)
            self.exhausted = not got or self.server_off >= self.server_total
            self.items.extend(r for r in got if not self.installed(r))
            self.total = len(self.items)
            self.refresh_menu()
            if not self.exhausted and len(self.items) < self.sel + 3 * self.ROWS:
                self._fetch_dense()

        def err(e):
            self.pending.discard("dense")
            self.exhausted = True
            self.total = len(self.items)
            app.toast(str(e), RED)
        app.bg(lambda: self._query(off, 120), done, err)

    def ensure(self, i):
        """Make sure the page holding row i is loaded (or loading)."""
        if self.static is not None:
            return
        if self.dense:
            if i >= len(self.items) - self.ROWS:
                self._fetch_dense()
            return
        if self.total is None or not (0 <= i < self.total):
            return
        start = (i // self.PAGE) * self.PAGE
        if any(r is None for r in self.items[start:start + self.PAGE]):
            self.fetch_page(start)

    # -- actions ------------------------------------------------------------
    def action(self, a):
        n = len(self.items)
        mv = {"up": -1, "down": 1, "l1": -self.ROWS, "r1": self.ROWS,
              "left": -self.ROWS, "right": self.ROWS}
        if a in mv and n:
            self.sel = max(0, min(n - 1, self.sel + mv[a]))
            self.ensure(self.sel + self.ROWS)
        elif a in ("l2", "r2") and n:
            if not self.starts or self.dense:
                self.app.toast("A–Z jump works in full lists sorted by name")
                return
            hit = letter_jump(self.starts, self.sel, a == "r2")
            if hit:
                self.sel = hit[0]
                # put the letter at the top of the list (without scrolling past the end)
                self.scroll = max(0, min(hit[0], len(self.items) - self.ROWS))
                self.bubble, self.bubble_until = hit[1], time.time() + 0.7
                self.ensure(self.sel)
                self.ensure(self.sel + self.ROWS)
        elif a == "ok" and n and self.items[self.sel] is not None:
            rom = self.items[self.sel]
            if self.mark_mode:
                if rom["id"] in self.marks:
                    del self.marks[rom["id"]]
                elif self.app.system_for(rom):
                    self.marks[rom["id"]] = rom
            elif self.rom_status(rom)[0] == "installed":
                self.app.modal = ManageMenu(self.app, rom)
            else:
                self.app.modal = DownloadConfirm(self.app, rom)
        elif a == "y":
            self.app.push(SearchScreen(self.app, platform=self.platform))
        elif a == "x" and self.mark_mode and self.marks:
            self._download_marked()          # what the hint bar promises in pick mode
        elif a == "x":
            self.menu_rom = self.items[self.sel] if self.items and self.sel < len(self.items) else None
            self.app.modal = ActionMenu(self.app, self.menu_title(), self.menu_entries(),
                                        refresh=self.menu_entries)
        elif a == "back" and self.mark_mode:
            self.mark_mode = False
        else:
            super().action(a)

    def menu_title(self):
        if self.static is not None or self.search:
            return self.title if self.static is not None else 'Results for "%s"' % self.search
        if self.collection:
            return self.collection.get("name") or self.title
        return self.title

    def menu_entries(self):
        """Actions first (they close the menu), then view controls that change
        the list in place while the menu stays open."""
        e = []
        cur = getattr(self, "menu_rom", None)
        if cur is not None:
            e.append(("More like this", cur.get("name") or cur.get("fs_name_no_ext") or "",
                      lambda: self._more_like(cur)))
        if self.mark_mode:
            e.append(("Stop picking", "", lambda: setattr(self, "mark_mode", False)))
        else:
            e.append(("Pick games to download", "Then {A} marks games, and {X} downloads them",
                      lambda: setattr(self, "mark_mode", True)))
        if self.marks:
            size = sum(r.get("fs_size_bytes") or 0 for r in self.marks.values())
            e.append(("Download %d picked" % len(self.marks), human_size(size), self._download_marked))
            e.append(("Clear picks", "", self.marks.clear))
        tot = self.server_total
        if tot is None:
            e.append(("Download every game in this list", "Counting games…", None))
        elif tot:
            if tot <= self.BULK_MAX:
                e.append(("Download every game in this list",
                          "{:,} games, skipping any already on this box".format(tot), self._download_all))
            else:
                e.append(("Download every game in this list",
                          "{:,} is more than 1,000. Narrow it with the filters below.".format(tot), None))
        if self.bios:
            n = len(self.bios)
            e.append(("Get BIOS for %s" % (self.platform.get("display_name") or self.platform["_system"]),
                      "%d file%s from RomM, checksum-verified" % (n, "" if n == 1 else "s"), self._fetch_bios))
        e.append(None)
        if self.static is None and not self.search and not self.collection:
            e.append(("Sort", "", lambda d=1: self._toggle_sort(),
                      "Newest first" if self.order_by == "id_desc" else "A to Z", "choice"))
        if self.static is None:
            e.append(("Region", "", self._cycle_region, self.REGION_CHOICES[self.region_i][1], "choice"))
        e.append(("Hide games on this box", "", self._toggle_hide, self.hide_installed, "switch"))
        if self.static is None:
            e.append(("Hide prototypes, demos and hacks", "", self._toggle_junk, self.hide_junk, "switch"))
            e.append(("Only checksum-verified dumps", "", self._toggle_verified, self.only_verified, "switch"))
        return e

    def refresh_menu(self):
        m = self.app.modal
        if isinstance(m, ActionMenu) and getattr(m.refresh, "__self__", None) is self:
            m.reload()

    def _more_like(self, rom):
        app = self.app
        name = rom.get("name") or rom.get("fs_name_no_ext")

        def done(roms):
            if not roms:
                app.toast("RomM has no similar games for %s" % name, AMBER)
                return
            app.push(GameListScreen(app, "Games like %s" % name, static=roms))
        app.bg(lambda: app.api.similar(rom["id"]), done)

    def _toggle_junk(self):
        app = self.app
        if not self.hide_junk and app.junk is None:
            def done(tags):
                app.junk = rommlib.junk_tags(tags)
                self.hide_junk = True
                self.reset()
                self.refresh_menu()
            app.bg(app.api.all_tags, done)
            return
        self.hide_junk = not self.hide_junk
        self.reset()

    def _toggle_verified(self):
        self.only_verified = not self.only_verified
        self.reset()

    def _toggle_hide(self):
        self.hide_installed = not self.hide_installed
        self.reset()

    def _cycle_region(self, step=1):
        self.region_i = (self.region_i + step) % len(self.REGION_CHOICES)
        self.reset()

    def _queue_many(self, roms, title):
        app = self.app
        def busy(r):
            j = app.downloader.job_for(r["id"])
            return bool(j and j.active)
        roms = [r for r in roms if app.system_for(r) and not self.installed(r) and not busy(r)]
        if not roms:
            app.toast("Nothing to download — all on this box already", AMBER)
            return
        size = sum(r.get("fs_size_bytes") or 0 for r in roms)
        items = [(r, app.system_for(r)) for r in roms]
        need = sum(rommlib.space_needed(r, sy) for r, sy in items)
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
            free = st.f_bavail * st.f_frsize
        except OSError:
            free = None

        def go(chosen):
            self.marks.clear()
            self.mark_mode = False
            if not any(rommlib.disc_info(r.get("fs_name_no_ext") or "") for r, _ in chosen):
                for r, sy in chosen:
                    app.downloader.enqueue(r, sy)
                app.toast("Queued %d games" % len(chosen), GREEN)
                return
            app.toast("Finding the other discs of multi-disc games…")

            def queued(groups):
                n = 0
                for group, members in groups:
                    if group:
                        n += app.queue_set(group, members, members[0][1])
                    else:
                        for r, sy in members:
                            app.downloader.enqueue(r, sy)
                            n += 1
                sets = sum(1 for g, _ in groups if g)
                app.toast("Queued %d download%s%s" % (n, "" if n == 1 else "s",
                          (", %d multi-disc set%s kept together" % (sets, "" if sets == 1 else "s"))
                          if sets else ""), GREEN)
            app.bg(lambda: app.expand_sets(chosen), queued)

        if free is not None and need + rommlib.SPACE_MARGIN > free:
            fit, used = rommlib.fit_in_space(items, free)
            entries = []
            if fit:
                entries.append(("Download the %d that fit" % len(fit),
                                "About %s once extracted" % human_size(used), lambda: go(fit)))
            entries.append(("Download all %d anyway" % len(items),
                            "Needs about %s; %s free. Later ones will fail." % (human_size(need), human_size(free)),
                            lambda: go(items)))
            entries.append(("Cancel", "", lambda: None))
            app.modal = ActionMenu(app, "Not enough space for all %d" % len(items), entries)
            return
        body = "%d games, %s to download (about %s once extracted)%s." % (
            len(roms), human_size(size), human_size(need),
            "" if free is None else ". %s free on this box" % human_size(free))
        app.modal = Confirm(app, title, body, "Download %d" % len(roms), lambda: go(items))

    def _download_marked(self):
        self._queue_many(list(self.marks.values()), "Download picked games?")

    def _download_all(self):
        app = self.app
        app.toast("Listing every game…")

        def collect():
            out, off = [], 0
            while True:
                page = self._query(off, 250)
                got = page.get("items", [])
                out.extend(got)
                off += len(got)
                if not got or off >= page.get("total", 0) or off >= self.BULK_MAX:
                    return out
        app.bg(collect, lambda roms: self._queue_many(roms, "Download this whole list?"))

    def _fetch_bios(self):
        app, offers, system = self.app, self.bios, self.platform["_system"]

        def done(written):
            self.bios = [o for o in offers if o[0]["file"] not in written]
            app.toast("BIOS installed: %s" % ", ".join(os.path.basename(w) for w in written), GREEN)
        app.bg(lambda: rommlib.fetch_bios(app.api, offers), done)

    def hints(self):
        if self.mark_mode:
            return [("A", "Pick"), ("X", "Download %d picked" % len(self.marks) if self.marks else "Menu"),
                    ("B", "Stop picking")]
        h = [("A", "Download"), ("X", "Menu"), ("Y", "Search")]
        if self.starts and not self.dense:
            h.append(("L2 R2", "Letter"))
        return h + [("L", "Page"), ("B", "Back")]

    def rom_status(self, rom):
        j = self.app.downloader.job_for(rom["id"])
        if j and j.active:
            return "active", j
        if j and j.state == rommlib.Job.FAILED:
            return "failed", j
        system = self.app.system_for(rom)
        if j and j.state == rommlib.Job.DONE:
            return "installed", j
        if system and self.app.library.is_installed(rom, system):
            return "installed", None
        return "remote", None

    def draw(self, c):
        app = self.app
        lx, ly, lw = 32, 80, 676
        # list header
        if self.total is None:
            cnt = "Loading…"
        elif self.dense:
            cnt = "{:,}{} not on this box".format(self.total, "" if self.exhausted else "+")
        else:
            cnt = "{:,} games".format(self.total) if self.total else "No games found"
        flt = [lab for on, lab in ((self.regions, self.REGION_CHOICES[self.region_i][1]),
                                   (self.mark_mode, "%d picked" % len(self.marks))) if on]
        if flt:
            cnt = ", ".join(flt + [cnt])
        title = self.title if not self.search else 'Results for "%s"' % self.search
        if measure(self.f.h3, title) <= 520:
            text(c, self.f.h3, title, (lx + 8, ly + 4), TEXT)
        else:
            for k, ln in enumerate(wrap(self.f.small, title, 520)[:2]):
                text(c, self.f.small, ln, (lx + 8, ly - 2 + k * 18), TEXT)
        text(c, self.f.small, cnt, (lx + lw - 8, ly + 8), FAINT, "topright")
        ly += 40
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + self.ROWS:
            self.scroll = self.sel - self.ROWS + 1
        multi_plat = self.platform is None
        for i in range(self.scroll, min(len(self.items), self.scroll + self.ROWS)):
            rom = self.items[i]
            on = i == self.sel
            r = pygame.Rect(lx, ly + (i - self.scroll) * self.ROW_H, lw, self.ROW_H - 4)
            if on:
                focus_box(c, r)
            if rom is None:
                self.ensure(i)
                text(c, self.f.row, "…", (r.left + 44, r.centery), FAINT, "midleft")
                continue
            st, j = self.rom_status(rom)
            ix = r.left + 24
            if self.mark_mode and st != "installed":
                picked = rom["id"] in self.marks
                rrect(c, ACCENT if picked else LINE, (ix - 9, r.centery - 9, 18, 18), 4, 0 if picked else 2)
                if picked:
                    polyline(c, TEXT, [(ix - 4, r.centery), (ix - 1, r.centery + 3), (ix + 4, r.centery - 3)], 2)
            elif st == "installed":
                circle(c, GREEN, (ix, r.centery), 9)
                polyline(c, BG, [(ix - 4, r.centery), (ix - 1, r.centery + 3),
                                                 (ix + 4, r.centery - 3)], 2)
            elif st == "active":
                frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
                circle(c, LINE, (ix, r.centery), 9, 2)
                if frac > 0:
                    arc(c, BLUE, (ix - 9, r.centery - 9, 18, 18),
                                    1.5708 - 6.2832 * frac, 1.5708, 3)
            elif st == "failed":
                circle(c, RED, (ix, r.centery), 9)
                text(c, self.f.tiny, "!", (ix, r.centery), BG, "center")
            else:
                circle(c, LINE, (ix, r.centery), 4)
            right_w = 0
            size = human_size(rom.get("fs_size_bytes"))
            sr = text(c, self.f.small, size, (r.right - 14, r.centery), FAINT if not on else DIM, "midright")
            right_w = sr.width + 14
            if multi_plat:
                p = app.platform_by_id.get(rom.get("platform_id"))
                tag = p["_system"] if p else rom.get("platform_slug") or "?"
                tw = int(measure(self.f.tiny, tag)) + 12
                tr = pygame.Rect(r.right - right_w - tw - 12, r.centery - 10, tw, 20)
                rrect(c, BG2 if p else (60, 30, 30), tr, 6)
                text(c, self.f.tiny, tag, tr.center, FAINT, "center")
                right_w += tw + 12
            name = rom_title(rom)
            nr = text(c, self.f.row, name, (r.left + 44, r.centery), TEXT if on else DIM,
                      "midleft", maxw=r.width - 44 - right_w - 70)
            regions = rom.get("regions") or []
            if regions:
                rg = "/".join(REGION_ABBR.get(x, x[:3]) for x in regions[:2])
                text(c, self.f.tiny, rg, (nr.right + 8, r.centery + 1), FAINT, "midleft")
        if self.loading:
            text(c, self.f.body, "Loading…", (lx + lw // 2, ly + 120), DIM, "center")
        # scrollbar
        if self.total and self.total > self.ROWS:
            track = pygame.Rect(lx + lw + 6, ly, 4, self.ROWS * self.ROW_H - 4)
            rrect(c, LINE, track, 2)
            h = max(24, track.height * self.ROWS // self.total)
            yy = track.top + int((track.height - h) * (self.sel / max(1, self.total - 1)))
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)
        # detail panel
        if self.items and self.items[self.sel] is not None:
            self.draw_detail(c, self.items[self.sel])
        elif self.items:
            p = pygame.Rect(728, 80, 520, 576)
            rrect(c, PANEL, p, 16)
            text(c, self.f.body, "Loading…", p.center, DIM, "center")
        draw_bubble(c, self.f, self.bubble, self.bubble_until, (lx + lw // 2, H // 2))

    def draw_detail(self, c, rom):
        app = self.app
        p = pygame.Rect(728, 80, 520, 576)
        rrect(c, PANEL, p, 16)
        cov = pygame.Rect(p.left + 24, p.top + 24, 192, 256)
        img = app.cover(rom)
        if img:
            pc = SR(cov)
            sc = app.scaled_covers.get(rom["id"])
            if sc is None or sc[0] is not img:
                iw, ih = img.get_size()
                f = min(pc.width / iw, pc.height / ih)
                sc = (img, smooth_scale(
                    img, (max(1, int(iw * f)), max(1, int(ih * f)))))
                if len(app.scaled_covers) > 64:
                    app.scaled_covers.clear()
                app.scaled_covers[rom["id"]] = sc
            c.blit(sc[1], sc[1].get_rect(midtop=(pc.centerx, pc.top)))
        else:
            rrect(c, BG2, cov, 10)
            text(c, self.f.small, "no cover" if rom["id"] in app.covers and
                 app.covers[rom["id"]] is None else "…", cov.center, FAINT, "center")
        tx, tw = cov.right + 20, p.right - cov.right - 44
        y = p.top + 24
        title = rom_title(rom)
        tl = wrap(self.f.h3, title, tw)
        tf, lh = (self.f.h3, 25) if len(tl) <= 3 else (self.f.body, 22)
        for ln in wrap(tf, title, tw, 5):
            text(c, tf, ln, (tx, y), TEXT)
            y += lh
        y += 8
        md = rom.get("metadatum") or {}
        plat = app.platform_by_id.get(rom.get("platform_id"))
        year = ""
        if md.get("first_release_date"):
            year = time.strftime("%Y", time.gmtime(md["first_release_date"] / 1000))
        facts = [
            ("Platform", (plat.get("display_name") or plat["name"]) if plat else
             (rom.get("platform_display_name") or "?")),
            ("Released", year),
            ("Genre", ", ".join((md.get("genres") or [])[:2])),
            ("Players", md.get("player_count") or ""),
            ("Size", human_size(rom.get("fs_size_bytes"))),
            ("Achievements", ("%d · %d points" % ra) if (ra := rommlib.ra_summary(rom)) and ra[0] else ""),
            ("Manual", "Included" if rommlib.manual_path(rom) else ""),
        ]
        for k, v in facts:
            if not v:
                continue
            text(c, self.f.small, k, (tx, y), FAINT)
            text(c, self.f.cond, str(v), (tx, y + 17), DIM, maxw=tw)
            y += 42
        # summary
        sy = max(y, cov.bottom) + 18
        summ = rom.get("summary") or ""
        lines = wrap(self.f.small, summ, p.width - 48, max(1, (p.bottom - 110 - sy) // 20))
        for i, ln in enumerate(lines if summ else []):
            text(c, self.f.small, ln, (p.left + 24, sy + i * 20), DIM)
        # action area
        ar = pygame.Rect(p.left + 24, p.bottom - 76, p.width - 48, 52)
        st, j = self.rom_status(rom)
        system = app.system_for(rom)
        if not system:
            rrect(c, BG2, ar, 12)
            text(c, self.f.body, "No Batocera system for this platform", ar.center, FAINT, "center")
        elif st == "installed":
            rrect(c, (20, 60, 48), ar, 12)
            gx = ar.left + 18
            gx += button_glyph(c, self.f, "A", gx, ar.centery - 11) + 12
            text(c, self.f.h3, "On this box", (gx, ar.centery), GREEN, "midleft")
            text(c, self.f.small, "roms/" + system, (ar.right - 20, ar.centery), DIM, "midright")
        elif st == "active":
            rrect(c, BG2, ar, 12)
            frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
            label = j.state
            if j.state == rommlib.Job.DOWNLOADING:
                label = "Downloading %d%%, %s/s" % (frac * 100, human_size(j.speed))
            text(c, self.f.body, label, (ar.left + 18, ar.top + 10), TEXT)
            progress_bar(c, (ar.left + 18, ar.bottom - 16, ar.width - 36, 6), frac, BLUE)
        else:
            rrect(c, ACCENT, ar, 12)
            gx = ar.left + 18
            gx += button_glyph(c, self.f, "A", gx, ar.centery - 11) + 12
            msg = "Retry download" if st == "failed" else "Download"
            text(c, self.f.h3, msg, (gx, ar.centery), TEXT, "midleft")
            text(c, self.f.small, "to roms/" + system, (ar.right - 20, ar.centery), (225, 215, 255), "midright")
            yy = ar.top - 22
            if st == "failed":
                text(c, self.f.small, j.message, (ar.left, yy), RED, maxw=ar.width)
                yy -= 22
            var = self.variants(rom, system)
            if var:
                text(c, self.f.small, "Already here: " + var[0] + (" +%d more" % (len(var) - 1) if len(var) > 1 else ""),
                     (ar.left, yy), AMBER, maxw=ar.width)

    def variants(self, rom, system):
        """Other versions of this game on the box (cached per rom)."""
        cache = self.__dict__.setdefault("_variants", {})
        if rom["id"] not in cache:
            if len(cache) > 300:
                cache.clear()
            cache[rom["id"]] = self.app.library.variants(rom, system)
        return cache[rom["id"]]


class SearchScreen(Screen):
    ROWS = ["1234567890", "QWERTYUIOP", "ASDFGHJKL'", "ZXCVBNM-:&"]
    SPECIAL = [("Space", 3), ("Delete", 3), ("Clear", 2), ("Search", 2)]

    def __init__(self, app, platform=None):
        super().__init__(app)
        self.platform = platform
        self.query = ""
        self.r, self.c = 1, 0
        self.preview = []
        self.preview_total = None
        self.preview_q = None
        self.pending_at = None

    def crumbs(self):
        out = ["Search"]
        if self.platform:
            out.append(self.platform.get("display_name") or self.platform["name"])
        return out

    def hints(self):
        return [("A", "Type"), ("X", "Delete"), ("Y", "Space"), ("START", "Search"), ("B", "Back")]

    def row_len(self, r):
        return len(self.ROWS[r]) if r < len(self.ROWS) else len(self.SPECIAL)

    def _type(self, s):
        self.query = (self.query + s)[:60]
        self.pending_at = time.time() + 0.45

    def action(self, a):
        nrows = len(self.ROWS) + 1
        if a == "up":
            self.r = (self.r - 1) % nrows
        elif a == "down":
            self.r = (self.r + 1) % nrows
        elif a == "left":
            self.c = (self.c - 1) % self.row_len(self.r)
        elif a == "right":
            self.c = (self.c + 1) % self.row_len(self.r)
        elif a == "x":
            self.query = self.query[:-1]
            self.pending_at = time.time() + 0.45
        elif a == "y":
            self._type(" ")
        elif a == "ok":
            if self.r < len(self.ROWS):
                self._type(self.ROWS[self.r][self.c].lower() if self.r else self.ROWS[self.r][self.c])
            else:
                key = self.SPECIAL[self.c][0]
                if key == "Space":
                    self._type(" ")
                elif key == "Delete":
                    self.query = self.query[:-1]
                    self.pending_at = time.time() + 0.45
                elif key == "Clear":
                    self.query = ""
                    self.preview = []
                    self.preview_total = None
                else:
                    self.go()
        elif a in ("start", "r1"):
            self.go()
        elif a == "back":
            self.app.pop()
        self.c = min(self.c, self.row_len(self.r) - 1)

    def go(self):
        q = self.query.strip()
        if len(q) < 2:
            self.app.toast("Type at least 2 characters", AMBER)
            return
        self.app.push(GameListScreen(self.app, "Search", platform=self.platform, search=q))

    def live_preview(self):
        if self.pending_at and time.time() >= self.pending_at:
            self.pending_at = None
            q = self.query.strip()
            if len(q) < 2:
                self.preview, self.preview_total = [], None
                return
            app = self.app
            pids = [self.platform["id"]] if self.platform else [p["id"] for p in app.platforms]

            def done(page, q=q):
                if q == self.query.strip():
                    self.preview = page.get("items", [])
                    self.preview_total = page.get("total")
            def call():
                page = app.api.roms(platform_ids=pids, search=q, limit=250)
                page["items"] = rank_search(q, page.get("items", []))[:8]
                return page
            app.bg(call, done)

    own_start = True   # Start = run the search here, not "go Home"

    def draw(self, c):
        self.live_preview()
        # query field
        qf = pygame.Rect(48, 88, 640, 60)
        rrect(c, PANEL, qf, 14)
        rrect(c, ACCENT, qf, 14, 2)
        shown = self.query or ""
        r = text(c, self.f.h2, shown, (qf.left + 22, qf.centery), TEXT, "midleft", maxw=qf.width - 50)
        if not shown:
            text(c, self.f.h2, "Search " + ((self.platform.get("display_name") or self.platform["name"])
                                            if self.platform else "all games"),
                 (qf.left + 22, qf.centery), FAINT, "midleft", maxw=qf.width - 50)
            r = pygame.Rect(qf.left + 20, qf.top, 0, qf.height)
        if int(self.app.t * 2) % 2 == 0:
            hline(c, ACCENT_HI, (r.right + 3, qf.top + 16), (r.right + 3, qf.bottom - 16), 2)
        # keyboard
        kx, ky, kw, kh, gap = 48, 172, 58, 58, 6
        for ri, row in enumerate(self.ROWS):
            for ci, ch in enumerate(row):
                kr = pygame.Rect(kx + ci * (kw + gap), ky + ri * (kh + gap), kw, kh)
                on = (ri, ci) == (self.r, self.c)
                rrect(c, ACCENT if on else PANEL, kr, 10)
                text(c, self.f.key, ch, kr.center, TEXT if on else DIM, "center")
        sy = ky + len(self.ROWS) * (kh + gap)
        sx = kx
        for ci, (label, span) in enumerate(self.SPECIAL):
            w = span * kw + (span - 1) * gap
            kr = pygame.Rect(sx, sy, w, kh)
            on = (self.r, self.c) == (len(self.ROWS), ci)
            col = ACCENT if on else (PANEL_HI if label == "Search" else PANEL)
            rrect(c, col, kr, 10)
            text(c, self.f.h3, label, kr.center, TEXT if on or label == "Search" else DIM, "center")
            sx += w + gap
        # live results
        p = pygame.Rect(720, 88, 528, 568)
        rrect(c, PANEL, p, 16)
        text(c, self.f.h3, "Top matches", (p.left + 24, p.top + 20), DIM)
        if self.preview_total is not None:
            text(c, self.f.small, "{:,} total".format(self.preview_total),
                 (p.right - 24, p.top + 22), FAINT, "topright")
        y = p.top + 56
        if not self.preview:
            msg = "Start typing — results appear here." if len(self.query.strip()) < 2 else \
                ("Searching…" if self.preview_total is None or self.pending_at else "No matches")
            text(c, self.f.body, msg, (p.left + 24, y), DIM)
        for rom in self.preview[:8]:
            pl = self.app.platform_by_id.get(rom.get("platform_id"))
            text(c, self.f.row, rom_title(rom), (p.left + 24, y),
                 TEXT, maxw=p.width - 48)
            sr = text(c, self.f.small, pl["_system"] if pl else "?", (p.left + 24, y + 26), FAINT)
            text(c, self.f.small, human_size(rom.get("fs_size_bytes")), (sr.right + 16, y + 26), FAINT)
            y += 58
        if self.preview:
            rich_text(c, self.f, self.f.small, "Press {START} to see all results",
                      (p.left + 24, p.bottom - 34), ACCENT_HI)


class DownloadsScreen(Screen):
    """The queue in the order it runs, then finished downloads (newest
    first). A: per-download menu (reorder, pause, cancel, retry); X pauses or
    resumes everything; Y clears the finished ones."""
    ROWS, ROW_H = 7, 76

    def __init__(self, app):
        super().__init__(app)
        self.sel = self.scroll = 0

    def crumbs(self):
        return ["Downloads"]

    def view(self):
        d = self.app.downloader
        jobs = list(d.jobs)
        pend = [j for j in jobs if j.active or j.state == rommlib.Job.PAUSED]
        return pend + [j for j in reversed(jobs) if j not in pend]

    def hints(self):
        d = self.app.downloader
        h = [("A", "Options")]
        if d.pending_count():
            h.append(("X", "Resume all" if d.hold else "Pause all"))
        if any(not (j.active or j.state == rommlib.Job.PAUSED) for j in d.jobs):
            h.append(("Y", "Clear finished"))
        return h + [("B", "Back")]

    def action(self, a):
        app, d = self.app, self.app.downloader
        jobs = self.view()
        if a in ("up", "down", "l1", "r1") and jobs:
            step = {"up": -1, "down": 1, "l1": -self.ROWS, "r1": self.ROWS}[a]
            self.sel = max(0, min(len(jobs) - 1, self.sel + step))
        elif a == "ok" and jobs:
            self.menu(jobs[min(self.sel, len(jobs) - 1)])
        elif a == "x" and d.pending_count():
            if d.hold:
                d.release_all()
                app.toast("Downloads resumed", GREEN)
            else:
                d.hold_all()
                app.toast("Downloads paused — partial files are kept", AMBER)
        elif a == "y":
            n = d.clear_finished()
            if n:
                app.toast("Cleared %d finished" % n)
        else:
            super().action(a)

    def menu(self, j):
        app, d = self.app, self.app.downloader
        J = rommlib.Job
        queued = [x for x in d.jobs if x.active or x.state == J.PAUSED]
        e = []
        if j in queued and len(queued) > 1:
            i = queued.index(j)
            e += [("Move to top", "Downloads next", (lambda: d.move(j, "top")) if i else None),
                  ("Move up", "", (lambda: d.move(j, "up")) if i else None),
                  ("Move down", "", (lambda: d.move(j, "down")) if i < len(queued) - 1 else None),
                  None]
        if j.active:
            e.append(("Pause", "Keeps the partial file; resume any time", lambda: d.pause_job(j)))
            e.append(("Cancel download", "", lambda: setattr(app, "modal", Confirm(
                app, "Cancel download?", j.label, "Cancel download", lambda: d.cancel_job(j), danger=True))))
        elif j.state == J.PAUSED:
            e.append(("Resume", "", lambda: d.resume_job(j)))
            e.append(("Cancel download", "", lambda: d.cancel_job(j)))
        elif j.state in (J.FAILED, J.CANCELLED):
            e.append(("Retry" if j.state == J.FAILED else "Download again", j.message, lambda: d.resume_job(j)))
            e.append(("Remove from the list", "", lambda: d.remove(j)))
        else:                                      # done
            e.append(("Remove from the list", "The game stays on the box", lambda: d.remove(j)))
        app.modal = ActionMenu(app, j.label, e)

    def status(self, j):
        """(text, colour) for a row."""
        J = rommlib.Job
        frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
        if j.state == J.DOWNLOADING:
            lim = " (slowed)" if self.app.downloader.rate_limit else ""
            return "%d%%   %s of %s   %s/s%s" % (frac * 100, human_size(j.done_bytes), human_size(j.total_bytes),
                                                 human_size(j.speed), lim), BLUE
        if j.state == J.VERIFYING:
            return "Checking checksum…", BLUE
        if j.state == J.EXTRACTING:
            return "Extracting…", AMBER
        if j.state == J.QUEUED:
            if self.app.downloader.hold:
                return "Paused (all)", AMBER
            wait = j.retry_at - time.time()
            if wait > 0:
                return "%s Retry %d of %d in %d s" % (j.message.split(" Retrying")[0], j.attempts,
                                                      len(rommlib.RETRY_DELAYS), wait + 1), AMBER
            return "Queued", DIM
        if j.state == J.DONE:
            return j.message or "Done", GREEN
        if j.state == J.FAILED:
            return "Failed — " + j.message, RED
        if j.state == J.PAUSED:
            return "Paused", AMBER
        return j.state, FAINT

    def draw(self, c):
        d = self.app.downloader
        jobs = self.view()
        y = 84
        if d.hold and d.pending_count():
            rich_text(c, self.f, self.f.small, "Downloads are paused. {X} resumes them.", (48, y), AMBER)
            y += 28
        chd = len([f for f in os.listdir(rommlib.CHD_QUEUE_DIR) if f.endswith(".json")]) \
            if os.path.isdir(rommlib.CHD_QUEUE_DIR) else 0
        if chd:
            text(c, self.f.small, "%d disc game%s waiting for background CHD compression "
                 "(runs when no game is playing)" % (chd, "s" if chd > 1 else ""),
                 (48, y), AMBER)
            y += 28
        if not jobs:
            text(c, self.f.h2, "No downloads yet", (W // 2, 300), DIM, "center")
            text(c, self.f.body, "Pick a game and press A to download it to this box.",
                 (W // 2, 340), FAINT, "center")
            return
        rows = max(1, (H - 60 - y) // self.ROW_H)
        self.sel = min(self.sel, len(jobs) - 1)
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + rows:
            self.scroll = self.sel - rows + 1
        J = rommlib.Job
        npend = sum(1 for j in jobs if j.active or j.state == J.PAUSED)
        for i in range(self.scroll, min(len(jobs), self.scroll + rows)):
            j = jobs[i]
            r = pygame.Rect(48, y, W - 96, self.ROW_H - 6)
            on = i == self.sel
            rrect(c, PANEL_HI if on else PANEL, r, 12)
            if on:
                rrect(c, ACCENT, r, 12, 2)
            x = r.left + 20
            if i < npend:                          # position in the queue
                text(c, self.f.small, str(i + 1), (x + 10, r.top + 24), FAINT, "center")
                x += 30
            st, col = self.status(j)
            sw = min(520, int(measure(self.f.small, st)) + 4)
            text(c, self.f.h3, j.label, (x, r.top + 12), TEXT, maxw=r.right - 40 - sw - x)
            text(c, self.f.small, st, (r.right - 20, r.top + 14), col, "topright", maxw=520)
            sub = "roms/" + j.system
            if j.group:
                sub += "  ·  %s, %d discs" % (j.group.get("title") or j.group.get("base"),
                                             len(j.group.get("rom_ids") or []))
            if j.state == J.DONE and j.verified:
                sub += "  ·  checksum OK"
            bar = j.active and j.state != J.QUEUED
            text(c, self.f.small, sub, (x, r.top + 42), FAINT, maxw=(r.left + 440 - x) if bar else r.width - 60)
            if bar:
                frac = (j.done_bytes / j.total_bytes) if j.total_bytes else 0
                busy = j.state in (J.EXTRACTING, J.VERIFYING)
                progress_bar(c, (r.left + 460, r.top + 48, r.width - 480, 8),
                             1.0 if busy else frac, AMBER if j.state == J.EXTRACTING else BLUE)
            y += self.ROW_H
        if len(jobs) > rows:
            text(c, self.f.small, "%d–%d of %d" % (self.scroll + 1, min(len(jobs), self.scroll + rows), len(jobs)),
                 (W - 48, H - 64), FAINT, "bottomright")


class TextInputScreen(Screen):
    """Full-charset on-screen keyboard for URLs / tokens. A types, X deletes,
    Y = shift, Start saves, B cancels."""
    LOWER = ["1234567890", "qwertyuiop", "asdfghjkl:", "zxcvbnm./-", "_@?=&%~+#!"]
    SPECIAL = [("Shift", 2), ("Space", 2), ("Delete", 2), ("Clear", 2), ("Save", 2)]
    own_start = True

    def __init__(self, app, title, value, on_save, secret=False):
        super().__init__(app)
        self.title, self.value, self.on_save, self.secret = title, value or "", on_save, secret
        self.shift = False
        self.r, self.c = 1, 0

    def rows(self):
        if not self.shift:
            return self.LOWER
        return [r.upper() if i in (1, 2, 3) else
                ("!@#$%^&*()" if i == 0 else "<>[]{}|;,\'")
                for i, r in enumerate(self.LOWER)]

    def crumbs(self):
        return ["Settings", self.title]

    def hints(self):
        return [("A", "Type"), ("X", "Delete"), ("Y", "Shift"), ("START", "Save"), ("B", "Cancel")]

    def row_len(self, r):
        return len(self.rows()[r]) if r < len(self.LOWER) else len(self.SPECIAL)

    def action(self, a):
        n = len(self.LOWER) + 1
        if a == "up":
            self.r = (self.r - 1) % n
        elif a == "down":
            self.r = (self.r + 1) % n
        elif a == "left":
            self.c = (self.c - 1) % self.row_len(self.r)
        elif a == "right":
            self.c = (self.c + 1) % self.row_len(self.r)
        elif a == "x":
            self.value = self.value[:-1]
        elif a == "y":
            self.shift = not self.shift
        elif a == "ok":
            if self.r < len(self.LOWER):
                self.value += self.rows()[self.r][self.c]
            else:
                key = self.SPECIAL[self.c][0]
                if key == "Shift":
                    self.shift = not self.shift
                elif key == "Space":
                    self.value += " "
                elif key == "Delete":
                    self.value = self.value[:-1]
                elif key == "Clear":
                    self.value = ""
                else:
                    self.save()
        elif a == "start":
            self.save()
        elif a == "back":
            self.app.pop()
        self.c = min(self.c, self.row_len(self.r) - 1)

    def save(self):
        self.app.pop()
        self.on_save(self.value.strip())

    def draw(self, c):
        qf = pygame.Rect(48, 88, W - 96, 60)
        rrect(c, PANEL, qf, 14)
        rrect(c, ACCENT, qf, 14, 2)
        shown = self.value
        if self.secret and len(shown) > 8:
            shown = shown[:4] + "•" * min(24, len(shown) - 8) + shown[-4:]
        # keep the tail (where you type) visible
        while shown and measure(self.f.h3, shown) > qf.width - 50:
            shown = shown[1:]
        r = text(c, self.f.h3, shown, (qf.left + 22, qf.centery), TEXT, "midleft")
        if not self.value:
            text(c, self.f.h3, self.title, (qf.left + 22, qf.centery), FAINT, "midleft")
            r = pygame.Rect(qf.left + 20, qf.top, 0, qf.height)
        if int(self.app.t * 2) % 2 == 0:
            hline(c, ACCENT_HI, (r.right + 3, qf.top + 16), (r.right + 3, qf.bottom - 16), 2)
        kw, kh, gap = 96, 62, 8
        kx = (W - (10 * kw + 9 * gap)) // 2
        ky = 172
        for ri, row in enumerate(self.rows()):
            for ci, ch in enumerate(row):
                kr = pygame.Rect(kx + ci * (kw + gap), ky + ri * (kh + gap), kw, kh)
                on = (ri, ci) == (self.r, self.c)
                rrect(c, ACCENT if on else PANEL, kr, 10)
                text(c, self.f.key, ch, kr.center, TEXT if on else DIM, "center")
        sy = ky + len(self.LOWER) * (kh + gap)
        sx = kx
        for ci, (label, span) in enumerate(self.SPECIAL):
            w = span * kw + (span - 1) * gap
            kr = pygame.Rect(sx, sy, w, kh)
            on = (self.r, self.c) == (len(self.LOWER), ci)
            hot = label == "Save" or (label == "Shift" and self.shift)
            rrect(c, ACCENT if on else (PANEL_HI if hot else PANEL), kr, 10)
            text(c, self.f.h3, label, kr.center, TEXT if on or hot else DIM, "center")
            sx += w + gap


class SettingsScreen(Screen):
    """Everything in config.json, editable with the pad. Saved immediately."""

    VISIBLE = 10

    def __init__(self, app):
        super().__init__(app)
        self.sel = 0
        self.scroll = 0
        self.cache_bytes = None
        self.prev = rommlib.backup_version()
        self._measure_cache()

    def _measure_cache(self):
        def size():
            tot = 0
            for dp, _, fns in os.walk(rommlib.COVER_CACHE):
                for f in fns:
                    try:
                        tot += os.path.getsize(os.path.join(dp, f))
                    except OSError:
                        pass
            return tot
        self.app.bg(size, lambda n: setattr(self, "cache_bytes", n))

    def items(self):
        cfg = self.app.cfg
        tok = cfg.get("token") or ""
        masked = (tok[:4] + "…" + tok[-4:]) if len(tok) > 10 else ("set" if tok else "not set")
        tls = rommlib.norm_verify(cfg.get("verify_tls", True))
        tls_s = "On" if tls is True else ("Off" if tls is False else "CA: " + os.path.basename(tls))
        arcade = (cfg.get("platform_map") or {}).get("arcade") or rommlib.PLATFORM_MAP["arcade"]
        return [
            ("url", "RomM server", rommlib.display_url(cfg.get("url")) or "not set",
             "Plain HTTP: the token isn't encrypted"
             if (cfg.get("url") or "").lower().startswith("http://") else "A to edit (http:// or https://)"),
            ("token", "API token", masked, "Create one in RomM under Profile, Client API tokens"),
            ("tls", "Verify TLS certificate", tls_s, "Off only for a self-signed cert"),
            ("test", "Test connection", "", "Fetch the platform list now"),
            ("style", "Button labels", self._style_value(), "Match the symbols on your controller"),
            ("swap", "Confirm button", "East (right)" if cfg.get("swap_ab") else "South (bottom)",
             "Which face button means OK"),
            ("chd", "Compress disc games to CHD", "On" if cfg.get("chd", True) else "Off",
             "Background, only while no game is running"),
            ("bgdl", "Keep downloading after exit", "On" if cfg.get("background_downloads", True) else "Off",
             "Finishes the queue while you play"),
            ("speed", "Download speed while playing",
             "%g MB/s" % cfg["speed_while_playing"] if cfg.get("speed_while_playing") else "No limit",
             "Keeps online play and streaming smooth"),
            ("notify", "Popup when downloads finish", "On" if cfg.get("notify", True) else "Off",
             "In EmulationStation, after you exit"),
            ("manuals", "Download manuals", "On" if cfg.get("manuals", True) else "Off",
             "PDF from RomM, opens from the game's menu in ES"),
            ("sounds", "Sounds", {"normal": "On", "quiet": "Quiet", "off": "Off"}.get(
                cfg.get("sounds", "normal"), "On"), "Clicks and chimes in this app"),
            ("arcade", "Arcade games go to", "roms/" + arcade, "fbneo (forgiving) or mame (exact sets)"),
            ("cache", "Clear cover cache",
             human_size(self.cache_bytes) if self.cache_bytes is not None else "…",
             "Covers re-download as you browse"),
            ("update", "Updates", ("%s available" % self.app.update_tag) if self.app.update_tag
             else "v" + rommlib.VERSION,
             ("Download, check and install %s" % self.app.update_tag) if self.app.update_tag
             else "Check GitHub for a newer release"),
        ] + ([("rollback", "Go back to the previous version", "v" + self.prev, "Undo the last update")]
             if self.prev else [])

    STYLES = ["auto", "xbox", "playstation", "nintendo"]
    SPEEDS = [0, 50, 20, 10, 5, 2]            # MB/s, 0 = no limit

    def _style_value(self):
        want = self.app.cfg.get("button_style") or "auto"
        if want == "auto":
            return "Auto (%s)" % STYLE_NAMES[style_from_names(self.app.input.names())]
        return STYLE_NAMES.get(want, want)

    def crumbs(self):
        return ["Settings"]

    def hints(self):
        return [("A", "Change"), ("B", "Back")]

    def action(self, a):
        n = len(self.items())
        if a in ("up", "down"):
            self.sel = (self.sel + (1 if a == "down" else -1)) % n
        elif a in ("ok", "left", "right"):
            key = self.items()[self.sel][0]
            app, cfg = self.app, self.app.cfg
            if key == "url" and a == "ok":
                def save_url(v):
                    if v and "://" not in v:
                        v = "https://" + v
                    if rommlib.url_has_userinfo(v):
                        app.toast("Leave user:password out of the URL — the token is the login", RED)
                        return
                    cfg["url"] = v.rstrip("/")
                    app.apply_config(reconnect=True)
                    app.toast("Server saved — reconnecting", GREEN)
                cur = cfg.get("url") or "https://"
                if rommlib.url_has_userinfo(cur):
                    cur = "https://"          # never pre-fill an embedded password
                app.push(TextInputScreen(app, "RomM server URL", cur, save_url))
            elif key == "token" and a == "ok":
                def save_tok(v):
                    cfg["token"] = v
                    app.apply_config(reconnect=True)
                    app.toast("Token saved — reconnecting", GREEN)
                app.push(TextInputScreen(app, "RomM client API token", cfg.get("token") or "",
                                         save_tok, secret=True))
            elif key == "tls":
                cfg["verify_tls"] = rommlib.norm_verify(cfg.get("verify_tls", True)) is False
                app.apply_config(reconnect=True)
            elif key == "test" and a == "ok":
                app.toast("Testing…")
                app.bg(app.api.platforms,
                       lambda p: app.toast("Connected: %d platforms on the server" % len(p), GREEN),
                       lambda e: app.toast(str(e), RED))
            elif key == "style":
                cur = cfg.get("button_style") or "auto"
                i = self.STYLES.index(cur) if cur in self.STYLES else 0
                cfg["button_style"] = self.STYLES[(i + (-1 if a == "left" else 1)) % len(self.STYLES)]
                app.apply_config()
            elif key == "swap":
                cfg["swap_ab"] = not cfg.get("swap_ab")
                app.apply_config()
                app.toast("Confirm is now the %s button" % ("east" if cfg["swap_ab"] else "south"))
            elif key == "bgdl":
                cfg["background_downloads"] = not cfg.get("background_downloads", True)
                app.apply_config()
            elif key == "speed":
                cur = cfg.get("speed_while_playing") or 0
                i = self.SPEEDS.index(cur) if cur in self.SPEEDS else 0
                cfg["speed_while_playing"] = self.SPEEDS[(i + (-1 if a == "left" else 1)) % len(self.SPEEDS)]
                app.apply_config()
            elif key == "notify":
                cfg["notify"] = not cfg.get("notify", True)
                app.apply_config()
            elif key == "manuals":
                cfg["manuals"] = not cfg.get("manuals", True)
                app.apply_config()
                app.downloader.cfg = cfg
            elif key == "sounds":
                lv = ["normal", "quiet", "off"]
                cur = cfg.get("sounds", "normal")
                i = lv.index(cur) if cur in lv else 0
                cfg["sounds"] = lv[(i + (-1 if a == "left" else 1)) % len(lv)]
                app.apply_config()
                app.sfx.set_level(cfg["sounds"])
                app.sfx.play("toggle")
            elif key == "chd":
                cfg["chd"] = not cfg.get("chd", True)
                app.apply_config()
                app.downloader.cfg = cfg
            elif key == "arcade":
                pm = dict(cfg.get("platform_map") or {})
                cur = pm.get("arcade") or rommlib.PLATFORM_MAP["arcade"]
                pm["arcade"] = "mame" if cur == "fbneo" else "fbneo"
                cfg["platform_map"] = pm
                app.apply_config(reconnect=True)
            elif key == "update" and a == "ok":
                if app.update_tag:
                    tag = app.update_tag
                    app.modal = Confirm(app, "Update to %s?" % tag,
                                        "Downloads it from GitHub, checks it, and keeps v%s so you can go "
                                        "back. RomM Browser then closes; open it again." % rommlib.VERSION,
                                        "Update", lambda: self._do_update())
                else:
                    app.toast("Checking GitHub…")

                    def checked(tag):
                        app.update_tag = tag
                        app.toast(("%s is available" % tag) if tag else
                                  "You have the latest version (v%s)" % rommlib.VERSION, BLUE if tag else GREEN)
                    app.bg(lambda: rommlib.newer_release(dict(cfg, check_updates=True), force=True), checked)
            elif key == "rollback" and a == "ok":
                app.modal = Confirm(app, "Go back to v%s?" % self.prev,
                                    "Swaps v%s back in; v%s is kept so you can undo this. RomM Browser then "
                                    "closes; open it again." % (self.prev, rommlib.VERSION),
                                    "Go back", lambda: self._swap(rommlib.rollback), danger=True)
            elif key == "cache" and a == "ok":
                shutil.rmtree(rommlib.COVER_CACHE, ignore_errors=True)
                app.covers.clear()
                app.scaled_covers.clear()
                self.cache_bytes = 0
                app.toast("Cover cache cleared", GREEN)
        else:
            super().action(a)

    def _do_update(self):
        self.app.toast("Downloading and checking the update…")
        self._swap(lambda: rommlib.install_staged(rommlib.stage_release(rommlib.release_info())))

    def _swap(self, fn):
        app = self.app

        def done(ver):
            app.modal = Confirm(app, "Now on v%s" % ver,
                                "Close RomM Browser and open it again from Pygame to use it.",
                                "Close RomM Browser", app._quit)

        def err(e):
            app.toast(str(e) if isinstance(e, rommlib.UpdateError) else "Update failed (%s)"
                      % e.__class__.__name__, RED)
        app.bg(fn, done, err)

    def draw(self, c):
        items = self.items()
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + self.VISIBLE:
            self.scroll = self.sel - self.VISIBLE + 1
        y = 84
        for i, (key, label, value, sub) in list(enumerate(items))[self.scroll:self.scroll + self.VISIBLE]:
            r = pygame.Rect(48, y, 700, 52)
            on = i == self.sel
            rrect(c, PANEL_HI if on else PANEL, r, 12)
            if on:
                rrect(c, ACCENT, r, 12, 2)
            text(c, self.f.h3, label, (r.left + 22, r.top + 4), TEXT if on else DIM)
            warn = sub.startswith("Plain HTTP")
            text(c, self.f.small, sub, (r.left + 22, r.top + 28), AMBER if warn else FAINT, maxw=420)
            vcol = ACCENT_HI if key in ("test", "cache", "update", "rollback") else (TEXT if on else DIM)
            text(c, self.f.body, value, (r.right - 22, r.centery), vcol, "midright", maxw=240)
            y += 57
        if len(items) > self.VISIBLE:
            track = pygame.Rect(756, 84, 4, self.VISIBLE * 57 - 5)
            rrect(c, LINE, track, 2)
            h = max(30, track.height * self.VISIBLE // len(items))
            yy = track.top + (track.height - h) * self.scroll // max(1, len(items) - self.VISIBLE)
            rrect(c, ACCENT, (track.left, yy, 4, h), 2)
        # About panel
        p = pygame.Rect(776, 84, 472, 554)
        rrect(c, PANEL, p, 16)

        text(c, self.f.h1, "RomM Browser", (p.left + 28, p.top + 24), TEXT)
        text(c, self.f.body, "romm-o-cera v" + rommlib.VERSION, (p.left + 28, p.top + 72), ACCENT_HI)
        rows = [("Update available", "%s is out. Updates (on the left) installs it."
                 % self.app.update_tag)] if self.app.update_tag else []
        rows += [("Status", self.app.status if not self.app.error else self.app.error),
                ("Platforms here", str(len(self.app.platforms))),
                ("Config", rommlib.CONFIG_PATH),
                ("Data / log", rommlib.LOG_PATH),
                ("Roms", rommlib.ROMS_ROOT)]
        yy = p.top + 124
        for k, v in rows:
            text(c, self.f.small, k, (p.left + 28, yy), FAINT)
            for j, ln in enumerate(wrap(self.f.cond, v, p.width - 56, 2)):
                text(c, self.f.cond, ln, (p.left + 28, yy + 18 + j * 19), DIM)
            yy += 66
        rich_text(c, self.f, self.f.small, "Hotkey + {START} exits", (p.left + 28, p.bottom - 36), FAINT)


class InstalledScreen(Screen):
    """Games RomM Browser installed, biggest first, with delete."""
    ROWS, ROW_H = 10, 54

    def __init__(self, app):
        super().__init__(app)
        self.items = None
        self.sel = self.scroll = 0
        self.load()

    def load(self):
        lib = self.app.library

        def scan():
            out, sets = [], {}
            with lib.lock:
                lib._reload()
                recs = list(lib.installed.items())
            for rid, rec in recs:
                paths = [p for p in rec.get("paths", []) if os.path.exists(p)]
                if not paths:
                    continue
                g = rec.get("group")
                if g:                           # a multi-disc set is one row
                    it = sets.get(g["id"])
                    if it is None:
                        it = sets[g["id"]] = {"id": int(rid), "group": g, "paths": [],
                                              "name": "%s (%d discs)" % (g.get("title") or g["base"],
                                                                         len(g.get("rom_ids") or [])),
                                              "system": rec.get("system"), "when": rec.get("when", "")}
                        out.append(it)
                    it["paths"] += [p for p in paths if p not in it["paths"]]
                    continue
                out.append({"id": int(rid), "name": rec.get("name") or os.path.basename(paths[0]),
                            "system": rec.get("system"), "when": rec.get("when", ""), "paths": paths})
            for it in out:
                it["size"] = sum(rommlib.path_size(p) for p in it.pop("paths"))
            return sorted(out, key=lambda i: -i["size"])
        self.app.bg(scan, lambda items: setattr(self, "items", items))

    def enter(self):
        self.load()

    def crumbs(self):
        return ["On this box"]

    def hints(self):
        return [("A", "Delete"), ("X", "Check games"), ("L", "Page up"), ("R", "Page down"), ("B", "Back")]

    def check_menu(self):
        app = self.app
        app.modal = ActionMenu(app, "Check the games on this box", [
            ("Quick check", "Missing tracks, damaged zips, sizes against RomM",
             lambda: app.push(AuditScreen(app, deep=False))),
            ("Full check", "Also checksums every file and verifies CHDs. Slow: hours for a big library",
             lambda: app.push(AuditScreen(app, deep=True))),
        ])

    def action(self, a):
        if a == "x":
            return self.check_menu()
        if not self.items:
            return super().action(a)
        n = len(self.items)
        mv = {"up": -1, "down": 1, "l1": -self.ROWS, "r1": self.ROWS}
        if a in mv:
            self.sel = max(0, min(n - 1, self.sel + mv[a]))
        elif a == "ok":
            it = self.items[self.sel]
            rom = {"id": it["id"], "name": it["name"]}
            if it.get("group"):
                lib, g, app = self.app.library, it["group"], self.app

                def gone(res):
                    app.toast("Deleted %s — %s freed" % (it["name"], human_size(res[1])), GREEN)
                    self.load()
                self.app.modal = Confirm(app, "Delete %s?" % it["name"],
                                         "Removes every disc and the playlist from roms/%s (%s). Saves and "
                                         "states are kept." % (it["system"], human_size(it["size"])), "Delete",
                                         lambda: app.bg(lambda: lib.uninstall_group(g, it["system"]), gone),
                                         danger=True)
                return
            self.app.modal = Confirm(self.app, "Delete %s?" % it["name"],
                                     "Removes it from roms/%s (%s). Saves and states are kept."
                                     % (it["system"], human_size(it["size"])), "Delete",
                                     lambda: self.app.uninstall(rom, it["system"], self.load), danger=True)
        else:
            super().action(a)

    def draw(self, c):
        if self.items is None:
            text(c, self.f.h2, "Measuring…", (W // 2, H // 2), DIM, "center")
            return
        try:
            st = os.statvfs(rommlib.ROMS_ROOT)
            free = human_size(st.f_bavail * st.f_frsize)
        except OSError:
            free = "?"
        text(c, self.f.h3, "%d game%s from RomM use%s %s. %s free." % (
            len(self.items), "" if len(self.items) == 1 else "s", "s" if len(self.items) == 1 else "",
            human_size(sum(i["size"] for i in self.items)), free), (56, 86), TEXT)
        lab = "{X} Check for damaged games"
        rich_text(c, self.f, self.f.small, lab, (W - 56 - 250, 89), ACCENT_HI)
        if not self.items:
            text(c, self.f.body, "Nothing installed by RomM Browser yet. Games copied over another way "
                 "can be deleted from their game list.", (56, 130), DIM)
            return
        rows = self.ROWS
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + rows:
            self.scroll = self.sel - rows + 1
        y = 124
        for i in range(self.scroll, min(len(self.items), self.scroll + rows)):
            it = self.items[i]
            on = i == self.sel
            r = pygame.Rect(48, y, W - 96, self.ROW_H - 4)
            if on:
                focus_box(c, r)
            text(c, self.f.row, it["name"], (r.left + 22, r.centery), TEXT if on else DIM, "midleft",
                 maxw=r.width - 420)
            tag = it["system"] or "?"
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - 290 - tw, r.centery - 10, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, FAINT, "center")
            text(c, self.f.small, it["when"][:10], (r.right - 150, r.centery), FAINT, "midright")
            text(c, self.f.small, human_size(it["size"]), (r.right - 20, r.centery), DIM, "midright")
            y += self.ROW_H


class AuditScreen(Screen):
    """Check what's on the box against RomM; damaged games can be downloaded
    again. Red: damaged or incomplete. Amber: not RomM's copy (another dump,
    a trimmed image…), which may well play."""
    ROWS, ROW_H = 8, 62

    def __init__(self, app, deep=False):
        super().__init__(app)
        self.deep = deep
        self.cancel = threading.Event()
        self.where = ""
        self.findings = None
        self.stats = None
        self.sel = self.scroll = 0
        self.queued = set()
        self.t0 = time.time()
        by_sys = {}
        for p in app.platforms:
            by_sys.setdefault(p["_system"], []).append(p["id"])

        def progress(system, name):
            self.where = "roms/%s/%s" % (system, name)

        def run():
            return rommlib.audit(app.api, by_sys, deep=deep, progress=progress, cancel=self.cancel)

        def done(res):
            f, self.stats = res
            order = {"damaged": 0, "differs": 1}
            self.findings = sorted(f, key=lambda x: (order.get(x["severity"], 2), x["system"], x["path"]))
        app.bg(run, done, lambda e: (setattr(self, "findings", []), app.toast(str(e), RED)))

    def crumbs(self):
        return ["On this box", "Full check" if self.deep else "Quick check"]

    def hints(self):
        if self.findings is None:
            return [("B", "Stop")]
        h = [("A", "Download again")] if self.findings else []
        if self.redownloadable():
            h.append(("Y", "Download all damaged again"))
        return h + [("B", "Back")]

    def redownloadable(self):
        return [f for f in (self.findings or []) if f["severity"] == "damaged" and f["rom"]
                and f["path"] not in self.queued]

    def redownload(self, f):
        app = self.app
        app.downloader.enqueue(dict(f["rom"]), f["system"])
        self.queued.add(f["path"])

    def action(self, a):
        app = self.app
        if self.findings is None:
            if a in ("back", "quit"):
                self.cancel.set()
                app.toast("Check stopped")
                super().action("back")
            return
        n = len(self.findings)
        mv = {"up": -1, "down": 1, "l1": -self.ROWS, "r1": self.ROWS}
        if a in mv and n:
            self.sel = max(0, min(n - 1, self.sel + mv[a]))
        elif a == "ok" and n:
            f = self.findings[self.sel]
            if not f["rom"]:
                app.toast("Not in RomM under this name — can't download it again", AMBER)
            elif f["path"] in self.queued:
                app.toast("Already queued")
            else:
                name = f["rom"].get("name") or os.path.basename(f["path"])
                app.modal = Confirm(app, "Download %s again?" % name,
                                    "%s. RomM's copy replaces the one on the box (saves are kept)." % f["problem"],
                                    "Download again", lambda: (self.redownload(f), app.toast("Queued: %s" % name, GREEN)))
        elif a == "y" and self.redownloadable():
            todo = self.redownloadable()
            seen, uniq = set(), []
            for f in todo:
                if f["rom"]["id"] not in seen:
                    seen.add(f["rom"]["id"])
                    uniq.append(f)

            def go():
                for f in todo:
                    if f["rom"]["id"] in seen:
                        self.redownload(f)
                app.toast("Queued %d games" % len(uniq), GREEN)
            app.modal = Confirm(app, "Download %d damaged games again?" % len(uniq),
                                "RomM's copies replace the damaged ones. Games that only differ from RomM "
                                "(amber) are left alone.", "Download %d" % len(uniq), go)
        else:
            if a == "back":
                self.cancel.set()
            super().action(a)

    def draw(self, c):
        if self.findings is None:
            secs = int(time.time() - self.t0)
            text(c, self.f.h2, "Checking games…", (W // 2, 280), TEXT, "center")
            text(c, self.f.body, self.where or "Asking RomM what it has…", (W // 2, 326), DIM, "center",
                 maxw=W - 160)
            text(c, self.f.small, "%d:%02d elapsed%s" % (secs // 60, secs % 60,
                 " · full check: checksums every file" if self.deep else ""), (W // 2, 362), FAINT, "center")
            return
        st = self.stats or {}
        dmg = sum(1 for f in self.findings if f["severity"] == "damaged")
        dif = len(self.findings) - dmg
        head = "%d checked, %d matched to RomM. " % (st.get("checked", 0), st.get("matched", 0))
        if not self.findings:
            text(c, self.f.h3, head + "Everything looks right.", (56, 86), GREEN)
            text(c, self.f.body, "Games not in RomM under the same file name aren't checked (%d)."
                 % st.get("unmatched", 0), (56, 124), DIM)
            return
        text(c, self.f.h3, head, (56, 86), TEXT)
        x = 56 + int(measure(self.f.h3, head)) + 6
        if dmg:
            r = text(c, self.f.h3, "%d damaged" % dmg, (x, 86), RED)
            x = r.right + 16
        if dif:
            text(c, self.f.h3, "%d differ from RomM" % dif, (x, 86), AMBER)
        rows = self.ROWS
        if self.sel < self.scroll:
            self.scroll = self.sel
        elif self.sel >= self.scroll + rows:
            self.scroll = self.sel - rows + 1
        y = 124
        for i in range(self.scroll, min(len(self.findings), self.scroll + rows)):
            f = self.findings[i]
            on = i == self.sel
            r = pygame.Rect(48, y, W - 96, self.ROW_H - 6)
            if on:
                focus_box(c, r)
            col = RED if f["severity"] == "damaged" else AMBER
            circle(c, col, (r.left + 18, r.top + 20), 5)
            name = os.path.relpath(f["path"], os.path.join(rommlib.ROMS_ROOT, f["system"]))
            text(c, self.f.row, name, (r.left + 34, r.top + 8), TEXT if on else DIM, maxw=r.width - 230)
            text(c, self.f.small, f["problem"], (r.left + 34, r.top + 34), col, maxw=r.width - 230)
            tag = "queued" if f["path"] in self.queued else f["system"]
            tw = int(measure(self.f.tiny, tag)) + 14
            tr = pygame.Rect(r.right - 20 - tw, r.top + 10, tw, 20)
            rrect(c, BG2, tr, 6)
            text(c, self.f.tiny, tag, tr.center, GREEN if f["path"] in self.queued else FAINT, "center")
            y += self.ROW_H


# ------------------------------------------------------------------ modals

class ActionMenu:
    """Modal menu. entries: list of rows, None = divider. A row is
    (label, sub, fn or None=disabled[, value[, kind]]):
      kind "action" (default): A runs fn and closes the menu;
      kind "switch": value True/False drawn as a switch, A/◀▶ flip it in place;
      kind "choice": value drawn as ‹ value ›, A/▶ next, ◀ previous, in place.
    In-place rows need `refresh` (returns fresh entries) so values update."""
    ROW, ROW_SUB, CTRL, GAP = 46, 56, 44, 14

    def __init__(self, app, title, entries, refresh=None):
        self.app, self.title, self.entries, self.refresh = app, title, entries, refresh
        self.sel = next((i for i, e in enumerate(entries) if e and e[2]), 0)

    @staticmethod
    def kind(e):
        return e[4] if len(e) > 4 else "action"

    def action(self, a):
        n = len(self.entries)
        e = self.entries[self.sel] if n else None
        if a in ("up", "down") and n:
            for _ in range(n):
                self.sel = (self.sel + (1 if a == "down" else -1)) % n
                if self.entries[self.sel] and self.entries[self.sel][2]:
                    break
        elif e and e[2] and self.kind(e) != "action" and a in ("ok", "left", "right"):
            fn = e[2]
            if self.kind(e) == "choice":
                fn(-1 if a == "left" else 1)
            else:
                fn()
            self.reload()
        elif a == "ok" and e and e[2]:
            self.app.modal = None
            e[2]()
        elif a in ("back", "quit", "x"):
            self.app.modal = None

    def reload(self):
        """Re-read entries, keeping focus on the same row (by label)."""
        if not self.refresh:
            return
        cur = self.entries[self.sel][0] if self.entries and self.entries[self.sel] else None
        self.entries = self.refresh()
        idx = next((i for i, e in enumerate(self.entries) if e and e[0] == cur), None)
        self.sel = idx if idx is not None else next((i for i, e in enumerate(self.entries) if e and e[2]), 0)

    def _height(self, e):
        if e is None:
            return self.GAP
        if self.kind(e) != "action":
            return self.CTRL
        return self.ROW_SUB if e[1] else self.ROW

    def draw(self, c):
        f = self.app.fonts
        veil = pygame.Surface(c.get_size(), pygame.SRCALPHA)
        veil.fill((0, 0, 0, 170))
        c.blit(veil, (0, 0))
        body = sum(self._height(e) for e in self.entries)
        r = pygame.Rect(0, 0, 680, 78 + body + 18)
        r.center = (W // 2, H // 2)
        rrect(c, PANEL, r, 18)
        rrect(c, LINE, r, 18, 1)
        text(c, f.h2, self.title, (r.left + 28, r.top + 24), TEXT, maxw=r.width - 56)
        y = r.top + 72
        for i, e in enumerate(self.entries):
            h = self._height(e)
            if e is None:                               # divider between actions and view controls
                hline(c, LINE, (r.left + 28, y + h // 2), (r.right - 28, y + h // 2))
                y += h
                continue
            label, sub, fn = e[:3]
            value = e[3] if len(e) > 3 else None
            kind = self.kind(e)
            row = pygame.Rect(r.left + 16, y, r.width - 32, h - 6)
            on = i == self.sel
            if on:
                focus_box(c, row)
            col = (TEXT if on else DIM) if fn else FAINT
            vw = 0
            if kind == "switch":
                tr = pygame.Rect(row.right - 18 - 44, row.centery - 12, 44, 24)
                rrect(c, ACCENT if value else LINE, tr, 12)
                circle(c, TEXT if value else DIM, (tr.right - 12 if value else tr.left + 12, tr.centery), 8)
                vw = 44 + 24
            elif kind == "choice":
                vr = text(c, f.body, str(value), (row.right - 40, row.centery), ACCENT_HI if on else DIM, "midright")
                for side, x0 in ((-1, vr.left - 16), (1, row.right - 26)):
                    pts = [(x0 + 4, row.centery - 6), (x0 - 2, row.centery), (x0 + 4, row.centery + 6)]
                    if side > 0:
                        pts = [(x0 - 2, row.centery - 6), (x0 + 4, row.centery), (x0 - 2, row.centery + 6)]
                    polyline(c, ACCENT_HI if on else FAINT, pts, 2)
                vw = (row.right - vr.left) + 24
            elif value:
                vr = text(c, f.body, value, (row.right - 18, row.centery), ACCENT_HI if on else DIM, "midright")
                vw = vr.width + 24
            if sub:
                text(c, f.body, label, (row.left + 18, row.top + 6), col, maxw=row.width - 36 - vw)
                if GLYPH_RE.search(sub):
                    rich_text(c, f, f.small, sub, (row.left + 18, row.top + 30), FAINT)
                else:
                    text(c, f.small, sub, (row.left + 18, row.top + 30), FAINT, maxw=row.width - 36 - vw)
            else:
                text(c, f.body, label, (row.left + 18, row.centery), col, "midleft", maxw=row.width - 36 - vw)
            y += h


class ManageMenu(ActionMenu):
    """For a game already on the box."""

    def __init__(self, app, rom):
        system = app.system_for(rom)
        lib = app.library
        paths = lib.paths_for(rom, system) if system else []
        size = sum(rommlib.path_size(p) for p in paths)
        name = rom_title(rom)
        group = lib.group_for(rom["id"]) if system else None
        if group:
            n = len(group.get("rom_ids") or [])
            allp = []
            for rid in group["rom_ids"]:
                for p in lib.paths_for({"id": rid, "fs_name": None, "fs_name_no_ext": None}, system):
                    if p not in allp:
                        allp.append(p)
            gsize = sum(rommlib.path_size(p) for p in allp)
            title = group.get("title") or name

            def delete_set():
                app.modal = Confirm(app, "Delete all %d discs of %s?" % (n, title),
                                    "Removes the discs and their playlist from roms/%s (%s). Saves and "
                                    "states are kept." % (system, human_size(gsize)), "Delete",
                                    lambda: app.bg(lambda: lib.uninstall_group(group, system),
                                                   lambda res: app.toast("Deleted %s — %s freed" % (
                                                       title, human_size(res[1])), GREEN)), danger=True)
            super().__init__(app, title, [
                ("Delete all %d discs" % n, "Frees %s" % human_size(gsize), delete_set if allp else None),
                ("Download this disc again", "Replaces this disc only", lambda: app.start_download(rom)),
            ])
            return

        def delete():
            files = ", ".join(os.path.basename(p) for p in paths[:3]) + ("…" if len(paths) > 3 else "")
            app.modal = Confirm(app, "Delete %s?" % name,
                                "Removes %s from roms/%s (%s). Saves and states are kept."
                                % (files, system, human_size(size)),
                                "Delete", lambda: app.uninstall(rom, system), danger=True)
        super().__init__(app, name, [
            ("Delete from this box", "Frees %s (%d file%s)" % (human_size(size), len(paths),
                                                         "" if len(paths) == 1 else "s"),
             delete if paths else None),
            ("Download again", "Replaces what's on the box", lambda: setattr(
                app, "modal", DownloadConfirm(app, rom))),
        ])


class Confirm:
    def __init__(self, app, title, body, ok_label, on_ok, danger=False):
        self.app, self.title, self.body = app, title, body
        self.ok_label, self.on_ok, self.danger = ok_label, on_ok, danger

    def action(self, a):
        if a == "ok":
            self.app.modal = None
            self.on_ok()
        elif a in ("back", "quit"):
            self.app.modal = None

    def draw(self, c):
        f = self.app.fonts
        veil = pygame.Surface(c.get_size(), pygame.SRCALPHA)
        veil.fill((0, 0, 0, 170))
        c.blit(veil, (0, 0))
        r = pygame.Rect(0, 0, 640, 260)
        r.center = (W // 2, H // 2)
        rrect(c, PANEL, r, 18)
        rrect(c, LINE, r, 18, 1)
        text(c, f.h2, self.title, (r.left + 32, r.top + 28), TEXT, maxw=r.width - 64)
        for i, ln in enumerate(wrap(f.body, self.body, r.width - 64, 4)):
            text(c, f.body, ln, (r.left + 32, r.top + 76 + i * 26), DIM)
        bx = r.left + 32
        by = r.bottom - 58
        okr = pygame.Rect(bx, by, 260, 40)
        rrect(c, RED if self.danger else ACCENT, okr, 10)
        g = button_glyph(c, f, "A", okr.left + 12, okr.centery - 11)
        text(c, f.h3, self.ok_label, (okr.left + 22 + g, okr.centery), TEXT, "midleft")
        nr = pygame.Rect(okr.right + 16, by, 180, 40)
        rrect(c, PANEL_HI, nr, 10)
        g = button_glyph(c, f, "B", nr.left + 12, nr.centery - 11)
        text(c, f.h3, "Back", (nr.left + 22 + g, nr.centery), DIM, "midleft")


class DownloadConfirm(Confirm):
    """Download one game. A disc of a multi-disc set first looks the set up in
    RomM, then offers all discs (one ES entry via an .m3u) or just this one."""

    def __init__(self, app, rom):
        system = app.system_for(rom)
        st = GameListScreen.rom_status(app.stack[-1], rom) if isinstance(app.stack[-1], GameListScreen) \
            else ("remote", None)
        name = rom.get("name") or rom.get("fs_name_no_ext")
        self.pending = False
        if not system:
            super().__init__(app, name, "This platform has no Batocera system to put it in.",
                             "OK", lambda: None)
            return
        if st[0] == "active":
            super().__init__(app, name, "Already downloading.", "OK", lambda: None)
            return
        body = "%s, saved to roms/%s." % (human_size(rom.get("fs_size_bytes")), system)
        if st[0] == "installed":
            body = "Already on this box. Download again anyway?  " + body
        var = app.library.variants(rom, system)
        if var:
            body += "  You already have %s%s." % (var[0], " and %d more" % (len(var) - 1) if len(var) > 1 else "")
        super().__init__(app, name, body, "Download", lambda: app.start_download(rom))
        if rommlib.disc_info(rom.get("fs_name_no_ext") or "") and st[0] != "installed":
            self.pending = True
            self.body = "Looking for the other discs in RomM…"
            app.bg(lambda: rommlib.find_disc_set(app.api, rom),
                   lambda res: self._found(rom, system, body, *res),
                   lambda e: self._lookup_failed(body, e))

    def _lookup_failed(self, body, e):
        self.pending = False
        self.body = body + "  (Couldn't look up the other discs: %s)" % e

    def _found(self, rom, system, body, discs, missing):
        app = self.app
        self.pending = False
        if app.modal is not self:
            return                            # closed meanwhile
        if not discs or len(discs) < 2:
            self.body = body + "  No other discs of it found in RomM."
            return
        me = rommlib.disc_info(rom.get("fs_name_no_ext") or "")[1]
        here = [r for _, r in discs if r["id"] != rom["id"] and app.library.is_installed(r, system)]
        size = sum(r.get("fs_size_bytes") or 0 for _, r in discs
                   if r["id"] == rom["id"] or not app.library.is_installed(r, system))
        m3u = app.downloader._accepts(system, ".m3u")
        sub = "%s · %s" % (human_size(size), "one entry in EmulationStation" if m3u
                           else "each disc listed separately")
        if here:
            sub += " · %d already here" % len(here)
        entries = [("Download all %d discs" % len(discs), sub, lambda: app.download_set(rom, discs))]
        if missing:
            entries.append(("Disc %s not in RomM" % ", ".join(map(str, missing)),
                            "The set looks incomplete", None))
        entries.append(("Only disc %d" % me, human_size(rom.get("fs_size_bytes")),
                        lambda: app.start_download(rom)))
        var = app.library.variants(rom, system)
        if var:
            entries += [None, ("Already here: %s" % var[0],
                               ("and %d more" % (len(var) - 1)) if len(var) > 1 else "Another version", None)]
        app.modal = ActionMenu(app, app.set_title(rom), entries)

    def action(self, a):
        if self.pending and a == "ok":
            return
        super().action(a)


# --------------------------------------------------------------------- main

def register_self():
    """First run: queue our own ES gamelist entry (name, icon) for the
    post-exit merge, so the pygame system lists "RomM Browser", not a folder."""
    marker = os.path.join(rommlib.DATA_DIR, ".registered")
    if os.path.exists(marker):
        return
    entry = {"system": "pygame", "paths": [os.path.join(APP_DIR, "rommbrowser.pygame")],
             "name": "RomM Browser",
             "desc": "Browse and search your RomM library with a controller and download "
                     "games straight into this box's roms folders (romm-o-cera v%s)."
                     % rommlib.VERSION,
             "genres": ["Utility"], "developer": "romm-o-cera", "players": "1",
             "image_local": os.path.join(APP_DIR, "icon.png")}
    import json
    with open(rommlib.GAMELIST_QUEUE, "a") as f:
        f.write(json.dumps(entry) + "\n")
    open(marker, "w").close()


def main():
    try:
        pygame.mixer.pre_init(44100, -16, 2, 512)    # small buffer: blips land on the press
    except Exception:
        pass
    pygame.init()
    pygame.mouse.set_visible(False)
    flags = pygame.FULLSCREEN
    try:
        screen = pygame.display.set_mode((0, 0), flags)
    except pygame.error:
        screen = pygame.display.set_mode((W, H))
    pygame.display.set_caption("RomM Browser")
    os.makedirs(rommlib.DATA_DIR, exist_ok=True)
    rommlib.log("start")
    register_self()
    app = App(screen)
    try:
        app.run()
    except Exception as e:
        import traceback
        rommlib.log("crash: " + traceback.format_exc())
        raise
    finally:
        rommlib.log("exit")
        pygame.quit()


if __name__ == "__main__":
    main()
